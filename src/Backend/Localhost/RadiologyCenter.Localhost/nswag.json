{
  "runtime": "Net100",
  "documentGenerator": {
    "aspNetCore": {
      "project": "RadiologyCenter.Localhost.csproj",
      "noBuild": false
    }
  },
  "codeGenerators": {
    "openApiToCSharpClient": {
      "namespace": "RadiologyCenter.Localhost.GeneratedClients",
      "output": "GeneratedClients/ApiClient.cs",
      "generateClientInterfaces": true,
      "useBaseUrl": true,
      "generateExceptionClasses": false,
      "operationNameGenerator": "OpenApiCSharpClientOperationNameGenerator"
    }
  }
}
