      LEFT JOIN (
          SELECT [p0].[Id], [p0].[GrossSalary], [p0].[Notes], [p0].[PayRunId], [p0].[StaffId], [p0].[UnpaidLeaveDays], [p0].[UnpaidLeaveDeduction], [p1].[Id] AS [Id0], [p1].[Amount], [p1].[IsDeduction], [p1].[Name], [p1].[PayslipId]
