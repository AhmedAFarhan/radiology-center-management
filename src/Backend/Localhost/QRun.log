      SELECT [p2].[Id], [p2].[CreatedAt], [p2].[CreatedBy], [p2].[DeletedAt], [p2].[DeletedBy], [p2].[IsDeleted], [p2].[LastModifiedAt], [p2].[LastModifiedBy], [p2].[Notes], [p2].[ProcessedAt], [p2].[ProcessedBy], [p2].[RunFrom], [p2].[RunTo], [p2].[Status], [s].[Id], [s].[GrossSalary], [s].[Notes], [s].[PayRunId], [s].[StaffId], [s].[UnpaidLeaveDays], [s].[UnpaidLeaveDeduction], [s].[Id0], [s].[Amount], [s].[IsDeduction], [s].[Name], [s].[PayslipId]
      FROM (
          SELECT TOP(1) [p].[Id], [p].[CreatedAt], [p].[CreatedBy], [p].[DeletedAt], [p].[DeletedBy], [p].[IsDeleted], [p].[LastModifiedAt], [p].[LastModifiedBy], [p].[Notes], [p].[ProcessedAt], [p].[ProcessedBy], [p].[RunFrom], [p].[RunTo], [p].[Status]
