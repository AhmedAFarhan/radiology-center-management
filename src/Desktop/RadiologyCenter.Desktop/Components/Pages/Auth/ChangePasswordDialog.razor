@inherits EditorDialogBase
@inject AuthService AuthService

<MudDialog Class="change-password-dialog">
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Shield" Title="@(Forced ? T.ChangePassword.RequiredTitle : T.ChangePassword.Title)" />
        @if (Forced)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" Variant="Variant.Outlined">
                @T.ChangePassword.AdminWarning
            </MudAlert>
        }
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.CurrentPassword"
                                  For="@(() => _model.CurrentPassword)"
                                  Label="@T.ChangePassword.Current"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="@(_showCurrent ? InputType.Text : InputType.Password)"
                                  AutoComplete="current-password"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showCurrent ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  AdornmentColor="Color.Default"
                                  OnAdornmentClick="@(() => _showCurrent = !_showCurrent)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.NewPassword"
                                  For="@(() => _model.NewPassword)"
                                  Label="@T.ChangePassword.New"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="@(_showNew ? InputType.Text : InputType.Password)"
                                  AutoComplete="new-password"
                                  HelperText="@T.ChangePassword.Helper"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showNew ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  AdornmentColor="Color.Default"
                                  OnAdornmentClick="@(() => _showNew = !_showNew)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.ConfirmPassword"
                                  For="@(() => _model.ConfirmPassword)"
                                  Label="@T.ChangePassword.Confirm"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                                  AutoComplete="new-password"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  AdornmentColor="Color.Default"
                                  OnAdornmentClick="@(() => _showConfirm = !_showConfirm)" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        @if (!Forced)
        {
            <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="Busy">@T.ChangePassword.Cancel</MudButton>
        }
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="Busy">
            @if (Busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.ChangePassword.Update</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

