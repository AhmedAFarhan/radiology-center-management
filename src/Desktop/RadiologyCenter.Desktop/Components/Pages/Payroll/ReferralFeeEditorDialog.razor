@inherits EditorDialogBase
@inject PayrollService PayrollService
@inject ResourceService ResourceService
@inject ExaminationService ExaminationService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.LocalHospital" Title="@(Fee is null ? T.ReferralFee.NewReferralFee : T.ReferralFee.EditReferralFee)" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                @if (IsEdit)
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_doctorName"
                                      Label="@T.ReferralFee.ReferralDoctor"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_examTypeName"
                                      Label="@T.ReferralFee.ExaminationType"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="true" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="6">
                        <MudAutocomplete T="ReferralDoctorDto"
                                         @bind-Value="_selectedDoctor"
                                         Label="@T.ReferralFee.DoctorSearch"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="1"
                                         DebounceInterval="300"
                                         SearchFunc="SearchDoctorsAsync"
                                         ToStringFunc="@(d => d is null ? string.Empty : d.FullName)"
                                         Clearable="true"
                                         Disabled="Busy" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudAutocomplete T="ExaminationTypeDto"
                                         @bind-Value="_selectedType"
                                         Label="@T.ReferralFee.ExamTypeSearch"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="1"
                                         DebounceInterval="300"
                                         SearchFunc="SearchTypesAsync"
                                         ToStringFunc="@(t => t is null ? string.Empty : $"{t.Code} - {t.Name}")"
                                         Clearable="true"
                                         Disabled="Busy" />
                    </MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.Amount"
                                     Label="@(_model.IsPercentage ? T.ReferralFee.PercentagePercent : T.ReferralFee.FlatAmount)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     For="@(() => _model.Amount)" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-items-center">
                    <MudSwitch T="bool" @bind-Value="_model.IsPercentage" Color="Color.Primary">@T.ReferralFee.AmountIsPercentage</MudSwitch>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.ReferralFee.SaveChanges : T.ReferralFee.CreateFee)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>