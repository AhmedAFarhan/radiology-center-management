@inject PayrollService PayrollService
@inject ResourceService ResourceService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.ReceiptLong" Title="@(_payRun is null ? "Pay Run" : $"Pay Run {_payRun.RunFrom.ToString("yyyy-MM-dd")} \u2192 {_payRun.RunTo.ToString("yyyy-MM-dd")}")" />
        @if (_payRun is null)
        {
            <DialogSkeleton Rows="6" />
        }
        else
        {
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-4 rounded" Style="border:1px solid rgba(0,0,0,.12)">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6" md="3">
                                <MudText Typo="Typo.caption" Class="text-secondary">Period</MudText>
                                <MudText Typo="Typo.body1" Class="font-weight-medium">@_payRun.RunFrom.ToString("yyyy-MM-dd") → @_payRun.RunTo.ToString("yyyy-MM-dd")</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudText Typo="Typo.caption" Class="text-secondary">Status</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@StatusColor(_payRun.Status)">@FormatStatus(_payRun.Status)</MudChip>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudText Typo="Typo.caption" Class="text-secondary">Processed</MudText>
                                <MudText Typo="Typo.body2">@(_payRun.ProcessedAt?.ToString("g") ?? "Not processed")</MudText>
                                @if (!string.IsNullOrWhiteSpace(_payRun.ProcessedBy))
                                {
                                    <MudText Typo="Typo.caption" Class="text-secondary">by @_payRun.ProcessedBy</MudText>
                                }
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudText Typo="Typo.caption" Class="text-secondary">Employees</MudText>
                                <MudText Typo="Typo.body1" Class="font-weight-medium">@_payRun.Payslips.Count</MudText>
                            </MudItem>
                        </MudGrid>
                        @if (!string.IsNullOrWhiteSpace(_payRun.Notes))
                        {
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.body2" Class="text-secondary">@_payRun.Notes</MudText>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12">
                    <MudGrid Spacing="2" Class="mb-2">
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-medium">Payslips</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" Class="d-flex justify-end">
                            @if (CanEditPayslips)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AddPayslipAsync" Disabled="_busy">Add Payslip</MudButton>
                            }
                        </MudItem>
                    </MudGrid>

                    @if (_payRun.Payslips.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="text-secondary pa-4">No payslips yet. Add employees to this pay run.</MudText>
                    }
                    else
                    {
                        <MudTable T="PayslipDto" Items="_payRun.Payslips" Dense="true" Hover="true" Elevation="0" Class="rounded" Style="border:1px solid rgba(0,0,0,.12)">
                            <HeaderContent>
                                <MudTh />
                                <MudTh>Employee</MudTh>
                                <MudTh Class="text-right">Gross</MudTh>
                                <MudTh Class="text-right">Earnings</MudTh>
                                <MudTh Class="text-right">Deductions</MudTh>
                                <MudTh Class="text-right">Unpaid Days</MudTh>
                                <MudTh Class="text-right">Net</MudTh>
                                @if (CanEditPayslips)
                                {
                                    <MudTh Class="text-center">Actions</MudTh>
                                }
                            </HeaderContent>
                            <RowTemplate Context="ps">
                                <MudTd>
                                    <MudIconButton Icon="@(IsExpanded(ps) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                                   Size="Size.Small"
                                                   aria-label="Toggle breakdown"
                                                   OnClick="@(() => ToggleExpand(ps))" />
                                </MudTd>
                                <MudTd DataLabel="Employee">
                                    <MudText Class="font-weight-medium">@ResolveStaff(ps.StaffId)</MudText>
                                </MudTd>
                                <MudTd DataLabel="Gross" Class="text-right">@ps.GrossSalary.ToString("N2")</MudTd>
                                <MudTd DataLabel="Earnings" Class="text-right" Style="color:var(--mud-palette-success)">@ps.TotalEarnings.ToString("N2")</MudTd>
                                <MudTd DataLabel="Deductions" Class="text-right" Style="color:var(--mud-palette-error)">@ps.TotalDeductions.ToString("N2")</MudTd>
                                <MudTd DataLabel="Unpaid Days" Class="text-right">@ps.UnpaidLeaveDays</MudTd>
                                <MudTd DataLabel="Net" Class="text-right"><MudText Typo="Typo.body2" Class="font-weight-medium">@ps.NetSalary.ToString("N2")</MudText></MudTd>
                                @if (CanEditPayslips)
                                {
                                    <MudTd DataLabel="Actions" Class="text-center">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Remove payslip" OnClick="@(() => RemovePayslipAsync(ps))" Disabled="_busy" />
                                    </MudTd>
                                }
                            </RowTemplate>
                            <ChildRowContent>
                                @if (IsExpanded(context))
                                {
                                    <MudTr>
                                        <td colspan="8">
                                            <MudText Typo="Typo.caption" Class="text-secondary mb-1">Earnings / deductions breakdown</MudText>
                                    @if (context.Components.Count == 0)
                                    {
                                        <MudText Typo="Typo.body2" Class="text-secondary pa-2">No components recorded.</MudText>
                                    }
                                    else
                                    {
                                        <MudTable T="PayslipComponentDto" Items="context.Components" Dense="true" Hover="true" Elevation="0">
                                            <HeaderContent>
                                                <MudTh>Component</MudTh>
                                                <MudTh Class="text-right">Amount</MudTh>
                                            </HeaderContent>
                                            <RowTemplate Context="cmp">
                                                <MudTd>
                                                    <MudChip T="string" Size="Size.Small" Color="@(cmp.IsDeduction ? Color.Error : Color.Success)" Variant="Variant.Text">@(cmp.IsDeduction ? "Deduction" : "Earning")</MudChip>
                                                    <span class="ms-2">@cmp.Name</span>
                                                </MudTd>
                                                <MudTd Class="text-right" Style="@(cmp.IsDeduction ? "color:var(--mud-palette-error)" : "color:var(--mud-palette-success)")">
                                                    @(cmp.IsDeduction ? "-" : "+")@cmp.Amount.ToString("N2")
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(context.Notes))
                                    {
                                        <MudText Typo="Typo.caption" Class="text-secondary mt-2">@context.Notes</MudText>
                                    }
                                        </td>
                                    </MudTr>
                                }
                            </ChildRowContent>
                        </MudTable>
                    }
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-1" />
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Class="text-secondary">
                                Workflow: Draft → Compute → Approve → Pay. Use Reject to send a computed run back for review; Restart reopens a rejected run as a draft.
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" Class="d-flex flex-wrap gap-2">
                            @if (CanCompute)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Calculate" OnClick="ComputeAsync" Disabled="_busy">Compute</MudButton>
                            }
                            @if (CanApprove)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="ApproveAsync" Disabled="_busy">Approve</MudButton>
                            }
                            @if (CanReject)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel" OnClick="RejectAsync" Disabled="_busy">Reject</MudButton>
                            }
                            @if (CanRestart)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="RestartAsync" Disabled="_busy">Restart</MudButton>
                            }
                            @if (CanPay)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Payments" OnClick="PayAsync" Disabled="_busy">Pay</MudButton>
                            }
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CloseAsync" Disabled="_busy">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string PayRunId { get; set; } = string.Empty;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private PayRunDto? _payRun;
    private IReadOnlyDictionary<string, string> _staffNames = new Dictionary<string, string>();
    private readonly HashSet<string> _expandedPayslips = new();
    private bool _busy;

    private bool IsExpanded(PayslipDto payslip) => _expandedPayslips.Contains(payslip.StaffId);

    private void ToggleExpand(PayslipDto payslip)
    {
        if (!_expandedPayslips.Add(payslip.StaffId))
            _expandedPayslips.Remove(payslip.StaffId);
    }

    private bool CanEditPayslips => _payRun?.Status == "Draft";
    private bool CanCompute => _payRun?.Status == "Draft";
    private bool CanApprove => _payRun?.Status == "Computed";
    private bool CanReject => _payRun?.Status == "Computed";
    private bool CanRestart => _payRun?.Status == "Rejected";
    private bool CanPay => _payRun?.Status == "Approved";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var staffTask = ResourceService.GetStaffsPagedAsync(null, null, false, 1, 100);
            var payRunTask = PayrollService.GetPayRunByIdAsync(PayRunId);
            await Task.WhenAll(staffTask, payRunTask);

            _payRun = await payRunTask;
            _staffNames = (await staffTask).Items.ToDictionary(s => s.Id, s => s.FullName);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to load pay run.", Severity.Error);
        }
    }

    private string ResolveStaff(string staffId)
        => _staffNames.TryGetValue(staffId, out var name) ? name : staffId;

    private async Task ReloadAsync()
    {
        try
        {
            _payRun = await PayrollService.GetPayRunByIdAsync(PayRunId);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reload pay run.", Severity.Error);
        }
    }

    private async Task AddPayslipAsync()
    {
        var parameters = new DialogParameters { ["StaffSearchFunc"] = (Func<string, CancellationToken, Task<IEnumerable<StaffDto>>>)SearchStaffAsync };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<AddPayslipDialog>("Add Payslip", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false } && result.Data is string staffId)
        {
            try
            {
                _busy = true;
                await PayrollService.AddPayslipAsync(PayRunId, staffId);
                Snackbar.Add("Payslip added.", Severity.Success);
                await ReloadAsync();
            }
            catch (ApiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
            catch (Exception)
            {
                Snackbar.Add("Unable to add payslip.", Severity.Error);
            }
            finally
            {
                _busy = false;
            }
        }
    }

    private async Task<IEnumerable<StaffDto>> SearchStaffAsync(string? value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Array.Empty<StaffDto>();

        try
        {
            var page = await ResourceService.GetStaffsPagedAsync(value, "LastName", false, 1, 20, ct);
            return page.Items;
        }
        catch (Exception)
        {
            return Array.Empty<StaffDto>();
        }
    }

    private async Task RemovePayslipAsync(PayslipDto payslip)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove Payslip",
            $"Are you sure you want to remove {ResolveStaff(payslip.StaffId)} from this pay run?",
            "Remove",
            "Cancel");

        if (confirmed != true)
            return;

        try
        {
            _busy = true;
            await PayrollService.RemovePayslipAsync(PayRunId, payslip.StaffId);
            Snackbar.Add("Payslip removed.", Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to remove payslip.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RunLifecycleAsync(string verb, string confirmTitle, string confirmMessage, string confirmOk)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(confirmTitle, confirmMessage, confirmOk, "Cancel");
        if (confirmed != true)
            return;

        try
        {
            _busy = true;
            switch (verb)
            {
                case "compute": await PayrollService.ComputePayRunAsync(PayRunId); break;
                case "approve": await PayrollService.ApprovePayRunAsync(PayRunId); break;
                case "reject": await PayrollService.RejectPayRunAsync(PayRunId); break;
                case "restart": await PayrollService.RestartPayRunAsync(PayRunId); break;
                case "pay": await PayrollService.PayPayRunAsync(PayRunId); break;
            }

            Snackbar.Add($"Pay run {verb}d.", Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task ComputeAsync() => RunLifecycleAsync("compute", "Compute Pay Run", "Generate payslips for all active staff in this period?", "Compute");
    private Task ApproveAsync() => RunLifecycleAsync("approve", "Approve Pay Run", "Approve this pay run for payment?", "Approve");
    private Task RejectAsync() => RunLifecycleAsync("reject", "Reject Pay Run", "Send this pay run back for review?", "Reject");
    private Task RestartAsync() => RunLifecycleAsync("restart", "Restart Pay Run", "Reopen this pay run as a draft?", "Restart");
    private Task PayAsync() => RunLifecycleAsync("pay", "Pay Pay Run", "Mark this pay run as paid? This cannot be undone.", "Pay");

    private void CloseAsync()
        => MudDialog.Close(DialogResult.Ok(true));

    private static string FormatStatus(string status) => status;
    private static Color StatusColor(string status) => status switch
    {
        "Draft" => Color.Default,
        "Computed" => Color.Info,
        "Approved" => Color.Primary,
        "Paid" => Color.Success,
        "Rejected" => Color.Error,
        _ => Color.Default,
    };
}

