@inject PayrollService PayrollService
@inject ResourceService ResourceService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.ReceiptLong" Title="@(_payRun is null ? T.PayRunDialog.Title : T.FormatValue(T.PayRunDialog.DetailTitle, _payRun.RunFrom.ToString("yyyy-MM-dd"), _payRun.RunTo.ToString("yyyy-MM-dd")))" />
        @if (_payRun is null)
        {
            <DialogSkeleton Rows="6" />
        }
        else
        {
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-4 rounded" Style="border:1px solid rgba(0,0,0,.12)">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6" md="3">
                                <MudText Typo="Typo.caption" Class="text-secondary">@T.PayRunDialog.Period</MudText>
                                <MudText Typo="Typo.body1" Class="font-weight-medium">@_payRun.RunFrom.ToString("yyyy-MM-dd") → @_payRun.RunTo.ToString("yyyy-MM-dd")</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudText Typo="Typo.caption" Class="text-secondary">@T.Common.Status</MudText>
                                <StatusChip Token="@_payRun.StatusKey">@_payRun.Status</StatusChip>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudText Typo="Typo.caption" Class="text-secondary">@T.PayRunDialog.Processed</MudText>
                                <MudText Typo="Typo.body2">@(_payRun.ProcessedAt?.ToString("g") ?? T.PayRunDialog.NotProcessed)</MudText>
                                @if (!string.IsNullOrWhiteSpace(_payRun.ProcessedBy))
                                {
                                    <MudText Typo="Typo.caption" Class="text-secondary">@(T.FormatValue(T.PayRunDialog.By, _payRun.ProcessedBy))</MudText>
                                }
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudText Typo="Typo.caption" Class="text-secondary">@T.PayRunDialog.Employees</MudText>
                                <MudText Typo="Typo.body1" Class="font-weight-medium">@_payRun.Payslips.Count</MudText>
                            </MudItem>
                        </MudGrid>
                        @if (!string.IsNullOrWhiteSpace(_payRun.Notes))
                        {
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.body2" Class="text-secondary">@_payRun.Notes</MudText>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12">
                    <MudGrid Spacing="2" Class="mb-2">
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-medium">@T.PayRunDialog.Payslips</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" Class="d-flex justify-end">
                            @if (CanEditPayslips)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AddPayslipAsync" Disabled="_busy">@T.Payslip.AddTitle</MudButton>
                            }
                        </MudItem>
                    </MudGrid>

                    @if (_payRun.Payslips.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="text-secondary pa-4">@T.PayRunDialog.NoPayslips</MudText>
                    }
                    else
                    {
                        <MudTable Breakpoint="Breakpoint.Sm" T="PayslipDto" Items="_payRun.Payslips" Dense="true" Hover="true" Elevation="0" Class="rounded" Style="border:1px solid rgba(0,0,0,.12)">
                            <HeaderContent>
                                <MudTh />
                                <MudTh>@T.PayRunDialog.Employee</MudTh>
                                <MudTh Class="text-right">@T.PayRunDialog.Gross</MudTh>
                                <MudTh Class="text-right">@T.PayRunDialog.Earnings</MudTh>
                                <MudTh Class="text-right">@T.PayRunDialog.Deductions</MudTh>
                                <MudTh Class="text-right">@T.PayRunDialog.UnpaidDays</MudTh>
                                <MudTh Class="text-right">@T.PayRunDialog.Net</MudTh>
                                @if (CanEditPayslips)
                                {
                                    <MudTh Class="text-center">@T.Common.Actions</MudTh>
                                }
                            </HeaderContent>
                            <RowTemplate Context="ps">
                                <MudTd DataLabel="@T.PayRunDialog.ToggleBreakdown">
                                    <MudIconButton Icon="@(IsExpanded(ps) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                                   Size="Size.Small"
                                                   aria-label="@T.PayRunDialog.ToggleBreakdown"
                                                   OnClick="@(() => ToggleExpand(ps))" />
                                </MudTd>
                                <MudTd DataLabel="@T.PayRunDialog.Employee">
                                    <MudText Class="font-weight-medium">@ResolveStaff(ps.StaffId)</MudText>
                                </MudTd>
                                <MudTd DataLabel="@T.PayRunDialog.Gross" Class="text-right">@ps.GrossSalary.ToString("N2")</MudTd>
                                <MudTd DataLabel="@T.PayRunDialog.Earnings" Class="text-right" Style="color:var(--mud-palette-success)">@ps.TotalEarnings.ToString("N2")</MudTd>
                                <MudTd DataLabel="@T.PayRunDialog.Deductions" Class="text-right" Style="color:var(--mud-palette-error)">@ps.TotalDeductions.ToString("N2")</MudTd>
                                <MudTd DataLabel="@T.PayRunDialog.UnpaidDays" Class="text-right">@ps.UnpaidLeaveDays</MudTd>
                                <MudTd DataLabel="@T.PayRunDialog.Net" Class="text-right"><MudText Typo="Typo.body2" Class="font-weight-medium">@ps.NetSalary.ToString("N2")</MudText></MudTd>
                                @if (CanEditPayslips)
                                {
                                    <MudTd DataLabel="@T.Common.Actions" Class="text-center">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.PayRunDialog.RemovePayslip" OnClick="@(() => RemovePayslipAsync(ps))" Disabled="_busy" />
                                    </MudTd>
                                }
                            </RowTemplate>
                            <ChildRowContent>
                                @if (IsExpanded(context))
                                {
                                    <MudTr>
                                        <td colspan="8">
                                            <MudText Typo="Typo.caption" Class="text-secondary mb-1">@T.PayRunDialog.Breakdown</MudText>
                                    @if (context.Components.Count == 0)
                                    {
                                        <MudText Typo="Typo.body2" Class="text-secondary pa-2">@T.PayRunDialog.NoComponents</MudText>
                                    }
                                    else
                                    {
                                        <MudTable T="PayslipComponentDto" Items="context.Components" Dense="true" Hover="true" Elevation="0">
                                            <HeaderContent>
                                                <MudTh>@T.PayRunDialog.Component</MudTh>
                                                <MudTh Class="text-right">@T.PayRunDialog.Amount</MudTh>
                                            </HeaderContent>
                                            <RowTemplate Context="cmp">
                                                <MudTd DataLabel="@T.PayRunDialog.Component">
                                                    <MudChip T="string" Size="Size.Small" Color="@(cmp.IsDeduction ? Color.Error : Color.Success)" Variant="Variant.Text">@(cmp.IsDeduction ? T.PayRunDialog.Deduction : T.PayRunDialog.Earning)</MudChip>
                                                    <span class="ms-2">@cmp.Name</span>
                                                </MudTd>
                                                <MudTd DataLabel="@T.PayRunDialog.Amount" Class="text-right" Style="@(cmp.IsDeduction ? "color:var(--mud-palette-error)" : "color:var(--mud-palette-success)")">
                                                    @(cmp.IsDeduction ? "-" : "+")@cmp.Amount.ToString("N2")
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(context.Notes))
                                    {
                                        <MudText Typo="Typo.caption" Class="text-secondary mt-2">@context.Notes</MudText>
                                    }
                                        </td>
                                    </MudTr>
                                }
                            </ChildRowContent>
                        </MudTable>
                    }
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-1" />
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Class="text-secondary">
                                @T.PayRunDialog.Workflow
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" Class="d-flex flex-wrap gap-2">
                            @if (CanCompute)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Calculate" OnClick="ComputeAsync" Disabled="_busy">@T.PayRunDialog.Compute</MudButton>
                            }
                            @if (CanApprove)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="ApproveAsync" Disabled="_busy">@T.PayRunDialog.Approve</MudButton>
                            }
                            @if (CanReject)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel" OnClick="RejectAsync" Disabled="_busy">@T.PayRunDialog.Reject</MudButton>
                            }
                            @if (CanRestart)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="RestartAsync" Disabled="_busy">@T.PayRunDialog.Restart</MudButton>
                            }
                            @if (CanPay)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Payments" OnClick="PayAsync" Disabled="_busy">@T.PayRunDialog.Pay</MudButton>
                            }
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CloseAsync" Disabled="_busy">@T.Common.Close</MudButton>
    </DialogActions>
</MudDialog>



