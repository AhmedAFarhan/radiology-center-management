@page "/payroll/examination-fees"
@attribute [Authorize]
@inject PayrollService PayrollService
@inject ExaminationService ExaminationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.MedicalServices" Title="@T.ExamFee.Title"
            Subtitle="@T.ExamFee.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.ExamFee.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.ExamFee.NewFee</MudButton>
</PageHeader>

<MudTable T="ExaminationFeeDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10">
    <HeaderContent>
        <MudTh>@T.ExamFee.ExaminationType</MudTh>
        <MudTh><MudTableSortLabel T="ExaminationFeeDto" SortLabel="@("Role")">@T.ExamFee.Role</MudTableSortLabel></MudTh>
        <MudTh Class="text-right"><MudTableSortLabel T="ExaminationFeeDto" SortLabel="@("Amount")">@T.ExamFee.Amount</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Type</MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.ExamFee.ExaminationType">
            <MudText Class="font-weight-medium">@ResolveExamType(context.ExaminationTypeId)</MudText>
        </MudTd>
        <MudTd DataLabel="@T.ExamFee.Role">
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@context.Role</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.ExamFee.Amount" Class="text-right">@(context.IsPercentage ? $"{context.Amount:N2}%" : context.Amount.ToString("N2"))</MudTd>
        <MudTd DataLabel="@T.Common.Type">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsPercentage ? Color.Warning : Color.Default)">@(context.IsPercentage ? T.ExamFee.Percentage : T.ExamFee.Flat)</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? T.Common.Active : T.Common.Inactive)</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Common.Edit" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                           Size="Size.Small"
                           Color="@(context.IsActive ? Color.Default : Color.Success)"
                           aria-label="@T.ExamFee.ToggleStatus"
                           OnClick="@(() => ToggleActiveAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Delete" OnClick="@(() => DeleteFeeAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.ExamFee.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        <EmptyState Icon="@Icons.Material.Filled.MedicalServices"
                    Title="@T.ExamFee.EmptyTitle"
                    Message="@T.ExamFee.EmptyMessage"
                    ActionLabel="@T.ExamFee.EmptyActionLabel"
                    Action="OpenCreateDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<ExaminationFeeDto>? _table;
    private string? _search;
    private CancellationTokenSource? _searchCts;
    private string? _loadError;
    private bool _offline;
    private IReadOnlyDictionary<string, string> _examTypeNames = new Dictionary<string, string>();

    private async Task<TableData<ExaminationFeeDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        try
        {
            var feesTask = PayrollService.GetExaminationFeesPagedAsync(
                _search,
                state.SortLabel,
                state.SortDirection == SortDirection.Descending,
                state.Page + 1,
                state.PageSize,
                ct);
            var typesTask = ExaminationService.GetTypesPagedAsync(null, null, false, 1, 100, ct);

            await Task.WhenAll(feesTask, typesTask);

            var fees = await feesTask;
            _examTypeNames = (await typesTask).Items.ToDictionary(t => t.Id, t => $"{t.Code} - {t.Name}");

            return new TableData<ExaminationFeeDto> { Items = fees.Items, TotalItems = fees.TotalCount };
        }
        catch (OperationCanceledException)
        {
            if (ct.IsCancellationRequested)
                return new TableData<ExaminationFeeDto> { Items = Array.Empty<ExaminationFeeDto>(), TotalItems = 0 };
            throw;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _loadError = ex.Message;
            _offline = false;
            return new TableData<ExaminationFeeDto> { Items = Array.Empty<ExaminationFeeDto>(), TotalItems = 0 };
        }
        catch (Exception)
        {
            Snackbar.Add(T.ExamFee.Unreachable, Severity.Error);
            _loadError = T.ExamFee.Unreachable;
            _offline = true;
            return new TableData<ExaminationFeeDto> { Items = Array.Empty<ExaminationFeeDto>(), TotalItems = 0 };
        }
    }

    private string ResolveExamType(string examTypeId)
        => _examTypeNames.TryGetValue(examTypeId, out var name) ? name : examTypeId;

    private async Task OnSearchChanged(string? value)
    {
        _search = value;

        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (_table is not null)
            await _table.ReloadServerData();
    }

    private Task ReloadAsync()
        => _table is null ? Task.CompletedTask : _table.ReloadServerData();

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<ExaminationFeeEditorDialog>(T.ExamFee.NewExaminationFee, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenEditDialogAsync(ExaminationFeeDto fee)
    {
        var parameters = new DialogParameters { ["Fee"] = fee };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<ExaminationFeeEditorDialog>(T.ExamFee.EditExaminationFee, parameters, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task ReloadIfSavedAsync(IDialogReference dialog)
    {
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task ToggleActiveAsync(ExaminationFeeDto fee)
    {
        try
        {
            if (fee.IsActive)
                await PayrollService.DeactivateExaminationFeeAsync(fee.Id);
            else
                await PayrollService.ActivateExaminationFeeAsync(fee.Id);

            Snackbar.Add(fee.IsActive ? T.ExamFee.Deactivated : T.ExamFee.Activated, Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add(T.ExamFee.Unreachable, Severity.Error);
        }
    }

    private async Task DeleteFeeAsync(ExaminationFeeDto fee)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            T.ExamFee.DeleteTitle,
            T.ExamFee.DeleteConfirm,
            T.Common.Delete,
            T.Common.Cancel);

        if (confirmed != true)
            return;

        try
        {
            await PayrollService.DeleteExaminationFeeAsync(fee.Id);
            Snackbar.Add(T.ExamFee.Deleted, Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add(T.ExamFee.Unreachable, Severity.Error);
        }
    }

    public void Dispose() => _searchCts?.Cancel();
}
