@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.ReceiptLong" Title="@T.Payslip.AddTitle" />
        <MudAutocomplete T="StaffDto"
                         @bind-Value="_selectedStaff"
                         Label="@T.Payslip.EmployeeSearch"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         MinCharacters="1"
                         DebounceInterval="300"
                         SearchFunc="StaffSearchFunc"
                         ToStringFunc="@(s => s is null ? string.Empty : s.FullName)"
                         Clearable="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_selectedStaff is null">@T.Common.Add</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Func<string?, CancellationToken, Task<IEnumerable<StaffDto>>> StaffSearchFunc { get; set; } = default!;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private StaffDto? _selectedStaff;

    private void SubmitAsync()
    {
        if (_selectedStaff is null)
        {
            Snackbar.Add(T.Payslip.SelectEmployee, Severity.Warning);
            return;
        }

        MudDialog.Close(DialogResult.Ok(_selectedStaff.Id));
    }

    private void CancelAsync()
        => MudDialog.Cancel();
}