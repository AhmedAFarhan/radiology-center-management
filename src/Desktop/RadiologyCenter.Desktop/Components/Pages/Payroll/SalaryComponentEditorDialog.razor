@inject PayrollService PayrollService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Category" Title="@(Component is null ? T.SalaryComponent.NewSalaryComponent : T.FormatValue(T.SalaryComponent.EditTitle, Component.Name))" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="7">
                    <MudTextField @bind-Value="_model.Name"
                                  Label="@T.Common.Name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Name)" />
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudSelect T="string"
                               @bind-Value="_model.Kind"
                               Label="@T.SalaryComponent.Kind"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.Kind)">
                        <MudSelectItem T="string" Value="@("Earning")">Earning</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Deduction")">Deduction</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string"
                               @bind-Value="_model.Frequency"
                               Label="@T.SalaryComponent.FrequencyOptional"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        <MudSelectItem T="string" Value="@((string?)null)">@T.SalaryComponent.NotSet</MudSelectItem>
                        @foreach (var frequency in Frequencies)
                        {
                            <MudSelectItem T="string" Value="@frequency">@FormatFrequency(frequency)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.DefaultValue"
                                     Label="@(_model.IsPercentage ? T.SalaryComponent.DefaultPercent : T.SalaryComponent.DefaultValue)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     For="@(() => _model.DefaultValue)" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex flex-column justify-center">
                    <MudSwitch T="bool" @bind-Value="_model.IsPercentage" Color="Color.Primary">@T.SalaryComponent.ValueIsPercentage</MudSwitch>
                    <MudSwitch T="bool" @bind-Value="_model.IsPerWorkDay" Color="Color.Primary">@T.SalaryComponent.PaidPerWorkDay</MudSwitch>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@(IsEdit ? T.SalaryComponent.SaveChanges : T.SalaryComponent.CreateComponent)</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>


