@inherits EditorDialogBase
@inject PayrollService PayrollService
@inject ResourceService ResourceService
@inject EnumOptionsService EnumOptionsService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Calculate" Title="@(Salary is null ? T.Salary.NewSalary : T.Salary.EditTitle)" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                @if (IsEdit)
                {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_employeeName"
                                      Label="@T.Salary.Employee"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="true" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudAutocomplete T="StaffDto"
                                         @bind-Value="_selectedStaff"
                                         Label="@T.SalaryDialog.EmployeeSearch"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="1"
                                         DebounceInterval="300"
                                         SearchFunc="SearchStaffAsync"
                                         ToStringFunc="@(s => s is null ? string.Empty : s.FullName)"
                                         Clearable="true"
                                         Disabled="Busy" />
                    </MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.BaseSalary"
                                     Label="@T.Salary.BaseSalary"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     For="@(() => _model.BaseSalary)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.SalaryType"
                               Label="@T.SalaryDialog.SalaryType"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.SalaryType)">
                        @foreach (var salaryType in _salaryTypeOptions)
                        {
                            <MudSelectItem T="string" Value="@salaryType.Key">@salaryType.Value</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_model.EffectiveDate"
                                   Label="@T.SalaryDialog.EffectiveDate"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="w-100" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.SalaryDialog.SaveChanges : T.SalaryDialog.CreateSalary)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>