@page "/payroll/salary-components"
@attribute [Authorize]
@inject PayrollService PayrollService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.Category" Title="@T.SalaryComponent.Title"
            Subtitle="@T.SalaryComponent.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.SalaryComponent.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.SalaryComponent.NewComponent</MudButton>
</PageHeader>

<MudTable T="SalaryComponentDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="SalaryComponentDto" SortLabel="@("Name")">@T.Common.Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="SalaryComponentDto" SortLabel="@("Kind")">@T.SalaryComponent.Kind</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Type</MudTh>
        <MudTh><MudTableSortLabel T="SalaryComponentDto" SortLabel="@("Frequency")">@T.SalaryComponent.Frequency</MudTableSortLabel></MudTh>
        <MudTh Class="text-right"><MudTableSortLabel T="SalaryComponentDto" SortLabel="@("DefaultValue")">@T.SalaryComponent.Default</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Common.Name">
            <MudText Class="font-weight-medium">@context.Name</MudText>
        </MudTd>
        <MudTd DataLabel="@T.SalaryComponent.Kind">
            <MudChip T="string" Size="Size.Small" Color="@(context.Kind == "Deduction" ? Color.Error : Color.Success)">@context.Kind</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Type">
            @if (context.IsPerWorkDay)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info">@T.SalaryComponent.PerWorkDay</MudChip>
            }
            @if (context.IsPercentage)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@T.SalaryComponent.Percentage</MudChip>
            }
            @if (!context.IsPercentage && !context.IsPerWorkDay)
            {
                <MudChip T="string" Size="Size.Small">@T.SalaryComponent.Fixed</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="@T.SalaryComponent.Frequency">@(string.IsNullOrWhiteSpace(context.Frequency) ? "-" : FormatFrequency(context.Frequency))</MudTd>
        <MudTd DataLabel="@T.SalaryComponent.Default" Class="text-right">@(context.IsPercentage ? $"{context.DefaultValue:N2}%" : context.DefaultValue.ToString("N2"))</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? T.Common.Active : T.Common.Inactive)</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Common.Edit" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                           Size="Size.Small"
                           Color="@(context.IsActive ? Color.Default : Color.Success)"
                           aria-label="@T.SalaryComponent.ToggleStatus"
                           OnClick="@(() => ToggleActiveAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Delete" OnClick="@(() => DeleteComponentAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.SalaryComponent.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        <EmptyState Icon="@Icons.Material.Filled.Category"
                    Title="@T.SalaryComponent.EmptyTitle"
                    Message="@T.SalaryComponent.EmptyMessage"
                    ActionLabel="@T.SalaryComponent.EmptyActionLabel"
                    Action="OpenCreateDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<SalaryComponentDto>? _table;
    private string? _search;
    private CancellationTokenSource? _searchCts;
    private string? _loadError;
    private bool _offline;

    private async Task<TableData<SalaryComponentDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        try
        {
            var page = await PayrollService.GetSalaryComponentsPagedAsync(
                _search,
                state.SortLabel,
                state.SortDirection == SortDirection.Descending,
                state.Page + 1,
                state.PageSize,
                ct);

            _loadError = null;
            _offline = false;
            return new TableData<SalaryComponentDto> { Items = page.Items, TotalItems = page.TotalCount };
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _loadError = ex.Message;
            _offline = false;
            return new TableData<SalaryComponentDto> { Items = Array.Empty<SalaryComponentDto>(), TotalItems = 0 };
        }
        catch (Exception)
        {
            Snackbar.Add(T.SalaryComponent.Unreachable, Severity.Error);
            _loadError = T.SalaryComponent.Unreachable;
            _offline = true;
            return new TableData<SalaryComponentDto> { Items = Array.Empty<SalaryComponentDto>(), TotalItems = 0 };
        }
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value;

        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (_table is not null)
            await _table.ReloadServerData();
    }

    private Task ReloadAsync()
        => _table is null ? Task.CompletedTask : _table.ReloadServerData();

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<SalaryComponentEditorDialog>(T.SalaryComponent.NewSalaryComponent, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenEditDialogAsync(SalaryComponentDto component)
    {
        var parameters = new DialogParameters { ["Component"] = component };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<SalaryComponentEditorDialog>(T.FormatValue(T.SalaryComponent.EditTitle, component.Name), parameters, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task ReloadIfSavedAsync(IDialogReference dialog)
    {
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task ToggleActiveAsync(SalaryComponentDto component)
    {
        try
        {
            if (component.IsActive)
                await PayrollService.DeactivateSalaryComponentAsync(component.Id);
            else
                await PayrollService.ActivateSalaryComponentAsync(component.Id);

            Snackbar.Add(component.IsActive ? T.SalaryComponent.Deactivated : T.SalaryComponent.Activated, Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add(T.SalaryComponent.Unreachable, Severity.Error);
        }
    }

    private async Task DeleteComponentAsync(SalaryComponentDto component)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            T.SalaryComponent.DeleteTitle,
            T.FormatValue(T.SalaryComponent.DeleteConfirm, component.Name),
            T.Common.Delete,
            T.Common.Cancel);

        if (confirmed != true)
            return;

        try
        {
            await PayrollService.DeleteSalaryComponentAsync(component.Id);
            Snackbar.Add(T.SalaryComponent.Deleted, Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add(T.SalaryComponent.Unreachable, Severity.Error);
        }
    }

    private static string FormatFrequency(string frequency) => frequency switch
    {
        "OneTime" => "One Time",
        "Monthly" => "Monthly",
        "Quarterly" => "Quarterly",
        "Annual" => "Annual",
        _ => frequency,
    };

    public void Dispose() => _searchCts?.Cancel();
}
