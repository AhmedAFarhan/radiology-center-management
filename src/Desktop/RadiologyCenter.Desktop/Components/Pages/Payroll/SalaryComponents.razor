@using static RadiologyCenter.Desktop.Services.Formatting
@page "/payroll/salary-components"
@attribute [Authorize]
@inherits ListPageBase<SalaryComponentDto>
@inject PayrollService PayrollService

<PageHeader Icon="@Icons.Material.Filled.Category" Title="@T.SalaryComponent.Title"
            Subtitle="@T.SalaryComponent.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.SalaryComponent.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    @if (Can("payroll.salary-components.manage"))
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.SalaryComponent.NewComponent</MudButton>
    }
</PageHeader>

<MudTable T="SalaryComponentDto" @ref="Table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="SalaryComponentDto" SortLabel="@("Name")">@T.Common.Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="SalaryComponentDto" SortLabel="@("Kind")">@T.SalaryComponent.Kind</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Type</MudTh>
        <MudTh><MudTableSortLabel T="SalaryComponentDto" SortLabel="@("Frequency")">@T.SalaryComponent.Frequency</MudTableSortLabel></MudTh>
        <MudTh Class="text-right"><MudTableSortLabel T="SalaryComponentDto" SortLabel="@("DefaultValue")">@T.SalaryComponent.Default</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Common.Name">
            <MudText Class="font-weight-medium">@context.Name</MudText>
        </MudTd>
        <MudTd DataLabel="@T.SalaryComponent.Kind">
            <MudChip T="string" Size="Size.Small" Color="@(context.Kind == "Deduction" ? Color.Error : Color.Success)">@context.Kind</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Type">
            @if (context.IsPerWorkDay)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info">@T.SalaryComponent.PerWorkDay</MudChip>
            }
            @if (context.IsPercentage)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@T.SalaryComponent.Percentage</MudChip>
            }
            @if (!context.IsPercentage && !context.IsPerWorkDay)
            {
                <StatusChip Token="Fixed">@T.SalaryComponent.Fixed</StatusChip>
            }
        </MudTd>
        <MudTd DataLabel="@T.SalaryComponent.Frequency">@(string.IsNullOrWhiteSpace(context.Frequency) ? "-" : FormatFrequency(context.Frequency))</MudTd>
        <MudTd DataLabel="@T.SalaryComponent.Default" Class="text-right">@(context.IsPercentage ? $"{context.DefaultValue:N2}%" : context.DefaultValue.ToString("N2"))</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <ActiveStatusChip IsActive="context.IsActive" ActiveLabel="@T.Common.Active" InactiveLabel="@T.Common.Inactive" />
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <RowActions IsActive="context.IsActive"
                        EditLabel="@T.Common.Edit"
                        ToggleLabel="@T.SalaryComponent.ToggleStatus"
                        DeleteLabel="@T.Common.Delete"
                        CanEdit="@Can("payroll.salary-components.manage")"
                        CanToggle="@Can("payroll.salary-components.manage")"
                        CanDelete="@Can("payroll.salary-components.manage")"
                        OnEdit="@(() => OpenEditDialogAsync(context))"
                        OnToggle="@(() => ToggleActiveAsync(context))"
                        OnDelete="@(() => DeleteComponentAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <TableNoRecords LoadError="@LoadError"
                        Offline="@Offline"
                        ErrorTitle="@T.SalaryComponent.LoadErrorTitle"
                        EmptyIcon="@Icons.Material.Filled.Category"
                        EmptyTitle="@T.SalaryComponent.EmptyTitle"
                        EmptyMessage="@T.SalaryComponent.EmptyMessage"
                        EmptyActionLabel="@T.SalaryComponent.EmptyActionLabel"
                        ShowAction="@Can("payroll.salary-components.manage")"
                        OnReload="ReloadAsync"
                        OnEmptyAction="OpenCreateDialogAsync" />
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>
