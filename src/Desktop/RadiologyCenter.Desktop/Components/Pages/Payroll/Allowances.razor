@page "/payroll/allowances"
@attribute [Authorize]
@inject PayrollService PayrollService
@inject ResourceService ResourceService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.AttachMoney" Title="@T.Allowance.Title"
            Subtitle="@T.Allowance.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.Allowance.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Allowance.NewAllowance</MudButton>
</PageHeader>

<MudTable T="AllowanceAssignmentDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh>@T.Allowance.Employee</MudTh>
        <MudTh><MudTableSortLabel T="AllowanceAssignmentDto" SortLabel="@("Name")">@T.Allowance.Allowance</MudTableSortLabel></MudTh>
        <MudTh Class="text-right"><MudTableSortLabel T="AllowanceAssignmentDto" SortLabel="@("Amount")">@T.Allowance.Amount</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="AllowanceAssignmentDto" SortLabel="@("Frequency")">@T.Allowance.Frequency</MudTableSortLabel></MudTh>
        <MudTh>@T.Allowance.PerWorkDay</MudTh>
        <MudTh><MudTableSortLabel T="AllowanceAssignmentDto" SortLabel="@("EffectiveDate")">@T.Allowance.Effective</MudTableSortLabel></MudTh>
        <MudTh>@T.Allowance.End</MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Allowance.Employee">
            <MudText Class="font-weight-medium">@ResolveStaff(context.StaffId)</MudText>
        </MudTd>
        <MudTd DataLabel="@T.Allowance.Allowance">@context.Name</MudTd>
        <MudTd DataLabel="@T.Allowance.Amount" Class="text-right">@context.Amount.ToString("N2")</MudTd>
        <MudTd DataLabel="@T.Allowance.Frequency">@(string.IsNullOrWhiteSpace(context.Frequency) ? "-" : FormatFrequency(context.Frequency))</MudTd>
        <MudTd DataLabel="@T.Allowance.PerWorkDay">
            @if (context.IsPerWorkDay)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info">@T.Allowance.PerWorkDay</MudChip>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="text-secondary">-</MudText>
            }
        </MudTd>
        <MudTd DataLabel="@T.Allowance.Effective">@context.EffectiveDate.ToString("yyyy-MM-dd")</MudTd>
        <MudTd DataLabel="@T.Allowance.End">@(context.EndDate?.ToString("yyyy-MM-dd") ?? "-")</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? T.Common.Active : T.Common.Inactive)</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Common.Edit" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                           Size="Size.Small"
                           Color="@(context.IsActive ? Color.Default : Color.Success)"
                           aria-label="@T.Allowance.ToggleStatus"
                           OnClick="@(() => ToggleActiveAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Delete" OnClick="@(() => DeleteAllowanceAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.Allowance.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        <EmptyState Icon="@Icons.Material.Filled.AttachMoney"
                    Title="@T.Allowance.EmptyTitle"
                    Message="@T.Allowance.EmptyMessage"
                    ActionLabel="@T.Allowance.EmptyActionLabel"
                    Action="OpenCreateDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>


