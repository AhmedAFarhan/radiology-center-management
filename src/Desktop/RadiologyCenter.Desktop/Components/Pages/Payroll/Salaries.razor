@page "/payroll/salaries"
@attribute [Authorize]
@inject PayrollService PayrollService
@inject ResourceService ResourceService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.Calculate" Title="@T.Salary.Title"
            Subtitle="@T.Salary.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.Salary.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Salary.NewSalary</MudButton>
</PageHeader>

<MudTable T="SalaryDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh>@T.Salary.Employee</MudTh>
        <MudTh Class="text-right"><MudTableSortLabel T="SalaryDto" SortLabel="@("BaseSalary")">@T.Salary.BaseSalary</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="SalaryDto" SortLabel="@("SalaryType")">@T.Common.Type</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="SalaryDto" SortLabel="@("EffectiveDate")">@T.Salary.Effective</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Salary.Employee">
            <MudText Class="font-weight-medium">@ResolveStaff(context.StaffId)</MudText>
        </MudTd>
        <MudTd DataLabel="@T.Salary.BaseSalary" Class="text-right">@context.BaseSalary.ToString("N2")</MudTd>
        <MudTd DataLabel="@T.Common.Type">
            <StatusChip Token="@context.SalaryType">@context.SalaryType</StatusChip>
        </MudTd>
        <MudTd DataLabel="@T.Salary.Effective">@context.EffectiveDate.ToString("yyyy-MM-dd")</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? T.Common.Active : T.Common.Inactive)</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Common.Edit" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                           Size="Size.Small"
                           Color="@(context.IsActive ? Color.Default : Color.Success)"
                           aria-label="@T.Salary.ToggleStatus"
                           OnClick="@(() => ToggleActiveAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Delete" OnClick="@(() => DeleteSalaryAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.Salary.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        <EmptyState Icon="@Icons.Material.Filled.Calculate"
                    Title="@T.Salary.EmptyTitle"
                    Message="@T.Salary.EmptyMessage"
                    ActionLabel="@T.Salary.EmptyActionLabel"
                    Action="OpenCreateDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>


