@inject PayrollService PayrollService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.ReceiptLong" Title="@T.PayRunDialog.CreateTitle" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_model.RunFrom"
                                   Label="@T.PayRunDialog.PeriodFrom"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="w-100" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_model.RunTo"
                                   Label="@T.PayRunDialog.PeriodTo"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="w-100" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Notes"
                                  Label="@T.PayRunDialog.Notes"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="3"
                                  Immediate="true" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.PayRunDialog.Create</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly PayRunFormModel _model = new();
    private EditContext _editContext = default!;
    private bool _busy;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
        _model.RunFrom = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _model.RunTo = _model.RunFrom.Value.AddMonths(1).AddDays(-1);
    }

    private async Task SubmitAsync()
    {
        if (!_editContext.Validate())
            return;

        if (_model.RunFrom is null || _model.RunTo is null)
        {
            Snackbar.Add(T.PayRunDialog.SelectBothDates, Severity.Warning);
            return;
        }

        if (_model.RunTo < _model.RunFrom)
        {
            Snackbar.Add(T.PayRunDialog.PeriodToAfterFrom, Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await PayrollService.CreatePayRunAsync(new CreatePayRunInput
            {
                RunFrom = _model.RunFrom.Value.Date,
                RunTo = _model.RunTo.Value.Date,
                Notes = _model.Notes,
            });

            Snackbar.Add(T.PayRunDialog.Created, Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add(T.PayRunDialog.Unreachable, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelAsync()
        => MudDialog.Cancel();

    private sealed class PayRunFormModel
    {
        public DateTime? RunFrom { get; set; }

        public DateTime? RunTo { get; set; }

        public string? Notes { get; set; }
    }
}
