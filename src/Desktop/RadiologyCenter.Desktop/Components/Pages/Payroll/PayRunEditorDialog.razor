@inherits EditorDialogBase
@inject PayrollService PayrollService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.ReceiptLong" Title="@T.PayRunDialog.CreateTitle" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_model.RunFrom"
                                   Label="@T.PayRunDialog.PeriodFrom"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="w-100" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_model.RunTo"
                                   Label="@T.PayRunDialog.PeriodTo"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="w-100" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Notes"
                                  Label="@T.PayRunDialog.Notes"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="3"
                                  Immediate="true" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@T.PayRunDialog.Create"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>