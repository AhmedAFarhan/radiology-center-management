@page "/payroll/referral-fees"
@attribute [Authorize]
@inherits ListPageBase<ReferralFeeDto>
@inject PayrollService PayrollService
@inject ResourceService ResourceService
@inject ExaminationService ExaminationService

<PageHeader Icon="@Icons.Material.Filled.LocalHospital" Title="@T.ReferralFee.Title"
            Subtitle="@T.ReferralFee.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.ReferralFee.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.ReferralFee.NewFee</MudButton>
</PageHeader>

<MudTable T="ReferralFeeDto" @ref="Table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh>@T.ReferralFee.Doctor</MudTh>
        <MudTh>@T.ReferralFee.ExaminationType</MudTh>
        <MudTh Class="text-right"><MudTableSortLabel T="ReferralFeeDto" SortLabel="@("Amount")">@T.ReferralFee.Amount</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Type</MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.ReferralFee.Doctor">
            <MudText Class="font-weight-medium">@ResolveDoctor(context.ReferralDoctorId)</MudText>
        </MudTd>
        <MudTd DataLabel="@T.ReferralFee.ExaminationType">@ResolveExamType(context.ExaminationTypeId)</MudTd>
        <MudTd DataLabel="@T.ReferralFee.Amount" Class="text-right">@(context.IsPercentage ? $"{context.Amount:N2}%" : context.Amount.ToString("N2"))</MudTd>
        <MudTd DataLabel="@T.Common.Type">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsPercentage ? Color.Warning : Color.Default)">@(context.IsPercentage ? T.ReferralFee.Percentage : T.ReferralFee.Flat)</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <ActiveStatusChip IsActive="context.IsActive" ActiveLabel="@T.Common.Active" InactiveLabel="@T.Common.Inactive" />
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <RowActions IsActive="context.IsActive"
                        EditLabel="@T.Common.Edit"
                        ToggleLabel="@T.ReferralFee.ToggleStatus"
                        DeleteLabel="@T.Common.Delete"
                        OnEdit="@(() => OpenEditDialogAsync(context))"
                        OnToggle="@(() => ToggleActiveAsync(context))"
                        OnDelete="@(() => DeleteFeeAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <TableNoRecords LoadError="@LoadError"
                        Offline="@Offline"
                        ErrorTitle="@T.ReferralFee.LoadErrorTitle"
                        EmptyIcon="@Icons.Material.Filled.LocalHospital"
                        EmptyTitle="@T.ReferralFee.EmptyTitle"
                        EmptyMessage="@T.ReferralFee.EmptyMessage"
                        EmptyActionLabel="@T.ReferralFee.EmptyActionLabel"
                        OnReload="ReloadAsync"
                        OnEmptyAction="OpenCreateDialogAsync" />
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>