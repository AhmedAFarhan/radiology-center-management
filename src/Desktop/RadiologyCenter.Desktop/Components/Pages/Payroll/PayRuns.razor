@page "/payroll/payruns"
@attribute [Authorize]
@inject PayrollService PayrollService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.ReceiptLong" Title="@T.Payroll.PayRunsTitle"
            Subtitle="@T.Payroll.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.Payroll.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    @if (Can("payroll.payruns.manage"))
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Payroll.NewPayRun</MudButton>
    }
</PageHeader>

@if (_statsLoaded)
{
    <MudGrid Spacing="2" Class="mb-4">
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Elevation="0" Class="pa-3 d-flex flex-column align-center rounded" Style="border:1px solid rgba(0,0,0,.12)">
                <MudText Typo="Typo.h5" Align="Align.Center">@_stats.Total</MudText>
                <MudText Typo="Typo.caption" Align="Align.Center" Class="text-secondary">@T.Payroll.OnPage</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Elevation="0" Class="pa-3 d-flex flex-column align-center rounded" Style="border:1px solid rgba(0,0,0,.12)">
                <MudText Typo="Typo.h5" Align="Align.Center" Class="text-secondary">@_stats.Draft</MudText>
                <MudText Typo="Typo.caption" Align="Align.Center" Class="text-secondary">@T.Payroll.Draft</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Elevation="0" Class="pa-3 d-flex flex-column align-center rounded" Style="border:1px solid rgba(0,0,0,.12)">
                <MudText Typo="Typo.h5" Align="Align.Center" Class="text-info">@_stats.Computed</MudText>
                <MudText Typo="Typo.caption" Align="Align.Center" Class="text-secondary">@T.Payroll.Computed</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Elevation="0" Class="pa-3 d-flex flex-column align-center rounded" Style="border:1px solid rgba(0,0,0,.12)">
                <MudText Typo="Typo.h5" Align="Align.Center" Class="text-primary">@_stats.Approved</MudText>
                <MudText Typo="Typo.caption" Align="Align.Center" Class="text-secondary">@T.Payroll.Approved</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Elevation="0" Class="pa-3 d-flex flex-column align-center rounded" Style="border:1px solid rgba(0,0,0,.12)">
                <MudText Typo="Typo.h5" Align="Align.Center" Class="text-success">@_stats.Paid</MudText>
                <MudText Typo="Typo.caption" Align="Align.Center" Class="text-secondary">@T.Payroll.Paid</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Elevation="0" Class="pa-3 d-flex flex-column align-center rounded" Style="border:1px solid rgba(0,0,0,.12)">
                <MudText Typo="Typo.h5" Align="Align.Center" Class="text-error">@_stats.Rejected</MudText>
                <MudText Typo="Typo.caption" Align="Align.Center" Class="text-secondary">@T.Payroll.Rejected</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

<MudTable T="PayRunDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="PayRunDto" SortLabel="@("RunFrom")">@T.Payroll.Period</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PayRunDto" SortLabel="@("Status")">@T.Common.Status</MudTableSortLabel></MudTh>
        <MudTh>@T.Payroll.Employees</MudTh>
        <MudTh Class="text-right">@T.Payroll.NetPay</MudTh>
        <MudTh><MudTableSortLabel T="PayRunDto" SortLabel="@("ProcessedAt")">@T.Payroll.Processed</MudTableSortLabel></MudTh>
        <MudTh>@T.Payroll.Notes</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Payroll.Period">
            <MudText Class="font-weight-medium">@context.RunFrom.ToString("yyyy-MM-dd") → @context.RunTo.ToString("yyyy-MM-dd")</MudText>
        </MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <StatusChip Token="@context.Status">@FormatStatus(context.Status)</StatusChip>
        </MudTd>
        <MudTd DataLabel="@T.Payroll.Employees">@context.Payslips.Count</MudTd>
        <MudTd DataLabel="@T.Payroll.NetPay" Class="text-right">@context.Payslips.Sum(p => p.NetSalary).ToString("N2")</MudTd>
        <MudTd DataLabel="@T.Payroll.Processed">@(context.ProcessedAt?.ToString("g") ?? "-")</MudTd>
        <MudTd DataLabel="@T.Payroll.Notes">@(string.IsNullOrWhiteSpace(context.Notes) ? "-" : context.Notes)</MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudTooltip Placement="Placement.Bottom" Text="@T.Payroll.View">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Default" aria-label="@T.Payroll.View" OnClick="@(() => OpenDetailDialogAsync(context))" />
            </MudTooltip>
            @if (Can("payroll.payruns.manage"))
            {
                <MudTooltip Placement="Placement.Bottom" Text="@T.Common.Delete">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Delete" OnClick="@(() => DeletePayRunAsync(context))" />
                </MudTooltip>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.Payroll.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        @if (Can("payroll.payruns.manage"))
        {
            <EmptyState Icon="@Icons.Material.Filled.ReceiptLong"
                        Title="@T.Payroll.EmptyTitle"
                        Message="@T.Payroll.EmptyMessage"
                        ActionLabel="@T.Payroll.EmptyActionLabel"
                        Action="OpenCreateDialogAsync" />
        }
        else
        {
            <EmptyState Icon="@Icons.Material.Filled.ReceiptLong"
                        Title="@T.Payroll.EmptyTitle"
                        Message="@T.Payroll.EmptyMessage" />
        }
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>


