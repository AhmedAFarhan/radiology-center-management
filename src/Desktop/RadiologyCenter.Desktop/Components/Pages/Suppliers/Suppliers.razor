@page "/inventory/suppliers"
@attribute [Authorize]
@inherits ListPageBase<SupplierDto>
@inject InventoryService InventoryService

<PageHeader Icon="@Icons.Material.Filled.LocalShipping" Title="@T.Suppliers.Title"
            Subtitle="@T.Suppliers.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchValue="@SearchQuery"
            SearchPlaceholder="@T.Suppliers.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <AuthorizeView Policy="@InventoryPermissions.SuppliersCreate">
        <Authorized>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Suppliers.AddSupplier</MudButton>
        </Authorized>
    </AuthorizeView>
</PageHeader>

<MudTable T="SupplierDto" @ref="Table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="SupplierDto" SortLabel="@("Name")">@T.Common.Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="SupplierDto" SortLabel="@("ContactPerson")">@T.Suppliers.Contact</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="SupplierDto" SortLabel="@("Phone")">@T.Suppliers.Phone</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="SupplierDto" SortLabel="@("Email")">@T.Suppliers.Email</MudTableSortLabel></MudTh>
        <MudTh>@T.Suppliers.PaymentTerms</MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Common.Name">
            <MudText Class="font-weight-medium">@context.Name</MudText>
            @if (!string.IsNullOrWhiteSpace(context.TaxNumber))
            {
                <MudText Typo="Typo.caption" Class="text-secondary">@T.Suppliers.Tax: @context.TaxNumber</MudText>
            }
        </MudTd>
        <MudTd DataLabel="@T.Suppliers.Contact">@(context.ContactPerson ?? "-")</MudTd>
        <MudTd DataLabel="@T.Suppliers.Phone">@context.Phone</MudTd>
        <MudTd DataLabel="@T.Suppliers.Email">@(context.Email ?? "-")</MudTd>
        <MudTd DataLabel="@T.Suppliers.PaymentTerms">@(context.PaymentTerms ?? "-")</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <ActiveStatusChip IsActive="context.IsActive" ActiveLabel="@T.Common.Active" InactiveLabel="@T.Common.Inactive" />
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <RowActions IsActive="context.IsActive"
                        EditLabel="@T.Common.Edit"
                        ToggleLabel="@T.Suppliers.ToggleStatus"
                        DeleteLabel="@T.Common.Delete"
                        EditPolicy="@InventoryPermissions.SuppliersUpdate"
                        TogglePolicy="@InventoryPermissions.SuppliersUpdate"
                        DeletePolicy="@InventoryPermissions.SuppliersDelete"
                        OnEdit="@(() => OpenEditDialogAsync(context))"
                        OnToggle="@(() => ToggleActiveAsync(context))"
                        OnDelete="@(() => DeleteSupplierAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <TableNoRecords LoadError="@LoadError"
                        Offline="@Offline"
                        ErrorTitle="@T.Suppliers.LoadErrorTitle"
                        EmptyIcon="@Icons.Material.Filled.LocalShipping"
                        EmptyTitle="@T.Suppliers.NoSuppliersTitle"
                        EmptyMessage="@T.Suppliers.EmptyMessage"
                        EmptyActionLabel="@T.Suppliers.AddFirstSupplier"
                        ActionPolicy="@InventoryPermissions.SuppliersCreate"
                        OnReload="ReloadAsync"
                        OnEmptyAction="OpenCreateDialogAsync" />
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>