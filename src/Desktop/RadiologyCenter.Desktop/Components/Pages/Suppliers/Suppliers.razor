@page "/inventory/suppliers"
@attribute [Authorize]
@inject InventoryService InventoryService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@inject NavigationManager NavigationManager
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.LocalShipping" Title="@T.Suppliers.Title"
            Subtitle="@T.Suppliers.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchValue="@SearchQuery"
            SearchPlaceholder="@T.Suppliers.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Suppliers.AddSupplier</MudButton>
</PageHeader>

<MudTable T="SupplierDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="SupplierDto" SortLabel="@("Name")">@T.Common.Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="SupplierDto" SortLabel="@("ContactPerson")">@T.Suppliers.Contact</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="SupplierDto" SortLabel="@("Phone")">@T.Suppliers.Phone</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="SupplierDto" SortLabel="@("Email")">@T.Suppliers.Email</MudTableSortLabel></MudTh>
        <MudTh>@T.Suppliers.PaymentTerms</MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Common.Name">
            <MudText Class="font-weight-medium">@context.Name</MudText>
            @if (!string.IsNullOrWhiteSpace(context.TaxNumber))
            {
                <MudText Typo="Typo.caption" Class="text-secondary">@T.Suppliers.Tax: @context.TaxNumber</MudText>
            }
        </MudTd>
        <MudTd DataLabel="@T.Suppliers.Contact">@(context.ContactPerson ?? "-")</MudTd>
        <MudTd DataLabel="@T.Suppliers.Phone">@context.Phone</MudTd>
        <MudTd DataLabel="@T.Suppliers.Email">@(context.Email ?? "-")</MudTd>
        <MudTd DataLabel="@T.Suppliers.PaymentTerms">@(context.PaymentTerms ?? "-")</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? T.Common.Active : T.Common.Inactive)</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Common.Edit" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                           Size="Size.Small"
                           Color="@(context.IsActive ? Color.Default : Color.Success)"
                           aria-label="@T.Suppliers.ToggleStatus"
                           OnClick="@(() => ToggleActiveAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Delete" OnClick="@(() => DeleteSupplierAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.Suppliers.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        <EmptyState Icon="@Icons.Material.Filled.LocalShipping"
                    Title="@T.Suppliers.NoSuppliersTitle"
                    Message="@T.Suppliers.EmptyMessage"
                    ActionLabel="@T.Suppliers.AddFirstSupplier"
                    Action="OpenCreateDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>


