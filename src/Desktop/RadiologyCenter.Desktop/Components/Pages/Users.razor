@page "/users"
@attribute [Authorize]
@inject IdentityService IdentityService
@inject TokenStorage TokenStorage
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<MudToolBar Dense="true" Class="mb-4">
    <MudText Typo="Typo.h5">Users</MudText>
    <MudText Typo="Typo.body2" Class="text-secondary ms-2">Manage user accounts and roles</MudText>
    <MudSpacer />
    <MudTextField T="string"
                  Value="_search"
                  ValueChanged="OnSearchChanged"
                  Placeholder="Search users..."
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Immediate="true"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="search-field" />
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" aria-label="Refresh" OnClick="ReloadAsync" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">New User</MudButton>
</MudToolBar>

<MudTable T="UserDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="UserDto" SortLabel="@("UserName")">Username</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="UserDto" SortLabel="@("LastName")">Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="UserDto" SortLabel="@("Email")">Email</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="UserDto" SortLabel="@("PhoneNumber")">Phone</MudTableSortLabel></MudTh>
        <MudTh>Status</MudTh>
        <MudTh><MudTableSortLabel T="UserDto" SortLabel="@("LastLoginAt")">Last Login</MudTableSortLabel></MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Username">
            <MudText Class="font-weight-medium">@context.UserName</MudText>
            @if (IsCurrentUser(context))
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">You</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="Name">@context.FullName</MudTd>
        <MudTd DataLabel="Email">@context.Email</MudTd>
        <MudTd DataLabel="Phone">@(string.IsNullOrWhiteSpace(context.PhoneNumber) ? "-" : context.PhoneNumber)</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Color="@(StatusColor(context))">@StatusText(context)</MudChip>
        </MudTd>
        <MudTd DataLabel="Last Login">@(context.LastLoginAt?.ToString("g") ?? "-")</MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="Edit profile" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Color="Color.Info" aria-label="Manage roles" OnClick="@(() => OpenRolesDialogAsync(context))" />
            @if (context.IsLocked)
            {
                <MudIconButton Icon="@Icons.Material.Filled.LockOpen" Size="Size.Small" Color="Color.Warning" aria-label="Unlock" OnClick="@(() => UnlockAsync(context))" />
            }
            else
            {
                <MudIconButton Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Default" aria-label="Lock" OnClick="@(() => OpenLockDialogAsync(context))" Disabled="@IsCurrentUser(context)" />
            }
            @if (context.IsActive)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error" aria-label="Deactivate" OnClick="@(() => DeactivateAsync(context))" Disabled="@IsCurrentUser(context)" />
            }
            else
            {
                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" aria-label="Activate" OnClick="@(() => ActivateAsync(context))" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4">No users found.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<UserDto>? _table;
    private string? _search;
    private string? _currentUserName;
    private CancellationTokenSource? _searchCts;

    protected override void OnInitialized()
        => _currentUserName = TokenStorage.GetTokens()?.Username;

    private bool IsCurrentUser(UserDto user)
        => string.Equals(user.UserName, _currentUserName, StringComparison.OrdinalIgnoreCase);

    private async Task<TableData<UserDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        try
        {
            var page = await IdentityService.GetUsersPagedAsync(
                _search,
                state.SortLabel,
                state.SortDirection == SortDirection.Descending,
                state.Page + 1,
                state.PageSize,
                ct);

            return new TableData<UserDto> { Items = page.Items, TotalItems = page.TotalCount };
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return new TableData<UserDto> { Items = Array.Empty<UserDto>(), TotalItems = 0 };
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
            return new TableData<UserDto> { Items = Array.Empty<UserDto>(), TotalItems = 0 };
        }
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value;

        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (_table is not null)
            await _table.ReloadServerData();
    }

    private Task ReloadAsync()
        => _table is null ? Task.CompletedTask : _table.ReloadServerData();

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<UserEditorDialog>("New User", options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenEditDialogAsync(UserDto user)
    {
        var parameters = new DialogParameters { ["User"] = user };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<UserEditorDialog>($"Edit {user.UserName}", parameters, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenRolesDialogAsync(UserDto user)
    {
        var parameters = new DialogParameters { ["User"] = user };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<UserRolesDialog>($"Roles - {user.UserName}", parameters, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenLockDialogAsync(UserDto user)
    {
        var parameters = new DialogParameters { ["User"] = user };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<UserLockDialog>($"Lock {user.UserName}", parameters, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task ReloadIfSavedAsync(IDialogReference dialog)
    {
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task ActivateAsync(UserDto user)
    {
        try
        {
            await IdentityService.ActivateUserAsync(user.Id);
            Snackbar.Add($"{user.UserName} activated.", Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
        }
    }

    private async Task DeactivateAsync(UserDto user)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Deactivate User",
            $"Are you sure you want to deactivate {user.UserName}? They will no longer be able to sign in.",
            "Deactivate",
            "Cancel");

        if (confirmed != true)
            return;

        try
        {
            await IdentityService.DeactivateUserAsync(user.Id);
            Snackbar.Add($"{user.UserName} deactivated.", Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
        }
    }

    private async Task UnlockAsync(UserDto user)
    {
        try
        {
            await IdentityService.UnlockUserAsync(user.Id);
            Snackbar.Add($"{user.UserName} unlocked.", Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
        }
    }

    private static string StatusText(UserDto user)
    {
        if (user.IsLocked)
            return "Locked";
        return user.IsActive ? "Active" : "Inactive";
    }

    private static Color StatusColor(UserDto user)
    {
        if (user.IsLocked)
            return Color.Warning;
        return user.IsActive ? Color.Success : Color.Default;
    }

    public void Dispose() => _searchCts?.Cancel();
}
