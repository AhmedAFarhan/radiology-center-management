@page "/users"
@attribute [Authorize]
@inject IdentityService IdentityService
@inject TokenStorage TokenStorage
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.Person" Title="@T.Users.Title"
            Subtitle="@T.Users.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.Users.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Users.NewUser</MudButton>
</PageHeader>

<MudTable T="UserDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="UserDto" SortLabel="@("UserName")">@T.Users.Username</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="UserDto" SortLabel="@("LastName")">@T.Common.Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="UserDto" SortLabel="@("Email")">@T.Users.Email</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="UserDto" SortLabel="@("PhoneNumber")">@T.Users.Phone</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh><MudTableSortLabel T="UserDto" SortLabel="@("LastLoginAt")">@T.Users.LastLogin</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Users.Username">
            <MudText Class="font-weight-medium">@context.UserName</MudText>
            @if (IsCurrentUser(context))
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@T.Users.You</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="@T.Common.Name">@context.FullName</MudTd>
        <MudTd DataLabel="@T.Users.Email">@context.Email</MudTd>
        <MudTd DataLabel="@T.Users.Phone">@(string.IsNullOrWhiteSpace(context.PhoneNumber) ? "-" : context.PhoneNumber)</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <MudChip T="string" Size="Size.Small" Color="@(StatusColor(context))">@StatusText(context)</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Users.LastLogin">@(context.LastLoginAt?.ToString("g") ?? "-")</MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Users.EditProfile" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Color="Color.Info" aria-label="@T.Users.ManageRoles" OnClick="@(() => OpenRolesDialogAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Key" Size="Size.Small" Color="Color.Default" aria-label="@T.Users.ResetPassword" OnClick="@(() => OpenResetPasswordDialogAsync(context))" Disabled="@IsCurrentUser(context)" />
            @if (context.IsLocked)
            {
                <MudIconButton Icon="@Icons.Material.Filled.LockOpen" Size="Size.Small" Color="Color.Warning" aria-label="@T.Users.Unlock" OnClick="@(() => UnlockAsync(context))" />
            }
            else
            {
                <MudIconButton Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Default" aria-label="@T.Users.Lock" OnClick="@(() => OpenLockDialogAsync(context))" Disabled="@IsCurrentUser(context)" />
            }
            @if (context.IsActive)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error" aria-label="@T.Users.Deactivate" OnClick="@(() => DeactivateAsync(context))" Disabled="@IsCurrentUser(context)" />
            }
            else
            {
                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" aria-label="@T.Users.Activate" OnClick="@(() => ActivateAsync(context))" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.Users.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        <EmptyState Icon="@Icons.Material.Filled.Person"
                    Title="@T.Users.EmptyTitle"
                    Message="@T.Users.EmptyMessage"
                    ActionLabel="@T.Users.EmptyAction"
                    Action="OpenCreateDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<UserDto>? _table;
    private string? _search;
    private string? _currentUserName;
    private CancellationTokenSource? _searchCts;
    private string? _loadError;
    private bool _offline;

    protected override void OnInitialized()
        => _currentUserName = TokenStorage.GetTokens()?.Username;

    private bool IsCurrentUser(UserDto user)
        => string.Equals(user.UserName, _currentUserName, StringComparison.OrdinalIgnoreCase);

    private async Task<TableData<UserDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        try
        {
            var page = await IdentityService.GetUsersPagedAsync(
                _search,
                state.SortLabel,
                state.SortDirection == SortDirection.Descending,
                state.Page + 1,
                state.PageSize,
                ct);

            _loadError = null;
            _offline = false;
            return new TableData<UserDto> { Items = page.Items, TotalItems = page.TotalCount };
        }
        catch (OperationCanceledException)
        {
            if (ct.IsCancellationRequested)
                return new TableData<UserDto> { Items = Array.Empty<UserDto>(), TotalItems = 0 };
            throw;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _loadError = ex.Message;
            _offline = false;
            return new TableData<UserDto> { Items = Array.Empty<UserDto>(), TotalItems = 0 };
        }
        catch (Exception)
        {
            Snackbar.Add(T.Users.Unreachable, Severity.Error);
            _loadError = T.Users.Unreachable;
            _offline = true;
            return new TableData<UserDto> { Items = Array.Empty<UserDto>(), TotalItems = 0 };
        }
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value;

        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (_table is not null)
            await _table.ReloadServerData();
    }

    private Task ReloadAsync()
        => _table is null ? Task.CompletedTask : _table.ReloadServerData();

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<UserEditorDialog>(T.UserDialog.NewTitle, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenEditDialogAsync(UserDto user)
    {
        var parameters = new DialogParameters { ["User"] = user };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<UserEditorDialog>(T.FormatValue(T.UserDialog.EditTitle, user.UserName), parameters, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenRolesDialogAsync(UserDto user)
    {
        var parameters = new DialogParameters { ["User"] = user };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<UserRolesDialog>(T.FormatValue(T.UserDialog.RolesTitle, user.UserName), parameters, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenLockDialogAsync(UserDto user)
    {
        var parameters = new DialogParameters { ["User"] = user };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<UserLockDialog>(T.FormatValue(T.UserDialog.LockTitle, user.UserName), parameters, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenResetPasswordDialogAsync(UserDto user)
    {
        var parameters = new DialogParameters { ["User"] = user };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<ResetPasswordDialog>(T.FormatValue(T.UserDialog.ResetPasswordTitle, user.UserName), parameters, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task ReloadIfSavedAsync(IDialogReference dialog)
    {
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task ActivateAsync(UserDto user)
    {
        try
        {
            await IdentityService.ActivateUserAsync(user.Id);
            Snackbar.Add(T.FormatValue(T.Users.Activated, user.UserName), Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add(T.Users.Unreachable, Severity.Error);
        }
    }

    private async Task DeactivateAsync(UserDto user)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            T.Users.DeactivateTitle,
            T.FormatValue(T.Users.DeactivateConfirm, user.UserName),
            T.Users.Deactivate,
            T.Common.Cancel);

        if (confirmed != true)
            return;

        try
        {
            await IdentityService.DeactivateUserAsync(user.Id);
            Snackbar.Add(T.FormatValue(T.Users.Deactivated, user.UserName), Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add(T.Users.Unreachable, Severity.Error);
        }
    }

    private async Task UnlockAsync(UserDto user)
    {
        try
        {
            await IdentityService.UnlockUserAsync(user.Id);
            Snackbar.Add(T.FormatValue(T.Users.Unlocked, user.UserName), Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add(T.Users.Unreachable, Severity.Error);
        }
    }

    private string StatusText(UserDto user)
    {
        if (user.IsLocked)
            return T.Users.Locked;
        return user.IsActive ? T.Common.Active : T.Common.Inactive;
    }

    private static Color StatusColor(UserDto user)
    {
        if (user.IsLocked)
            return Color.Warning;
        return user.IsActive ? Color.Success : Color.Default;
    }

    public void Dispose() => _searchCts?.Cancel();
}
