@page "/analytics/overview"
@attribute [Authorize]
@inherits AnalyticsPageBase
@using RadiologyCenter.Desktop.Components.Analytics
@using RadiologyCenter.Desktop.Models

<PageHeader Icon="@Icons.Material.Filled.Insights" Title="Analytics" Subtitle="Business overview for the selected period" OnRefresh="() => ReloadAsync()" ShowSearch="false" />

<PeriodSelector Class="mb-4" />

@if (Loading)
{
    <PageSkeleton Rows="8" />
}
else if (Error)
{
    <ErrorState Title="Couldn't load analytics" Message="Unable to reach the server. Check your connection and try again." Action="ReloadAsync" RetryLabel="Try again" />
}
else
{
    <div class="profit-hero mb-4">
        <div class="profit-hero-body">
            <div class="profit-hero-label">Net profit</div>
            <div class="profit-hero-value">@AnalyticsFormat.Money(_profit!.NetProfit)</div>
            <div class="profit-hero-sub">
                Generated @AnalyticsFormat.Money(_profit.RevenueCollected) revenue this period
            </div>
        </div>
        <div class="profit-hero-metrics">
            <div class="hero-metric">
                <div class="hero-metric-label">Margin</div>
                <div class="hero-metric-value">@AnalyticsFormat.Percent(_profit.NetMargin)</div>
            </div>
            <div class="hero-metric">
                <div class="hero-metric-label">Billed</div>
                <div class="hero-metric-value">@AnalyticsFormat.MoneyCompact(_profit.TotalBilled)</div>
            </div>
            <div class="hero-metric">
                <div class="hero-metric-label">Total costs</div>
                <div class="hero-metric-value">@AnalyticsFormat.MoneyCompact(_profit.TotalCosts)</div>
            </div>
        </div>
    </div>

    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Label="Revenue (collected)" Value="@AnalyticsFormat.Money(_financial!.TotalCollected)" Icon="@Icons.Material.Filled.Payments" Color="Color.Primary" TrendText="Net invoices & payments" TrendUp="true" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Label="Total billed" Value="@AnalyticsFormat.Money(_financial.TotalBilled)" Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Secondary" TrendText="@ExamCountLabel()" TrendUp="true" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Label="Outstanding (receivable)" Value="@AnalyticsFormat.Money(_financial.Receivables)" Icon="@Icons.Material.Filled.Wallet" Color="Color.Warning" TrendText="@($"Avg {AnalyticsFormat.Money(_financial.AvgPerExam)} / exam")" TrendUp="false" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Label="Discounts given" Value="@AnalyticsFormat.Money(_financial.TotalDiscounts)" Icon="@Icons.Material.Filled.LocalOffer" Color="Color.Info" TrendText="Revenue stream" TrendUp="true" />
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3" Class="mt-1">
        <MudItem xs="12" lg="8">
            <ChartCard Title="Revenue trend" Subtitle="Collected vs billed by month">
                <RevenueTrendChart Items="@_financial!.RevenueByMonth" />
            </ChartCard>
        </MudItem>
        <MudItem xs="12" lg="4">
            <ChartCard Title="Cost structure" Subtitle="Where the money goes">
                <DonutChart Items="@BuildCostBreakdown()" />
            </ChartCard>
        </MudItem>
        <MudItem xs="12" lg="5">
            <ChartCard Title="Receivable aging" Subtitle="Outstanding balances">
                <DonutChart Items="@BuildReceivableSlices()" Height="260px" />
            </ChartCard>
        </MudItem>
        <MudItem xs="12" lg="7">
            <ChartCard Title="Net income waterfall" Subtitle="From revenue to profit">
                <div class="waterfall">
                    @foreach (var row in BuildWaterfall())
                    {
                        <div class="waterfall-row">
                            <div class="waterfall-label">@row.Label</div>
                            <div class="waterfall-track">
                                <div class="waterfall-fill" style="@($"width:{row.Percent}%;background:{row.Color}")"></div>
                            </div>
                            <div class="waterfall-value">@AnalyticsFormat.Money(row.Value)</div>
                        </div>
                    }
                </div>
            </ChartCard>
        </MudItem>
    </MudGrid>
}

@code {
    [Inject]
    private AnalyticsService Api { get; set; } = null!;

    private ProfitAnalyticsDto? _profit;
    private FinancialAnalyticsDto? _financial;

    protected override async Task LoadAsync(DateTime from, DateTime to)
    {
        _profit = await Api.GetProfitAsync(from, to);
        _financial = await Api.GetFinancialAsync(from, to);
    }

    private string ExamCountLabel() => $"{AnalyticsFormat.Count(_financial!.ExamCount)} exams";

    private IReadOnlyList<AnalyticsSlice> BuildCostBreakdown()
    {
        var list = new List<AnalyticsSlice>();
        Add(list, "Staff case fees", _profit!.StaffCaseFees);
        Add(list, "Referral fees", _profit.ReferralFees);
        Add(list, "Labor (payroll)", _profit.LaborCosts);
        Add(list, "Materials", _profit.MaterialCosts);
        return list.Count == 0
            ? new List<AnalyticsSlice> { new AnalyticsSlice("No costs", 0) }
            : list;
    }

    private static void Add(List<AnalyticsSlice> list, string label, decimal value)
    {
        if (value > 0)
            list.Add(new AnalyticsSlice(label, value));
    }

    private IReadOnlyList<AnalyticsSlice> BuildReceivableSlices()
        => _financial!.ReceivableAging
            .Select(r => new AnalyticsSlice(r.Bucket, r.Amount))
            .ToList();

    private List<WaterfallRow> BuildWaterfall()
    {
        var baseValue = _profit!.RevenueCollected;
        int percent(decimal v) => (int)Math.Round(v / (baseValue == 0 ? 1 : baseValue) * 100);

        return new List<WaterfallRow>
        {
            Build("Revenue", _profit.RevenueCollected, percent(_profit.RevenueCollected), "#5476FC"),
            Build("Staff fees", -_profit.StaffCaseFees, percent(_profit.StaffCaseFees), "#FF8A65"),
            Build("Referral fees", -_profit.ReferralFees, percent(_profit.ReferralFees), "#FF8A65"),
            Build("Labor", -_profit.LaborCosts, percent(_profit.LaborCosts), "#FF8A65"),
            Build("Materials", -_profit.MaterialCosts, percent(_profit.MaterialCosts), "#FF8A65"),
            Build("Net profit", _profit.NetProfit, percent(_profit.NetProfit), "#66BB6A"),
        };
    }

    private static WaterfallRow Build(string label, decimal value, int percent, string color)
        => new WaterfallRow(label, value, Math.Clamp(percent, 0, 100), color);

    private sealed record WaterfallRow(string Label, decimal Value, int Percent, string Color);
}
