@page "/analytics/financial"
@attribute [Authorize]
@inherits AnalyticsPageBase
@using RadiologyCenter.Desktop.Components.Analytics
@using RadiologyCenter.Desktop.Components.Pages.Dashboard
@using RadiologyCenter.Desktop.Models
@inject AppLocalizer T

<PageHeader Icon="@Icons.Material.Filled.AccountBalanceWallet" Title="@T.Financial.Title" Subtitle="@T.Financial.Subtitle" OnRefresh="() => ReloadAsync()" ShowSearch="false" />

<PeriodSelector Class="mb-4" />

@if (Loading)
{
    <AnalyticsSkeleton ShowHero="false" />
}
else if (Error)
{
    <ErrorState Title="@T.Financial.LoadErrorTitle" Message="@T.Financial.LoadErrorMsg" Detail="@LastError" Action="ReloadAsync" RetryLabel="@T.Financial.Retry" />
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" lg="4">
            <StatCard Label="@T.Financial.Exams" Value="@AnalyticsFormat.Count(_data!.ExamCount)" Icon="@Icons.Material.Filled.MedicalServices" Color="Color.Primary" TrendText="@T.Financial.CompletedInPeriod" TrendUp="true" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="4">
            <StatCard Label="@T.Financial.Collected" Value="@AnalyticsFormat.Money(_data.TotalCollected)" Icon="@Icons.Material.Filled.Payments" Color="Color.Secondary" TrendText="@T.Financial.CashIn" TrendUp="true" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="4">
            <StatCard Label="@T.Financial.Billed" Value="@AnalyticsFormat.Money(_data.TotalBilled)" Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Info" TrendText="@T.Financial.GrossInvoices" TrendUp="true" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Label="@T.Financial.Discounts" Value="@AnalyticsFormat.Money(_data.TotalDiscounts)" Icon="@Icons.Material.Filled.LocalOffer" Color="Color.Warning" TrendText="@T.Financial.GivenThisPeriod" TrendUp="false" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Label="@T.Financial.AveragePerExam" Value="@AnalyticsFormat.Money(_data.AvgPerExam)" Icon="@Icons.Material.Filled.MonetizationOn" Color="Color.Primary" TrendText="@T.Financial.CollectedOverExams" TrendUp="true" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Label="@T.Financial.Outstanding" Value="@AnalyticsFormat.Money(_data.Receivables)" Icon="@Icons.Material.Filled.Wallet" Color="Color.Error" TrendText="@T.Financial.StillToCollect" TrendUp="false" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Label="@T.Financial.CollectionRate" Value="@CollectionRate()" Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" TrendText="@T.Financial.OfTotalBilled" TrendUp="true" />
        </MudItem>
    </MudGrid>

    @if (_insuranceStats is not null)
    {
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.h6" Class="mb-1">@T.Financial.Insurance</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" lg="4">
                <StatCard Label="@T.Financial.OutstandingFromInsurers" Value="@AnalyticsFormat.Money(_insuranceStats.OutstandingAmount)" Icon="@Icons.Material.Filled.RequestQuote" Color="Color.Error" TrendText="@(T.FormatValue(T.Financial.ApprovedClaims, _insuranceStats.ApprovedClaims))" TrendUp="false" />
            </MudItem>
            <MudItem xs="12" sm="6" lg="4">
                <StatCard Label="@T.Financial.ClaimsInFlight" Value="@_insuranceStats.SubmittedClaims.ToString()" Icon="@Icons.Material.Filled.Send" Color="Color.Warning" TrendText="@(T.FormatValue(T.Financial.DraftClaims, _insuranceStats.DraftClaims))" TrendUp="true" />
            </MudItem>
            <MudItem xs="12" sm="6" lg="4">
                <StatCard Label="@T.Financial.PendingAuthorizations" Value="@_insuranceStats.PendingPreAuthorizations.ToString()" Icon="@Icons.Material.Filled.Approval" Color="Color.Info" TrendText="@(T.FormatValue(T.Financial.Approved, _insuranceStats.ApprovedPreAuthorizations))" TrendUp="true" />
            </MudItem>
        </MudGrid>
    }

    <MudGrid Spacing="3" Class="mt-1">
        <MudItem xs="12" lg="8">
            <ChartCard Title="@T.Financial.RevenueTrend" Subtitle="@T.Financial.CollectedVsBilledByMonth">
                <RevenueTrendChart Items="@_data!.RevenueByMonth" />
            </ChartCard>
        </MudItem>
        <MudItem xs="12" lg="4">
            <ChartCard Title="@T.Financial.RevenueByModality" Subtitle="@T.Financial.CollectedContribution">
                <ModalityRevenueChart Items="@_data!.RevenueByModality" Height="300px" />
            </ChartCard>
        </MudItem>
        <MudItem xs="12" lg="5">
            <ChartCard Title="@T.Financial.ReceivableAging" Subtitle="@T.Financial.OutstandingBalancesByBucket">
                <DonutChart Items="@BuildReceivableSlices()" Height="280px" />
            </ChartCard>
        </MudItem>
        <MudItem xs="12" lg="7">
            <ChartCard Title="@T.Financial.ExamRevenueDetail" Subtitle="@T.Financial.BillingPerCompletedExam">
                <MudTable Items="_exams!.Where(e => e.Billed > 0).OrderByDescending(e => e.CompletedAt).Take(12)" Dense="true" Hover="true" FixedHeader="true" Height="360" Elevation="0" Bordered="false">
                    <HeaderContent>
                        <MudTh>@T.Financial.Exam</MudTh>
                        <MudTh>@T.Financial.Completed</MudTh>
                        <MudTh Right="true">@T.Financial.Billed</MudTh>
                        <MudTh Right="true">@T.Financial.Discount</MudTh>
                        <MudTh Right="true">@T.Financial.Paid</MudTh>
                        <MudTh Right="true">@T.Financial.Remaining</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@T.Financial.Exam">@context.ExaminationTypeName</MudTd>
                        <MudTd DataLabel="@T.Financial.Completed">@(context.CompletedAt?.ToString("dd MMM") ?? "-")</MudTd>
                        <MudTd DataLabel="@T.Financial.Billed" Right="true">@context.Billed.ToString("C")</MudTd>
                        <MudTd DataLabel="@T.Financial.Discount" Right="true">@context.Discount.ToString("C")</MudTd>
                        <MudTd DataLabel="@T.Financial.Paid" Right="true">@context.Paid.ToString("C")</MudTd>
                        <MudTd DataLabel="@T.Financial.Remaining" Right="true">@context.Remaining.ToString("C")</MudTd>
                    </RowTemplate>
                </MudTable>
            </ChartCard>
        </MudItem>
    </MudGrid>
}

@code {
    [Inject]
    private AnalyticsService Api { get; set; } = null!;

    [Inject]
    private InsuranceService Insurance { get; set; } = null!;

    private FinancialAnalyticsDto? _data;
    private IReadOnlyList<FinancialExamRowDto>? _exams;
    private InsuranceStatsDto? _insuranceStats;

    protected override async Task LoadAsync(DateTime from, DateTime to)
    {
        _data = await Api.GetFinancialAsync(from, to);
        _exams = await Api.GetFinancialExamsAsync(from, to);

        try
        {
            _insuranceStats = await Insurance.GetStatsAsync();
        }
        catch
        {
            _insuranceStats = null;
        }
    }

    private IReadOnlyList<AnalyticsSlice> BuildReceivableSlices()
        => (_data?.ReceivableAging ?? Array.Empty<ReceivableBucketDto>())
            .Select(r => new AnalyticsSlice(r.Bucket, r.Amount))
            .ToList();

    private string CollectionRate()
        => _data!.TotalBilled > 0
            ? AnalyticsFormat.Percent(_data.TotalCollected / _data.TotalBilled)
            : "-";
}


