@page "/analytics/staff"
@attribute [Authorize]
@inherits AnalyticsPageBase
@using RadiologyCenter.Desktop.Components.Analytics
@using RadiologyCenter.Desktop.Components.Pages.Dashboard
@using RadiologyCenter.Desktop.Models
@inject AppLocalizer T

<PageHeader Icon="@Icons.Material.Filled.Groups" Title="@T.StaffMachine.Title" Subtitle="@T.StaffMachine.Subtitle" OnRefresh="() => ReloadAsync()" ShowSearch="false" />

<PeriodSelector Class="mb-4" />

@if (Loading)
{
    <AnalyticsSkeleton ShowHero="false" />
}
else if (Error)
{
    <ErrorState Title="@T.StaffMachine.LoadErrorTitle" Message="@T.StaffMachine.LoadErrorMsg" Detail="@LastError" Action="ReloadAsync" RetryLabel="@T.StaffMachine.Retry" />
}
else
{
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Label="@T.StaffMachine.Radiologists" Value="@AnalyticsFormat.Count(_data!.Radiologists.Count)" Icon="@Icons.Material.Filled.Biotech" Color="Color.Primary" TrendText="@T.StaffMachine.PerformedExams" TrendUp="true" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Label="@T.StaffMachine.Technicians" Value="@AnalyticsFormat.Count(_data.Technicians.Count)" Icon="@Icons.Material.Filled.Handyman" Color="Color.Secondary" TrendText="@T.StaffMachine.ActiveInPeriod" TrendUp="true" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Label="@T.StaffMachine.ReferralDoctors" Value="@AnalyticsFormat.Count(_data.ReferralDoctors.Count)" Icon="@Icons.Material.Filled.LocalHospital" Color="Color.Warning" TrendText="@T.StaffMachine.ReferredCases" TrendUp="true" />
        </MudItem>
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Label="@T.StaffMachine.Modalities" Value="@AnalyticsFormat.Count(_data.ModalityUtilization.Count)" Icon="@Icons.Material.Filled.PrecisionManufacturing" Color="Color.Info" TrendText="@T.StaffMachine.WithCaseActivity" TrendUp="true" />
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3" Class="mt-1">
        <MudItem xs="12" lg="6">
            <ChartCard Title="@T.StaffMachine.TopRadiologists" Subtitle="@T.StaffMachine.CompletedExamsByCaseLoad">
                <ListBarChart Items="@BuildRadiologistSlices()" SeriesName="@T.StaffMachine.Exams" />
            </ChartCard>
        </MudItem>
        <MudItem xs="12" lg="6">
            <ChartCard Title="@T.StaffMachine.TopTechnicians" Subtitle="@T.StaffMachine.CompletedExamsSupported">
                <ListBarChart Items="@BuildTechnicianSlices()" SeriesName="@T.StaffMachine.Exams" />
            </ChartCard>
        </MudItem>
        <MudItem xs="12" lg="5">
            <ChartCard Title="@T.StaffMachine.ReferralPerformance" Subtitle="@T.StaffMachine.CasesReferredToYourCenter">
                <ListBarChart Items="@BuildReferralSlices()" SeriesName="@T.StaffMachine.Referrals" />
            </ChartCard>
        </MudItem>
        <MudItem xs="12" lg="7">
            <ChartCard Title="@T.StaffMachine.MachineUtilization" Subtitle="@T.StaffMachine.ExamsPerMachineByModality">
                <UtilizationChart Items="@_data!.ModalityUtilization" />
            </ChartCard>
        </MudItem>
    </MudGrid>
}




