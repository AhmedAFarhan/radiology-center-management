@page "/examinations"
@attribute [Authorize]
@inject ExaminationService ExaminationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<MudToolBar Dense="true" Class="mb-4">
    <MudText Typo="Typo.h5">Examinations</MudText>
    <MudText Typo="Typo.body2" Class="text-secondary ms-2">Manage examination types</MudText>
    <MudSpacer />
    <MudTextField T="string"
                  Value="_search"
                  ValueChanged="OnSearchChanged"
                  Placeholder="Search types..."
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Immediate="true"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="search-field" />
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" aria-label="Refresh" OnClick="ReloadAsync" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">Add Type</MudButton>
</MudToolBar>

<MudTable T="ExaminationTypeDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="ExaminationTypeDto" SortLabel="@("Code")">Code</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ExaminationTypeDto" SortLabel="@("Name")">Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ExaminationTypeDto" SortLabel="@("Modality")">Modality</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ExaminationTypeDto" SortLabel="@("BodyPart")">Body Part</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ExaminationTypeDto" SortLabel="@("StandardDurationMinutes")">Duration</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ExaminationTypeDto" SortLabel="@("Price")">Price</MudTableSortLabel></MudTh>
        <MudTh>Requirements</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Code" Class="mono-text">@context.Code</MudTd>
        <MudTd DataLabel="Name">
            <MudText Class="font-weight-medium">@context.Name</MudText>
            <MudText Typo="Typo.caption" Class="text-secondary">@context.Items.Count item(s)</MudText>
        </MudTd>
        <MudTd DataLabel="Modality">@context.Modality</MudTd>
        <MudTd DataLabel="Body Part">@context.BodyPart</MudTd>
        <MudTd DataLabel="Duration">@(context.StandardDurationMinutes == 0 ? "-" : $"{context.StandardDurationMinutes} min")</MudTd>
        <MudTd DataLabel="Price">@context.Price.ToString("C")</MudTd>
        <MudTd DataLabel="Requirements">
            @if (context.RequiresPreparation)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="me-1">Prep</MudChip>
            }
            @if (context.RequiresConsent)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="me-1">Consent</MudChip>
            }
            @if (context.RequiresContrast)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">Contrast</MudChip>
            }
            @if (!context.RequiresPreparation && !context.RequiresConsent && !context.RequiresContrast)
            {
                <MudText Typo="Typo.caption" Class="text-secondary">None</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Active" : "Inactive")</MudChip>
        </MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="Edit" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                           Size="Size.Small"
                           Color="@(context.IsActive ? Color.Default : Color.Success)"
                           aria-label="Toggle status"
                           OnClick="@(() => ToggleActiveAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Delete" OnClick="@(() => DeleteTypeAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4">No examination types found.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<ExaminationTypeDto>? _table;
    private string? _search;
    private CancellationTokenSource? _searchCts;

    private async Task<TableData<ExaminationTypeDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        try
        {
            var page = await ExaminationService.GetTypesPagedAsync(
                _search,
                state.SortLabel,
                state.SortDirection == SortDirection.Descending,
                state.Page + 1,
                state.PageSize,
                ct);

            return new TableData<ExaminationTypeDto> { Items = page.Items, TotalItems = page.TotalCount };
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return new TableData<ExaminationTypeDto> { Items = Array.Empty<ExaminationTypeDto>(), TotalItems = 0 };
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
            return new TableData<ExaminationTypeDto> { Items = Array.Empty<ExaminationTypeDto>(), TotalItems = 0 };
        }
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value;

        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (_table is not null)
            await _table.ReloadServerData();
    }

    private Task ReloadAsync()
        => _table is null ? Task.CompletedTask : _table.ReloadServerData();

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ExaminationTypeEditorDialog>("New Examination Type", options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenEditDialogAsync(ExaminationTypeDto type)
    {
        var parameters = new DialogParameters { ["Type"] = type };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ExaminationTypeEditorDialog>("Edit Examination Type", parameters, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task ReloadIfSavedAsync(IDialogReference dialog)
    {
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task ToggleActiveAsync(ExaminationTypeDto type)
    {
        try
        {
            if (type.IsActive)
                await ExaminationService.DeactivateTypeAsync(type.Id);
            else
                await ExaminationService.ActivateTypeAsync(type.Id);

            Snackbar.Add(type.IsActive ? "Examination type deactivated." : "Examination type activated.", Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
        }
    }

    private async Task DeleteTypeAsync(ExaminationTypeDto type)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Examination Type",
            $"Are you sure you want to delete {type.Name}? This cannot be undone.",
            "Delete",
            "Cancel");

        if (confirmed != true)
            return;

        try
        {
            await ExaminationService.DeleteTypeAsync(type.Id);
            Snackbar.Add("Examination type deleted.", Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
        }
    }

    public void Dispose() => _searchCts?.Cancel();
}
