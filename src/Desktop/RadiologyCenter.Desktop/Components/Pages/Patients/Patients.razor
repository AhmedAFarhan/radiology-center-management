@page "/patients"
@attribute [Authorize]
@inject PatientService PatientService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@inject NavigationManager NavigationManager
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.People" Title="@T.Patients.Title"
            Subtitle="@T.Patients.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchValue="@SearchQuery"
            SearchPlaceholder="@T.Patients.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <AuthorizeView Policy="@PatientsPermissions.Create">
        <Authorized Context="auth">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Patients.AddPatient</MudButton>
        </Authorized>
    </AuthorizeView>
</PageHeader>

<MudTable T="PatientDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="PatientDto" SortLabel="@("PatientCode")">@T.Patients.Code</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PatientDto" SortLabel="@("LastName")">@T.Common.Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PatientDto" SortLabel="@("Gender")">@T.Patients.Gender</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PatientDto" SortLabel="@("Age")">@T.Patients.Age</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PatientDto" SortLabel="@("PhoneNumber")">@T.Patients.Phone</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PatientDto" SortLabel="@("CreatedAt")">@T.Patients.Registered</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Patients.Code"><MudText Class="font-weight-medium">@context.PatientCode</MudText></MudTd>
        <MudTd DataLabel="@T.Common.Name">@context.FullName</MudTd>
        <MudTd DataLabel="@T.Patients.Gender">@context.Gender</MudTd>
        <MudTd DataLabel="@T.Patients.Age">@FormatAge(context.Age, context.DateOfBirth)</MudTd>
        <MudTd DataLabel="@T.Patients.Phone">@context.PhoneNumber</MudTd>
        <MudTd DataLabel="@T.Patients.Registered">@context.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? T.Common.Active : T.Common.Inactive)</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <AuthorizeView Policy="@PatientsPermissions.Update">
                <Authorized Context="auth">
                    <MudTooltip Placement="Placement.Bottom" Text="@T.Common.Edit">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Common.Edit" OnClick="@(() => OpenEditDialogAsync(context))" />
                    </MudTooltip>
                    <MudTooltip Placement="Placement.Bottom" Text="@T.Patients.ToggleStatus">
                        <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                                       Size="Size.Small"
                                       Color="@(context.IsActive ? Color.Default : Color.Success)"
                                       aria-label="@T.Patients.ToggleStatus"
                                       OnClick="@(() => ToggleActiveAsync(context))" />
                    </MudTooltip>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@PatientsPermissions.Delete">
                <Authorized Context="auth">
                    <MudTooltip Placement="Placement.Bottom" Text="@T.Common.Delete">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Delete" OnClick="@(() => DeletePatientAsync(context))" />
                    </MudTooltip>
                </Authorized>
            </AuthorizeView>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.Patients.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        <AuthorizeView Policy="@PatientsPermissions.Create">
            <Authorized Context="auth">
                <EmptyState Icon="@Icons.Material.Filled.Person"
                            Title="@T.Patients.EmptyTitle"
                            Message="@T.Patients.EmptyMessage"
                            ActionLabel="@T.Patients.EmptyAction"
                            Action="OpenCreateDialogAsync" />
            </Authorized>
            <NotAuthorized>
                <EmptyState Icon="@Icons.Material.Filled.Person"
                            Title="@T.Patients.EmptyTitle"
                            Message="@T.Patients.EmptyMessage" />
            </NotAuthorized>
        </AuthorizeView>
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>


