@inject InventoryService InventoryService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.LocalShipping" Title="@(Supplier is null ? "New Supplier" : "Edit Supplier")" />
        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_model.Name"
                                  Label="Name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Name)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_model.Phone"
                                  Label="Phone"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Phone)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.ContactPerson"
                                  Label="Contact Person"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.ContactPerson)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Email"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Email)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Address"
                                  Label="Address"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Address)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.TaxNumber"
                                  Label="Tax Number"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.TaxNumber)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.PaymentTerms"
                                  Label="Payment Terms"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.PaymentTerms)" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@(IsEdit ? "Save Changes" : "Create Supplier")</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public SupplierDto? Supplier { get; set; }

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly SupplierFormModel _model = new();
    private EditContext _editContext = default!;
    private bool _busy;

    private bool IsEdit => Supplier is not null;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);

        if (Supplier is null)
            return;

        _model.Name = Supplier.Name;
        _model.Phone = Supplier.Phone;
        _model.ContactPerson = Supplier.ContactPerson;
        _model.Email = Supplier.Email;
        _model.Address = Supplier.Address;
        _model.TaxNumber = Supplier.TaxNumber;
        _model.PaymentTerms = Supplier.PaymentTerms;
    }

    private async Task SubmitAsync()
    {
        if (!_editContext.Validate())
            return;

        _busy = true;
        try
        {
            var input = new SupplierInput
            {
                Name = _model.Name,
                Phone = _model.Phone,
                ContactPerson = _model.ContactPerson,
                Email = _model.Email,
                Address = _model.Address,
                TaxNumber = _model.TaxNumber,
                PaymentTerms = _model.PaymentTerms,
            };

            if (IsEdit)
                await InventoryService.UpdateSupplierAsync(Supplier!.Id, input);
            else
                await InventoryService.CreateSupplierAsync(input);

            Snackbar.Add(IsEdit ? "Supplier updated." : "Supplier created.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server. Please try again.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelAsync()
        => MudDialog.Cancel();

    private sealed class SupplierFormModel
    {
        [Required(ErrorMessage = "Name is required.")]
        [MaxLength(200, ErrorMessage = "Name must be 200 characters or fewer.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Phone is required.")]
        [MaxLength(30, ErrorMessage = "Phone must be 30 characters or fewer.")]
        public string Phone { get; set; } = string.Empty;

        [MaxLength(100, ErrorMessage = "Contact person must be 100 characters or fewer.")]
        public string? ContactPerson { get; set; }

        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string? Email { get; set; }

        [MaxLength(300, ErrorMessage = "Address must be 300 characters or fewer.")]
        public string? Address { get; set; }

        [MaxLength(50, ErrorMessage = "Tax number must be 50 characters or fewer.")]
        public string? TaxNumber { get; set; }

        [MaxLength(200, ErrorMessage = "Payment terms must be 200 characters or fewer.")]
        public string? PaymentTerms { get; set; }
    }
}
