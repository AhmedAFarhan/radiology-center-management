@inject IdentityService IdentityService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Security" Title="@(T.FormatValue(T.RoleDialog.PermissionsTitle, Role.Name))" />
        <MudText Typo="Typo.body2" Class="text-secondary mb-3">
            @(T.FormatValue(T.RoleDialog.PermissionsDescription, Role.Name))
        </MudText>

        <MudGrid Spacing="2">
                @foreach (var group in PermissionCatalog.Groups())
                {
                    <MudItem xs="12" sm="6">
                        <MudPaper Elevation="0" Class="pa-3 mb-2 permission-group">
                            <MudText Typo="Typo.subtitle2" Class="mb-1">@group</MudText>
                            @foreach (var permission in PermissionCatalog.ByGroup(group))
                            {
                                <div>
                                    <MudSwitch T="bool"
                                               @bind-Value="_selected[permission.Code]"
                                               Color="Color.Primary"
                                               Size="Size.Small">
                                        <MudText Typo="Typo.body2">@permission.Name</MudText>
                                        <MudText Typo="Typo.caption" Class="text-secondary d-block">@permission.Code</MudText>
                                    </MudSwitch>
                                </div>
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.RoleDialog.SavePermissions</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public RoleDto Role { get; set; } = default!;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly Dictionary<string, bool> _selected = new();
    private bool _busy;

    protected override void OnInitialized()
    {
        foreach (var permission in PermissionCatalog.All)
            _selected[permission.Code] = Role.Permissions.Contains(permission.Code, StringComparer.OrdinalIgnoreCase);
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        try
        {
            var current = Role.Permissions.Select(p => p.ToLowerInvariant()).ToHashSet();
            var next = _selected.Where(kv => kv.Value).Select(kv => kv.Key.ToLowerInvariant()).ToHashSet();

            foreach (var add in next.Except(current))
                await IdentityService.AddPermissionToRoleAsync(Role.Id, add);

            foreach (var remove in current.Except(next))
                await IdentityService.RemovePermissionFromRoleAsync(Role.Id, remove);

            Snackbar.Add(T.RoleDialog.PermissionsUpdated, Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add(T.RoleDialog.Unreachable, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelAsync()
        => MudDialog.Cancel();

