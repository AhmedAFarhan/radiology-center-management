        public static IEnumerable<string> Groups()
            => All.Select(p => p.Group)
                  .Where(g => !string.IsNullOrWhiteSpace(g))
                  .Cast<string>()
                  .Distinct()
                  .OrderBy(g => g);

        public static IEnumerable<PermissionDto> ByGroup(string group)
