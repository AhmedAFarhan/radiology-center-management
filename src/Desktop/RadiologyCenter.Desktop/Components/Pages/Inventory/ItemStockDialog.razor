@inject InventoryService InventoryService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Inventory2" Title="@(_stock?.ItemName ?? T.ItemDialog.ItemStockTitle)" />
        @if (_loadError is not null)
        {
            <ErrorState Title="@T.ItemDialog.LoadStockErrorTitle" Message="@_loadError" Action="LoadStockAsync" />
        }
        else if (_stock is null)
        {
            <DialogSkeleton Rows="4" />
        }
        else
        {
            <MudText Typo="Typo.body2" Class="text-secondary mb-3">
                @T.ItemDialog.StockOnHand <b>@_stock.StockOnHand</b>
            </MudText>

            <MudText Typo="Typo.subtitle2" Class="mb-1">@T.ItemDialog.Batches</MudText>
            <MudSimpleTable Dense="true">
                <thead>
                    <tr>
                        <th>@T.ItemDialog.Lot</th>
                        <th>@T.ItemDialog.Expiry</th>
                        <th>@T.ItemDialog.Remaining</th>
                        <th>@T.Common.Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_stock.Batches.Count == 0)
                    {
                        <tr>
                            <td colspan="4">@T.ItemDialog.NoBatches</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var batch in _stock.Batches)
                        {
                            <tr>
                                <td>@batch.LotNumber</td>
                                <td>@(batch.ExpiryDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>@batch.QuantityRemaining</td>
                                <td>
                                    <MudChip T="string" Size="Size.Small" Color="@(batch.IsExpired ? Color.Error : Color.Success)">@(batch.IsExpired ? T.ItemDialog.Expired : T.Common.Ok)</MudChip>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2" Class="mb-1">@T.ItemDialog.IssueStock</MudText>
            <EditForm EditContext="_editContext">
                <LocalizedDataAnnotationsValidator />
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="int?" @bind-Value="_model.Quantity"
                                         For="@(() => _model.Quantity)"
                                         Label="@T.ItemDialog.Quantity"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="1" />
                    </MudItem>
                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="_model.Reference"
                                      Label="@T.ItemDialog.Reference"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_model.Notes"
                                      Label="@T.ItemDialog.Notes"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                    </MudItem>
                </MudGrid>
            </EditForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="IssueAsync" Disabled="_busy || _stock is null || _loadError is not null">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.ItemDialog.IssueStock</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string ItemId { get; set; } = string.Empty;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private ItemStockDto? _stock;
    private string? _loadError;
    private readonly IssueStockModel _model = new();
    private EditContext _editContext = default!;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_model);
        await LoadStockAsync();
    }

    private async Task LoadStockAsync()
    {
        _loadError = null;
        try
        {
            _stock = await InventoryService.GetStockAsync(ItemId);
        }
        catch (ApiException ex)
        {
            _loadError = ex.Message;
        }
        catch (Exception)
        {
            _loadError = T.Inventory.Unreachable;
        }
    }

    private async Task IssueAsync()
    {
        if (!_editContext.Validate())
            return;

        if (_model.Quantity is not { } qty)
            return;

        await SafeExecute.RunAsync(async () =>
            {
                await InventoryService.IssueStockAsync(ItemId, new IssueStockInput
                {
                    Quantity = qty,
                    Reference = _model.Reference,
                    Notes = _model.Notes,
                });

                Snackbar.Add(T.FormatValue(T.ItemDialog.IssuedUnits, qty), Severity.Success);
                _model.Quantity = null;
                _model.Reference = null;
                _model.Notes = null;
                await LoadStockAsync();
            },
            Snackbar,
            () => T.Inventory.Unreachable,
            busy => _busy = busy);
    }

    private void CancelAsync()
        => MudDialog.Cancel();

    private sealed class IssueStockModel
    {
        [Range(1, int.MaxValue, ErrorMessage = "Quantity must be at least 1.")]
        public int? Quantity { get; set; }

        public string? Reference { get; set; }

        public string? Notes { get; set; }
    }
}

