@inherits EditorDialogBase
@inject InventoryService InventoryService
@inject EnumOptionsService EnumOptionsService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Inventory2" Title="@(Item is null ? T.ItemDialog.NewItem : T.ItemDialog.EditItem)" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_model.Name"
                                  Label="@T.Common.Name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Name)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_model.Brand"
                                  Label="@T.ItemDialog.Brand"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.Category"
                               Label="@T.ItemDialog.Category"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.Category)">
                        @foreach (var category in _categoryOptions)
                        {
                            <MudSelectItem T="string" Value="@category.Key">@category.Value</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.Unit"
                               Label="@T.ItemDialog.Unit"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.Unit)">
                        @foreach (var unit in _unitOptions)
                        {
                            <MudSelectItem T="string" Value="@unit.Key">@unit.Value</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField T="int"
                                     @bind-Value="_model.ReorderLevel"
                                     Label="@T.ItemDialog.ReorderLevel"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     For="@(() => _model.ReorderLevel)" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField T="int"
                                     @bind-Value="_model.ReorderQuantity"
                                     Label="@T.ItemDialog.ReorderQuantity"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     For="@(() => _model.ReorderQuantity)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.LotTracked"
                               Label="@T.ItemDialog.LotTracking"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        <MudSelectItem T="string" Value="@("No")">@T.Common.No</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Yes")">@T.Common.Yes</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-items-center">
                    <MudText Typo="Typo.body2" Class="text-secondary">
                        @T.ItemDialog.LotsHint
                    </MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.StorageInstructions"
                                  Label="@T.ItemDialog.StorageInstructions"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="3"
                                  Immediate="true" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.ItemDialog.SaveChanges : T.ItemDialog.CreateItem)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>