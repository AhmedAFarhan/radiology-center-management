@inject IdentityService IdentityService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Security" Title="@(T.FormatValue(T.UserDialog.RolesTitle, User.UserName))" />
        <MudText Typo="Typo.body2" Class="text-secondary mb-3">
            @(T.FormatValue(T.UserDialog.RolesDescription, User.UserName))
        </MudText>
        @if (_loadError is not null)
        {
            <ErrorState Title="@T.UserDialog.LoadRolesErrorTitle" Message="@_loadError" />
        }
        else if (_roles.Count == 0)
        {
            <DialogSkeleton Rows="4" />
        }
        else
        {
            <MudList T="RoleDto" Dense="true">
                @foreach (var role in _roles)
                {
                    <MudListItem T="RoleDto" Value="@role">
                        <MudSwitch T="bool"
                                   @bind-Value="_selected[role.Id]"
                                   Color="Color.Primary">
                            <MudText>@role.Name</MudText>
                            @if (role.IsSystem)
                            {
                                <MudText Typo="Typo.caption" Class="text-secondary">@T.UserDialog.SystemRole</MudText>
                            }
                        </MudSwitch>
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy || _roles.Count == 0">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.UserDialog.SaveRoles</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public UserDto User { get; set; } = default!;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private List<RoleDto> _roles = new();
    private readonly Dictionary<string, bool> _selected = new();
    private string? _loadError;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var roles = await IdentityService.GetRolesPagedAsync(null, "Name", false, 1, 100);
            _roles = roles.Items.ToList();
            foreach (var role in _roles)
                _selected[role.Id] = false;
        }
        catch (ApiException ex)
        {
            _loadError = ex.Message;
        }
        catch (Exception)
        {
            _loadError = T.UserDialog.LoadRolesError;
        }
    }

    private async Task SubmitAsync()
    {
        var selectedIds = _selected.Where(kv => kv.Value).Select(kv => kv.Key).ToList();
        if (selectedIds.Count == 0)
        {
            Snackbar.Add(T.UserDialog.SelectRole, Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await IdentityService.UpdateUserRolesAsync(User.Id, selectedIds);
            Snackbar.Add(T.UserDialog.RolesUpdated, Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add(T.UserDialog.Unreachable, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelAsync()
        => MudDialog.Cancel();
}

