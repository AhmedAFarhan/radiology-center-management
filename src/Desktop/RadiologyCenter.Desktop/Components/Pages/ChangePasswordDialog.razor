@inject AuthService AuthService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Shield" Title="@(Forced ? T.ChangePassword.RequiredTitle : T.ChangePassword.Title)" />
        @if (Forced)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" Variant="Variant.Outlined">
                @T.ChangePassword.AdminWarning
            </MudAlert>
        }
        <MudTextField @bind-Value="_currentPassword"
                      Label="@T.ChangePassword.Current"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      InputType="InputType.Password"
                      AutoComplete="current-password" />
        <MudTextField @bind-Value="_newPassword"
                      Label="@T.ChangePassword.New"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      InputType="InputType.Password"
                      AutoComplete="new-password"
                      HelperText="@T.ChangePassword.Helper" />
        <MudTextField @bind-Value="_confirmPassword"
                      Label="@T.ChangePassword.Confirm"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      InputType="InputType.Password"
                      AutoComplete="new-password" />
    </DialogContent>
    <DialogActions>
        @if (!Forced)
        {
            <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.ChangePassword.Cancel</MudButton>
        }
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.ChangePassword.Update</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Forced { get; set; }

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _busy;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            Snackbar.Add(T.ChangePassword.EnterCurrent, Severity.Warning);
            return;
        }

        if (_newPassword.Length < 8 || !_newPassword.Any(char.IsLetter) || !_newPassword.Any(char.IsDigit))
        {
            Snackbar.Add(T.ChangePassword.InvalidNew, Severity.Warning);
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add(T.ChangePassword.Mismatch, Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await AuthService.ChangePasswordAsync(_currentPassword, _newPassword);
            Snackbar.Add(T.ChangePassword.Success, Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add(T.ChangePassword.Unreachable, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelAsync()
        => MudDialog.Cancel();
}