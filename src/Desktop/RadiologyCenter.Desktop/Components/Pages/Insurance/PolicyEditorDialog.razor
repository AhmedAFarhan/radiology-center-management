@inject InsuranceService InsuranceService
@inject PatientService PatientService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Description" Title="@T.PolicyDialog.Title" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="PatientDto"
                                     @bind-Value="_selectedPatient"
                                     Label="@T.PolicyDialog.PatientSearchLabel"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchPatientsAsync"
                                     ToStringFunc="@(p => p is null ? string.Empty : p.FullName)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="InsuranceCompanyDto"
                                     @bind-Value="_selectedCompany"
                                     Label="@T.PolicyDialog.CompanyLabel"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchCompaniesAsync"
                                     ToStringFunc="@(c => c is null ? string.Empty : c.Name)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.PolicyNumber"
                                  Label="@T.PolicyDialog.PolicyNumber"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.PolicyNumber)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.CoveragePercent"
                                     Label="@T.PolicyDialog.CoveragePercent"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     Max="100"
                                     For="@(() => _model.CoveragePercent)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_model.EffectiveFrom"
                                   Label="@T.PolicyDialog.EffectiveFrom"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_model.EffectiveTo"
                                   Label="@T.PolicyDialog.EffectiveTo"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch T="bool" @bind-Value="_model.IsGovernment" Color="Color.Primary">@T.PolicyDialog.GovernmentPolicy</MudSwitch>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.PolicyDialog.Create</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

