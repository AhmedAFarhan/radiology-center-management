@page "/insurance/companies"
@attribute [Authorize]
@inject InsuranceService InsuranceService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@inject NavigationManager NavigationManager
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.Shield" Title="@T.Insurance.CompaniesTitle"
            Subtitle="@T.Insurance.CompaniesSubtitle"
            SearchValueChanged="OnSearchChanged"
            SearchValue="@SearchQuery"
            SearchPlaceholder="@T.Insurance.CompaniesSearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Insurance.AddCompany</MudButton>
</PageHeader>

<MudTable T="InsuranceCompanyDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="InsuranceCompanyDto" SortLabel="@("Name")">@T.Common.Name</MudTableSortLabel></MudTh>
        <MudTh>@T.Insurance.TaxNumber</MudTh>
        <MudTh>@T.Insurance.Phone</MudTh>
        <MudTh>@T.Insurance.Email</MudTh>
        <MudTh>@T.Insurance.Address</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Common.Name">
            <MudText Class="font-weight-medium">@context.Name</MudText>
        </MudTd>
        <MudTd DataLabel="@T.Insurance.TaxNumber">@(context.TaxId ?? "-")</MudTd>
        <MudTd DataLabel="@T.Insurance.Phone">@(context.Phone ?? "-")</MudTd>
        <MudTd DataLabel="@T.Insurance.Email">@(context.Email ?? "-")</MudTd>
        <MudTd DataLabel="@T.Insurance.Address">@(context.Address ?? "-")</MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Common.Edit" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Delete" OnClick="@(() => DeleteCompanyAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.Insurance.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        <EmptyState Icon="@Icons.Material.Filled.Shield"
                    Title="@T.Insurance.EmptyTitle"
                    Message="@T.Insurance.EmptyMessage"
                    ActionLabel="@T.Insurance.EmptyActionLabel"
                    Action="OpenCreateDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>

