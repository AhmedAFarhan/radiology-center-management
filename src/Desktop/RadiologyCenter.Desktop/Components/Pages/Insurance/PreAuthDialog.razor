@inject InsuranceService InsuranceService
@inject ExaminationService ExaminationService
@inject PatientService PatientService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Approval" Title="Request Pre-Authorization" />
        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="PatientDto"
                                     @bind-Value="_selectedPatient"
                                     Label="Patient (search by name or phone)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchPatientsAsync"
                                     ToStringFunc="@(p => p is null ? string.Empty : p.FullName)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="InsurancePolicyDto"
                                     @bind-Value="_selectedPolicy"
                                     Label="Insurance Policy (search by policy #)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchPoliciesAsync"
                                     ToStringFunc="@(p => p is null ? string.Empty : p.PolicyNumber)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="ExaminationDto"
                                     @bind-Value="_selectedExamination"
                                     Label="Examination (search by type name)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchExaminationsAsync"
                                     ToStringFunc="@(e => e is null ? string.Empty : e.ExaminationTypeName)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.EstimatedAmount"
                                     Label="Estimated Amount"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     For="@(() => _model.EstimatedAmount)" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>Request Authorization</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly PreAuthFormModel _model = new();
    private EditContext _editContext = default!;
    private PatientDto? _selectedPatient;
    private InsurancePolicyDto? _selectedPolicy;
    private ExaminationDto? _selectedExamination;
    private bool _busy;

    protected override void OnInitialized()
        => _editContext = new EditContext(_model);

    private async Task<IEnumerable<PatientDto>> SearchPatientsAsync(string? value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Array.Empty<PatientDto>();

        try
        {
            var page = await PatientService.GetPagedAsync(value, "LastName", false, 1, 20, ct);
            return page.Items;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return Array.Empty<PatientDto>();
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to search patients.", Severity.Error);
            return Array.Empty<PatientDto>();
        }
    }

    private async Task<IEnumerable<InsurancePolicyDto>> SearchPoliciesAsync(string? value, CancellationToken ct)
    {
        if (_selectedPatient is null)
        {
            Snackbar.Add("Select a patient first.", Severity.Info);
            return Array.Empty<InsurancePolicyDto>();
        }

        try
        {
            var policies = await InsuranceService.GetPoliciesByPatientAsync(_selectedPatient.Id, ct);
            if (string.IsNullOrWhiteSpace(value))
                return policies;

            return policies.Where(p => p.PolicyNumber.Contains(value, StringComparison.OrdinalIgnoreCase));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return Array.Empty<InsurancePolicyDto>();
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to search policies.", Severity.Error);
            return Array.Empty<InsurancePolicyDto>();
        }
    }

    private async Task<IEnumerable<ExaminationDto>> SearchExaminationsAsync(string? value, CancellationToken ct)
    {
        if (_selectedPatient is null)
        {
            Snackbar.Add("Select a patient first.", Severity.Info);
            return Array.Empty<ExaminationDto>();
        }

        try
        {
            var page = await ExaminationService.GetPagedAsync(value, "ScheduledAt", false, 1, 50, ct);
            return page.Items.Where(e => e.PatientId == _selectedPatient.Id);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return Array.Empty<ExaminationDto>();
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to search examinations.", Severity.Error);
            return Array.Empty<ExaminationDto>();
        }
    }

    private async Task SubmitAsync()
    {
        if (_selectedPatient is null || _selectedPolicy is null || _selectedExamination is null)
        {
            Snackbar.Add("Patient, policy and examination are required.", Severity.Error);
            return;
        }

        if (!_editContext.Validate())
            return;

        _busy = true;
        try
        {
            var input = new CreatePreAuthorizationInput
            {
                ExaminationId = _selectedExamination.Id,
                PatientId = _selectedPatient.Id,
                PolicyId = _selectedPolicy.Id,
                EstimatedAmount = _model.EstimatedAmount,
            };

            await InsuranceService.CreatePreAuthorizationAsync(input);
            Snackbar.Add("Pre-authorization requested.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server. Please try again.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelAsync()
        => MudDialog.Cancel();

    private sealed class PreAuthFormModel
    {
        [Range(0, double.MaxValue, ErrorMessage = "Estimated amount must be zero or greater.")]
        public decimal EstimatedAmount { get; set; }
    }
}