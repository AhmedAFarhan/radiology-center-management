@inject InsuranceService InsuranceService
@inject ExaminationService ExaminationService
@inject PatientService PatientService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Approval" Title="@T.PreAuthDialog.Title" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="PatientDto"
                                     @bind-Value="_selectedPatient"
                                     Label="@T.PreAuthDialog.PatientSearchLabel"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchPatientsAsync"
                                     ToStringFunc="@(p => p is null ? string.Empty : p.FullName)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="InsurancePolicyDto"
                                     @bind-Value="_selectedPolicy"
                                     Label="@T.PreAuthDialog.PolicySearchLabel"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchPoliciesAsync"
                                     ToStringFunc="@(p => p is null ? string.Empty : p.PolicyNumber)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="ExaminationDto"
                                     @bind-Value="_selectedExamination"
                                     Label="@T.PreAuthDialog.ExaminationSearchLabel"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchExaminationsAsync"
                                     ToStringFunc="@(e => e is null ? string.Empty : e.ExaminationTypeName)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.EstimatedAmount"
                                     Label="@T.PreAuthDialog.EstimatedAmount"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     For="@(() => _model.EstimatedAmount)" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.PreAuthDialog.RequestAuthorization</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

