@page "/insurance/claims"
@attribute [Authorize]
@inject InsuranceService InsuranceService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.RequestQuote" Title="@T.Claim.Title"
            Subtitle="@T.Claim.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.Claim.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Claim.CreateClaim</MudButton>
</PageHeader>

<MudTable T="ClaimListItemDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="ClaimListItemDto" SortLabel="@("PatientName")">@T.Claim.Patient</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ClaimListItemDto" SortLabel="@("ExaminationTypeName")">@T.Claim.Examination</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ClaimListItemDto" SortLabel="@("PolicyNumber")">@T.Claim.PolicyNumber</MudTableSortLabel></MudTh>
        <MudTh Class="text-right"><MudTableSortLabel T="ClaimListItemDto" SortLabel="@("BilledAmount")">@T.Claim.Billed</MudTableSortLabel></MudTh>
        <MudTh Class="text-right"><MudTableSortLabel T="ClaimListItemDto" SortLabel="@("PayerShare")">@T.Claim.PayerShare</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ClaimListItemDto" SortLabel="@("Status")">@T.Common.Status</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Claim.Patient">
            <MudText Class="font-weight-medium">@context.PatientName</MudText>
        </MudTd>
        <MudTd DataLabel="@T.Claim.Examination">@context.ExaminationTypeName</MudTd>
        <MudTd DataLabel="@T.Claim.PolicyNumber">
            <MudText Class="mono-text">@context.PolicyNumber</MudText>
        </MudTd>
        <MudTd DataLabel="@T.Claim.Billed" Class="text-right">@context.BilledAmount.ToString("C")</MudTd>
        <MudTd DataLabel="@T.Claim.PayerShare" Class="text-right">
            @if (context.Status is "Approved" or "Paid")
            {
                <MudText>@context.PayerShare.ToString("C")</MudText>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="text-secondary">-</MudText>
            }
        </MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <StatusChip Token="@context.Status">@FormatStatus(context.Status)</StatusChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Default" aria-label="@T.Claim.View" OnClick="@(() => OpenDetailDialogAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.Claim.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        <EmptyState Icon="@Icons.Material.Filled.RequestQuote"
                    Title="@T.Claim.EmptyTitle"
                    Message="@T.Claim.EmptyMessage"
                    ActionLabel="@T.Claim.EmptyActionLabel"
                    Action="OpenCreateDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>


