@page "/insurance/preauthorizations"
@attribute [Authorize]
@inject InsuranceService InsuranceService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.Approval" Title="@T.PreAuth.Title"
            Subtitle="@T.PreAuth.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.PreAuth.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.PreAuth.RequestAuthorization</MudButton>
</PageHeader>

<MudTable T="PreAuthorizationListItemDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="PreAuthorizationListItemDto" SortLabel="@("PatientName")">@T.PreAuth.Patient</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PreAuthorizationListItemDto" SortLabel="@("ExaminationTypeName")">@T.PreAuth.Examination</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PreAuthorizationListItemDto" SortLabel="@("PolicyNumber")">@T.PreAuth.PolicyNumber</MudTableSortLabel></MudTh>
        <MudTh Class="text-right"><MudTableSortLabel T="PreAuthorizationListItemDto" SortLabel="@("EstimatedAmount")">@T.PreAuth.Estimated</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PreAuthorizationListItemDto" SortLabel="@("RequestedAt")">@T.PreAuth.Requested</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.PreAuth.Patient">
            <MudText Class="font-weight-medium">@context.PatientName</MudText>
        </MudTd>
        <MudTd DataLabel="@T.PreAuth.Examination">@context.ExaminationTypeName</MudTd>
        <MudTd DataLabel="@T.PreAuth.PolicyNumber">
            <MudText Class="mono-text">@context.PolicyNumber</MudText>
        </MudTd>
        <MudTd DataLabel="@T.PreAuth.Estimated" Class="text-right">@context.EstimatedAmount.ToString("C")</MudTd>
        <MudTd DataLabel="@T.PreAuth.Requested">@context.RequestedAt.ToString("yyyy-MM-dd")</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <StatusChip Token="@context.Status">@FormatStatus(context.Status)</StatusChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Default" aria-label="@T.PreAuth.View" OnClick="@(() => OpenDetailDialogAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.PreAuth.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        <EmptyState Icon="@Icons.Material.Filled.Approval"
                    Title="@T.PreAuth.EmptyTitle"
                    Message="@T.PreAuth.EmptyMessage"
                    ActionLabel="@T.PreAuth.EmptyActionLabel"
                    Action="OpenCreateDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>

