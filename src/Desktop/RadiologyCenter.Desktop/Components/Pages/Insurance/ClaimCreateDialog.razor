@inherits EditorDialogBase
@inject InsuranceService InsuranceService
@inject ExaminationService ExaminationService
@inject PatientService PatientService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.RequestQuote" Title="@T.ClaimDialog.Title" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="PatientDto"
                                     @bind-Value="_selectedPatient"
                                     Label="@T.ClaimDialog.PatientSearchLabel"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchPatientsAsync"
                                     ToStringFunc="@(p => p is null ? string.Empty : p.FullName)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="InsurancePolicyDto"
                                     @bind-Value="_selectedPolicy"
                                     Label="@T.ClaimDialog.PolicySearchLabel"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchPoliciesAsync"
                                     ToStringFunc="@(p => p is null ? string.Empty : p.PolicyNumber)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="ExaminationDto"
                                     @bind-Value="_selectedExamination"
                                     Label="@T.ClaimDialog.ExaminationSearchLabel"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchExaminationsAsync"
                                     ToStringFunc="@(e => e is null ? string.Empty : e.ExaminationTypeName)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="PreAuthorizationDto"
                                     @bind-Value="_selectedPreAuthorization"
                                     Label="@T.ClaimDialog.PreAuthorizationLabel"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchPreAuthorizationsAsync"
                                     ToStringFunc="@(p => p is null ? string.Empty : $"{p.Status} · {p.EstimatedAmount:C}")"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.BilledAmount"
                                     Label="@T.ClaimDialog.BilledAmount"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     For="@(() => _model.BilledAmount)" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@T.ClaimDialog.CreateClaim"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>

