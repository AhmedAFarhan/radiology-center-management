@inject InsuranceService InsuranceService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.RequestQuote" Title="@T.ClaimDialog.DetailsTitle" />

        @if (_loadError is not null)
        {
            <ErrorState Title="@T.ClaimDialog.LoadErrorTitle" Message="@_loadError" Action="LoadAsync" />
        }
        else if (_claim is null)
        {
            <DialogSkeleton Rows="3" />
        }
        else
        {
            <MudGrid Spacing="2">
                <DetailField Label="@T.ClaimDialog.Patient" Value="@_patientName" />
                <DetailField Label="@T.ClaimDialog.Examination" Value="@_examinationName" />
                <DetailField Label="@T.ClaimDialog.Policy" Value="@_policyNumber" />
                <DetailField Label="@T.Common.Status" Value="@_claim.Status" />
                <DetailField Label="@T.ClaimDialog.BilledAmount" Value="@_claim.BilledAmount.ToString("C")" Xs="12" Sm="4" Md="4" />
                <DetailField Label="@T.ClaimDialog.PayerShare" Value="@_claim.PayerShare.ToString("C")" Xs="12" Sm="4" Md="4" />
                <DetailField Label="@T.ClaimDialog.PatientShare" Value="@_claim.PatientShare.ToString("C")" Xs="12" Sm="4" Md="4" />
                @if (_claim.RemainingOwed > 0)
                {
                    <DetailField Label="@T.ClaimDialog.TotalSettled" Value="@_claim.TotalSettled.ToString("C")" />
                    <DetailField Label="@T.ClaimDialog.RemainingOwed" Value="@_claim.RemainingOwed.ToString("C")" />
                }
            </MudGrid>

            @if (_claim.Status == "Draft")
            {
                <MudDivider Class="my-2" />
                <MudButton FullWidth="true" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Send" OnClick="SubmitAsync" Disabled="_busy">@T.ClaimDialog.SubmitClaim</MudButton>
            }
            else if (_claim.Status == "Submitted")
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2" Class="mb-1">@T.ClaimDialog.Adjudication</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal?"
                                         @bind-Value="_approvedAmount"
                                         Label="@T.ClaimDialog.ApprovedAmount"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_rejectionCode"
                                      Label="@T.ClaimDialog.RejectionCodeForReject"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_rejectionReason"
                                      Label="@T.ClaimDialog.RejectionReasonForReject"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="2"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudButton FullWidth="true" Color="Color.Success" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Check" OnClick="ApproveAsync" Disabled="_busy">@T.ClaimDialog.Approve</MudButton>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudButton FullWidth="true" Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="RejectAsync" Disabled="_busy">@T.ClaimDialog.Reject</MudButton>
                    </MudItem>
                </MudGrid>
            }
            else if (_claim.Status == "Rejected")
            {
                <MudDivider Class="my-2" />
                <MudButton FullWidth="true" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Refresh" OnClick="ResubmitAsync" Disabled="_busy">@T.ClaimDialog.ResubmitClaim</MudButton>
            }
            else if (_claim.Status is "Approved" or "Paid" && _claim.RemainingOwed > 0)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2" Class="mb-1">@T.ClaimDialog.RecordSettlement</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="decimal"
                                         @bind-Value="_settlementAmount"
                                         Label="@T.ClaimDialog.Amount"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string"
                                   @bind-Value="_settlementMethod"
                                   Label="@T.ClaimDialog.Method"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            @foreach (var method in SettlementMethods)
                            {
                                <MudSelectItem T="string" Value="@method">@method</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_settlementReference"
                                      Label="@T.ClaimDialog.ReferenceOptional"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudButton FullWidth="true" Color="Color.Secondary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Payments" OnClick="RecordSettlementAsync" Disabled="_busy">@T.ClaimDialog.RecordSettlement</MudButton>
                    </MudItem>
                </MudGrid>
            }

            @if (_claim.Status == "Rejected" && _claim.Rejections.Count > 0)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2" Class="mb-1">@T.ClaimDialog.Rejections</MudText>
                @foreach (var rejection in _claim.Rejections)
                {
                    <MudPaper Elevation="0" Outlined="true" Class="d-flex align-center pa-2 my-1">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Class="mx-2" />
                        <div>
                            <MudText Typo="Typo.body2">@rejection.Code</MudText>
                            <MudText Typo="Typo.caption">@rejection.Reason</MudText>
                            <MudText Typo="Typo.caption" Class="text-secondary">@rejection.RejectedAt.ToString("yyyy-MM-dd")</MudText>
                        </div>
                    </MudPaper>
                }
            }

            @if (_claim.Settlements.Count > 0)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2" Class="mb-1">@T.ClaimDialog.Settlements</MudText>
                @foreach (var settlement in _claim.Settlements)
                {
                    <MudPaper Elevation="0" Outlined="true" Class="d-flex align-center pa-2 my-1">
                        <MudIcon Icon="@Icons.Material.Filled.Payments" Class="mx-2" />
                        <div>
                            <MudText Typo="Typo.body2">@settlement.Amount.ToString("C")</MudText>
                            <MudText Typo="Typo.caption" Class="text-secondary">@settlement.Method @(!string.IsNullOrWhiteSpace(settlement.Reference) ? $"· {settlement.Reference}" : "") · @settlement.SettledAt.ToString("yyyy-MM-dd")</MudText>
                        </div>
                    </MudPaper>
                }
            }

            @if (_claim.Status == "Submitted" && _claim.Rejections.Count > 0)
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2" Class="mb-1">@T.ClaimDialog.PriorRejections</MudText>
                @foreach (var rejection in _claim.Rejections)
                {
                    <MudPaper Elevation="0" Outlined="true" Class="d-flex align-center pa-2 my-1">
                        <div>
                            <MudText Typo="Typo.body2">@rejection.Code</MudText>
                            <MudText Typo="Typo.caption">@rejection.Reason</MudText>
                            <MudText Typo="Typo.caption" Class="text-secondary">@rejection.RejectedAt.ToString("yyyy-MM-dd")</MudText>
                        </div>
                    </MudPaper>
                }
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync">@T.Common.Close</MudButton>
    </DialogActions>
</MudDialog>

