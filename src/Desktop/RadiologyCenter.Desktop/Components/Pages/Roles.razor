@page "/roles"
@attribute [Authorize]
@inject IdentityService IdentityService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.Security" Title="@T.Roles.Title"
            Subtitle="@T.Roles.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.Roles.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Roles.NewRole</MudButton>
</PageHeader>

<MudTable T="RoleDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="RoleDto" SortLabel="@("Name")">@T.Common.Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="RoleDto" SortLabel="@("Description")">@T.Roles.Description</MudTableSortLabel></MudTh>
        <MudTh>@T.Roles.Permissions</MudTh>
        <MudTh><MudTableSortLabel T="RoleDto" SortLabel="@("CreatedAt")">@T.Roles.Created</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Common.Name">
            <MudText Class="font-weight-medium">@context.Name</MudText>
            @if (context.IsSystem)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@T.Roles.System</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="@T.Roles.Description">@(string.IsNullOrWhiteSpace(context.Description) ? "-" : context.Description)</MudTd>
        <MudTd DataLabel="@T.Roles.Permissions">
            <MudChip T="string" Size="Size.Small" Color="@(context.Permissions.Count == 0 ? Color.Default : Color.Success)">@(T.FormatValue(T.Roles.PermissionCount, context.Permissions.Count))</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Roles.Created">@context.CreatedAt.ToString("g")</MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Roles.EditRole" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Key" Size="Size.Small" Color="Color.Info" aria-label="@T.Roles.ManagePermissions" OnClick="@(() => OpenPermissionsDialogAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.Roles.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        <EmptyState Icon="@Icons.Material.Filled.Security"
                    Title="@T.Roles.EmptyTitle"
                    Message="@T.Roles.EmptyMessage"
                    ActionLabel="@T.Roles.EmptyAction"
                    Action="OpenCreateDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<RoleDto>? _table;
    private string? _search;
    private CancellationTokenSource? _searchCts;
    private string? _loadError;
    private bool _offline;

    private async Task<TableData<RoleDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        try
        {
            var page = await IdentityService.GetRolesPagedAsync(
                _search,
                state.SortLabel,
                state.SortDirection == SortDirection.Descending,
                state.Page + 1,
                state.PageSize,
                ct);

            _loadError = null;
            _offline = false;
            return new TableData<RoleDto> { Items = page.Items, TotalItems = page.TotalCount };
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _loadError = ex.Message;
            _offline = false;
            return new TableData<RoleDto> { Items = Array.Empty<RoleDto>(), TotalItems = 0 };
        }
        catch (Exception)
        {
            Snackbar.Add(T.Roles.Unreachable, Severity.Error);
            _loadError = T.Roles.Unreachable;
            _offline = true;
            return new TableData<RoleDto> { Items = Array.Empty<RoleDto>(), TotalItems = 0 };
        }
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value;

        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (_table is not null)
            await _table.ReloadServerData();
    }

    private Task ReloadAsync()
        => _table is null ? Task.CompletedTask : _table.ReloadServerData();

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<RoleEditorDialog>(T.RoleDialog.NewRole, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenEditDialogAsync(RoleDto role)
    {
        var parameters = new DialogParameters { ["Role"] = role };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<RoleEditorDialog>(T.FormatValue(T.Roles.EditTitle, role.Name), parameters, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenPermissionsDialogAsync(RoleDto role)
    {
        var parameters = new DialogParameters { ["Role"] = role };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<RolePermissionsDialog>(T.FormatValue(T.RoleDialog.PermissionsTitle, role.Name), parameters, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task ReloadIfSavedAsync(IDialogReference dialog)
    {
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadAsync();
    }

    public void Dispose() => _searchCts?.Cancel();
}
