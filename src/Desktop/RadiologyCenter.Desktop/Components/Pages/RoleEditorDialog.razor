@inject IdentityService IdentityService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Security" Title="@(Role is null ? "New Role" : "Edit Role")" />
        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="_model.Name"
                          Label="Role Name"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Class="mb-3"
                          For="@(() => _model.Name)" />
            <MudTextField @bind-Value="_model.Description"
                          Label="Description"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="3"
                          Immediate="true"
                          For="@(() => _model.Description)" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@(IsEdit ? "Save Changes" : "Create Role")</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public RoleDto? Role { get; set; }

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly RoleFormModel _model = new();
    private EditContext _editContext = default!;
    private bool _busy;

    private bool IsEdit => Role is not null;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);

        if (Role is null)
            return;

        _model.Name = Role.Name;
        _model.Description = Role.Description;
    }

    private async Task SubmitAsync()
    {
        if (!_editContext.Validate())
            return;

        _busy = true;
        try
        {
            if (IsEdit)
            {
                await IdentityService.UpdateRoleAsync(Role!.Id, new UpdateRoleInput
                {
                    Name = _model.Name,
                    Description = _model.Description,
                });
                Snackbar.Add("Role updated.", Severity.Success);
            }
            else
            {
                await IdentityService.CreateRoleAsync(new CreateRoleInput
                {
                    Name = _model.Name,
                    Description = _model.Description,
                });
                Snackbar.Add("Role created.", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server. Please try again.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelAsync()
        => MudDialog.Cancel();

    private sealed class RoleFormModel
    {
        [Required(ErrorMessage = "Role name is required.")]
        [MaxLength(256, ErrorMessage = "Role name must be 256 characters or fewer.")]
        public string Name { get; set; } = string.Empty;

        [MaxLength(500, ErrorMessage = "Description must be 500 characters or fewer.")]
        public string? Description { get; set; }
    }
}
