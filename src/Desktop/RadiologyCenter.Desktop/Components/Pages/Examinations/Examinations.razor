@page "/examinations"
@attribute [Authorize]
@inject ExaminationService ExaminationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@inject NavigationManager NavigationManager
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.MedicalServices" Title="@T.Examinations.Title"
            Subtitle="@T.Examinations.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchValue="@SearchQuery"
            SearchPlaceholder="@T.Examinations.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Examinations.AddType</MudButton>
</PageHeader>

<MudTable T="ExaminationTypeDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="ExaminationTypeDto" SortLabel="@("Code")">@T.Examinations.Code</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ExaminationTypeDto" SortLabel="@("Name")">@T.Common.Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ExaminationTypeDto" SortLabel="@("Modality")">@T.Examinations.Modality</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ExaminationTypeDto" SortLabel="@("BodyPart")">@T.Examinations.BodyPart</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ExaminationTypeDto" SortLabel="@("StandardDurationMinutes")">@T.Examinations.Duration</MudTableSortLabel></MudTh>
        <MudTh Class="text-right"><MudTableSortLabel T="ExaminationTypeDto" SortLabel="@("Price")">@T.Examinations.Price</MudTableSortLabel></MudTh>
        <MudTh>@T.Examinations.Requirements</MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Examinations.Code" Class="mono-text">@context.Code</MudTd>
        <MudTd DataLabel="@T.Common.Name">
            <MudText Class="font-weight-medium">@context.Name</MudText>
            <MudText Typo="Typo.caption" Class="text-secondary">@(T.FormatValue(T.Examinations.ItemCount, context.Items?.Count ?? 0))</MudText>
        </MudTd>
        <MudTd DataLabel="@T.Examinations.Modality">@context.Modality</MudTd>
        <MudTd DataLabel="@T.Examinations.BodyPart">@context.BodyPart</MudTd>
        <MudTd DataLabel="@T.Examinations.Duration">@(context.StandardDurationMinutes == 0 ? "-" : T.FormatValue(T.Examinations.Minutes, context.StandardDurationMinutes))</MudTd>
        <MudTd DataLabel="@T.Examinations.Price" Class="text-right">@context.Price.ToString("C")</MudTd>
        <MudTd DataLabel="@T.Examinations.Requirements">
            @if (context.RequiresPreparation)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Class="me-1">@T.Examinations.Prep</MudChip>
            }
            @if (context.RequiresConsent)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="me-1">@T.Examinations.Consent</MudChip>
            }
            @if (context.RequiresContrast)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">@T.Examinations.Contrast</MudChip>
            }
            @if (!context.RequiresPreparation && !context.RequiresConsent && !context.RequiresContrast)
            {
                <MudText Typo="Typo.caption" Class="text-secondary">@T.Common.None</MudText>
            }
        </MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? T.Common.Active : T.Common.Inactive)</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Common.Edit" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                           Size="Size.Small"
                           Color="@(context.IsActive ? Color.Default : Color.Success)"
                           aria-label="@T.Examinations.ToggleStatus"
                           OnClick="@(() => ToggleActiveAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Delete" OnClick="@(() => DeleteTypeAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.Examinations.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        <EmptyState Icon="@Icons.Material.Filled.MedicalServices"
                    Title="@T.Examinations.EmptyTitle"
                    Message="@T.Examinations.EmptyMessage"
                    ActionLabel="@T.Examinations.EmptyAction"
                    Action="OpenCreateDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>


