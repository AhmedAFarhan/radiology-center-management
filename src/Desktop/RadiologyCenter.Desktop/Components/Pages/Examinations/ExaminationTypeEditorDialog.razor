@inject ExaminationService ExaminationService
@inject InventoryService InventoryService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.MedicalServices" Title="@(Type is null ? T.ExamDialog.NewTitle : T.ExamDialog.EditTitle)" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_model.Code"
                                  Label="@T.ExamDialog.Code"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Code)" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_model.Name"
                                  Label="@T.Common.Name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Name)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.Modality"
                               Label="@T.ExamDialog.Modality"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.Modality)">
                        @foreach (var modality in Modalities)
                        {
                            <MudSelectItem T="string" Value="@modality">@modality</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.BodyPart"
                                  Label="@T.ExamDialog.BodyPart"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.BodyPart)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="int"
                                     @bind-Value="_model.StandardDurationMinutes"
                                     Label="@T.ExamDialog.StandardDuration"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     For="@(() => _model.StandardDurationMinutes)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.Price"
                                     Label="@T.ExamDialog.Price"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     For="@(() => _model.Price)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool" @bind-Value="_model.RequiresPreparation" Color="Color.Info">@T.ExamDialog.RequiresPreparation</MudSwitch>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool" @bind-Value="_model.RequiresConsent" Color="Color.Warning">@T.ExamDialog.RequiresConsent</MudSwitch>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-3" />
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.subtitle2">@T.ExamDialog.ItemsTitle</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddItem" Size="Size.Small">@T.ExamDialog.AddItem</MudButton>
            </div>

            @foreach (var item in _model.Items)
            {
                <MudGrid Spacing="2" Class="align-center mb-2">
                    <MudItem xs="12" sm="5">
                        <MudSelect T="string"
                                   @bind-Value="item.ItemId"
                                   Label="@T.ExamDialog.InventoryItem"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            @foreach (var invItem in _inventoryItems)
                            {
                                <MudSelectItem T="string" Value="@invItem.Id">@invItem.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudNumericField T="int"
                                         @bind-Value="item.Quantity"
                                         Label="@T.ExamDialog.Qty"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="1" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSwitch T="bool" @bind-Value="item.IsContrast" Color="Color.Secondary" Class="me-3">@T.ExamDialog.Contrast</MudSwitch>
                        <MudSwitch T="bool" @bind-Value="item.IsRequired" Color="Color.Primary">@T.ExamDialog.Required</MudSwitch>
                    </MudItem>
                    <MudItem xs="12" sm="1">
                        <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       aria-label="@T.ExamDialog.RemoveItem"
                                       OnClick="@(() => RemoveItem(item))" />
                    </MudItem>
                </MudGrid>
            }
            @if (_model.Items.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="text-secondary">@T.ExamDialog.NoItems</MudText>
            }
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@(IsEdit ? T.ExamDialog.SaveChanges : T.ExamDialog.CreateType)</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>


