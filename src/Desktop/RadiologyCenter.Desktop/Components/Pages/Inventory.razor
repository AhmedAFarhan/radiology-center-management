@page "/inventory/items"
@attribute [Authorize]
@inject InventoryService InventoryService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.Inventory2" Title="@T.Inventory.Title"
            Subtitle="@T.Inventory.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.Inventory.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Inventory.AddItem</MudButton>
</PageHeader>

<MudTable T="ItemDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="ItemDto" SortLabel="@("Name")">@T.Common.Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ItemDto" SortLabel="@("Category")">@T.Inventory.Category</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ItemDto" SortLabel="@("Unit")">@T.Inventory.Unit</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ItemDto" SortLabel="@("ReorderLevel")">@T.Inventory.ReorderLevel</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ItemDto" SortLabel="@("ReorderQuantity")">@T.Inventory.ReorderQty</MudTableSortLabel></MudTh>
        <MudTh>@T.Inventory.LotTracked</MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Common.Name">
            <MudText Class="font-weight-medium">@context.Name</MudText>
            @if (!string.IsNullOrWhiteSpace(context.Brand))
            {
                <MudText Typo="Typo.caption" Class="text-secondary">@context.Brand</MudText>
            }
        </MudTd>
        <MudTd DataLabel="@T.Inventory.Category">@FormatCategory(context.Category)</MudTd>
        <MudTd DataLabel="@T.Inventory.Unit">@context.Unit</MudTd>
        <MudTd DataLabel="@T.Inventory.ReorderLevel">@context.ReorderLevel</MudTd>
        <MudTd DataLabel="@T.Inventory.ReorderQty">@context.ReorderQuantity</MudTd>
        <MudTd DataLabel="@T.Inventory.LotTracked">
            <MudChip T="string" Size="Size.Small" Color="@(context.LotTracked ? Color.Primary : Color.Default)">@(context.LotTracked ? T.Common.Yes : T.Common.No)</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? T.Common.Active : T.Common.Inactive)</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Common.Edit" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Color="Color.Info" aria-label="@T.Inventory.Stock" OnClick="@(() => OpenStockDialogAsync(context))" />
            <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                           Size="Size.Small"
                           Color="@(context.IsActive ? Color.Default : Color.Success)"
                           aria-label="@T.Inventory.ToggleStatus"
                           OnClick="@(() => ToggleActiveAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Delete" OnClick="@(() => DeleteItemAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.Inventory.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        <EmptyState Icon="@Icons.Material.Filled.Inventory2"
                    Title="@T.Inventory.NoItemsTitle"
                    Message="@T.Inventory.EmptyMessage"
                    ActionLabel="@T.Inventory.AddFirstItem"
                    Action="OpenCreateDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<ItemDto>? _table;
    private string? _search;
    private CancellationTokenSource? _searchCts;
    private string? _loadError;
    private bool _offline;

    private async Task<TableData<ItemDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        try
        {
            var page = await InventoryService.GetItemsPagedAsync(
                _search,
                state.SortLabel,
                state.SortDirection == SortDirection.Descending,
                state.Page + 1,
                state.PageSize,
                ct);

            _loadError = null;
            _offline = false;
            return new TableData<ItemDto> { Items = page.Items, TotalItems = page.TotalCount };
        }
        catch (OperationCanceledException)
        {
            if (ct.IsCancellationRequested)
                return new TableData<ItemDto> { Items = Array.Empty<ItemDto>(), TotalItems = 0 };
            throw;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _loadError = ex.Message;
            _offline = false;
            return new TableData<ItemDto> { Items = Array.Empty<ItemDto>(), TotalItems = 0 };
        }
        catch (Exception)
        {
            Snackbar.Add(T.Inventory.Unreachable, Severity.Error);
            _loadError = T.Inventory.Unreachable;
            _offline = true;
            return new TableData<ItemDto> { Items = Array.Empty<ItemDto>(), TotalItems = 0 };
        }
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value;

        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (_table is not null)
            await _table.ReloadServerData();
    }

    private Task ReloadAsync()
        => _table is null ? Task.CompletedTask : _table.ReloadServerData();

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<ItemEditorDialog>(T.ItemDialog.NewItem, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenEditDialogAsync(ItemDto item)
    {
        var parameters = new DialogParameters { ["Item"] = item };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<ItemEditorDialog>(T.ItemDialog.EditItem, parameters, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenStockDialogAsync(ItemDto item)
    {
        var parameters = new DialogParameters
        {
            ["ItemId"] = item.Id,
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true };
        await DialogService.ShowAsync<ItemStockDialog>(item.Name, parameters, options);
    }

    private async Task ReloadIfSavedAsync(IDialogReference dialog)
    {
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task ToggleActiveAsync(ItemDto item)
    {
        try
        {
            if (item.IsActive)
                await InventoryService.DeactivateItemAsync(item.Id);
            else
                await InventoryService.ActivateItemAsync(item.Id);

            Snackbar.Add(item.IsActive ? T.Inventory.ItemDeactivated : T.Inventory.ItemActivated, Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add(T.Inventory.Unreachable, Severity.Error);
        }
    }

    private async Task DeleteItemAsync(ItemDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            T.Inventory.DeleteItemTitle,
            T.FormatValue(T.Inventory.DeleteConfirm, item.Name),
            T.Common.Delete,
            T.Common.Cancel);

        if (confirmed != true)
            return;

        try
        {
            await InventoryService.DeleteItemAsync(item.Id);
            Snackbar.Add(T.Inventory.ItemDeleted, Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add(T.Inventory.Unreachable, Severity.Error);
        }
    }

    private static string FormatCategory(string category) => category switch
    {
        "ContrastMedia" => "Contrast Media",
        "MedicalSupply" => "Medical Supply",
        _ => category,
    };

    public void Dispose() => _searchCts?.Cancel();
}
