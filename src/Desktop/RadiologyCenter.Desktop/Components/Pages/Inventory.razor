@page "/inventory"
@attribute [Authorize]
@inject InventoryService InventoryService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<MudToolBar Dense="true" Class="mb-4">
    <MudText Typo="Typo.h5">Inventory</MudText>
    <MudText Typo="Typo.body2" Class="text-secondary ms-2">Manage items and stock</MudText>
    <MudSpacer />
    <MudTextField T="string"
                  Value="_search"
                  ValueChanged="OnSearchChanged"
                  Placeholder="Search items..."
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Immediate="true"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="search-field" />
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" aria-label="Refresh" OnClick="ReloadAsync" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">Add Item</MudButton>
</MudToolBar>

<MudTable T="ItemDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="ItemDto" SortLabel="@("Name")">Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ItemDto" SortLabel="@("Category")">Category</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ItemDto" SortLabel="@("Unit")">Unit</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ItemDto" SortLabel="@("ReorderLevel")">Reorder Level</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ItemDto" SortLabel="@("ReorderQuantity")">Reorder Qty</MudTableSortLabel></MudTh>
        <MudTh>Lot Tracked</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">
            <MudText Class="font-weight-medium">@context.Name</MudText>
            @if (!string.IsNullOrWhiteSpace(context.Brand))
            {
                <MudText Typo="Typo.caption" Class="text-secondary">@context.Brand</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Category">@FormatCategory(context.Category)</MudTd>
        <MudTd DataLabel="Unit">@context.Unit</MudTd>
        <MudTd DataLabel="Reorder Level">@context.ReorderLevel</MudTd>
        <MudTd DataLabel="Reorder Qty">@context.ReorderQuantity</MudTd>
        <MudTd DataLabel="Lot Tracked">
            <MudChip T="string" Size="Size.Small" Color="@(context.LotTracked ? Color.Primary : Color.Default)">@(context.LotTracked ? "Yes" : "No")</MudChip>
        </MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Active" : "Inactive")</MudChip>
        </MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="Edit" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Color="Color.Info" aria-label="Stock" OnClick="@(() => OpenStockDialogAsync(context))" />
            <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                           Size="Size.Small"
                           Color="@(context.IsActive ? Color.Default : Color.Success)"
                           aria-label="Toggle status"
                           OnClick="@(() => ToggleActiveAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Delete" OnClick="@(() => DeleteItemAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-4">No items found.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<ItemDto>? _table;
    private string? _search;
    private CancellationTokenSource? _searchCts;

    private async Task<TableData<ItemDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        try
        {
            var page = await InventoryService.GetItemsPagedAsync(
                _search,
                state.SortLabel,
                state.SortDirection == SortDirection.Descending,
                state.Page + 1,
                state.PageSize,
                ct);

            return new TableData<ItemDto> { Items = page.Items, TotalItems = page.TotalCount };
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return new TableData<ItemDto> { Items = Array.Empty<ItemDto>(), TotalItems = 0 };
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
            return new TableData<ItemDto> { Items = Array.Empty<ItemDto>(), TotalItems = 0 };
        }
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value;

        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (_table is not null)
            await _table.ReloadServerData();
    }

    private Task ReloadAsync()
        => _table is null ? Task.CompletedTask : _table.ReloadServerData();

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ItemEditorDialog>("New Item", options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenEditDialogAsync(ItemDto item)
    {
        var parameters = new DialogParameters { ["Item"] = item };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ItemEditorDialog>("Edit Item", parameters, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenStockDialogAsync(ItemDto item)
    {
        var parameters = new DialogParameters
        {
            ["ItemId"] = item.Id,
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<ItemStockDialog>(item.Name, parameters, options);
    }

    private async Task ReloadIfSavedAsync(IDialogReference dialog)
    {
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task ToggleActiveAsync(ItemDto item)
    {
        try
        {
            if (item.IsActive)
                await InventoryService.DeactivateItemAsync(item.Id);
            else
                await InventoryService.ActivateItemAsync(item.Id);

            Snackbar.Add(item.IsActive ? "Item deactivated." : "Item activated.", Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
        }
    }

    private async Task DeleteItemAsync(ItemDto item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Item",
            $"Are you sure you want to delete {item.Name}? This cannot be undone.",
            "Delete",
            "Cancel");

        if (confirmed != true)
            return;

        try
        {
            await InventoryService.DeleteItemAsync(item.Id);
            Snackbar.Add("Item deleted.", Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
        }
    }

    private static string FormatCategory(string category) => category switch
    {
        "ContrastMedia" => "Contrast Media",
        "MedicalSupply" => "Medical Supply",
        _ => category,
    };

    public void Dispose() => _searchCts?.Cancel();
}
