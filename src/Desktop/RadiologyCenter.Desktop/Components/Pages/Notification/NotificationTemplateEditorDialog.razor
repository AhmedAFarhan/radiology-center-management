@inject NotificationService NotificationService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Article" Title="@(Template is null ? T.TemplateDialog.NewTitle : T.FormatValue(T.TemplateDialog.EditTitle, Template.Name))" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="5">
                    <MudTextField @bind-Value="_model.Code"
                                  Label="@T.TemplateDialog.Code"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Disabled="_isEdit"
                                  HelperText="@T.TemplateDialog.CodeHelper"
                                  For="@(() => _model.Code)" />
                </MudItem>
                <MudItem xs="12" sm="7">
                    <MudTextField @bind-Value="_model.Name"
                                  Label="@T.Common.Name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Name)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Subject"
                                  Label="@T.TemplateDialog.Subject"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  HelperText="@T.TemplateDialog.SubjectHelper"
                                  For="@(() => _model.Subject)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Body"
                                  Label="@T.TemplateDialog.Body"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Lines="5"
                                  Multiline="true"
                                  HelperText="@T.TemplateDialog.BodyHelper"
                                  For="@(() => _model.Body)" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@(_isEdit ? T.TemplateDialog.SaveChanges : T.TemplateDialog.CreateTemplate)</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public NotificationTemplateDto? Template { get; set; }

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly NotificationTemplateFormModel _model = new();
    private EditContext _editContext = default!;
    private bool _busy;
    private bool _isEdit;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
        _isEdit = Template is not null;

        if (Template is null)
            return;

        _model.Code = Template.Code;
        _model.Name = Template.Name;
        _model.Subject = Template.Subject;
        _model.Body = Template.Body;
    }

    private async Task SubmitAsync()
    {
        if (!_editContext.Validate())
            return;

        _busy = true;
        try
        {
            var input = new NotificationTemplateInput
            {
                Code = _model.Code.Trim(),
                Name = _model.Name.Trim(),
                Subject = (_model.Subject ?? string.Empty).Trim(),
                Body = _model.Body.Trim(),
            };

            if (_isEdit)
                await NotificationService.UpdateTemplateAsync(Template!.Id, input);
            else
                await NotificationService.CreateTemplateAsync(input);

            Snackbar.Add(_isEdit ? T.TemplateDialog.Updated : T.TemplateDialog.Created, Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add(T.TemplateDialog.Unreachable, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelAsync()
        => MudDialog.Cancel();

    private sealed class NotificationTemplateFormModel
    {
        [Required(ErrorMessage = "Code is required.")]
        [MaxLength(100, ErrorMessage = "Code must be 100 characters or fewer.")]
        public string Code { get; set; } = string.Empty;

        [Required(ErrorMessage = "Name is required.")]
        [MaxLength(200, ErrorMessage = "Name must be 200 characters or fewer.")]
        public string Name { get; set; } = string.Empty;

        [MaxLength(400, ErrorMessage = "Subject must be 400 characters or fewer.")]
        public string? Subject { get; set; }

        [Required(ErrorMessage = "Body is required.")]
        public string Body { get; set; } = string.Empty;
    }
}