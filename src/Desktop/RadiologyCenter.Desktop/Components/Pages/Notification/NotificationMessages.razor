@page "/notifications/messages"
@attribute [Authorize]
@inject NotificationService NotificationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.Notifications" Title="@T.Notifications.MessagesTitle"
            Subtitle="@T.Notifications.MessagesSubtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.Notifications.MessagesSearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudSelect T="string" Value="_channel" ValueChanged="OnChannelChangedAsync" Label="@T.Notifications.Channel"
               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="status-filter ms-2">
        <MudSelectItem Value="@(string.Empty)">@T.Common.All</MudSelectItem>
        <MudSelectItem Value="@("Sms")">SMS</MudSelectItem>
        <MudSelectItem Value="@("Email")">Email</MudSelectItem>
        <MudSelectItem Value="@("Push")">Push</MudSelectItem>
    </MudSelect>
    <MudSelect T="string" Value="_status" ValueChanged="OnStatusChangedAsync" Label="@T.Common.Status"
               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="status-filter ms-2">
        <MudSelectItem Value="@(string.Empty)">@T.Common.All</MudSelectItem>
        <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
        <MudSelectItem Value="@("Sent")">Sent</MudSelectItem>
        <MudSelectItem Value="@("Failed")">Failed</MudSelectItem>
    </MudSelect>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" OnClick="OpenSendDialogAsync">@T.SendDialog.Title</MudButton>
</PageHeader>

<MudTable T="NotificationMessageDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="NotificationMessageDto" SortLabel="@("CreatedAt")">@T.Notifications.SentAt</MudTableSortLabel></MudTh>
        <MudTh>@T.Notifications.Channel</MudTh>
        <MudTh>@T.Notifications.Recipient</MudTh>
        <MudTh>@T.Notifications.Subject</MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh><MudTableSortLabel T="NotificationMessageDto" SortLabel="@("Attempts")">@T.Notifications.Attempts</MudTableSortLabel></MudTh>
        <MudTh>@T.Notifications.Reference</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Notifications.SentAt">@context.CreatedAt.ToLocalTime().ToString("g")</MudTd>
        <MudTd DataLabel="@T.Notifications.Channel">
            <MudChip T="string" Size="Size.Small" Color="@ChannelColor(context.Channel)" Variant="Variant.Outlined">@context.Channel</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Notifications.Recipient">
            <MudText Class="font-weight-medium">@context.Recipient</MudText>
        </MudTd>
        <MudTd DataLabel="@T.Notifications.Subject">@(string.IsNullOrWhiteSpace(context.Subject) ? "-" : Truncate(context.Subject))</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@context.Status</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Notifications.Attempts" Class="text-center">@context.Attempts</MudTd>
        <MudTd DataLabel="@T.Notifications.Reference">@(string.IsNullOrWhiteSpace(context.ReferenceId) ? "-" : context.ReferenceId)</MudTd>
        <MudTd DataLabel="@T.Common.Actions" Class="text-center">
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Default" aria-label="@T.Notifications.View" OnClick="@(() => OpenDetailAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.Notifications.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
            <EmptyState Icon="@Icons.Material.Filled.Notifications"
                        Title="@T.Notifications.MessagesEmptyTitle"
                        Message="@T.Notifications.MessagesEmptyMessage"
                        ActionLabel="@T.Notifications.MessagesEmptyActionLabel"
                        Action="OpenSendDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<NotificationMessageDto>? _table;
    private string? _search;
    private string _channel = string.Empty;
    private string _status = string.Empty;
    private CancellationTokenSource? _searchCts;
    private string? _loadError;
    private bool _offline;

    private async Task<TableData<NotificationMessageDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        try
        {
            var page = await NotificationService.GetMessagesPagedAsync(
                _search,
                state.SortLabel,
                state.SortDirection == SortDirection.Descending,
                state.Page + 1,
                state.PageSize,
                string.IsNullOrWhiteSpace(_channel) ? null : _channel,
                string.IsNullOrWhiteSpace(_status) ? null : _status,
                ct);

            _loadError = null;
            _offline = false;
            return new TableData<NotificationMessageDto> { Items = page.Items, TotalItems = page.TotalCount };
        }
        catch (OperationCanceledException)
        {
            if (ct.IsCancellationRequested)
                return new TableData<NotificationMessageDto> { Items = Array.Empty<NotificationMessageDto>(), TotalItems = 0 };
            throw;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _loadError = ex.Message;
            _offline = false;
            return new TableData<NotificationMessageDto> { Items = Array.Empty<NotificationMessageDto>(), TotalItems = 0 };
        }
        catch (Exception)
        {
            Snackbar.Add(T.Notifications.Unreachable, Severity.Error);
            _loadError = T.Notifications.Unreachable;
            _offline = true;
            return new TableData<NotificationMessageDto> { Items = Array.Empty<NotificationMessageDto>(), TotalItems = 0 };
        }
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value;

        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (_table is not null)
            await _table.ReloadServerData();
    }

    private async Task OnChannelChangedAsync(string value)
    {
        _channel = value;
        await ReloadAsync();
    }

    private async Task OnStatusChangedAsync(string value)
    {
        _status = value;
        await ReloadAsync();
    }

    private Task ReloadAsync()
        => _table is null ? Task.CompletedTask : _table.ReloadServerData();

    private async Task OpenSendDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true };
        var dialog = await DialogService.ShowAsync<SendNotificationDialog>(T.SendDialog.Title, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenDetailAsync(NotificationMessageDto message)
    {
        var parameters = new DialogParameters { ["Message"] = message };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, NoHeader = true };
        await DialogService.ShowAsync<NotificationMessageDetailDialog>(T.MessageDialog.Title, parameters, options);
    }

    private async Task ReloadIfSavedAsync(IDialogReference dialog)
    {
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadAsync();
    }

    private static Color ChannelColor(string channel) => channel switch
    {
        "Sms" => Color.Info,
        "Email" => Color.Warning,
        "Push" => Color.Secondary,
        _ => Color.Default,
    };

    private static Color StatusColor(string status) => status switch
    {
        "Sent" => Color.Success,
        "Failed" => Color.Error,
        "Pending" => Color.Warning,
        _ => Color.Default,
    };

    private static string Truncate(string value)
        => value.Length > 55 ? value[..55] + "…" : value;

    public void Dispose() => _searchCts?.Cancel();
}