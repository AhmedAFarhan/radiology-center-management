@page "/notifications/messages"
@attribute [Authorize]
@inject NotificationService NotificationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.Notifications" Title="@T.Notifications.MessagesTitle"
            Subtitle="@T.Notifications.MessagesSubtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.Notifications.MessagesSearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudSelect T="string" Value="_channel" ValueChanged="OnChannelChangedAsync" Label="@T.Notifications.Channel"
               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="status-filter ms-2">
        <MudSelectItem Value="@(string.Empty)">@T.Common.All</MudSelectItem>
        <MudSelectItem Value="@("Sms")">SMS</MudSelectItem>
        <MudSelectItem Value="@("Email")">Email</MudSelectItem>
        <MudSelectItem Value="@("Push")">Push</MudSelectItem>
    </MudSelect>
    <MudSelect T="string" Value="_status" ValueChanged="OnStatusChangedAsync" Label="@T.Common.Status"
               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="status-filter ms-2">
        <MudSelectItem Value="@(string.Empty)">@T.Common.All</MudSelectItem>
        <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
        <MudSelectItem Value="@("Sent")">Sent</MudSelectItem>
        <MudSelectItem Value="@("Failed")">Failed</MudSelectItem>
    </MudSelect>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" OnClick="OpenSendDialogAsync">@T.SendDialog.Title</MudButton>
</PageHeader>

<MudTable T="NotificationMessageDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="NotificationMessageDto" SortLabel="@("CreatedAt")">@T.Notifications.SentAt</MudTableSortLabel></MudTh>
        <MudTh>@T.Notifications.Channel</MudTh>
        <MudTh>@T.Notifications.Recipient</MudTh>
        <MudTh>@T.Notifications.Subject</MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh><MudTableSortLabel T="NotificationMessageDto" SortLabel="@("Attempts")">@T.Notifications.Attempts</MudTableSortLabel></MudTh>
        <MudTh>@T.Notifications.Reference</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Notifications.SentAt">@context.CreatedAt.ToLocalTime().ToString("g")</MudTd>
        <MudTd DataLabel="@T.Notifications.Channel">
            <MudChip T="string" Size="Size.Small" Color="@ChannelColor(context.Channel)" Variant="Variant.Outlined">@context.Channel</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Notifications.Recipient">
            <MudText Class="font-weight-medium">@context.Recipient</MudText>
        </MudTd>
        <MudTd DataLabel="@T.Notifications.Subject">@(string.IsNullOrWhiteSpace(context.Subject) ? "-" : Truncate(context.Subject))</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <StatusChip Token="@context.Status">@context.Status</StatusChip>
        </MudTd>
        <MudTd DataLabel="@T.Notifications.Attempts" Class="text-center">@context.Attempts</MudTd>
        <MudTd DataLabel="@T.Notifications.Reference">@(string.IsNullOrWhiteSpace(context.ReferenceId) ? "-" : context.ReferenceId)</MudTd>
        <MudTd DataLabel="@T.Common.Actions" Class="text-center">
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Default" aria-label="@T.Notifications.View" OnClick="@(() => OpenDetailAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.Notifications.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
            <EmptyState Icon="@Icons.Material.Filled.Notifications"
                        Title="@T.Notifications.MessagesEmptyTitle"
                        Message="@T.Notifications.MessagesEmptyMessage"
                        ActionLabel="@T.Notifications.MessagesEmptyActionLabel"
                        Action="OpenSendDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>

