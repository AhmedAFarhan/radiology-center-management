@inject NotificationService NotificationService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Send" Title="@T.SendDialog.Title" />
        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="mb-3">
            @T.SendDialog.LogOnlyAlert
        </MudAlert>
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Recipient"
                                  Label="@T.SendDialog.RecipientLabel"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Recipient)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Value="_model.Channel"
                               ValueChanged="OnChannelChangedAsync"
                               Label="@T.SendDialog.Channel"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.Channel)">
                        <MudSelectItem T="string" Value="@("Sms")">SMS</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Email")">Email</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Push")">Push</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="string"
                               Value="_model.TemplateCode"
                               ValueChanged="OnTemplateCodeChangedAsync"
                               Label="@T.SendDialog.Template"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               HelperText="@T.SendDialog.TemplateHelper">
                        <MudSelectItem T="string" Value="@(string.Empty)">@T.SendDialog.NoTemplate</MudSelectItem>
                        @foreach (var template in _templates)
                        {
                            <MudSelectItem T="string" Value="@template.Code">@template.Code - @template.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Subject"
                                  Label="@T.SendDialog.Subject"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Body"
                                  Label="@T.SendDialog.Body"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Lines="4"
                                  Multiline="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.ReferenceId"
                                  Label="@T.SendDialog.ReferenceOptional"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Placeholders"
                                  Label="@T.SendDialog.PlaceholdersLabel"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true" />
                </MudItem>
            </MudGrid>
        </EditForm>

        @if (_preview is not null)
        {
            <MudPaper Elevation="1" Class="mt-3 pa-3">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-1">@T.SendDialog.Preview</MudText>
                <MudText Typo="Typo.caption" Class="mb-1">@(T.FormatValue(T.SendDialog.PreviewSubject, _preview.Subject))</MudText>
                <MudText>@_preview.Body</MudText>
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="PreviewAsync" Disabled="_busy" StartIcon="@Icons.Material.Filled.Preview">
            @T.SendDialog.Preview
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy" StartIcon="@Icons.Material.Filled.Send">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.SendDialog.Send</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

