@inject IdentityService IdentityService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Security" Title="@(T.FormatValue(T.UserDialog.RolesTitle, User.UserName))" />
        <MudText Typo="Typo.body2" Class="text-secondary mb-3">
            @(T.FormatValue(T.UserDialog.RolesDescription, User.UserName))
        </MudText>
        @if (_loadError is not null)
        {
            <ErrorState Title="@T.UserDialog.LoadRolesErrorTitle" Message="@_loadError" />
        }
        else if (_roles.Count == 0)
        {
            <DialogSkeleton Rows="4" />
        }
        else
        {
            <MudList T="RoleDto" Dense="true">
                @foreach (var role in _roles)
                {
                    <MudListItem T="RoleDto" Value="@role">
                        <MudSwitch T="bool"
                                   @bind-Value="_selected[role.Id]"
                                   Color="Color.Primary">
                            <MudText>@role.Name</MudText>
                            @if (role.IsSystem)
                            {
                                <MudText Typo="Typo.caption" Class="text-secondary">@T.UserDialog.SystemRole</MudText>
                            }
                        </MudSwitch>
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy || _roles.Count == 0">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.UserDialog.SaveRoles</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>



