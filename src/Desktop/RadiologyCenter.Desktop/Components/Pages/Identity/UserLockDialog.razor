@inject IdentityService IdentityService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Lock" Title="@(T.FormatValue(T.UserDialog.LockTitle, User.UserName))" />
        <MudText Typo="Typo.body2" Class="text-secondary mb-3">
            @(T.FormatValue(T.UserDialog.LockDescription, User.UserName))
        </MudText>
        <MudDatePicker @bind-Date="_lockoutDate"
                       Label="@T.UserDialog.LockUntil"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="w-100" />
        <MudTimePicker @bind-Time="_lockoutTime"
                       Label="@T.UserDialog.LockUntilTime"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="w-100" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.UserDialog.LockUser</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public UserDto User { get; set; } = default!;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private DateTime? _lockoutDate = DateTime.Today.AddDays(1);
    private TimeSpan? _lockoutTime = TimeSpan.FromHours(8);
    private bool _busy;

    private async Task SubmitAsync()
    {
        if (_lockoutDate is null || _lockoutTime is null)
        {
            Snackbar.Add(T.UserDialog.SelectDateTime, Severity.Warning);
            return;
        }

        var lockoutEnd = _lockoutDate.Value.Date + _lockoutTime.Value;
        if (lockoutEnd <= DateTime.Now)
        {
            Snackbar.Add(T.UserDialog.LockFuture, Severity.Warning);
            return;
        }

        await SafeExecute.RunAsync(async () =>
            {
                await IdentityService.LockUserAsync(User.Id, lockoutEnd);
                Snackbar.Add(T.FormatValue(T.UserDialog.LockedUntil, User.UserName, lockoutEnd), Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            },
            Snackbar,
            () => T.UserDialog.Unreachable,
            busy => _busy = busy);
    }

    private void CancelAsync()
        => MudDialog.Cancel();
}
