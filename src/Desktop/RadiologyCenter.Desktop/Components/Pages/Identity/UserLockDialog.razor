@inject IdentityService IdentityService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Lock" Title="@(T.FormatValue(T.UserDialog.LockTitle, User.UserName))" />
        <MudText Typo="Typo.body2" Class="text-secondary mb-3">
            @(T.FormatValue(T.UserDialog.LockDescription, User.UserName))
        </MudText>
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudDatePicker @bind-Date="_model.LockUntilDate"
                           For="@(() => _model.LockUntilDate)"
                           Label="@T.UserDialog.LockUntil"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="w-100" />
            <MudTimePicker @bind-Time="_model.LockUntilTime"
                           For="@(() => _model.LockUntilTime)"
                           Label="@T.UserDialog.LockUntilTime"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="w-100" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.UserDialog.LockUser</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>


