@page "/roles"
@attribute [Authorize]
@inherits ListPageBase<RoleDto>
@inject IdentityService IdentityService

<PageHeader Icon="@Icons.Material.Filled.Security" Title="@T.Roles.Title"
            Subtitle="@T.Roles.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.Roles.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    @if (Can("roles.create"))
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Roles.NewRole</MudButton>
    }
</PageHeader>

<MudTable T="RoleDto" @ref="Table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="RoleDto" SortLabel="@("Name")">@T.Common.Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="RoleDto" SortLabel="@("Description")">@T.Roles.Description</MudTableSortLabel></MudTh>
        <MudTh>@T.Roles.Permissions</MudTh>
        <MudTh><MudTableSortLabel T="RoleDto" SortLabel="@("CreatedAt")">@T.Roles.Created</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Common.Name">
            <MudText Class="font-weight-medium">@context.Name</MudText>
            @if (context.IsSystem)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@T.Roles.System</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="@T.Roles.Description">@(string.IsNullOrWhiteSpace(context.Description) ? "-" : context.Description)</MudTd>
        <MudTd DataLabel="@T.Roles.Permissions">
            <MudChip T="string" Size="Size.Small" Color="@(context.Permissions.Count == 0 ? Color.Default : Color.Success)">@(T.FormatValue(T.Roles.PermissionCount, context.Permissions.Count))</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Roles.Created">@context.CreatedAt.ToString("g")</MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            @if (Can("roles.update"))
            {
                <MudTooltip Placement="Placement.Bottom" Text="@T.Roles.EditRole">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Roles.EditRole" OnClick="@(() => OpenEditDialogAsync(context))" />
                </MudTooltip>
            }
            @if (Can("roles.manage-permissions"))
            {
                <MudTooltip Placement="Placement.Bottom" Text="@T.Roles.ManagePermissions">
                    <MudIconButton Icon="@Icons.Material.Filled.Key" Size="Size.Small" Color="Color.Info" aria-label="@T.Roles.ManagePermissions" OnClick="@(() => OpenPermissionsDialogAsync(context))" />
                </MudTooltip>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <TableNoRecords LoadError="@LoadError"
                        Offline="@Offline"
                        ErrorTitle="@T.Roles.LoadErrorTitle"
                        EmptyIcon="@Icons.Material.Filled.Security"
                        EmptyTitle="@T.Roles.EmptyTitle"
                        EmptyMessage="@T.Roles.EmptyMessage"
                        EmptyActionLabel="@T.Roles.EmptyAction"
                        ShowAction="@Can("roles.create")"
                        OnReload="ReloadAsync"
                        OnEmptyAction="OpenCreateDialogAsync" />
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>


