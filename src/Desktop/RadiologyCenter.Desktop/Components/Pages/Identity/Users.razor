@page "/users"
@attribute [Authorize]
@using RadiologyCenter.Desktop.Components.Pages.Auth
@inherits ListPageBase<UserDto>
@inject IdentityService IdentityService
@inject TokenStorage TokenStorage

<PageHeader Icon="@Icons.Material.Filled.Person" Title="@T.Users.Title"
            Subtitle="@T.Users.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchValue="@SearchQuery"
            SearchPlaceholder="@T.Users.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Users.NewUser</MudButton>
</PageHeader>

<MudTable T="UserDto" @ref="Table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="UserDto" SortLabel="@("UserName")">@T.Users.Username</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="UserDto" SortLabel="@("LastName")">@T.Common.Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="UserDto" SortLabel="@("Email")">@T.Users.Email</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="UserDto" SortLabel="@("PhoneNumber")">@T.Users.Phone</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh><MudTableSortLabel T="UserDto" SortLabel="@("LastLoginAt")">@T.Users.LastLogin</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Users.Username">
            <MudText Class="font-weight-medium">@context.UserName</MudText>
            @if (IsCurrentUser(context))
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@T.Users.You</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="@T.Common.Name">@context.FullName</MudTd>
        <MudTd DataLabel="@T.Users.Email">@context.Email</MudTd>
        <MudTd DataLabel="@T.Users.Phone">@(string.IsNullOrWhiteSpace(context.PhoneNumber) ? "-" : context.PhoneNumber)</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <StatusChip Token="@(context.IsLocked ? "Locked" : context.IsActive ? "Active" : "Inactive")">@StatusText(context)</StatusChip>
        </MudTd>
        <MudTd DataLabel="@T.Users.LastLogin">@(context.LastLoginAt?.ToString("g") ?? "-")</MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Users.EditProfile" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Color="Color.Info" aria-label="@T.Users.ManageRoles" OnClick="@(() => OpenRolesDialogAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Key" Size="Size.Small" Color="Color.Default" aria-label="@T.Users.ResetPassword" OnClick="@(() => OpenResetPasswordDialogAsync(context))" Disabled="@IsCurrentUser(context)" />
            @if (context.IsLocked)
            {
                <MudIconButton Icon="@Icons.Material.Filled.LockOpen" Size="Size.Small" Color="Color.Warning" aria-label="@T.Users.Unlock" OnClick="@(() => UnlockAsync(context))" />
            }
            else
            {
                <MudIconButton Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Default" aria-label="@T.Users.Lock" OnClick="@(() => OpenLockDialogAsync(context))" Disabled="@IsCurrentUser(context)" />
            }
            @if (context.IsActive)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error" aria-label="@T.Users.Deactivate" OnClick="@(() => DeactivateAsync(context))" Disabled="@IsCurrentUser(context)" />
            }
            else
            {
                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" aria-label="@T.Users.Activate" OnClick="@(() => ActivateAsync(context))" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <TableNoRecords LoadError="@LoadError"
                        Offline="@Offline"
                        ErrorTitle="@T.Users.LoadErrorTitle"
                        EmptyIcon="@Icons.Material.Filled.Person"
                        EmptyTitle="@T.Users.EmptyTitle"
                        EmptyMessage="@T.Users.EmptyMessage"
                        EmptyActionLabel="@T.Users.EmptyAction"
                        OnReload="ReloadAsync"
                        OnEmptyAction="OpenCreateDialogAsync" />
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>


