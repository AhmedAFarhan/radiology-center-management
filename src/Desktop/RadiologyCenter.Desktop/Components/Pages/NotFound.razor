@page "/not-found"
@layout Layout.MainLayout
@inject AppLocalizer T

<MudPaper Class="pa-8 text-center">
    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Error" />
    <MudText Typo="Typo.h5" Class="mt-2">@T.NotFound.Title</MudText>
    <MudText Class="text-secondary">@T.NotFound.Message</MudText>
</MudPaper>