@using static RadiologyCenter.Desktop.Services.Formatting
@page "/inventory/stock-movements"
@attribute [Authorize]
@inherits ListPageBase<StockMovementDto>
@inject InventoryService InventoryService

<PageHeader Icon="@Icons.Material.Filled.SwapVert" Title="@T.StockMovements.Title"
            Subtitle="@T.StockMovements.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.StockMovements.SearchPlaceholder"
            OnRefresh="ReloadAsync">
</PageHeader>

<MudTable Breakpoint="Breakpoint.Sm" T="StockMovementDto" @ref="Table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="StockMovementDto" SortLabel="@("CreatedAt")">@T.Common.Date</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="StockMovementDto" SortLabel="@("MovementType")">@T.Common.Type</MudTableSortLabel></MudTh>
        <MudTh Class="text-right"><MudTableSortLabel T="StockMovementDto" SortLabel="@("Quantity")">@T.StockMovements.Quantity</MudTableSortLabel></MudTh>
        <MudTh Class="text-right">@T.StockMovements.UnitCost</MudTh>
        <MudTh>@T.StockMovements.Item</MudTh>
        <MudTh>@T.StockMovements.Reference</MudTh>
        <MudTh>@T.StockMovements.Notes</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Common.Date">@context.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</MudTd>
        <MudTd DataLabel="@T.Common.Type">
            <StatusChip Token="@context.MovementTypeKey">@context.MovementType</StatusChip>
        </MudTd>
        <MudTd DataLabel="@T.StockMovements.Quantity" Class="text-right">
            <MudText Color="@(context.Quantity < 0 ? Color.Error : Color.Success)">@(context.Quantity > 0 ? $"+{context.Quantity}" : context.Quantity.ToString())</MudText>
        </MudTd>
        <MudTd DataLabel="@T.StockMovements.UnitCost" Class="text-right">@(context.UnitCost?.ToString("C") ?? "-")</MudTd>
        <MudTd DataLabel="@T.StockMovements.Item" Class="mono-text">@ShortId(context.ItemId)</MudTd>
        <MudTd DataLabel="@T.StockMovements.Reference">@(context.Reference ?? "-")</MudTd>
        <MudTd DataLabel="@T.StockMovements.Notes">@(context.Notes ?? "-")</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <TableNoRecords LoadError="@LoadError"
                        Offline="@Offline"
                        ErrorTitle="@T.StockMovements.LoadErrorTitle"
                        EmptyIcon="@Icons.Material.Filled.SwapVert"
                        EmptyTitle="@T.StockMovements.NoMovementsTitle"
                        EmptyMessage="@T.StockMovements.EmptyMessage"
                        OnReload="ReloadAsync" />
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>