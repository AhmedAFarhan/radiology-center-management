@inject IdentityService IdentityService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Key" Title="@(T.FormatValue(T.UserDialog.ResetPasswordTitle, User.UserName))" />
        <MudText Typo="Typo.body2" Class="text-secondary mb-3">
            @(T.FormatValue(T.UserDialog.ResetPasswordDescription, User.UserName))
        </MudText>
        <MudTextField @bind-Value="_newPassword"
                      Label="@T.UserDialog.NewPassword"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      InputType="InputType.Password"
                      AutoComplete="new-password"
                      HelperText="@T.UserDialog.PasswordHelper" />
        <MudTextField @bind-Value="_confirmPassword"
                      Label="@T.UserDialog.ConfirmPassword"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      InputType="InputType.Password"
                      AutoComplete="new-password" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.UserDialog.ResetPasswordButton</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public UserDto User { get; set; } = default!;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _busy;

    private async Task SubmitAsync()
    {
        if (_newPassword.Length < 8 || !_newPassword.Any(char.IsLetter) || !_newPassword.Any(char.IsDigit))
        {
            Snackbar.Add(T.UserDialog.InvalidNewPassword, Severity.Warning);
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add(T.UserDialog.PasswordMismatch, Severity.Warning);
            return;
        }

        await SafeExecute.RunAsync(async () =>
            {
                await IdentityService.ResetPasswordAsync(User.Id, _newPassword);
                Snackbar.Add(T.FormatValue(T.UserDialog.PasswordReset, User.UserName), Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            },
            Snackbar,
            () => T.UserDialog.Unreachable,
            busy => _busy = busy);
    }

    private void CancelAsync()
        => MudDialog.Cancel();
}