@inject IdentityService IdentityService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Key" Title="@($"Reset Password - {User.UserName}")" />
        <MudText Typo="Typo.body2" Class="text-secondary mb-3">
            Set a new temporary password for @User.UserName. The user will be required to change it at next sign-in.
        </MudText>
        <MudTextField @bind-Value="_newPassword"
                      Label="New Password"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      InputType="InputType.Password"
                      AutoComplete="new-password"
                      HelperText="Minimum 8 characters and must contain both letters and digits." />
        <MudTextField @bind-Value="_confirmPassword"
                      Label="Confirm New Password"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      InputType="InputType.Password"
                      AutoComplete="new-password" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>Reset Password</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public UserDto User { get; set; } = default!;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _busy;

    private async Task SubmitAsync()
    {
        if (_newPassword.Length < 8 || !_newPassword.Any(char.IsLetter) || !_newPassword.Any(char.IsDigit))
        {
            Snackbar.Add("New password must be at least 8 characters long and contain both letters and digits.", Severity.Warning);
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add("Passwords do not match.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await IdentityService.ResetPasswordAsync(User.Id, _newPassword);
            Snackbar.Add($"{User.UserName} password reset. They must change it at next sign-in.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelAsync()
        => MudDialog.Cancel();
}