@inject CashService CashService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Lock" Title="@T.CloseCash.Title" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="text-secondary mb-1">
                        @(T.FormatValue(T.CloseCash.ExpectedTotalHint, _expectedTotal.ToString("C")))
                    </MudText>
                    <MudNumericField @bind-Value="_model.CountedTotal"
                                     Label="@T.CloseCash.CountedTotal"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Immediate="true"
                                     For="@(() => _model.CountedTotal)" />
                </MudItem>
                <MudItem xs="12">
                    <MudDivider />
                    <MudText Typo="Typo.caption" Class="text-secondary mt-2">
                        @T.CloseCash.HandoverHint
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.ReceivingUserId"
                                  Label="@T.CloseCash.ReceivingUserId"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.ReceivingUserId)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_model.ReceivingOpeningFloat"
                                     Label="@T.CloseCash.ReceivingOpeningFloat"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Immediate="true"
                                     For="@(() => _model.ReceivingOpeningFloat)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Notes"
                                  Label="@T.CloseCash.Notes"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Notes)" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.CloseCash.Submit</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

