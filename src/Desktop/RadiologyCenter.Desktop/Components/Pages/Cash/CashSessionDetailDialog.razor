@using static RadiologyCenter.Desktop.Services.Formatting
@inject CashService CashService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.AccountBalanceWallet" Title="@(Session is null ? T.CashSession.Title : T.FormatValue(T.CashSession.TitleWithId, ShortId(Session.Id)))" />
        @if (Session is null)
        {
            <DialogSkeleton Rows="8" />
        }
        else
        {
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudPaper Elevation="0" Class="pa-4 rounded" Style="border:1px solid rgba(0,0,0,.12)">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6" md="3">
                                <MudText Typo="Typo.caption" Class="text-secondary">@T.Common.Status</MudText>
                                <StatusChip Token="@Session.StatusKey">@Session.Status</StatusChip>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudText Typo="Typo.caption" Class="text-secondary">@T.CashSession.User</MudText>
                                <MudText Typo="Typo.body1" Class="font-weight-medium">@(string.IsNullOrWhiteSpace(Session.UserName) ? ShortId(Session.UserId) : Session.UserName)</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudText Typo="Typo.caption" Class="text-secondary">@T.CashSession.OpeningFloat</MudText>
                                <MudText Typo="Typo.body1" Class="font-weight-medium">@Session.OpeningFloat.ToString("C")</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudText Typo="Typo.caption" Class="text-secondary">@T.CashSession.Balance</MudText>
                                <MudText Typo="Typo.body1" Class="font-weight-medium" Color="@(Session.Balance < 0 ? Color.Error : Color.Default)">@Session.Balance.ToString("C")</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Class="text-secondary">@T.CashSession.OpenedAt</MudText>
                                <MudText Typo="Typo.body2">@Session.OpenedAt.ToLocalTime().ToString("g")</MudText>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudText Typo="Typo.caption" Class="text-secondary">@T.CashSession.ClosedAt</MudText>
                                <MudText Typo="Typo.body2">@(Session.ClosedAt?.ToLocalTime().ToString("g") ?? T.CashSession.NotClosed)</MudText>
                            </MudItem>
                        </MudGrid>
                        @if (!string.IsNullOrWhiteSpace(Session.Notes))
                        {
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.body2" Class="text-secondary">@Session.Notes</MudText>
                        }
                    </MudPaper>
                </MudItem>

                @if (_handover is not null)
                {
                    <MudItem xs="12">
                        <MudPaper Elevation="0" Class="pa-4 rounded" Style="border:1px solid rgba(0,0,0,.12)">
                            <MudGrid Spacing="2" Class="mb-2">
                                <MudItem xs="12" sm="8">
                                    <MudText Typo="Typo.subtitle1" Class="font-weight-medium">@T.CashSession.Handover</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="4" Class="d-flex justify-end">
                                    @if (_handover.ApprovedAt is null)
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Check" OnClick="ApproveAsync" Disabled="_busy">@T.CashSession.ApproveHandover</MudButton>
                                    }
                                </MudItem>
                            </MudGrid>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption" Class="text-secondary">@T.CashSession.Expected</MudText>
                                    <MudText Typo="Typo.body1" Class="font-weight-medium">@_handover.ExpectedTotal.ToString("C")</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption" Class="text-secondary">@T.CashSession.Counted</MudText>
                                    <MudText Typo="Typo.body1" Class="font-weight-medium">@_handover.CountedTotal.ToString("C")</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption" Class="text-secondary">@T.CashSession.OverShort</MudText>
                                    <MudText Typo="Typo.body1" Class="font-weight-medium" Color="@OverShortColor(_handover.OverShortAmount)">@(_handover.OverShortAmount >= 0 ? $"+{_handover.OverShortAmount:C}" : _handover.OverShortAmount.ToString("C"))</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudText Typo="Typo.caption" Class="text-secondary">@T.CashSession.Approved</MudText>
                                    <MudText Typo="Typo.body2">@(_handover.ApprovedAt?.ToLocalTime().ToString("g") ?? T.CashSession.NotApproved)</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.caption" Class="text-secondary">@T.CashSession.ClosedBy</MudText>
                                    <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(_handover.ClosedByName) ? ShortId(_handover.ClosedByUserId) : _handover.ClosedByName)</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.caption" Class="text-secondary">@T.CashSession.ReceivingSession</MudText>
                                    <MudText Typo="Typo.body2">@(_handover.ReceivingCashSessionId is null ? "-" : ShortId(_handover.ReceivingCashSessionId))</MudText>
                                </MudItem>
                            </MudGrid>
                            @if (!string.IsNullOrWhiteSpace(_handover.Notes))
                            {
                                <MudDivider Class="my-2" />
                                <MudText Typo="Typo.body2" Class="text-secondary">@_handover.Notes</MudText>
                            }
                        </MudPaper>
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudGrid Spacing="2" Class="mb-2">
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-medium">@(T.FormatValue(T.CashSession.EntriesCount, _entries.Count))</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" Class="d-flex justify-end">
                            @if (IsOpen)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.SwapVert" OnClick="AddEntryAsync" Disabled="_busy">@T.CashSession.AddEntry</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" Class="ms-2" StartIcon="@Icons.Material.Filled.Lock" OnClick="CloseAsync" Disabled="_busy">@T.CashSession.CloseSession</MudButton>
                            }
                        </MudItem>
                    </MudGrid>

                    @if (_entries.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="text-secondary pa-4">@T.CashSession.NoEntries</MudText>
                    }
                    else
                    {
                        <MudTable T="CashEntryDto" Items="_entries" Dense="true" Hover="true" Elevation="0" Class="rounded" Style="border:1px solid rgba(0,0,0,.12)">
                            <HeaderContent>
                                <MudTh>@T.Common.Date</MudTh>
                                <MudTh>@T.CashSession.Direction</MudTh>
                                <MudTh>@T.CashSession.Reason</MudTh>
                                <MudTh Class="text-right">@T.CashSession.Amount</MudTh>
                                <MudTh>@T.CashSession.Reference</MudTh>
                                <MudTh>@T.CashSession.Description</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="entry">
                                <MudTd DataLabel="@T.Common.Date">@entry.OccurredAt.ToLocalTime().ToString("g")</MudTd>
                                <MudTd DataLabel="@T.CashSession.Direction">
                                    <StatusChip Token="@entry.DirectionKey">@entry.Direction</StatusChip>
                                </MudTd>
                                <MudTd DataLabel="@T.CashSession.Reason">@entry.Reason</MudTd>
                                <MudTd DataLabel="@T.CashSession.Amount" Class="text-right">
                                    <MudText Class="font-weight-medium" Color="@(entry.DirectionKey == "Out" ? Color.Error : Color.Success)">
                                        @(entry.Direction == "Out" ? $"-{entry.Amount:C}" : $"+{entry.Amount:C}")
                                    </MudText>
                                </MudTd>
                                <MudTd DataLabel="@T.CashSession.Reference">@(entry.ReferenceId ?? "-")</MudTd>
                                <MudTd DataLabel="@T.CashSession.Description">@(entry.Description ?? "-")</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Typo="Typo.body2" Class="text-secondary pa-4">@T.CashSession.NoEntriesToDisplay</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    }
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CloseDialogAsync">@T.Common.Close</MudButton>
    </DialogActions>
</MudDialog>

