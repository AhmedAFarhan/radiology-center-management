@inject CashService CashService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.SwapVert" Title="@T.CashEntry.Title" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_model.Direction"
                               Label="@T.CashEntry.Direction"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.Direction)">
                        <MudSelectItem Value="@("In")">@T.CashEntry.DirectionIn</MudSelectItem>
                        <MudSelectItem Value="@("Out")">@T.CashEntry.DirectionOut</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_model.Reason"
                               Label="@T.CashEntry.Reason"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.Reason)">
                        <MudSelectItem Value="@("Payment")">@T.CashEntry.ReasonPayment</MudSelectItem>
                        <MudSelectItem Value="@("Refund")">@T.CashEntry.ReasonRefund</MudSelectItem>
                        <MudSelectItem Value="@("Deposit")">@T.CashEntry.ReasonDeposit</MudSelectItem>
                        <MudSelectItem Value="@("Payout")">@T.CashEntry.ReasonPayout</MudSelectItem>
                        <MudSelectItem Value="@("Adjustment")">@T.CashEntry.ReasonAdjustment</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_model.Amount"
                                     Label="@T.CashEntry.Amount"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Immediate="true"
                                     For="@(() => _model.Amount)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.ReferenceId"
                                  Label="@T.CashEntry.Reference"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.ReferenceId)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Description"
                                  Label="@T.CashEntry.Description"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Description)" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.CashEntry.Submit</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string SessionId { get; set; } = string.Empty;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly AddEntryFormModel _model = new();
    private EditContext _editContext = default!;
    private bool _busy;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
        _model.Reason = "Payment";
    }

    private async Task SubmitAsync()
    {
        if (!_editContext.Validate())
            return;

        await SafeExecute.RunAsync(async () =>
            {
                var input = new AddCashEntryInput
                {
                    CashSessionId = SessionId,
                    Direction = _model.Direction,
                    Reason = _model.Reason,
                    Amount = _model.Amount,
                    Description = _model.Description,
                    ReferenceId = _model.ReferenceId,
                };

                await CashService.AddEntryAsync(SessionId, input);
                Snackbar.Add(T.CashEntry.Added, Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            },
            Snackbar,
            () => T.CashEntry.UnreachableRetry,
            busy => _busy = busy);
    }

    private void CancelAsync()
        => MudDialog.Cancel();

    private sealed class AddEntryFormModel
    {
        public string Direction { get; set; } = "In";

        public string Reason { get; set; } = "Payment";

        [Range(0.01, (double)decimal.MaxValue, ErrorMessage = "Amount must be greater than zero.")]
        public decimal Amount { get; set; }

        [MaxLength(100, ErrorMessage = "Reference must be 100 characters or fewer.")]
        public string? ReferenceId { get; set; }

        [MaxLength(500, ErrorMessage = "Description must be 500 characters or fewer.")]
        public string? Description { get; set; }
    }
}