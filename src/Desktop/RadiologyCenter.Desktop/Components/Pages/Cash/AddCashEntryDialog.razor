@inherits EditorDialogBase
@inject CashService CashService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.SwapVert" Title="@T.CashEntry.Title" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_model.Direction"
                               Label="@T.CashEntry.Direction"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.Direction)">
                        <MudSelectItem Value="@("In")">@T.CashEntry.DirectionIn</MudSelectItem>
                        <MudSelectItem Value="@("Out")">@T.CashEntry.DirectionOut</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_model.Reason"
                               Label="@T.CashEntry.Reason"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.Reason)">
                        <MudSelectItem Value="@("Payment")">@T.CashEntry.ReasonPayment</MudSelectItem>
                        <MudSelectItem Value="@("Refund")">@T.CashEntry.ReasonRefund</MudSelectItem>
                        <MudSelectItem Value="@("Deposit")">@T.CashEntry.ReasonDeposit</MudSelectItem>
                        <MudSelectItem Value="@("Payout")">@T.CashEntry.ReasonPayout</MudSelectItem>
                        <MudSelectItem Value="@("Adjustment")">@T.CashEntry.ReasonAdjustment</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_model.Amount"
                                     Label="@T.CashEntry.Amount"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Immediate="true"
                                     For="@(() => _model.Amount)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.ReferenceId"
                                  Label="@T.CashEntry.Reference"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.ReferenceId)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Description"
                                  Label="@T.CashEntry.Description"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Description)" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@T.CashEntry.Submit"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>

