@inject CashService CashService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.SwapVert" Title="Add Cash Entry" />
        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_model.Direction"
                               Label="Direction"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.Direction)">
                        <MudSelectItem Value="@("In")">In (money in)</MudSelectItem>
                        <MudSelectItem Value="@("Out")">Out (money out)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_model.Reason"
                               Label="Reason"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.Reason)">
                        <MudSelectItem Value="@("Payment")">Payment</MudSelectItem>
                        <MudSelectItem Value="@("Refund")">Refund</MudSelectItem>
                        <MudSelectItem Value="@("Deposit")">Deposit</MudSelectItem>
                        <MudSelectItem Value="@("Payout")">Payout</MudSelectItem>
                        <MudSelectItem Value="@("Adjustment")">Adjustment</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_model.Amount"
                                     Label="Amount"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Immediate="true"
                                     For="@(() => _model.Amount)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.ReferenceId"
                                  Label="Reference"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.ReferenceId)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Description"
                                  Label="Description"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Description)" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>Add Entry</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string SessionId { get; set; } = string.Empty;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly AddEntryFormModel _model = new();
    private EditContext _editContext = default!;
    private bool _busy;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
        _model.Reason = "Payment";
    }

    private async Task SubmitAsync()
    {
        if (!_editContext.Validate())
            return;

        _busy = true;
        try
        {
            var input = new AddCashEntryInput
            {
                CashSessionId = SessionId,
                Direction = _model.Direction,
                Reason = _model.Reason,
                Amount = _model.Amount,
                Description = _model.Description,
                ReferenceId = _model.ReferenceId,
            };

            await CashService.AddEntryAsync(SessionId, input);
            Snackbar.Add("Cash entry added.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server. Please try again.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelAsync()
        => MudDialog.Cancel();

    private sealed class AddEntryFormModel
    {
        public string Direction { get; set; } = "In";

        public string Reason { get; set; } = "Payment";

        [Range(0.01, (double)decimal.MaxValue, ErrorMessage = "Amount must be greater than zero.")]
        public decimal Amount { get; set; }

        [MaxLength(100, ErrorMessage = "Reference must be 100 characters or fewer.")]
        public string? ReferenceId { get; set; }

        [MaxLength(500, ErrorMessage = "Description must be 500 characters or fewer.")]
        public string? Description { get; set; }
    }
}