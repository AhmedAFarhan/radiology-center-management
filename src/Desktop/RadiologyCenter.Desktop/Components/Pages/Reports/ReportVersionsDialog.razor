@inject ReportService ReportService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.History" Title="@T.ReportVersions.Title" />

        <div style="max-height: 440px; overflow-y: auto;">
            @if (_loading)
            {
                <DialogSkeleton Rows="3" />
            }
            else if (_error is not null)
            {
                <ErrorState Title="@T.ReportVersions.LoadErrorTitle"
                            Message="@_error"
                            RetryLabel="@T.Common.Retry"
                            Action="LoadAsync" />
            }
            else if (!_versions.Any())
            {
                <EmptyState Icon="@Icons.Material.Filled.History" Title="@T.ReportVersions.NoVersions" Message="@T.ReportVersions.NoVersionsMessage" />
            }
            else
            {
                @foreach (var version in _versions.OrderByDescending(v => v.VersionNumber))
                {
                    <MudPaper Elevation="1" Class="pa-3 mb-3">
                        <div class="mb-1">
                            <MudChip T="string" Size="Size.Small" Color="@(version.VersionNumber == _versions.Count ? Color.Primary : Color.Default)">v@version.VersionNumber</MudChip>
                            <MudText Typo="Typo.caption" Class="text-secondary ms-2 d-inline">@(version.CreatedAt.ToString("f"))</MudText>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(version.AmendmentReason))
                        {
                            <MudText Typo="Typo.body2" Class="text-secondary mb-2">@(T.FormatValue(T.ReportVersions.Amended, version.AmendmentReason))</MudText>
                        }
                        @foreach (var vsection in version.Sections.OrderBy(s => s.Position))
                        {
                            <div class="mb-1">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-medium">@vsection.Title</MudText>
                                @if (string.IsNullOrWhiteSpace(vsection.Body))
                                {
                                    <MudText Typo="Typo.caption" Class="text-secondary">-</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2">@vsection.Body</MudText>
                                }
                            </div>
                        }
                        @if (version.Findings.Any())
                        {
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2" Class="font-weight-medium mb-1">@T.ReportVersions.Findings</MudText>
                            @foreach (var finding in version.Findings.OrderBy(f => f.Position))
                            {
                                <div class="mb-1">
                                    <StatusChip Token="@finding.SeverityKey" Variant="Variant.Outlined" Class="me-1">@finding.Severity</StatusChip>
                                    <MudText Typo="Typo.body2" Class="d-inline">@finding.Region - @finding.Description</MudText>
                                </div>
                            }
                        }
                    </MudPaper>
                }
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync">@T.Common.Close</MudButton>
    </DialogActions>
</MudDialog>

