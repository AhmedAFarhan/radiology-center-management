@inject ExaminationService ExaminationService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.EventNote" Title="@(T.FormatValue(T.VisitSchedule.Title, Visit.ExaminationTypeName))" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudDatePicker @bind-Date="_model.ScheduledDate"
                           For="@(() => _model.ScheduledDate)"
                           Label="@T.VisitSchedule.ScheduledDate"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="w-100" />
            <MudTimePicker @bind-Time="_model.ScheduledTime"
                           For="@(() => _model.ScheduledTime)"
                           Label="@T.VisitSchedule.ScheduledTime"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Class="w-100" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.VisitSchedule.Schedule</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public ExaminationDto Visit { get; set; } = default!;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly VisitScheduleModel _model = new()
    {
        ScheduledDate = DateTime.Today,
        ScheduledTime = TimeSpan.FromHours(9),
    };
    private EditContext _editContext = default!;
    private bool _busy;

    protected override void OnInitialized()
        => _editContext = new EditContext(_model);

    private async Task SubmitAsync()
    {
        if (!_editContext.Validate())
            return;

        if (_model.ScheduledDate is null || _model.ScheduledTime is null)
            return;

        var scheduledAt = _model.ScheduledDate.Value.Date + _model.ScheduledTime.Value;

        await SafeExecute.RunAsync(async () =>
            {
                await ExaminationService.ScheduleAsync(Visit.Id, scheduledAt);
                Snackbar.Add(T.VisitSchedule.Scheduled, Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            },
            Snackbar,
            () => T.VisitSchedule.Unreachable,
            busy => _busy = busy);
    }

    private void CancelAsync()
        => MudDialog.Cancel();

    private sealed class VisitScheduleModel
    {
        [Required(ErrorMessage = "Scheduled date is required.")]
        public DateTime? ScheduledDate { get; set; }

        [Required(ErrorMessage = "Scheduled time is required.")]
        public TimeSpan? ScheduledTime { get; set; }
    }
}
