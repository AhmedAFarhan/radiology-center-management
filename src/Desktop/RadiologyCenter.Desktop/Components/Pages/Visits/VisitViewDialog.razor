@inject ExaminationService ExaminationService
@inject PatientService PatientService
@inject InventoryService InventoryService
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.EventNote" Title="@T.VisitDialog.DetailsTitle" />
        @if (_loading)
        {
            <DialogSkeleton Rows="4" />
        }
        else if (_loadError is not null)
        {
            <ErrorState Title="@T.VisitDialog.LoadErrorTitle" Message="@_loadError" Action="LoadAsync" />
        }
        else if (_visit is not null)
        {
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Class="text-secondary">@T.VisitDialog.Patient</MudText>
                    <MudText Typo="Typo.subtitle1">@_patientName</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Class="text-secondary">@T.VisitDialog.Examination</MudText>
                    <MudText Typo="Typo.subtitle1">@_visit.ExaminationTypeName</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Class="text-secondary">@T.Common.Status</MudText>
                    <StatusChip Token="@_visit.StatusKey">@_visit.Status</StatusChip>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Class="text-secondary">@T.VisitDialog.Priority</MudText>
                    <StatusChip Token="@_visit.PriorityKey">@_visit.Priority</StatusChip>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="text-secondary">@T.VisitDialog.Radiologist</MudText>
                    <MudText Typo="Typo.subtitle1">@(_visit.RadiologistId ?? "-")</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="text-secondary">@T.VisitDialog.Technician</MudText>
                    <MudText Typo="Typo.subtitle1">@(_visit.TechnicianId ?? "-")</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="text-secondary">@T.VisitDialog.ReferralDoctor</MudText>
                    <MudText Typo="Typo.subtitle1">@(string.IsNullOrWhiteSpace(_visit.ReferralDoctorId) ? "-" : _visit.ReferralDoctorId)</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="text-secondary">@T.VisitDialog.ClinicalIndication</MudText>
                    <MudText Typo="Typo.body1">@(string.IsNullOrWhiteSpace(_visit.ClinicalIndication) ? "-" : _visit.ClinicalIndication)</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Class="text-secondary">@T.VisitDialog.Scheduled</MudText>
                    <MudText Typo="Typo.body1">@(_visit.ScheduledAt?.ToString("g") ?? "-")</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Class="text-secondary">@T.VisitDialog.Started</MudText>
                    <MudText Typo="Typo.body1">@(_visit.StartedAt?.ToString("g") ?? "-")</MudText>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudText Typo="Typo.caption" Class="text-secondary">@T.VisitDialog.Completed</MudText>
                    <MudText Typo="Typo.body1">@(_visit.CompletedAt?.ToString("g") ?? "-")</MudText>
                </MudItem>

                @if (!string.IsNullOrWhiteSpace(_visit.CancellationReason))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Class="text-secondary">@T.VisitDialog.CancellationReason</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Error">@_visit.CancellationReason</MudText>
                    </MudItem>
                }

                <MudDivider Class="my-1" />
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">@T.VisitDialog.Billing</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Class="text-secondary">@T.VisitDialog.Price</MudText>
                    <MudText Typo="Typo.body1">@_visit.Price.ToString("C")</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Class="text-secondary">@T.VisitDialog.Discount</MudText>
                    <MudText Typo="Typo.body1">@(_visit.IsDiscountPercentage ? $"{_visit.Discount}%" : _visit.Discount.ToString("C"))</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Class="text-secondary">@T.VisitDialog.Paid</MudText>
                    <MudText Typo="Typo.body1">@_visit.Paid.ToString("C")</MudText>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudText Typo="Typo.caption" Class="text-secondary">@T.VisitDialog.Remaining</MudText>
                    <MudText Typo="Typo.body1" Color="@(_visit.Remaining > 0 ? Color.Error : Color.Success)">@_visit.Remaining.ToString("C")</MudText>
                </MudItem>

                <MudDivider Class="my-1" />
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">@T.VisitDialog.Items</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudSimpleTable Dense="true">
                        <thead>
                            <tr>
                                <th>@T.VisitDialog.Item</th>
                                <th>@T.VisitDialog.Qty</th>
                                <th>@T.Common.Type</th>
                                <th>@T.VisitDialog.Required</th>
                                <th>@T.VisitDialog.Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_visit.Items.Count == 0)
                            {
                                <tr>
                                    <td colspan="5">@T.VisitDialog.NoItems</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in _visit.Items)
                                {
                                    <tr>
                                        <td>@ResolveItemName(item.ItemId)</td>
                                        <td>@item.Quantity</td>
                                        <td>
                                            <MudChip T="string" Size="Size.Small" Color="@(item.IsContrast ? Color.Secondary : Color.Default)" Variant="Variant.Outlined">@(item.IsContrast ? T.VisitDialog.Contrast : T.VisitDialog.Consumable)</MudChip>
                                        </td>
                                        <td>@(item.IsRequired ? T.Common.Yes : T.Common.No)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Notes) ? "-" : item.Notes)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudItem>

                @if (!string.IsNullOrWhiteSpace(_visit.Notes))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Class="text-secondary">@T.VisitDialog.Notes</MudText>
                        <MudText Typo="Typo.body1">@_visit.Notes</MudText>
                    </MudItem>
                }
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CloseAsync">@T.Common.Close</MudButton>
    </DialogActions>
</MudDialog>



