@inject ExaminationService ExaminationService
@inject PatientService PatientService
@inject ResourceService ResourceService
@inject InventoryService InventoryService
@inject EnumOptionsService EnumOptionsService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.EventNote" Title="@(Visit is null ? T.VisitDialog.NewTitle : T.VisitDialog.EditTitle)" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="PatientDto"
                                     @bind-Value="_model.Patient"
                                     Label="@T.VisitDialog.PatientSearch"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchPatientsAsync"
                                     ToStringFunc="@(p => p is null ? string.Empty : p.FullName)"
                                     For="@(() => _model.Patient)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="ExaminationTypeDto"
                                     @bind-Value="_model.ExaminationType"
                                     Label="@T.VisitDialog.TypeSearch"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchTypesAsync"
                                     ToStringFunc="@(t => t is null ? string.Empty : $"{t.Code} - {t.Name}")"
                                     For="@(() => _model.ExaminationType)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.RadiologistId"
                               Label="@T.VisitDialog.Radiologist"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true">
                        @foreach (var staff in _radiologists)
                        {
                            <MudSelectItem T="string" Value="@staff.Id">@staff.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.TechnicianId"
                               Label="@T.VisitDialog.Technician"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true">
                        @foreach (var staff in _technicians)
                        {
                            <MudSelectItem T="string" Value="@staff.Id">@staff.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="ReferralDoctorDto"
                                     @bind-Value="_selectedReferralDoctor"
                                     Label="@T.VisitDialog.ReferralDoctorId"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchReferralDoctorsAsync"
                                     ToStringFunc="@(d => d is null ? string.Empty : d.FullName)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.Priority"
                               Label="@T.VisitDialog.Priority"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        @foreach (var priority in _priorityOptions)
                        {
                            <MudSelectItem T="string" Value="@priority.Key">@priority.Value</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.Status"
                               Label="@T.VisitDialog.Status"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        @foreach (var status in _statusOptions)
                        {
                            <MudSelectItem T="string" Value="@status.Key">@status.Value</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @if (_model.Status == "Scheduled")
                {
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_model.ScheduledDate"
                                       Label="@T.VisitDialog.ScheduledDate"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Class="w-100"
                                       For="@(() => _model.ScheduledDate)" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                    <MudTimePicker @bind-Time="_model.ScheduledTime"
                                   Label="@T.VisitDialog.ScheduledTime"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="w-100"
                                   For="@(() => _model.ScheduledTime)" />
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.ClinicalIndication"
                                  Label="@T.VisitDialog.ClinicalIndication"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="2"
                                  Immediate="true"
                                  For="@(() => _model.ClinicalIndication)" />
                </MudItem>

                <MudDivider Class="my-1" />
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">@T.VisitDialog.Billing</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     Value="_model.ExaminationType?.Price ?? 0"
                                     Label="@T.VisitDialog.Price"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.Discount"
                                     Label="@T.VisitDialog.Discount"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool" @bind-Value="_model.IsDiscountPercentage" Color="Color.Primary">@T.VisitDialog.DiscountIsPercentage</MudSwitch>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.Paid"
                                     Label="@T.VisitDialog.AmountPaid"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Notes"
                                  Label="@T.VisitDialog.Notes"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="3"
                                  Immediate="true" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@(IsEdit ? T.VisitDialog.SaveChanges : T.VisitDialog.CreateVisit)</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>


