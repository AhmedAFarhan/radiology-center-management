@inject ExaminationService ExaminationService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Cancel" Title="@(T.FormatValue(T.Visits.CancelVisitTitle, Visit.ExaminationTypeName))" />
        <MudTextField @bind-Value="_reason"
                      Label="@T.Visits.CancellationReasonOptional"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.Visits.CancelVisit</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public ExaminationDto Visit { get; set; } = default!;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private string? _reason;
    private bool _busy;

    private async Task SubmitAsync()
    {
        await SafeExecute.RunAsync(async () =>
            {
                await ExaminationService.CancelAsync(Visit.Id, _reason);
                Snackbar.Add(T.Visits.Cancelled, Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            },
            Snackbar,
            () => T.Visits.Unreachable,
            busy => _busy = busy);
    }

    private void CancelAsync()
        => MudDialog.Cancel();
}
