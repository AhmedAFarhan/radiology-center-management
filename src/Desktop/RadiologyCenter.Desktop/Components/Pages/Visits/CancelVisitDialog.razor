@inject ExaminationService ExaminationService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Cancel" Title="@(T.FormatValue(T.Visits.CancelVisitTitle, Visit.ExaminationTypeName))" />
        <MudTextField @bind-Value="_reason"
                      Label="@T.Visits.CancellationReasonOptional"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      FullWidth="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.Visits.CancelVisit</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>


