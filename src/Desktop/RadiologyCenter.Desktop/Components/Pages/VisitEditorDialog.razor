@inject ExaminationService ExaminationService
@inject PatientService PatientService
@inject InventoryService InventoryService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.EventNote" Title="@(Visit is null ? "New Visit" : "Edit Visit")" />
        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />
            <MudGrid Spacing="2">
                @if (!IsEdit)
                {
                    <MudItem xs="12" sm="6">
                        <MudAutocomplete T="PatientDto"
                                         @bind-Value="_selectedPatient"
                                         Label="Patient (search by name or phone)"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="1"
                                         DebounceInterval="300"
                                         SearchFunc="SearchPatientsAsync"
                                         ToStringFunc="@(p => p is null ? string.Empty : p.FullName)"
                                         Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudAutocomplete T="ExaminationTypeDto"
                                         @bind-Value="_selectedType"
                                         Label="Examination Type (search by code or name)"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="1"
                                         DebounceInterval="300"
                                         SearchFunc="SearchTypesAsync"
                                         ToStringFunc="@(t => t is null ? string.Empty : $"{t.Code} - {t.Name}")"
                                         Clearable="true" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.PatientName"
                                      Label="Patient"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_model.ExaminationTypeName"
                                      Label="Examination Type"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="true" />
                    </MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.RadiologistId"
                                  Label="Radiologist ID"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.RadiologistId)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.TechnicianId"
                                  Label="Technician ID"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.TechnicianId)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.ReferralDoctorId"
                                  Label="Referral Doctor ID (optional)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.Priority"
                               Label="Priority"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        @foreach (var priority in Priorities)
                        {
                            <MudSelectItem T="string" Value="@priority">@priority</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.ClinicalIndication"
                                  Label="Clinical Indication"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="2"
                                  Immediate="true"
                                  For="@(() => _model.ClinicalIndication)" />
                </MudItem>

                <MudDivider Class="my-1" />
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Billing</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.Discount"
                                     Label="Discount"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch T="bool" @bind-Value="_model.IsDiscountPercentage" Color="Color.Primary">Discount is percentage</MudSwitch>
                </MudItem>
                @if (!IsEdit)
                {
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal"
                                         @bind-Value="_model.Paid"
                                         Label="Amount Paid"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0" />
                    </MudItem>
                }
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Notes"
                                  Label="Notes"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="3"
                                  Immediate="true" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@(IsEdit ? "Save Changes" : "Create Visit")</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public ExaminationDto? Visit { get; set; }

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private static readonly string[] Priorities = { "Routine", "Urgent", "Stat" };

    private readonly VisitFormModel _model = new();
    private EditContext _editContext = default!;
    private PatientDto? _selectedPatient;
    private ExaminationTypeDto? _selectedType;
    private bool _busy;

    private bool IsEdit => Visit is not null;

    private async Task<IEnumerable<PatientDto>> SearchPatientsAsync(string? value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Array.Empty<PatientDto>();

        try
        {
            var page = await PatientService.GetPagedAsync(value, "LastName", false, 1, 20, ct);
            return page.Items;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return Array.Empty<PatientDto>();
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to search patients.", Severity.Error);
            return Array.Empty<PatientDto>();
        }
    }

    private async Task<IEnumerable<ExaminationTypeDto>> SearchTypesAsync(string? value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Array.Empty<ExaminationTypeDto>();

        try
        {
            var page = await ExaminationService.GetTypesPagedAsync(value, "Name", false, 1, 20, ct);
            return page.Items;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return Array.Empty<ExaminationTypeDto>();
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to search examination types.", Severity.Error);
            return Array.Empty<ExaminationTypeDto>();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_model);

        if (IsEdit)
        {
            _model.PatientName = "Loading...";
            _model.ExaminationTypeName = Visit!.ExaminationTypeName;
            _model.RadiologistId = Visit.RadiologistId;
            _model.TechnicianId = Visit.TechnicianId;
            _model.ReferralDoctorId = Visit.ReferralDoctorId;
            _model.ClinicalIndication = Visit.ClinicalIndication;
            _model.Priority = Visit.Priority;
            _model.Notes = Visit.Notes;
            _model.Discount = Visit.Discount;
            _model.IsDiscountPercentage = Visit.IsDiscountPercentage;
        }
    }

    private async Task SubmitAsync()
    {
        if (!_editContext.Validate())
            return;

        if (!IsEdit && _selectedPatient is null)
        {
            Snackbar.Add("Select a patient.", Severity.Warning);
            return;
        }

        if (!IsEdit && _selectedType is null)
        {
            Snackbar.Add("Select an examination type.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            if (IsEdit)
            {
                await ExaminationService.UpdateAsync(Visit!.Id, new ExaminationUpdateInput
                {
                    RadiologistId = _model.RadiologistId,
                    TechnicianId = _model.TechnicianId,
                    ReferralDoctorId = string.IsNullOrWhiteSpace(_model.ReferralDoctorId) ? null : _model.ReferralDoctorId,
                    ClinicalIndication = _model.ClinicalIndication,
                    Priority = _model.Priority,
                    Notes = _model.Notes,
                    Discount = _model.Discount,
                    IsDiscountPercentage = _model.IsDiscountPercentage,
                });
                Snackbar.Add("Visit updated.", Severity.Success);
            }
            else
            {
                await ExaminationService.CreateAsync(new ExaminationInput
                {
                    PatientId = _selectedPatient!.Id,
                    ExaminationTypeId = _selectedType!.Id,
                    RadiologistId = _model.RadiologistId,
                    TechnicianId = _model.TechnicianId,
                    ReferralDoctorId = string.IsNullOrWhiteSpace(_model.ReferralDoctorId) ? null : _model.ReferralDoctorId,
                    ClinicalIndication = _model.ClinicalIndication,
                    Priority = _model.Priority,
                    Discount = _model.Discount,
                    IsDiscountPercentage = _model.IsDiscountPercentage,
                    Paid = _model.Paid,
                    Notes = _model.Notes,
                });
                Snackbar.Add("Visit created.", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server. Please try again.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelAsync()
        => MudDialog.Cancel();

    private sealed class VisitFormModel
    {
        public string PatientName { get; set; } = string.Empty;
        public string ExaminationTypeName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Radiologist is required.")]
        public string RadiologistId { get; set; } = string.Empty;

        [Required(ErrorMessage = "Technician is required.")]
        public string TechnicianId { get; set; } = string.Empty;

        public string? ReferralDoctorId { get; set; }

        [Required(ErrorMessage = "Clinical indication is required.")]
        [MaxLength(1000, ErrorMessage = "Clinical indication must be 1000 characters or fewer.")]
        public string ClinicalIndication { get; set; } = string.Empty;

        public string Priority { get; set; } = "Routine";
        public decimal Discount { get; set; }
        public bool IsDiscountPercentage { get; set; }
        public decimal Paid { get; set; }
        public string? Notes { get; set; }
    }
}
