@page "/radiologist"
@attribute [Authorize]

<PageHeader Icon="@Icons.Material.Filled.Biotech" Title="@T.ReadingRoom.Title"
            Subtitle="@T.ReadingRoom.Subtitle"
            ShowSearch="false"
            OnRefresh="RefreshQueueAsync">
    <MudChip T="string" Color="Color.Primary" Size="Size.Medium" Label="true" Variant="Variant.Outlined">
        @PendingCount @T.ReadingRoom.Pending
    </MudChip>
    <MudChip T="string" Color="Color.Secondary" Size="Size.Medium" Label="true" Variant="Variant.Outlined">
        @ImagedCount @T.ReadingRoom.Imaged
    </MudChip>
</PageHeader>

<div class="reading-room @(_worklistCollapsed ? "wl-collapsed" : string.Empty) @(_reportCollapsed ? "rpt-collapsed" : string.Empty)">
    <!-- â•â•â•â•â•â•â•â•â•â• Worklist pane â•â•â•â•â•â•â•â•â•â• -->
    <section class="reading-room-pane rr-worklist">
        <div class="rr-pane-header">
            <MudText Typo="Typo.subtitle1" Class="font-weight-medium">@T.ReadingRoom.ReadingQueue</MudText>
            <MudTextField T="string"
                          Value="@_filter"
                          ValueChanged="OnFilterChanged"
                          Placeholder="@T.ReadingRoom.FilterPlaceholder"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="rr-search" />
        </div>
        <div class="rr-worklist-items">
            @if (_loadingQueue)
            {
                <MudProgressCircular Size="Size.Large" Class="mx-auto d-block my-8" Indeterminate="true" />
            }
            else if (_queueError is not null)
            {
                <ErrorState Icon="@Icons.Material.Filled.CloudOff"
                            Title="@T.ReadingRoom.QueueLoadErrorTitle"
                            Message="@_queueError"
                            RetryLabel="@T.Common.Retry"
                            Action="LoadQueueAsync" />
            }
            else if (!Queue.Any())
            {
                <EmptyState Icon="@Icons.Material.Filled.MedicalServices"
                            Title="@T.ReadingRoom.NoImagedStudies"
                            Message="@T.ReadingRoom.NoImagedStudiesMessage" />
            }
            else
            {
                @foreach (var item in Queue)
                {
                    var current = item;
                    <button type="button"
                            class="rr-worklist-item @(IsSelected(current) ? "selected" : string.Empty)"
                            @onclick="() => SelectExamAsync(current)">
                        <div class="rr-item-top">
                            <span class="rr-prio @PriorityClass(current.Priority)" title="@current.Priority" aria-hidden="true"></span>
                            <span class="rr-item-name">@current.PatientName</span>
                            <span class="rr-item-time">@current.DateLabel</span>
                        </div>
                        <div class="rr-item-exam">
                            <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Size="Size.Small" />
                            <span>@current.ExamName</span>
                        </div>
                        <div class="rr-item-meta">
                            <StatusChip Token="@current.ReportStatusKey">@current.ReportStatus</StatusChip>
                            <StatusChip Token="@current.Priority">@current.Priority</StatusChip>
                            @if (current.StudyInstanceUid is null)
                            {
                                @if (IsLinking(current))
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="rr-link-busy" />
                                }
                                else
                                {
                                    <button type="button"
                                            class="rr-link-btn"
                                            title="@T.ReadingRoom.LoadImages"
                                            aria-label="@T.ReadingRoom.LoadImages"
                                            @onclick="() => LinkImagesAsync(current)"
                                            @onclick:stopPropagation="true">
                                        <MudIcon Icon="@Icons.Material.Filled.ImageSearch" Size="Size.Small" />
                                        <span>@T.ReadingRoom.LoadImages</span>
                                    </button>
                                }
                            }
                        </div>
                    </button>
                }
            }
        </div>
    </section>

    <!-- â•â•â•â•â•â•â•â•â•â• Image viewer pane â•â•â•â•â•â•â•â•â•â• -->
    <section class="reading-room-pane rr-viewer @(_viewerFullscreen ? "fullscreen" : string.Empty)">
        <div class="rr-pane-header">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Monitor" Size="Size.Small" />
                <MudText Typo="Typo.subtitle1" Class="font-weight-medium">@T.ReadingRoom.ImageViewer</MudText>
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="rr-pane-toggles">
                <MudTooltip Placement="Placement.Bottom" Text="@(_worklistCollapsed ? T.ReadingRoom.ShowWorklist : T.ReadingRoom.HideWorklist)">
                    <MudIconButton Icon="@(_worklistCollapsed
                                               ? (T.IsRTL ? Icons.Material.Filled.ChevronLeft : Icons.Material.Filled.ChevronRight)
                                               : (T.IsRTL ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ChevronLeft))"
                                   Size="Size.Small"
                                   Color="Color.Default"
                                   aria-label="@(_worklistCollapsed ? T.ReadingRoom.ShowWorklist : T.ReadingRoom.HideWorklist)"
                                   OnClick="ToggleWorklist" />
                </MudTooltip>
                <MudTooltip Placement="Placement.Bottom" Text="@(_reportCollapsed ? T.ReadingRoom.ShowReport : T.ReadingRoom.HideReport)">
                    <MudIconButton Icon="@(_reportCollapsed
                                               ? (T.IsRTL ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ChevronLeft)
                                               : (T.IsRTL ? Icons.Material.Filled.ChevronLeft : Icons.Material.Filled.ChevronRight))"
                                   Size="Size.Small"
                                   Color="Color.Default"
                                   aria-label="@(_reportCollapsed ? T.ReadingRoom.ShowReport : T.ReadingRoom.HideReport)"
                                   OnClick="ToggleReport" />
                </MudTooltip>
                <MudTooltip Placement="Placement.Bottom" Text="@(_viewerFullscreen ? T.ReadingRoom.ExitFullscreen : T.ReadingRoom.Fullscreen)">
                    <MudIconButton Icon="@(_viewerFullscreen ? Icons.Material.Filled.CloseFullscreen : Icons.Material.Filled.OpenInFull)"
                                   Size="Size.Small"
                                   Color="Color.Default"
                                   aria-label="@(_viewerFullscreen ? T.ReadingRoom.ExitFullscreen : T.ReadingRoom.Fullscreen)"
                                   OnClick="ToggleViewerFullscreen" />
                </MudTooltip>
            </MudStack>
            <span class="rr-modality">@(Selected?.ExamName ?? "-")</span>
        </div>
        <div class="rr-viewer-stage">
            @if (Selected is null)
            {
                <EmptyState Icon="@Icons.Material.Filled.Biotech"
                            Title="@T.ReadingRoom.NoStudySelected"
                            Message="@T.ReadingRoom.SelectStudyMessage" />
            }
            else if (SelectedStudyUrl is { } viewerUrl)
            {
                <iframe class="rr-ohif-frame" src="@viewerUrl" title="@Selected.ExamName" allowfullscreen></iframe>
            }
            else
            {
                <div class="rr-placeholder">
                    <MudIcon Icon="@Icons.Material.Filled.Biotech" Size="Size.Large" Class="rr-placeholder-icon" />
                    <MudText Typo="Typo.h6" Class="text-secondary">@Selected.PatientName</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary">@Selected.ExamName - @Selected.PatientCode</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary">@Selected.Priority @T.ReadingRoom.Priority</MudText>
                    <MudText Typo="Typo.caption" Class="mt-2">@T.ReadingRoom.NoImagedStudiesMessage</MudText>
                </div>
            }
        </div>
        @if (Selected is not null && SelectedStudyUrl is null)
        {
            <div class="rr-thumbnails">
                <span class="rr-thumbs-label">@T.ReadingRoom.Series</span>
                @for (var i = 1; i <= SeriesCount; i++)
                {
                    var index = i;
                    <button type="button"
                            class="rr-thumb @(index == _selectedSeries ? "selected" : string.Empty)"
                            title="@(T.FormatValue(T.ReadingRoom.SeriesThumbTitle, index))"
                            @onclick="() => _selectedSeries = index">
                        <MudText Typo="Typo.caption">S@index</MudText>
                    </button>
                }
            </div>
        }
    </section>

    <!-- â•â•â•â•â•â•â•â•â•â• Report pane â•â•â•â•â•â•â•â•â•â• -->
    <section class="reading-room-pane rr-report">
        @if (Selected is null)
        {
            <div class="rr-report-empty">
                <EmptyState Icon="@Icons.Material.Filled.Assignment"
                            Title="@T.ReadingRoom.NoReport"
                            Message="@T.ReadingRoom.SelectStudyToRead" />
            </div>
        }
        else if (_loadingReport)
        {
            <div class="rr-report-empty">
                <MudProgressCircular Size="Size.Large" Indeterminate="true" />
            </div>
        }
        else if (_reportError is not null)
        {
            <div class="rr-report-empty">
                <ErrorState Icon="@Icons.Material.Filled.ErrorOutline"
                            Title="@T.ReadingRoom.ReportLoadErrorTitle"
                            Message="@_reportError"
                            RetryLabel="@T.Common.Retry"
                            Action="ReloadSelectedAsync" />
            </div>
        }
        else if (_report is null)
        {
            <div class="rr-report-empty">
                <EmptyState Icon="@Icons.Material.Filled.Assignment"
                            Title="@T.ReadingRoom.NoReport"
                            Message="@T.ReadingRoom.NoDraftMessage"
                            ActionLabel="@T.ReadingRoom.StartReport"
                            Action="StartReportAsync" />
            </div>
        }
        else
        {
            <div class="rr-pane-header">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudAvatar Size="Size.Small" Color="Color.Primary" Class="text-subtitle2">@Initials(Selected.PatientName)</MudAvatar>
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-medium">@Selected.PatientName</MudText>
                        <MudText Typo="Typo.caption" Class="text-secondary">@Selected.PatientCode â€¢ v@(_report.CurrentVersionNumber)</MudText>
                    </div>
                </MudStack>
                <StatusChip Token="@_report.StatusKey">@_report.Status</StatusChip>
            </div>

            <div class="rr-patient-summary">
                <div class="rr-summary-block">
                    <span class="rr-summary-label">@T.ReadingRoom.ClinicalIndication</span>
                    <span class="rr-summary-value">@(string.IsNullOrWhiteSpace(Selected.Indication) ? T.Common.None : Selected.Indication)</span>
                </div>
                <MudStack Row="true" Spacing="2">
                    <div class="rr-summary-cell"><span class="rr-summary-label">@T.ReadingRoom.Exam</span><span>@Selected.ExamName- @Selected.Priority</span></div>
                    <div class="rr-summary-cell"><span class="rr-summary-label">@T.Common.Status</span><span>@_report.Status</span></div>
                </MudStack>
            </div>

            <MudDivider />

            <div class="rr-report-body">
                @if (!string.IsNullOrWhiteSpace(_report.CancelReason) && _report.StatusKey == "Cancelled")
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                        @(T.FormatValue(T.ReadingRoom.CancelledWithReason, _report.CancelReason))
                    </MudAlert>
                }

                <div class="d-flex align-center mb-1">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-medium">@T.ReadingRoom.Sections</MudText>
                    <MudSpacer />
                    @if (CanEdit)
                    {
                        <MudTooltip Placement="Placement.Bottom" Text="@T.ReportTemplate.Title">
                            <MudIconButton Icon="@Icons.Material.Filled.Newspaper"
                                           Size="Size.Small"
                                           aria-label="@T.ReportTemplate.Title"
                                           OnClick="OpenTemplatePicker" />
                        </MudTooltip>
                    }
                    <MudTooltip Placement="Placement.Bottom" Text="@T.ReportVersions.Title">
                        <MudIconButton Icon="@Icons.Material.Filled.History"
                                       Size="Size.Small"
                                       aria-label="@T.ReportVersions.Title"
                                       OnClick="OpenVersionsAsync" />
                    </MudTooltip>
                </div>

                @foreach (var section in _sections)
                {
                    var currentSection = section;
                    <MudTextField T="string"
                                  @bind-Value="currentSection.Body"
                                  Label="@currentSection.Label"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="@(currentSection.Position == 3 ? 5 : 3)"
                                  Disabled="@(!CanEdit || currentSection.Locked)"
                                  Immediate="true"
                                  Class="mb-3" />
                }

                <MudDivider Class="my-3" />

                <MudText Typo="Typo.subtitle1" Class="font-weight-medium mb-2">@T.ReadingRoom.Findings</MudText>
                @if (_findings.Any())
                {
                    @foreach (var finding in _findings)
                    {
                        var currentFinding = finding;
                        <div class="d-flex align-center mb-2 pa-2" style="border:1px solid var(--mud-palette-lines-default,#e0e0e0);border-radius:8px;">
                            <MudStack Spacing="0" Class="flex-grow-1">
                                <MudText Typo="Typo.subtitle2">@currentFinding.Region</MudText>
                                <MudText Typo="Typo.body2" Class="text-secondary">@currentFinding.Description</MudText>
                            </MudStack>
                            @if (CanEdit)
                            {
                                <MudSelect T="string"
                                           Value="@currentFinding.Severity"
                                           ValueChanged="@(s => OnSeverityChangedAsync(currentFinding, s))"
                                           Margin="Margin.Dense"
                                           Variant="Variant.Outlined"
                                           Class="flex-shrink-0"
                                           Style="min-width:120px;">
                                    @foreach (var level in SeverityOptions)
                                    {
                                        <MudSelectItem T="string" Value="@level">@level</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudTooltip Placement="Placement.Bottom" Text="@T.ReadingRoom.RemoveFinding">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   aria-label="@T.ReadingRoom.RemoveFinding"
                                                   OnClick="@(() => RemoveFindingAsync(currentFinding))"
                                                   Class="ms-1" />
                                </MudTooltip>
                            }
                        </div>
                    }
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="text-secondary">@T.ReadingRoom.NoFindings</MudText>
                }

                @if (CanEdit)
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle1" Class="font-weight-medium mb-2">@T.ReadingRoom.AddFinding</MudText>
                    <MudTextField T="string"
                                  @bind-Value="_newRegion"
                                  Label="@T.ReadingRoom.RegionAnatomy"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true" />
                    <MudTextField T="string"
                                  @bind-Value="_newDescription"
                                  Label="@T.ReadingRoom.Description"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="2"
                                  Immediate="true"
                                  Class="mt-2" />
                    <MudSelect T="string"
                               @bind-Value="_newSeverity"
                               Label="@T.ReadingRoom.Severity"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="mt-2">
                        @foreach (var level in SeverityOptions)
                        {
                            <MudSelectItem T="string" Value="@level">@level</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               Class="mt-2"
                               OnClick="AddFindingAsync"
                               Disabled="@(string.IsNullOrWhiteSpace(_newRegion) || string.IsNullOrWhiteSpace(_newDescription))">@T.ReadingRoom.AddFinding</MudButton>
                }
            </div>

            <div class="rr-report-actions">
                @if (CanEdit)
                {
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync" Disabled="_busy">@T.ReadingRoom.SaveDraft</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.CancelPresentation" OnClick="OpenCancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
                    </MudStack>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="FinalizeAsync" Disabled="_busy">@T.ReadingRoom.SignReport</MudButton>
                }
                else if (_report.StatusKey == "Finalized")
                {
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.EditNote" OnClick="OpenAmendAsync" Disabled="_busy">@T.ReadingRoom.Amend</MudButton>
                        <MudChip T="string" Color="Color.Success" Size="Size.Medium" Variant="Variant.Filled" Label="true">@(T.FormatValue(T.ReadingRoom.SignedAt, _report.FinalizedAt?.ToString("yyyy-MM-dd") ?? "-"))</MudChip>
                    </MudStack>
                }
                else if (_report.StatusKey == "Cancelled")
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Medium" Variant="Variant.Outlined">@T.ReadingRoom.Cancelled</MudChip>
                }
            </div>
        }
    </section>
</div>
