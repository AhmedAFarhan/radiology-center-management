@inject InventoryService InventoryService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Inventory2" Title="@(_stock?.ItemName ?? "Item Stock")" />
        @if (_loadError is not null)
        {
            <ErrorState Title="Couldn't load stock" Message="@_loadError" Action="LoadStockAsync" />
        }
        else if (_stock is null)
        {
            <PageSkeleton Rows="4" />
        }
        else
        {
            <MudText Typo="Typo.body2" Class="text-secondary mb-3">
                Stock on hand: <b>@_stock.StockOnHand</b>
            </MudText>

            <MudText Typo="Typo.subtitle2" Class="mb-1">Batches</MudText>
            <MudSimpleTable Dense="true">
                <thead>
                    <tr>
                        <th>Lot</th>
                        <th>Expiry</th>
                        <th>Remaining</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_stock.Batches.Count == 0)
                    {
                        <tr>
                            <td colspan="4">No batches recorded.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var batch in _stock.Batches)
                        {
                            <tr>
                                <td>@batch.LotNumber</td>
                                <td>@(batch.ExpiryDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>@batch.QuantityRemaining</td>
                                <td>
                                    <MudChip T="string" Size="Size.Small" Color="@(batch.IsExpired ? Color.Error : Color.Success)">@(batch.IsExpired ? "Expired" : "OK")</MudChip>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2" Class="mb-1">Issue Stock</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudNumericField T="int?" @bind-Value="_quantity"
                                     Label="Quantity"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="1" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_reference"
                                  Label="Reference"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_notes"
                                  Label="Notes"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">Close</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="IssueAsync" Disabled="_busy || _stock is null || _loadError is not null">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>Issue Stock</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string ItemId { get; set; } = string.Empty;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private ItemStockDto? _stock;
    private string? _loadError;
    private int? _quantity;
    private string? _reference;
    private string? _notes;
    private bool _busy;

    protected override async Task OnInitializedAsync()
        => await LoadStockAsync();

    private async Task LoadStockAsync()
    {
        _loadError = null;
        try
        {
            _stock = await InventoryService.GetStockAsync(ItemId);
        }
        catch (ApiException ex)
        {
            _loadError = ex.Message;
        }
        catch (Exception)
        {
            _loadError = "Unable to reach the server.";
        }
    }

    private async Task IssueAsync()
    {
        if (_quantity is not { } qty || qty <= 0)
        {
            Snackbar.Add("Enter a quantity greater than zero.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await InventoryService.IssueStockAsync(ItemId, new IssueStockInput
            {
                Quantity = qty,
                Reference = _reference,
                Notes = _notes,
            });

            Snackbar.Add($"Issued {qty} unit(s).", Severity.Success);
            _quantity = null;
            _reference = null;
            _notes = null;
            await LoadStockAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelAsync()
        => MudDialog.Cancel();
}
