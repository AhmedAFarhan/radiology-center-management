@inject InventoryService InventoryService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.ReceiptLong" Title="@(_po is null ? T.PoDialog.OrderDetails : T.FormatValue(T.PoDialog.OrderTitle, _po.OrderNumber))" />
        @if (_loading)
        {
            <DialogSkeleton Rows="4" />
        }
        else if (_error is not null)
        {
            <ErrorState Title="@T.PoDialog.LoadErrorTitle" Message="@_error" Action="LoadAsync" />
        }
        else if (_po is not null)
        {
            <MudText Typo="Typo.body2" Class="text-secondary mb-3">
                @_po.SupplierName · <StatusChip Token="@_po.Status">@FormatStatus(_po.Status)</StatusChip>
            </MudText>

            <MudSimpleTable Dense="true">
                <thead>
                    <tr>
                        <th>@T.PoDialog.Item</th>
                        <th>@T.PoDialog.Ordered</th>
                        <th>@T.PoDialog.Received</th>
                        <th>@T.PoDialog.UnitCost</th>
                        <th>@T.PoDialog.Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _po.Items)
                    {
                        <tr>
                            <td>@item.ItemName</td>
                            <td>@item.QuantityOrdered</td>
                            <td>@item.QuantityReceived</td>
                            <td>@item.UnitCost.ToString("C")</td>
                            <td>@((item.QuantityOrdered * item.UnitCost).ToString("C"))</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="4" class="font-weight-medium text-right">@T.PoDialog.Total</td>
                        <td class="font-weight-medium">@Total().ToString("C")</td>
                    </tr>
                </tbody>
            </MudSimpleTable>

            @if (!string.IsNullOrWhiteSpace(_po.Notes))
            {
                <MudText Typo="Typo.body2" Class="mt-3 text-secondary">@_po.Notes</MudText>
            }

            <MudText Typo="Typo.caption" Class="mt-3 text-secondary">
                @T.PoDialog.ExpectedDelivery @(_po.ExpectedDeliveryAt?.ToString("dd MMM yyyy") ?? T.PoDialog.NotSet)
                @if (_po.ReceivedAt is not null)
                {
                    <text> · @T.PoDialog.ReceivedAt @_po.ReceivedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</text>
                }
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CloseAsync">@T.Common.Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string PurchaseOrderId { get; set; } = string.Empty;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private PurchaseOrderDto? _po;
    private string? _error;
    private bool _loading;

    protected override async Task OnInitializedAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _po = await InventoryService.GetPurchaseOrderByIdAsync(PurchaseOrderId);
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = T.PoDialog.Unreachable;
        }
        finally
        {
            _loading = false;
        }
    }

    private decimal Total()
        => _po is null ? 0 : _po.Items.Sum(i => i.QuantityOrdered * i.UnitCost);

    private static string FormatStatus(string status) => status switch
    {
        "PartiallyReceived" => "Partially Received",
        _ => status,
    };

    private void CloseAsync()
        => MudDialog.Close();
}

