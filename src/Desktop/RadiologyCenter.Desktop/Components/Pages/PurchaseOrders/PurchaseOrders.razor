@page "/inventory/purchase-orders"
@attribute [Authorize]
@inherits ListPageBase<PurchaseOrderDto>
@inject InventoryService InventoryService

<PageHeader Icon="@Icons.Material.Filled.ReceiptLong" Title="@T.PurchaseOrders.Title"
            Subtitle="@T.PurchaseOrders.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.PurchaseOrders.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.PurchaseOrders.NewOrder</MudButton>
</PageHeader>

<MudTable T="PurchaseOrderDto" @ref="Table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="PurchaseOrderDto" SortLabel="@("OrderNumber")">@T.PurchaseOrders.Order</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PurchaseOrderDto" SortLabel="@("SupplierId")">@T.PurchaseOrders.Supplier</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PurchaseOrderDto" SortLabel="@("Status")">@T.Common.Status</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PurchaseOrderDto" SortLabel="@("ExpectedDeliveryAt")">@T.PurchaseOrders.Expected</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.PurchaseOrders.Order">
            <MudText Class="font-weight-medium mono-text">@context.OrderNumber</MudText>
        </MudTd>
        <MudTd DataLabel="@T.PurchaseOrders.Supplier">@context.SupplierName</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <StatusChip Token="@context.Status">@FormatStatus(context.Status)</StatusChip>
        </MudTd>
        <MudTd DataLabel="@T.PurchaseOrders.Expected">@(context.ExpectedDeliveryAt?.ToString("dd MMM yyyy") ?? "-")</MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            @if (context.Status == "Draft")
            {
                <MudTooltip Placement="Placement.Bottom" Text="@T.PurchaseOrders.PlaceOrder">
                    <MudIconButton Icon="@Icons.Material.Filled.Send" Size="Size.Small" Color="Color.Primary" aria-label="@T.PurchaseOrders.PlaceOrder" OnClick="@(() => PlaceAsync(context))" />
                </MudTooltip>
            }
            @if (context.Status is "Ordered" or "PartiallyReceived")
            {
                <MudTooltip Placement="Placement.Bottom" Text="@T.PurchaseOrders.Receive">
                    <MudIconButton Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" Color="Color.Info" aria-label="@T.PurchaseOrders.Receive" OnClick="@(() => OpenReceiveDialogAsync(context))" />
                </MudTooltip>
            }
            @if (context.Status is "Draft" or "Ordered")
            {
                <MudTooltip Placement="Placement.Bottom" Text="@T.PurchaseOrders.CancelOrder">
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Default" aria-label="@T.PurchaseOrders.CancelOrder" OnClick="@(() => CancelAsync(context))" />
                </MudTooltip>
            }
            <MudTooltip Placement="Placement.Bottom" Text="@T.PurchaseOrders.View">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Default" aria-label="@T.PurchaseOrders.View" OnClick="@(() => OpenViewDialogAsync(context))" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <TableNoRecords LoadError="@LoadError"
                        Offline="@Offline"
                        ErrorTitle="@T.PurchaseOrders.LoadErrorTitle"
                        EmptyIcon="@Icons.Material.Filled.ReceiptLong"
                        EmptyTitle="@T.PurchaseOrders.NoOrdersTitle"
                        EmptyMessage="@T.PurchaseOrders.EmptyMessage"
                        EmptyActionLabel="@T.PurchaseOrders.CreateFirstOrder"
                        OnReload="ReloadAsync"
                        OnEmptyAction="OpenCreateDialogAsync" />
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>


