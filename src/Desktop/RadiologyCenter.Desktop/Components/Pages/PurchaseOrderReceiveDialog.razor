@inject InventoryService InventoryService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.ReceiptLong" Title="@(_po is null ? "Receive Order" : $"Receive {_po.OrderNumber}")" />
        @if (_loading)
        {
            <DialogSkeleton Rows="4" />
        }
        else if (_error is not null)
        {
            <ErrorState Title="Couldn't load purchase order" Message="@_error" Action="LoadAsync" />
        }
        else if (_po is not null)
        {
            <MudText Typo="Typo.body2" Class="text-secondary mb-3">@_po.SupplierName · @_po.Status</MudText>

            @foreach (var line in _receiveLines)
            {
                var item = _po!.Items.First(i => i.Id == line.Id);
                var remaining = item.QuantityOrdered - item.QuantityReceived;

                <MudDivider Class="my-2" />
                <MudText Class="font-weight-medium">@item.ItemName</MudText>
                <MudText Typo="Typo.caption" Class="text-secondary">
                    Ordered @item.QuantityOrdered · Received @item.QuantityReceived · Remaining @remaining
                </MudText>

                <MudGrid Spacing="2" Class="mt-1">
                    <MudItem xs="12" sm="4">
                        <MudNumericField T="int?"
                                         @bind-Value="line.Quantity"
                                         Label="Receive Qty"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="1"
                                         Max="@remaining" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="line.LotNumber"
                                      Label="Lot Number"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudDatePicker @bind-Date="line.ExpiryDate"
                                       Label="Expiry Date"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true" />
                    </MudItem>
                </MudGrid>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">Close</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy || _po is null">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>Receive Items</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string PurchaseOrderId { get; set; } = string.Empty;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private PurchaseOrderDto? _po;
    private List<ReceiveLineModel> _receiveLines = new();
    private string? _error;
    private bool _loading;
    private bool _busy;

    protected override async Task OnInitializedAsync()
        => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _po = await InventoryService.GetPurchaseOrderByIdAsync(PurchaseOrderId);
            _receiveLines = _po.Items.Select(i => new ReceiveLineModel
            {
                Id = i.Id,
                ItemId = i.ItemId,
                Quantity = i.QuantityOrdered - i.QuantityReceived,
            }).ToList();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = "Unable to reach the server.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (_po is null)
            return;

        var lines = _receiveLines
            .Where(l => l.Quantity is > 0)
            .ToList();

        if (lines.Count == 0)
        {
            Snackbar.Add("Enter a quantity for at least one item.", Severity.Warning);
            return;
        }

        if (lines.Any(l => string.IsNullOrWhiteSpace(l.LotNumber)))
        {
            Snackbar.Add("A lot number is required for each received item.", Severity.Warning);
            return;
        }

        if (lines.Any(l => l.ExpiryDate is not null && l.ExpiryDate.Value.Date < DateTime.Today))
        {
            Snackbar.Add("Expiry date cannot be in the past.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var input = new ReceivePurchaseOrderInput
            {
                Lines = lines.Select(l => new ReceivePurchaseOrderLineInput
                {
                    ItemId = l.ItemId,
                    Quantity = l.Quantity!.Value,
                    LotNumber = l.LotNumber.Trim(),
                    ExpiryDate = l.ExpiryDate,
                }).ToList(),
            };

            await InventoryService.ReceivePurchaseOrderAsync(_po.Id, input);
            Snackbar.Add("Items received.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server. Please try again.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelAsync()
        => MudDialog.Cancel();

    private sealed class ReceiveLineModel
    {
        public string Id { get; set; } = string.Empty;
        public string ItemId { get; set; } = string.Empty;
        public int? Quantity { get; set; }
        public string LotNumber { get; set; } = string.Empty;
        public DateTime? ExpiryDate { get; set; }
    }
}

