@inject ResourceService ResourceService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.BeachAccess" Title="@(Leave is null ? T.Leave.NewLeave : T.Leave.EditLeave)" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudAutocomplete T="StaffDto"
                                     @bind-Value="_selectedStaff"
                                     Label="@T.LeaveDialog.StaffSearch"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchStaffAsync"
                                     ToStringFunc="@(s => s is null ? string.Empty : s.FullName)"
                                     Clearable="true"
                                     Disabled="_busy" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.LeaveType"
                               Label="@T.LeaveDialog.LeaveType"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.LeaveType)">
                        @foreach (var type in LeaveTypes)
                        {
                            <MudSelectItem T="string" Value="@type.Key">@type.Value</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_model.StartDate"
                                   Label="@T.Leave.StartDate"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="w-100" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_model.EndDate"
                                   Label="@T.Leave.EndDate"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="w-100" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Reason"
                                  Label="@T.Leave.Reason"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="3"
                                  Immediate="true" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@(IsEdit ? T.LeaveDialog.SaveChanges : T.LeaveDialog.CreateLeave)</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>


