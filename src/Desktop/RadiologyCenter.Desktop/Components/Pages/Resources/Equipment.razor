@page "/resources/equipment"
@attribute [Authorize]
@inherits ListPageBase<EquipmentDto>
@inject ResourceService ResourceService

<PageHeader Icon="@Icons.Material.Filled.Biotech" Title="@T.Equipment.Title"
            Subtitle="@T.Equipment.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.Equipment.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Equipment.Add</MudButton>
</PageHeader>

<MudTable Breakpoint="Breakpoint.Sm" T="EquipmentDto" @ref="Table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="EquipmentDto" SortLabel="@("Name")">@T.Common.Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="EquipmentDto" SortLabel="@("SerialNumber")">@T.Equipment.SerialNumber</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="EquipmentDto" SortLabel="@("Modality")">@T.Equipment.Modality</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh><MudTableSortLabel T="EquipmentDto" SortLabel="@("PurchaseDate")">@T.Equipment.PurchaseDate</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Active</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Common.Name">
            <MudText Class="font-weight-medium">@context.Name</MudText>
        </MudTd>
        <MudTd DataLabel="@T.Equipment.SerialNumber">@(string.IsNullOrWhiteSpace(context.SerialNumber) ? "-" : context.SerialNumber)</MudTd>
        <MudTd DataLabel="@T.Equipment.Modality">@context.Modality</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <StatusChip Token="@context.Status">@FormatStatus(context.Status)</StatusChip>
        </MudTd>
        <MudTd DataLabel="@T.Equipment.PurchaseDate">@(context.PurchaseDate?.ToString("yyyy-MM-dd") ?? "-")</MudTd>
        <MudTd DataLabel="@T.Common.Active">
            <ActiveStatusChip IsActive="context.IsActive" ActiveLabel="@T.Common.Active" InactiveLabel="@T.Common.Inactive" />
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudTooltip Placement="Placement.Bottom" Text="@T.Common.Edit">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Common.Edit" OnClick="@(() => OpenEditDialogAsync(context))" />
            </MudTooltip>
            <MudTooltip Placement="Placement.Bottom" Text="@T.Equipment.SetStatus">
                <MudIconButton Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Color="Color.Info" aria-label="@T.Equipment.SetStatus" OnClick="@(() => OpenStatusDialogAsync(context))" />
            </MudTooltip>
            <MudTooltip Placement="Placement.Bottom" Text="@T.Equipment.ToggleStatus">
                <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                               Size="Size.Small"
                               Color="@(context.IsActive ? Color.Default : Color.Success)"
                               aria-label="@T.Equipment.ToggleStatus"
                               OnClick="@(() => ToggleActiveAsync(context))" />
            </MudTooltip>
            <MudTooltip Placement="Placement.Bottom" Text="@T.Common.Delete">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Delete" OnClick="@(() => DeleteEquipmentAsync(context))" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <TableNoRecords LoadError="@LoadError"
                        Offline="@Offline"
                        ErrorTitle="@T.Equipment.LoadErrorTitle"
                        EmptyIcon="@Icons.Material.Filled.Biotech"
                        EmptyTitle="@T.Equipment.EmptyTitle"
                        EmptyMessage="@T.Equipment.EmptyMessage"
                        EmptyActionLabel="@T.Equipment.EmptyActionLabel"
                        OnReload="ReloadAsync"
                        OnEmptyAction="OpenCreateDialogAsync" />
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>