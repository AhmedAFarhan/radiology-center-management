@page "/resources/work-shifts"
@attribute [Authorize]
@inherits ListPageBase<WorkShiftDto>
@inject ResourceService ResourceService

<PageHeader Icon="@Icons.Material.Filled.CalendarMonth" Title="@T.WorkShift.Title"
            Subtitle="@T.WorkShift.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.WorkShift.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.WorkShift.Add</MudButton>
</PageHeader>

<MudTable T="WorkShiftDto" @ref="Table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="WorkShiftDto" SortLabel="@("Date")">@T.Common.Date</MudTableSortLabel></MudTh>
        <MudTh>@T.WorkShift.Staff</MudTh>
        <MudTh><MudTableSortLabel T="WorkShiftDto" SortLabel="@("StartTime")">@T.WorkShift.Start</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="WorkShiftDto" SortLabel="@("EndTime")">@T.WorkShift.End</MudTableSortLabel></MudTh>
        <MudTh>@T.WorkShift.Equipment</MudTh>
        <MudTh>@T.WorkShift.Notes</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Common.Date">
            <MudText Class="font-weight-medium">@context.Date.ToString("yyyy-MM-dd")</MudText>
            <MudText Typo="Typo.caption" Class="text-secondary">@context.Date.ToString("dddd")</MudText>
        </MudTd>
        <MudTd DataLabel="@T.WorkShift.Staff">@(ResolveStaff(context.StaffId))</MudTd>
        <MudTd DataLabel="@T.WorkShift.Start">@context.StartTime.ToString(@"hh\:mm")</MudTd>
        <MudTd DataLabel="@T.WorkShift.End">@context.EndTime.ToString(@"hh\:mm")</MudTd>
        <MudTd DataLabel="@T.WorkShift.Equipment">@(string.IsNullOrWhiteSpace(context.EquipmentId) ? "-" : ResolveEquipment(context.EquipmentId))</MudTd>
        <MudTd DataLabel="@T.WorkShift.Notes">@(string.IsNullOrWhiteSpace(context.Notes) ? "-" : context.Notes)</MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Common.Edit" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Delete" OnClick="@(() => DeleteShiftAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <TableNoRecords LoadError="@LoadError"
                        Offline="@Offline"
                        ErrorTitle="@T.WorkShift.LoadErrorTitle"
                        EmptyIcon="@Icons.Material.Filled.CalendarMonth"
                        EmptyTitle="@T.WorkShift.EmptyTitle"
                        EmptyMessage="@T.WorkShift.EmptyMessage"
                        EmptyActionLabel="@T.WorkShift.EmptyActionLabel"
                        OnReload="ReloadAsync"
                        OnEmptyAction="OpenCreateDialogAsync" />
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>