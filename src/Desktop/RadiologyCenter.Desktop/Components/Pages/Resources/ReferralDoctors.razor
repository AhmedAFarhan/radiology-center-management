@page "/resources/referral-doctors"
@attribute [Authorize]
@inherits ListPageBase<ReferralDoctorDto>
@inject ResourceService ResourceService

<PageHeader Icon="@Icons.Material.Filled.LocalHospital" Title="@T.ReferralDoctor.Title"
            Subtitle="@T.ReferralDoctor.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchValue="@SearchQuery"
            SearchPlaceholder="@T.ReferralDoctor.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.ReferralDoctor.Add</MudButton>
</PageHeader>

<MudTable T="ReferralDoctorDto" @ref="Table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="ReferralDoctorDto" SortLabel="@("LastName")">@T.Common.Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ReferralDoctorDto" SortLabel="@("Phone")">@T.ReferralDoctor.Phone</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ReferralDoctorDto" SortLabel="@("Email")">@T.ReferralDoctor.Email</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ReferralDoctorDto" SortLabel="@("Specialization")">@T.ReferralDoctor.Specialization</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ReferralDoctorDto" SortLabel="@("Hospital")">@T.ReferralDoctor.Hospital</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Common.Name">
            <MudText Class="font-weight-medium">@context.FullName</MudText>
        </MudTd>
        <MudTd DataLabel="@T.ReferralDoctor.Phone">@context.Phone</MudTd>
        <MudTd DataLabel="@T.ReferralDoctor.Email">@(string.IsNullOrWhiteSpace(context.Email) ? "-" : context.Email)</MudTd>
        <MudTd DataLabel="@T.ReferralDoctor.Specialization">@(string.IsNullOrWhiteSpace(context.Specialization) ? "-" : context.Specialization)</MudTd>
        <MudTd DataLabel="@T.ReferralDoctor.Hospital">@(string.IsNullOrWhiteSpace(context.Hospital) ? "-" : context.Hospital)</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <ActiveStatusChip IsActive="context.IsActive" ActiveLabel="@T.Common.Active" InactiveLabel="@T.Common.Inactive" />
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <RowActions IsActive="context.IsActive"
                        EditLabel="@T.Common.Edit"
                        ToggleLabel="@T.ReferralDoctor.ToggleStatus"
                        DeleteLabel="@T.Common.Delete"
                        OnEdit="@(() => OpenEditDialogAsync(context))"
                        OnToggle="@(() => ToggleActiveAsync(context))"
                        OnDelete="@(() => DeleteDoctorAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <TableNoRecords LoadError="@LoadError"
                        Offline="@Offline"
                        ErrorTitle="@T.ReferralDoctor.LoadErrorTitle"
                        EmptyIcon="@Icons.Material.Filled.LocalHospital"
                        EmptyTitle="@T.ReferralDoctor.EmptyTitle"
                        EmptyMessage="@T.ReferralDoctor.EmptyMessage"
                        EmptyActionLabel="@T.ReferralDoctor.EmptyActionLabel"
                        OnReload="ReloadAsync"
                        OnEmptyAction="OpenCreateDialogAsync" />
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>