@page "/resources/staff"
@attribute [Authorize]
@inject ResourceService ResourceService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@inject NavigationManager NavigationManager
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.Badge" Title="@T.Staff.Title"
            Subtitle="@T.Staff.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchValue="@SearchQuery"
            SearchPlaceholder="@T.Staff.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Staff.Add</MudButton>
</PageHeader>

<MudTable T="StaffDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="StaffDto" SortLabel="@("LastName")">@T.Common.Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="StaffDto" SortLabel="@("Position")">@T.Staff.Position</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="StaffDto" SortLabel="@("Department")">@T.Staff.Department</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="StaffDto" SortLabel="@("Specialization")">@T.Staff.Specialization</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="StaffDto" SortLabel="@("PhoneNumber")">@T.Staff.Phone</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="StaffDto" SortLabel="@("HireDate")">@T.Staff.HireDate</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Common.Name">
            <MudText Class="font-weight-medium">@context.FullName</MudText>
        </MudTd>
        <MudTd DataLabel="@T.Staff.Position">@FormatPosition(context.Position)</MudTd>
        <MudTd DataLabel="@T.Staff.Department">@(string.IsNullOrWhiteSpace(context.Department) ? "-" : context.Department)</MudTd>
        <MudTd DataLabel="@T.Staff.Specialization">@(string.IsNullOrWhiteSpace(context.Specialization) ? "-" : context.Specialization)</MudTd>
        <MudTd DataLabel="@T.Staff.Phone">@context.PhoneNumber</MudTd>
        <MudTd DataLabel="@T.Staff.HireDate">@context.HireDate.ToString("yyyy-MM-dd")</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? T.Common.Active : T.Common.Inactive)</MudChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Common.Edit" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                           Size="Size.Small"
                           Color="@(context.IsActive ? Color.Default : Color.Success)"
                           aria-label="@T.Staff.ToggleStatus"
                           OnClick="@(() => ToggleActiveAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Delete" OnClick="@(() => DeleteStaffAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.Staff.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        <EmptyState Icon="@Icons.Material.Filled.Badge"
                    Title="@T.Staff.EmptyTitle"
                    Message="@T.Staff.EmptyMessage"
                    ActionLabel="@T.Staff.EmptyActionLabel"
                    Action="OpenCreateDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>


