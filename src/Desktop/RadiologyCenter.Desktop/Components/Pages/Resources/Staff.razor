@page "/resources/staff"
@attribute [Authorize]
@inject ResourceService ResourceService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<PageHeader Title="Staff"
            Subtitle="Manage staff members"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="Search staff..."
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">Add Staff</MudButton>
</PageHeader>

<MudTable T="StaffDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="StaffDto" SortLabel="@("LastName")">Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="StaffDto" SortLabel="@("Position")">Position</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="StaffDto" SortLabel="@("Department")">Department</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="StaffDto" SortLabel="@("Specialization")">Specialization</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="StaffDto" SortLabel="@("PhoneNumber")">Phone</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="StaffDto" SortLabel="@("HireDate")">Hire Date</MudTableSortLabel></MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">
            <MudText Class="font-weight-medium">@context.FullName</MudText>
        </MudTd>
        <MudTd DataLabel="Position">@FormatPosition(context.Position)</MudTd>
        <MudTd DataLabel="Department">@(string.IsNullOrWhiteSpace(context.Department) ? "-" : context.Department)</MudTd>
        <MudTd DataLabel="Specialization">@(string.IsNullOrWhiteSpace(context.Specialization) ? "-" : context.Specialization)</MudTd>
        <MudTd DataLabel="Phone">@context.PhoneNumber</MudTd>
        <MudTd DataLabel="Hire Date">@context.HireDate.ToString("yyyy-MM-dd")</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">@(context.IsActive ? "Active" : "Inactive")</MudChip>
        </MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="Edit" OnClick="@(() => OpenEditDialogAsync(context))" />
            <MudIconButton Icon="@(context.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                           Size="Size.Small"
                           Color="@(context.IsActive ? Color.Default : Color.Success)"
                           aria-label="Toggle status"
                           OnClick="@(() => ToggleActiveAsync(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="Delete" OnClick="@(() => DeleteStaffAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="Couldn't load data"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        <EmptyState Icon="@Icons.Material.Filled.Badge"
                    Title="No staff members yet"
                    Message="Add staff before assigning shifts, salaries, or payroll."
                    ActionLabel="Add your first staff member"
                    Action="OpenCreateDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<StaffDto>? _table;
    private string? _search;
    private CancellationTokenSource? _searchCts;
    private string? _loadError;
    private bool _offline;

    private async Task<TableData<StaffDto>> LoadServerData(TableState state, CancellationToken ct)
    {
        try
        {
            var page = await ResourceService.GetStaffsPagedAsync(
                _search,
                state.SortLabel,
                state.SortDirection == SortDirection.Descending,
                state.Page + 1,
                state.PageSize,
                ct);

            _loadError = null;
            _offline = false;
            return new TableData<StaffDto> { Items = page.Items, TotalItems = page.TotalCount };
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _loadError = ex.Message;
            _offline = false;
            return new TableData<StaffDto> { Items = Array.Empty<StaffDto>(), TotalItems = 0 };
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
            _loadError = "Unable to reach the server.";
            _offline = true;
            return new TableData<StaffDto> { Items = Array.Empty<StaffDto>(), TotalItems = 0 };
        }
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value;

        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(400, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (_table is not null)
            await _table.ReloadServerData();
    }

    private Task ReloadAsync()
        => _table is null ? Task.CompletedTask : _table.ReloadServerData();

    private async Task OpenCreateDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<StaffEditorDialog>("New Staff", options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task OpenEditDialogAsync(StaffDto staff)
    {
        var parameters = new DialogParameters { ["Staff"] = staff };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<StaffEditorDialog>($"Edit {staff.FullName}", parameters, options);
        await ReloadIfSavedAsync(dialog);
    }

    private async Task ReloadIfSavedAsync(IDialogReference dialog)
    {
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await ReloadAsync();
    }

    private async Task ToggleActiveAsync(StaffDto staff)
    {
        try
        {
            if (staff.IsActive)
                await ResourceService.DeactivateStaffAsync(staff.Id);
            else
                await ResourceService.ActivateStaffAsync(staff.Id);

            Snackbar.Add(staff.IsActive ? "Staff member deactivated." : "Staff member activated.", Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
        }
    }

    private async Task DeleteStaffAsync(StaffDto staff)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Staff",
            $"Are you sure you want to delete {staff.FullName}? This cannot be undone.",
            "Delete",
            "Cancel");

        if (confirmed != true)
            return;

        try
        {
            await ResourceService.DeleteStaffAsync(staff.Id);
            Snackbar.Add("Staff member deleted.", Severity.Success);
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("Unable to reach the server.", Severity.Error);
        }
    }

    private static string FormatPosition(string position) => position switch
    {
        "Technician" => "Technician",
        "Radiologist" => "Radiologist",
        "Receptionist" => "Receptionist",
        "Nurse" => "Nurse",
        _ => position,
    };

    public void Dispose() => _searchCts?.Cancel();
}
