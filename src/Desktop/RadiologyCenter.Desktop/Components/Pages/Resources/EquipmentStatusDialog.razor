@inject ResourceService ResourceService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Biotech" Title="@(T.FormatValue(T.Equipment.SetStatusTitle, Equipment.Name))" />
        <MudText Typo="Typo.body2" Class="mb-2 text-secondary">
            @(T.Equipment.CurrentStatus): <MudChip T="string" Size="Size.Small" Color="@StatusColor(Equipment.Status)">@FormatStatus(Equipment.Status)</MudChip>
        </MudText>
        <MudSelect T="string"
                   @bind-Value="_status"
                   Label="@T.Common.Status"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Class="w-100">
            @foreach (var option in StatusOptions)
            {
                <MudSelectItem T="string" Value="@option.Key">@option.Value</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.EquipmentDialog.SaveStatus</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public EquipmentDto Equipment { get; set; } = default!;

    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;

    private static readonly Dictionary<string, string> StatusOptions = new()
    {
        ["Operational"] = "Operational",
        ["UnderMaintenance"] = "Under Maintenance",
        ["OutOfService"] = "Out of Service",
        ["Retired"] = "Retired",
    };

    private string _status = string.Empty;
    private bool _busy;

    protected override void OnInitialized()
        => _status = Equipment.Status;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_status))
        {
            Snackbar.Add(T.EquipmentDialog.SelectStatus, Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await ResourceService.SetEquipmentStatusAsync(Equipment.Id, _status);
            Snackbar.Add(T.EquipmentDialog.StatusUpdated, Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add(T.EquipmentDialog.Unreachable, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelAsync()
        => MudDialog.Cancel();

    private static string FormatStatus(string status) => status switch
    {
        "UnderMaintenance" => "Under Maintenance",
        "OutOfService" => "Out of Service",
        _ => status,
    };

    private static Color StatusColor(string status) => status switch
    {
        "Operational" => Color.Success,
        "UnderMaintenance" => Color.Warning,
        "OutOfService" => Color.Error,
        _ => Color.Default,
    };
}
