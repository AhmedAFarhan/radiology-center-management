@inject ResourceService ResourceService
@inject EnumOptionsService EnumOptionsService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Biotech" Title="@(T.FormatValue(T.Equipment.SetStatusTitle, Equipment.Name))" />
        <MudText Typo="Typo.body2" Class="mb-2 text-secondary">
            @(T.Equipment.CurrentStatus): <StatusChip Token="@Equipment.StatusKey">@Equipment.Status</StatusChip>
        </MudText>
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudSelect T="string"
                       @bind-Value="_model.Status"
                       For="@(() => _model.Status)"
                       Label="@T.Common.Status"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="w-100">
                @foreach (var option in _statusOptions)
                {
                    <MudSelectItem T="string" Value="@option.Key">@option.Value</MudSelectItem>
                }
            </MudSelect>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.EquipmentDialog.SaveStatus</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>


