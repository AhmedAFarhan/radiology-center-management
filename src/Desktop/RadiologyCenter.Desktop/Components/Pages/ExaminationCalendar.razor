@page "/examinations/calendar"
@attribute [Authorize]

<PageHeader Icon="@Icons.Material.Filled.CalendarMonth" Title="@T.ExamCalendar.Title"
            Subtitle="@T.ExamCalendar.Subtitle"
            OnRefresh="LoadDataAsync">

    <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Class="me-2">
        <MudButton OnClick="PreviousDay" StartIcon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small">@T.ExamCalendar.Prev</MudButton>
        <MudButton OnClick="GoToToday" Size="Size.Small">@T.ExamCalendar.Today</MudButton>
        <MudButton OnClick="NextDay" EndIcon="@Icons.Material.Filled.ChevronRight" Size="Size.Small">@T.ExamCalendar.Next</MudButton>
    </MudButtonGroup>

    <MudSelect T="string" Value="@_viewMode" ValueChanged="OnViewModeChanged" Variant="Variant.Outlined" Dense="true" Class="me-2" Style="width: 100px;">
        <MudSelectItem Value="@("day")">@T.ExamCalendar.DayView</MudSelectItem>
        <MudSelectItem Value="@("week")">@T.ExamCalendar.WeekView</MudSelectItem>
    </MudSelect>

    <MudSelect T="string?" Value="@_selectedModality" ValueChanged="OnModalityChanged" Variant="Variant.Outlined" Dense="true" Placeholder="@T.ExamCalendar.ModalityFilter" Clearable="true" Class="me-2" Style="width: 150px;">
        @foreach (var m in _modalities)
        {
            <MudSelectItem Value="@((string?)m)">@m</MudSelectItem>
        }
    </MudSelect>

    <MudSelect T="string?" Value="@_selectedEquipmentId" ValueChanged="OnEquipmentChanged" Variant="Variant.Outlined" Dense="true" Placeholder="@T.ExamCalendar.EquipmentFilter" Clearable="true" Style="width: 200px;">
        @foreach (var eq in _equipments)
        {
            <MudSelectItem Value="@((string?)eq.Id)">@eq.Name</MudSelectItem>
        }
    </MudSelect>
</PageHeader>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Class="d-flex mx-auto my-4" />
}
else
{
    <div class="cal-container">
        @* ── Day tabs (week view) ── *@
        @if (_viewMode == "week" && _weekDays.Any())
        {
            <div class="cal-day-tabs">
                @foreach (var day in _weekDays)
                {
                    <button class="cal-day-tab @(day.Date == _currentDate.Date ? "active" : "")"
                            @onclick="() => SelectDayAsync(day.Date)">
                        <span class="cal-day-name">@day.ToString("ddd")</span>
                        <span class="cal-day-num">@day.Day</span>
                    </button>
                }
            </div>
        }

        <MudPaper Elevation="1" Class="cal-paper">
            <div class="cal-scroll-wrapper">
                @* ── Left: resource names (fixed) ── *@
                <div class="cal-resource-col">
                    <div class="cal-resource-header">
                        <MudText Typo="Typo.caption" Class="cal-header-label">@T.ExamCalendar.Equipment</MudText>
                    </div>
                    @foreach (var resource in _resources)
                    {
                        <div class="cal-resource-row">
                            <div class="cal-resource-indicator" style="background: @GetModalityColor(resource.Type);"></div>
                            <div class="cal-resource-info">
                                <MudText Typo="Typo.body2" Class="cal-resource-name">@resource.Name</MudText>
                                <MudText Typo="Typo.caption" Class="cal-resource-type">@resource.Type</MudText>
                            </div>
                        </div>
                    }
                </div>

                @* ── Right: scrollable time grid ── *@
                <div class="cal-time-grid" @ref="_timeGridRef">
                    @* Time headers *@
                    <div class="cal-time-headers">
                        @foreach (var time in _timeHeaders)
                        {
                            <div class="cal-time-header-cell">
                                <MudText Typo="Typo.caption" Class="cal-time-label">@time</MudText>
                            </div>
                        }
                    </div>

                    @* Slot rows *@
                    @foreach (var resource in _resources)
                    {
                        <div class="cal-slot-row">
                            @foreach (var slot in resource.Slots)
                            {
                                var statusClass = GetSlotStatusClass(slot);
                                <div class="cal-slot-cell @statusClass @(slot.IsAvailable ? "available" : "occupied")"
                                     @onclick="() => OnSlotClick(slot)">
                                    @if (!slot.IsAvailable && slot.Exam is not null)
                                    {
                                        <div class="cal-slot-content">
                                            <MudText Typo="Typo.caption" Class="cal-slot-patient">@slot.Exam.PatientName</MudText>
                                            <MudText Typo="Typo.caption" Class="cal-slot-type">@slot.Exam.ExaminationTypeName</MudText>
                                            <MudText Typo="Typo.caption" Class="cal-slot-time">@slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")</MudText>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="cal-slot-empty">
                                            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="cal-slot-add-icon" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @* Current time indicator *@
                    @if (_currentTimeLeft.HasValue)
                    {
                        <div class="cal-now-line" style="left: @_currentTimeLeft.Value.ToString("F0")px;"></div>
                    }
                </div>
            </div>
        </MudPaper>

        @* ── Legend ── *@
        <div class="cal-legend">
            <div class="cal-legend-item">
                <span class="cal-legend-dot" style="background: #E8F5E9; border: 1px solid #A5D6A7;"></span>
                <MudText Typo="Typo.caption">@T.ExamCalendar.Available</MudText>
            </div>
            <div class="cal-legend-item">
                <span class="cal-legend-dot" style="background: #BBDEFB; border-left: 3px solid #1976D2;"></span>
                <MudText Typo="Typo.caption">@T.ExamCalendar.Scheduled</MudText>
            </div>
            <div class="cal-legend-item">
                <span class="cal-legend-dot" style="background: #FFE0B2; border-left: 3px solid #F57C00;"></span>
                <MudText Typo="Typo.caption">@T.ExamCalendar.CheckedIn</MudText>
            </div>
            <div class="cal-legend-item">
                <span class="cal-legend-dot" style="background: #E1BEE7; border-left: 3px solid #7B1FA2;"></span>
                <MudText Typo="Typo.caption">@T.ExamCalendar.InProgress</MudText>
            </div>
        </div>
    </div>
}

<style>
    /* ── Container ── */
    .cal-container { display: flex; flex-direction: column; gap: 8px; }

    /* ── Day tabs (week view) ── */
    .cal-day-tabs {
        display: flex; gap: 4px; padding: 4px 0;
    }
    .cal-day-tab {
        display: flex; flex-direction: column; align-items: center;
        padding: 6px 14px; border-radius: 8px; border: 1px solid var(--mud-palette-lines-default);
        background: var(--mud-palette-surface); cursor: pointer; transition: all 0.15s;
        min-width: 52px;
    }
    .cal-day-tab:hover { background: var(--mud-palette-gray-lighten); }
    .cal-day-tab.active {
        background: var(--mud-palette-primary); color: var(--mud-palette-primary-text);
        border-color: var(--mud-palette-primary);
    }
    .cal-day-tab.active .cal-day-name,
    .cal-day-tab.active .cal-day-num { color: var(--mud-palette-primary-text); }
    .cal-day-name { font-size: 11px; text-transform: uppercase; opacity: 0.7; font-weight: 500; }
    .cal-day-num   { font-size: 16px; font-weight: 700; line-height: 1.2; }

    /* ── Paper wrapper ── */
    .cal-paper { overflow: hidden; }

    /* ── Scroll wrapper ── */
    .cal-scroll-wrapper {
        display: flex; overflow-x: auto; overflow-y: hidden;
        max-height: calc(100vh - 240px);
    }

    /* ── Resource column (fixed) ── */
    .cal-resource-col {
        flex: 0 0 180px; min-width: 180px;
        border-right: 2px solid var(--mud-palette-lines-default);
        display: flex; flex-direction: column;
    }
    .cal-resource-header {
        height: 44px; display: flex; align-items: center; padding: 0 12px;
        border-bottom: 2px solid var(--mud-palette-lines-default);
        background: var(--mud-palette-gray-lighten);
    }
    .cal-header-label { font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; opacity: 0.7; }
    .cal-resource-row {
        display: flex; align-items: center; height: 72px; padding: 0 12px; gap: 10px;
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }
    .cal-resource-indicator {
        width: 4px; height: 36px; border-radius: 2px; flex-shrink: 0;
    }
    .cal-resource-info { display: flex; flex-direction: column; min-width: 0; }
    .cal-resource-name { font-weight: 600; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cal-resource-type { font-size: 11px; opacity: 0.6; text-transform: uppercase; letter-spacing: 0.3px; }

    /* ── Time grid (scrollable) ── */
    .cal-time-grid {
        flex: 1; min-width: 0; position: relative;
    }
    .cal-time-headers {
        display: flex; height: 44px; border-bottom: 2px solid var(--mud-palette-lines-default);
        background: var(--mud-palette-gray-lighten); position: sticky; top: 0; z-index: 2;
    }
    .cal-time-header-cell {
        flex: 0 0 100px; width: 100px; display: flex; align-items: center; justify-content: center;
        border-left: 1px solid var(--mud-palette-lines-default);
    }
    .cal-time-label { font-size: 12px; font-weight: 500; opacity: 0.7; }

    /* ── Slot rows ── */
    .cal-slot-row {
        display: flex; height: 72px;
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }
    .cal-slot-cell {
        flex: 0 0 100px; width: 100px; height: 72px;
        border-left: 1px solid var(--mud-palette-lines-default);
        cursor: pointer; transition: all 0.15s; position: relative; overflow: hidden;
    }
    .cal-slot-cell.available { background: #FAFFF9; }
    .cal-slot-cell.available:hover { background: #E8F5E9; }
    .cal-slot-cell.available .cal-slot-add-icon { opacity: 0; transition: opacity 0.15s; }
    .cal-slot-cell.available:hover .cal-slot-add-icon { opacity: 0.3; }

    /* ── Booked slots by status ── */
    .cal-slot-cell.status-scheduled  { background: #E3F2FD; border-left: 3px solid #1976D2; }
    .cal-slot-cell.status-checked-in { background: #FFF3E0; border-left: 3px solid #F57C00; }
    .cal-slot-cell.status-in-progress { background: #F3E5F5; border-left: 3px solid #7B1FA2; }

    .cal-slot-cell.occupied:hover { filter: brightness(0.96); }

    /* ── Slot content ── */
    .cal-slot-content {
        display: flex; flex-direction: column; justify-content: center;
        padding: 4px 6px; height: 100%; gap: 1px;
    }
    .cal-slot-patient {
        font-weight: 600; font-size: 12px; line-height: 1.2;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .cal-slot-type {
        font-size: 10px; opacity: 0.75;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .cal-slot-time {
        font-size: 10px; opacity: 0.5; font-weight: 500;
    }

    .cal-slot-empty {
        display: flex; align-items: center; justify-content: center; height: 100%;
    }

    /* ── Current time line ── */
    .cal-now-line {
        position: absolute; top: 0; bottom: 0; width: 2px;
        background: #F44336; z-index: 3; pointer-events: none;
    }
    .cal-now-line::before {
        content: ''; position: absolute; top: -4px; left: -4px;
        width: 10px; height: 10px; border-radius: 50%; background: #F44336;
    }

    /* ── Legend ── */
    .cal-legend {
        display: flex; gap: 16px; padding: 6px 4px; flex-wrap: wrap; align-items: center;
    }
    .cal-legend-item {
        display: flex; align-items: center; gap: 6px;
    }
    .cal-legend-dot {
        width: 20px; height: 14px; border-radius: 3px; flex-shrink: 0;
    }
</style>
