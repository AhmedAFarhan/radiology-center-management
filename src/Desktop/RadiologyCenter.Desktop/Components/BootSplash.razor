@inject BackendStatusService Backend

<div class="boot-splash" @onclick="() => { }" @oncontextmenu="() => { }">
    <div class="boot-splash-center">
        <div class="boot-splash-logo">
            <img src="images/healthcare_logo_v2_64.png" alt="EGcare" />
        </div>

        <div class="boot-splash-title">EGcare</div>

        @if (Backend.IsFailed)
        {
            <div class="boot-splash-error">
                <MudIcon Icon="@Icons.Material.Filled.Error" Class="mr-2" Color="Color.Error" />
                <span>Failed to start the local service.</span>
            </div>
            <div class="boot-splash-error-detail">@Backend.Error</div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RetryAsync" Disabled="_retrying" StartIcon="@Icons.Material.Filled.Refresh">
                @if (_retrying) { @("Retrying…") } else { @("Try Again") }
            </MudButton>
        }
    </div>
</div>

@code {
    private bool _retrying;

    protected override async Task OnInitializedAsync()
    {
        Backend.StateChanged += NotifyStateChanged;
        await Backend.EnsureStartedAsync();
    }

    private void NotifyStateChanged() => InvokeAsync(StateHasChanged);

    private async Task RetryAsync()
    {
        _retrying = true;
        StateHasChanged();
        await Backend.RetryAsync();
        _retrying = false;
    }

    public void Dispose() => Backend.StateChanged -= NotifyStateChanged;
}