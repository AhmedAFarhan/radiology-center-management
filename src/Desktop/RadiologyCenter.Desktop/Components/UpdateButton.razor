@using Velopack
@inject UpdateService UpdateService

<div id="update-panel">
    @if (_state == UpdateState.Checking)
    {
        <div class="alert alert-info">Checking for updates...</div>
    }
    else if (_state == UpdateState.Downloading)
    {
        <div class="alert alert-info">
            <div class="d-flex justify-content-between mb-1">
                <span>Downloading update...</span>
                <span>@_downloadProgress%</span>
            </div>
            <div class="progress" style="height: 6px;">
                <div class="progress-bar progress-bar-striped progress-bar-animated"
                     role="progressbar"
                     style="width: @(_downloadProgress)%;"
                     aria-valuenow="@_downloadProgress" aria-valuemin="0" aria-valuemax="100">
                </div>
            </div>
        </div>
    }
    else if (_state == UpdateState.Available)
    {
        <div class="alert alert-warning d-flex align-items-center justify-content-between">
            <span>Version @_latestVersion is available</span>
            <button class="btn btn-primary btn-sm" @onclick="StartUpdate">
                Update & Restart
            </button>
        </div>
    }
    else if (_state == UpdateState.Downloaded)
    {
        <div class="alert alert-success d-flex align-items-center justify-content-between">
            <span>Update downloaded. Restarting...</span>
        </div>
    }
    else if (_state == UpdateState.Error)
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between">
            <span>@_errorMessage</span>
            <button class="btn btn-outline-danger btn-sm" @onclick="CheckForUpdates">Retry</button>
        </div>
    }
</div>

@code {
    private enum UpdateState { Idle, Checking, Available, Downloading, Downloaded, Error }

    private UpdateState _state = UpdateState.Idle;
    private string? _latestVersion;
    private string? _errorMessage;
    private UpdateInfo? _updateInfo;
    private int _downloadProgress;

    protected override async Task OnInitializedAsync()
    {
        await CheckForUpdates();
    }

    private async Task CheckForUpdates()
    {
        _state = UpdateState.Checking;
        _updateInfo = await UpdateService.CheckForUpdatesAsync();

        if (_updateInfo is not null)
        {
            _latestVersion = _updateInfo.TargetFullRelease.Version.ToString();
            _state = UpdateState.Available;
        }
        else
        {
            _state = UpdateState.Idle;
        }
    }

    private async Task StartUpdate()
    {
        if (_updateInfo is null) return;

        _downloadProgress = 0;
        _state = UpdateState.Downloading;
        StateHasChanged();

        var success = await UpdateService.DownloadUpdateAsync(_updateInfo, p =>
        {
            _downloadProgress = p;
            StateHasChanged();
        });

        if (success)
        {
            _state = UpdateState.Downloaded;
            StateHasChanged();
            await Task.Delay(500);
            UpdateService.ApplyAndRestart(_updateInfo);
        }
        else
        {
            _state = UpdateState.Error;
            _errorMessage = "Download failed. Check your connection.";
            StateHasChanged();
        }
    }
}
