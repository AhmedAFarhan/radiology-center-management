<MudItem Xs="Xs" Sm="Sm" Md="Md" Class="@Class">
    <MudText Typo="Typo.caption" Color="Color.Secondary">@Label</MudText>
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <MudText>@(Value ?? "-")</MudText>
    }
</MudItem>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;

    [Parameter] public string? Value { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string? Class { get; set; }

    [Parameter] public int Xs { get; set; } = 12;

    [Parameter] public int Sm { get; set; } = 6;

    [Parameter] public int Md { get; set; } = 6;
}