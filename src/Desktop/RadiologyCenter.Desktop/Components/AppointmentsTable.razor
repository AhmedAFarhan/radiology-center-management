@inject AppLocalizer T

<MudCard Elevation="0" Class="dashboard-card h-100">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.subtitle1" Class="font-weight-medium">@T.Dashboard.RecentExaminations</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudTable T="ExaminationDto" Items="Items" Dense="true" Hover="true" Striped="true" Elevation="0">
            <HeaderContent>
                <MudTh>@T.Dashboard.ExamType</MudTh>
                <MudTh>@T.Dashboard.ExamStatus</MudTh>
                <MudTh>@T.Dashboard.ExamPriority</MudTh>
                <MudTh>@T.Dashboard.ReferringDoctor</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@T.Dashboard.ExamType">@context.ExaminationTypeName</MudTd>
                <MudTd DataLabel="@T.Dashboard.ExamStatus">
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@context.Status</MudChip>
                </MudTd>
                <MudTd DataLabel="@T.Dashboard.ExamPriority">@context.Priority</MudTd>
                <MudTd DataLabel="@T.Dashboard.ReferringDoctor">@(context.ReferralDoctorId ?? "-")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Icon="@Icons.Material.Filled.EventNote" Title="@T.Dashboard.NoRecentExams" Message="@T.Dashboard.ExamsWillAppear" />
            </NoRecordsContent>
        </MudTable>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public IReadOnlyList<ExaminationDto> Items { get; set; } = Array.Empty<ExaminationDto>();

    private static Color StatusColor(string status) => status switch
    {
        "Completed" => Color.Success,
        "Cancelled" => Color.Default,
        "InProgress" => Color.Warning,
        "CheckedIn" => Color.Info,
        "Scheduled" => Color.Secondary,
        _ => Color.Primary,
    };
}