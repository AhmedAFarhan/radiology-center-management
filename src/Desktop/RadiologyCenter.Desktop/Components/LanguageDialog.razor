@inject AppLocalizer T

<MudDialog Class="language-dialog">
    <DialogContent>
        <MudText Typo="Typo.h6" Align="Align.Center" Class="mb-4">@T.Language.DialogTitle</MudText>

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
                <button type="button"
                        class="language-option @(IsSelected(AppLocalizer.DefaultCulture) ? "selected" : "")"
                        aria-pressed="@(IsSelected(AppLocalizer.DefaultCulture))"
                        @onclick="@(() => Select(AppLocalizer.DefaultCulture))">
                    <img src="images/flags/us.svg" alt="@T.Language.EnglishFlag" class="language-flag" />
                    <MudText Typo="Typo.body1" Class="font-weight-medium">@T.Language.English</MudText>
                    <MudText Typo="Typo.caption" Class="text-secondary">English</MudText>
                </button>
            </MudItem>
            <MudItem xs="12" sm="6">
                <button type="button"
                        class="language-option @(IsSelected(AppLocalizer.ArabicCulture) ? "selected" : "")"
                        aria-pressed="@(IsSelected(AppLocalizer.ArabicCulture))"
                        @onclick="@(() => Select(AppLocalizer.ArabicCulture))">
                    <img src="images/flags/eg.svg" alt="@T.Language.ArabicFlag" class="language-flag" />
                    <MudText Typo="Typo.body1" Class="font-weight-medium">@T.Language.Arabic</MudText>
                    <MudText Typo="Typo.caption" Class="text-secondary">العربية</MudText>
                </button>
            </MudItem>
        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Default" OnClick="Cancel" Disabled="@_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ApplyAsync" Disabled="@(_selected == _current || _busy)">
            @T.Common.Apply
        </MudButton>
    </DialogActions>
</MudDialog>

