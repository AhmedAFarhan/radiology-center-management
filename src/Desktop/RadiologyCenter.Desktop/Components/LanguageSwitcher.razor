@inject AppLocalizer T
@inject IDialogService DialogService

<MudTooltip Placement="Placement.Bottom" Text="@(T.IsRTL ? T.Language.English : T.Language.Arabic)">
    <MudIconButton Icon="@Icons.Material.Filled.Translate"
                   Color="Color.Inherit"
                   aria-label="@T.Language.Language"
                   OnClick="OpenAsync" />
</MudTooltip>

@code {
    private async Task OpenAsync()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            BackdropClick = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            NoHeader = true,
        };
        await DialogService.ShowAsync<LanguageDialog>("", options);
    }
}