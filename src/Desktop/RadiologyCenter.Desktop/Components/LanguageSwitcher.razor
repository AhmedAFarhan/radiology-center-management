@inject AppLocalizer T
@inject IDialogService DialogService

<MudIconButton Icon="@Icons.Material.Filled.Translate"
               Color="Color.Inherit"
               Title="@(T.IsRTL ? T.Language.English : T.Language.Arabic)"
               aria-label="Language"
               OnClick="OpenAsync" />

@code {
    private async Task OpenAsync()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            BackdropClick = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
        };
        await DialogService.ShowAsync<LanguageDialog>("", options);
    }
}