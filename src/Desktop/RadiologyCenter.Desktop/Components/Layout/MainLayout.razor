@inherits LayoutComponentBase
@using RadiologyCenter.Desktop.Components.Pages
@using RadiologyCenter.Desktop.Components.Pages.Auth
@using RadiologyCenter.Desktop.Models
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@inject SearchService SearchService
@inject SearchHistoryService SearchHistory
@inject ConnectionMonitorService Connection

<div class="app-shell" @onkeydown="HandleGlobalKeyDown">
    <aside class="app-sidebar @(_drawerOpen ? "open" : "collapsed")">
        <div class="app-brand">
            <img src="images/healthcare-logo-64.png" alt="EGcare" class="app-brand-logo" />
            <span class="app-brand-text">EGcare</span>
        </div>
        <NavMenu IsCollapsed="@(!_drawerOpen)" />
    </aside>

    <div class="app-main-col">
        <header class="app-topbar">
            <MudTooltip Placement="Placement.Bottom" Text="@T.Layout.ToggleNav">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="@T.Layout.ToggleNav" />
            </MudTooltip>
            <div class="global-search" @onclick="OnSearchBoxClick">
                <MudTextField T="string"
                              @ref="_searchField"
                              Placeholder="@T.Layout.SearchPlaceholder"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Value="@_searchText"
                              ValueChanged="@(v => OnSearchTextChanged(v))"
                              OnKeyDown="OnSearchKeyDown"
                              OnBlur="OnSearchBlur"
                              Class="header-search app-bar-search global-search-input" />

                @if (_resultsOpen)
                {
                    <div class="global-search-overlay" @onmousedown="CloseSearch"></div>
                    <div class="global-search-results">
                        @if (_searching && _flatItems.Count > 0)
                        {
                            <div class="global-search-loading">
                                <MudProgressCircular Size="Size.Small" Color="Color.Primary" Indeterminate="true" />
                            </div>
                        }

                        @if (_showRecents)
                        {
                            @if (_recentSearches.Count > 0)
                            {
                                <div class="global-search-group">
                                    <div class="global-search-group-title">@T.Search.Recents</div>
                                    @foreach (var term in _recentSearches)
                                    {
                                        <button type="button"
                                                class="global-search-item"
                                                @onmousedown:preventDefault="true"
                                                @onmousedown="() => RecentClickedAsync(term)">
                                            <span class="global-search-item-title">
                                                <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" Class="me-1 global-search-recent-icon" />
                                                @term
                                            </span>
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="global-search-status">@T.Search.TypeHint</div>
                            }
                        }
                        else if (_searching && _flatItems.Count == 0)
                        {
                            <div class="global-search-status">@T.Common.Loading</div>
                        }
                        else if (_searchError)
                        {
                            <div class="global-search-status">
                                @T.Search.Error
                                <button type="button"
                                        class="global-search-retry"
                                        @onmousedown:preventDefault="true"
                                        @onmousedown="RetrySearchAsync">@T.Search.Retry</button>
                            </div>
                        }
                        else if (_searchText.Trim().Length < 2)
                        {
                            <div class="global-search-status">@T.Search.TypeHint</div>
                        }
                        else if (_flatItems.Count == 0)
                        {
                            <div class="global-search-status">@T.Search.NoResults</div>
                        }
                        else
                        {
                            @foreach (var group in _results!.Where(g => g.Items.Count > 0))
                            {
                                <div class="global-search-group">
                                    <div class="global-search-group-head">
                                        <span class="global-search-group-title">@GroupLabel(group.EntityType)</span>
                                        <span class="global-search-group-count">@group.Count</span>
                                        <button type="button"
                                                class="global-search-viewall"
                                                @onmousedown:preventDefault="true"
                                                @onmousedown="() => ViewAllAsync(group.EntityType)">@T.Search.ViewAll</button>
                                    </div>
                                    @foreach (var item in group.Items)
                                    {
                                        <button type="button"
                                                class="global-search-item @(IsSelected(item) ? "selected" : "")"
                                                @onmousedown:preventDefault="true"
                                                @onmousedown="() => ActivateAsync(new SearchFlatItem(group.EntityType, item))"
                                                @onmouseenter="() => SelectItem(item)">
                                            <span class="global-search-item-title">@Highlighted(item.Title)</span>
                                            @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                            {
                                                <span class="global-search-item-subtitle">@item.Subtitle</span>
                                            }
                                        </button>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
            <MudSpacer />
            <MudTooltip Placement="Placement.Bottom" Text="@T.Layout.Notifications">
                <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" aria-label="@T.Layout.Notifications" OnClick="OnNotifications" />
            </MudTooltip>
            <LanguageSwitcher />
            <MudMenu ActivationEvent="MouseEvent.LeftClick"
                     AnchorOrigin="@(T.IsRTL ? Origin.BottomLeft : Origin.BottomRight)"
                     TransformOrigin="@(T.IsRTL ? Origin.TopLeft : Origin.TopRight)"
                     Class="profile-menu"
                     ListClass="profile-menu-list">
                <ActivatorContent>
                    <div class="d-flex align-center profile-trigger" @onclick="context.ToggleAsync">
                        <MudAvatar Size="Size.Small" Color="Color.Primary" Class="mx-2 app-bar-avatar">@GetInitial()</MudAvatar>
                        <MudText Typo="Typo.body2" Class="me-2 app-bar-user">@_displayName</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Class="app-bar-chevron" />
                    </div>
                </ActivatorContent>
                <ChildContent>
                    <div class="profile-menu-header">
                        <MudAvatar Size="Size.Medium" Class="profile-menu-avatar">@GetInitial()</MudAvatar>
                        <div class="profile-menu-meta">
                            <div class="profile-menu-name">@_userFullName</div>
                            <div class="profile-menu-email">@_userEmail</div>
                        </div>
                    </div>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Key" OnClick="OnChangePassword">@T.Layout.ChangePassword</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="OnLogout">@T.Layout.SignOut</MudMenuItem>
                </ChildContent>
            </MudMenu>
        </header>

        <ConnectionBanner />

        <main class="app-main-content">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-4">
                @Body
            </MudContainer>
        </main>
    </div>

    @if (_loggingOut)
    {
        <div class="logout-overlay">
            <MudProgressCircular Size="Size.Medium" Indeterminate="true" Color="Color.Primary" />
            <span>@T.Layout.SigningOut</span>
        </div>
    }

    @if (BusyState.Instance.IsBusy)
    {
        <div class="busy-overlay">
            <MudProgressCircular Size="Size.Large" Indeterminate="true" Color="Color.Primary" />
            <span>@T.Common.Loading</span>
        </div>
    }
</div>

