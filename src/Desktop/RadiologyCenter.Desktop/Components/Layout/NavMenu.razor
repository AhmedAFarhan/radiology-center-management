@inject NavigationManager Navigation

<div class="app-nav-collapsed-side @(IsCollapsed ? "nav-visible" : "")">
    <nav class="app-nav">
        <MudNavMenu>
            <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" Ripple="false" />
            <MudNavLink Href="/patients" Icon="@Icons.Material.Filled.People" Ripple="false" />
            <MudNavLink Href="/visits" Icon="@Icons.Material.Filled.EventNote" Ripple="false" />
            <MudNavLink Href="/radiologist" Icon="@Icons.Material.Filled.Biotech" Ripple="false" />
            <MudNavLink Href="/examinations" Icon="@Icons.Material.Filled.MedicalServices" Ripple="false" />

        <MudMenu Icon="@Icons.Material.Filled.Warehouse"
                 IconSize="Size.Medium"
                 Class="collapsed-nav-menu"
                 AnchorOrigin="Origin.CenterRight"
                 TransformOrigin="Origin.TopLeft"
                 Dense="true"
                 OffsetX="12"
                 Direction="Direction.Left">
            <MudMenuItem Icon="@Icons.Material.Filled.Inventory2" OnClick="@(() => Go("/inventory/items"))">Inventory</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.LocalShipping" OnClick="@(() => Go("/inventory/suppliers"))">Suppliers</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.ReceiptLong" OnClick="@(() => Go("/inventory/purchase-orders"))">Purchase Orders</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.SwapVert" OnClick="@(() => Go("/inventory/stock-movements"))">Stock Movements</MudMenuItem>
        </MudMenu>

        <MudMenu Icon="@Icons.Material.Filled.Payments"
                 IconSize="Size.Medium"
                 Class="collapsed-nav-menu"
                 AnchorOrigin="Origin.CenterRight"
                 TransformOrigin="Origin.TopLeft"
                 Dense="true"
                 OffsetX="12"
                 Direction="Direction.Left">
            <MudMenuItem Icon="@Icons.Material.Filled.ReceiptLong" OnClick="@(() => Go("/payroll/payruns"))">Pay Runs</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Category" OnClick="@(() => Go("/payroll/salary-components"))">Salary Components</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Calculate" OnClick="@(() => Go("/payroll/salaries"))">Salaries</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.AttachMoney" OnClick="@(() => Go("/payroll/allowances"))">Allowances</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.MedicalServices" OnClick="@(() => Go("/payroll/examination-fees"))">Examination Fees</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.LocalHospital" OnClick="@(() => Go("/payroll/referral-fees"))">Referral Fees</MudMenuItem>
        </MudMenu>

        <MudMenu Icon="@Icons.Material.Filled.Approval"
                 IconSize="Size.Medium"
                 Class="collapsed-nav-menu"
                 AnchorOrigin="Origin.CenterRight"
                 TransformOrigin="Origin.TopLeft"
                 Dense="true"
                 OffsetX="12"
                 Direction="Direction.Left">
            <MudMenuItem Icon="@Icons.Material.Filled.Shield" OnClick="@(() => Go("/insurance/companies"))">Companies</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Description" OnClick="@(() => Go("/insurance/policies"))">Policies</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Approval" OnClick="@(() => Go("/insurance/preauthorizations"))">Pre-Authorizations</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.RequestQuote" OnClick="@(() => Go("/insurance/claims"))">Claims</MudMenuItem>
        </MudMenu>

        <MudMenu Icon="@Icons.Material.Filled.AccountBalanceWallet"
                 IconSize="Size.Medium"
                 Class="collapsed-nav-menu"
                 AnchorOrigin="Origin.CenterRight"
                 TransformOrigin="Origin.TopLeft"
                 Dense="true"
                 OffsetX="12"
                 Direction="Direction.Left">
            <MudMenuItem Icon="@Icons.Material.Filled.AccountBalanceWallet" OnClick="@(() => Go("/cash/sessions"))">Cash Sessions</MudMenuItem>
        </MudMenu>

        <MudMenu Icon="@Icons.Material.Filled.PrecisionManufacturing"
                 IconSize="Size.Medium"
                 Class="collapsed-nav-menu"
                 AnchorOrigin="Origin.CenterRight"
                 TransformOrigin="Origin.TopLeft"
                 Dense="true"
                 OffsetX="12"
                 Direction="Direction.Left">
            <MudMenuItem Icon="@Icons.Material.Filled.Biotech" OnClick="@(() => Go("/resources/equipment"))">Equipment</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Badge" OnClick="@(() => Go("/resources/staff"))">Staff</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.CalendarMonth" OnClick="@(() => Go("/resources/work-shifts"))">Work Shifts</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.BeachAccess" OnClick="@(() => Go("/resources/leaves"))">Leave</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.LocalHospital" OnClick="@(() => Go("/resources/referral-doctors"))">Referral Doctors</MudMenuItem>
        </MudMenu>

        <MudMenu Icon="@Icons.Material.Filled.Insights"
                 IconSize="Size.Medium"
                 Class="collapsed-nav-menu"
                 AnchorOrigin="Origin.CenterRight"
                 TransformOrigin="Origin.TopLeft"
                 Dense="true"
                 OffsetX="12"
                 Direction="Direction.Left">
            <MudMenuItem Icon="@Icons.Material.Filled.Speed" OnClick="@(() => Go("/analytics/overview"))">Overview</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.AccountBalanceWallet" OnClick="@(() => Go("/analytics/financial"))">Financials</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Construction" OnClick="@(() => Go("/analytics/operations"))">Operations</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Groups" OnClick="@(() => Go("/analytics/staff"))">Staff &amp; Machines</MudMenuItem>
        </MudMenu>

        <MudMenu Icon="@Icons.Material.Filled.AdminPanelSettings"
                 IconSize="Size.Medium"
                 Class="collapsed-nav-menu"
                 AnchorOrigin="Origin.CenterRight"
                 TransformOrigin="Origin.TopLeft"
                 Dense="true"
                 OffsetX="12"
                 Direction="Direction.Left">
            <MudMenuItem Icon="@Icons.Material.Filled.Person" OnClick="@(() => Go("/users"))">Users</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Security" OnClick="@(() => Go("/roles"))">Roles</MudMenuItem>
        </MudMenu>
    </MudNavMenu>
    </nav>
</div>

