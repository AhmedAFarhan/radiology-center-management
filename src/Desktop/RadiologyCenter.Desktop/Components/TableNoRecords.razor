@using Microsoft.AspNetCore.Components

@if (LoadError is not null)
{
    <ErrorState Icon="@(Offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                Title="@ErrorTitle"
                Message="@LoadError"
                Action="OnReload" />
}
else if (string.IsNullOrWhiteSpace(ActionPolicy))
{
    <EmptyState Icon="@EmptyIcon"
                Title="@EmptyTitle"
                Message="@EmptyMessage"
                ActionLabel="@EmptyActionLabel"
                Action="@OnEmptyAction" />
}
else
{
    <AuthorizeView Policy="@ActionPolicy">
        <Authorized>
            <EmptyState Icon="@EmptyIcon"
                        Title="@EmptyTitle"
                        Message="@EmptyMessage"
                        ActionLabel="@EmptyActionLabel"
                        Action="@OnEmptyAction" />
        </Authorized>
        <NotAuthorized>
            <EmptyState Icon="@EmptyIcon"
                        Title="@EmptyTitle"
                        Message="@EmptyMessage" />
        </NotAuthorized>
    </AuthorizeView>
}