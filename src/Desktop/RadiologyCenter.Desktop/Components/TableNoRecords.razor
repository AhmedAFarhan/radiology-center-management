@using Microsoft.AspNetCore.Components

@if (LoadError is not null)
{
    <ErrorState Icon="@(Offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                Title="@ErrorTitle"
                Message="@LoadError"
                Action="OnReload" />
}
else
{
    <EmptyState Icon="@EmptyIcon"
                Title="@EmptyTitle"
                Message="@EmptyMessage"
                ActionLabel="@EmptyActionLabel"
                Action="OnEmptyAction" />
}