@inject AnalyticsPeriodService Preset
@inject AppLocalizer T

<MudCard Elevation="0" Class="@($"period-bar {@Class}")">
    <MudCardContent>
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.DateRange" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Class="font-weight-medium me-2" Style="white-space:nowrap">@T.Analytics.Period</MudText>
            <MudSelect T="AnalyticsRangePreset"
                       Value="@Preset.Selected"
                       ValueChanged="@OnPreset"
                       Label="@T.Analytics.Range"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense"
                       Class="period-select-control">
                <MudSelectItem T="AnalyticsRangePreset" Value="AnalyticsRangePreset.Last7Days">@T.Analytics.Last7Days</MudSelectItem>
                <MudSelectItem T="AnalyticsRangePreset" Value="AnalyticsRangePreset.Last30Days">@T.Analytics.Last30Days</MudSelectItem>
                <MudSelectItem T="AnalyticsRangePreset" Value="AnalyticsRangePreset.Last90Days">@T.Analytics.Last90Days</MudSelectItem>
                <MudSelectItem T="AnalyticsRangePreset" Value="AnalyticsRangePreset.ThisMonth">@T.Analytics.ThisMonth</MudSelectItem>
                <MudSelectItem T="AnalyticsRangePreset" Value="AnalyticsRangePreset.ThisYear">@T.Analytics.ThisYear</MudSelectItem>
                <MudSelectItem T="AnalyticsRangePreset" Value="AnalyticsRangePreset.AllTime">@T.Analytics.AllTime</MudSelectItem>
            </MudSelect>
            <MudText Typo="Typo.caption" Class="text-secondary mx-2" Style="white-space:nowrap">
                @Preset.From.ToString("dd MMM yyyy") &mdash; @DateTime.Today.ToString("dd MMM yyyy")
            </MudText>
            <MudSpacer />
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@Preset.Label</MudChip>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Primary"
                           aria-label="@T.Analytics.Refresh"
                           OnClick="@(() => Preset.Refresh())"
                           Class="mx-1" />
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string? Class { get; set; }

    protected override void OnInitialized()
    {
        Preset.Changed += OnPeriodChanged;
    }

    private void OnPeriodChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Preset.Changed -= OnPeriodChanged;
    }

    private Task OnPreset(AnalyticsRangePreset preset)
    {
        Preset.SetPreset(preset);
        return Task.CompletedTask;
    }
}