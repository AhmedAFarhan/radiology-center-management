@using ApexCharts
@using RadiologyCenter.Desktop.Models
@inject AppLocalizer T

@if (Items.Count == 0)
{
    <div class="pa-6 text-center text-secondary">@T.Analytics.NoMachineData</div>
}
else
{
    <ApexChart TItem="ModalityUtilizationDto" Height="Height" Options="_options">
        <ApexPointSeries TItem="ModalityUtilizationDto"
                         Items="Items"
                         Name="Exams per machine"
                         SeriesType="SeriesType.Bar"
                         XValue="@(m => m.Modality)"
                         YValue="@(m => m.ExamsPerMachine)" />
        <ApexPointSeries TItem="ModalityUtilizationDto"
                         Items="Items"
                         Name="Active machines"
                         SeriesType="SeriesType.Bar"
                         XValue="@(m => m.Modality)"
                         YValue="@(m => m.ActiveMachines)" />
    </ApexChart>
}




