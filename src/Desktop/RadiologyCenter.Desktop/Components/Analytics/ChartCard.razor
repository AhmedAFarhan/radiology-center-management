<MudCard Elevation="0" Class="dashboard-card h-100">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.subtitle1" Class="font-weight-medium">@Title</MudText>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <MudText Typo="Typo.caption" Class="text-secondary">@Subtitle</MudText>
            }
        </CardHeaderContent>
        <CardHeaderActions>
            @Actions
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <div role="img" aria-label="@(string.IsNullOrWhiteSpace(Subtitle) ? Title : $"{Title} — {Subtitle}")">
            @ChildContent
        </div>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;

    [Parameter] public string Subtitle { get; set; } = string.Empty;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }
}