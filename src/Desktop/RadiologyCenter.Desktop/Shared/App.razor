@inject BackendStatusService Backend
@inject AppLocalizer T
@inject IJSRuntime JS

<MudRTLProvider RightToLeft="@T.IsRTL">
    <MudThemeProvider Theme="@AppTheme.Default" IsDarkMode="false" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    @if (Backend.IsReady)
    {
        <CascadingAuthenticationState>
            <AppErrorBoundary>
                <Router AppAssembly="typeof(MauiProgram).Assembly" NotFoundPage="typeof(Pages.NotFound)" @key="_languageKey">
                    <Found Context="routeData">
                        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                            <NotAuthorized Context="authenticationState">
                                @if (authenticationState.User.Identity?.IsAuthenticated == true)
                                {
                                    <div class="pa-6">
                                        <h1 class="mud-typography mud-typography-h5" tabindex="-1">@(T.IsRTL ? "لا تملك صلاحية فتح هذه الصفحة" : "You do not have access to this page")</h1>
                                        <MudText Class="my-3">@(T.IsRTL ? "اطلب من مسؤول العيادة مراجعة صلاحيات حسابك." : "Ask the clinic administrator to review your account permissions.")</MudText>
                                        <MudButton Href="/dashboard" Variant="Variant.Filled" Color="Color.Primary">@T.Dashboard.Title</MudButton>
                                    </div>
                                }
                                else
                                {
                                    <RedirectToLogin />
                                }
                            </NotAuthorized>
                            <Authorizing>
                                <div class="d-flex align-items-center justify-content-center" style="height: 100vh;">
                                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="320px" Height="180px" Animation="Animation.Pulse" Style="border-radius:12px" />
                                </div>
                            </Authorizing>
                        </AuthorizeRouteView>
                        <FocusOnNavigate RouteData="routeData" Selector="h1" />
                    </Found>
                </Router>
            </AppErrorBoundary>
        </CascadingAuthenticationState>
    }
    else
    {
        <BootSplash />
    }
</MudRTLProvider>


