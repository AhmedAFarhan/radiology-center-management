@inherits LayoutComponentBase
@using RadiologyCenter.Desktop.Shared.Pages
@using RadiologyCenter.Desktop.Features.Auth.Components
@using RadiologyCenter.Desktop.Models
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@inject SearchService SearchService
@inject SearchHistoryService SearchHistory
@inject ConnectionMonitorService Connection
@inject IJSRuntime JS
@inject GlobalSearchService SearchSvc

<div class="app-shell @SidebarModeClass" @onkeydown="HandleGlobalKeyDown">
    @if (ShowSidebarScrim)
    {
        <div class="app-sidebar-scrim" @onclick="CloseSidebarOverlay" aria-hidden="true"></div>
    }
    <aside class="app-sidebar @SidebarClass">
        <div class="app-brand">
            <img src="images/healthcare-logo-64.png" alt="EGcare" class="app-brand-logo" />
            <span class="app-brand-text">EGcare</span>
        </div>
        <NavMenu IsCollapsed="@(!_drawerOpen)" />
    </aside>

    <div class="app-main-col">
        <header class="app-topbar">
            <MudTooltip Placement="Placement.Bottom" Text="@T.Layout.ToggleNav">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="ToggleSidebar" aria-label="@T.Layout.ToggleNav" />
            </MudTooltip>

            <GlobalSearch @ref="_globalSearch"
                          SearchText="@SearchSvc.SearchText"
                          SearchTextChanged="OnSearchTextChanged"
                          ResultsOpen="@SearchSvc.ResultsOpen"
                          Searching="@SearchSvc.Searching"
                          SearchError="@SearchSvc.SearchError"
                          ShowRecents="@SearchSvc.ShowRecents"
                          RecentSearches="@SearchSvc.RecentSearches"
                          Results="@SearchSvc.Results"
                          FlatItems="@SearchSvc.FlatItems"
                          SelectedIndex="@SearchSvc.SelectedIndex"
                          HighlightWords="@SearchSvc.HighlightWords"
                          UserName="@SearchSvc.UserName"
                          SearchKeyDown="OnSearchKeyDown"
                          SearchBlur="OnSearchBlur"
                          SearchBoxClick="OnSearchBoxClick"
                          RecentClicked="RecentClickedAsync"
                          RetrySearch="RetrySearchAsync"
                          ActivateItem="OnActivateItem"
                          ViewAll="OnViewAll"
                          CloseSearch="CloseSearch" />

            <MudSpacer />
            <MudTooltip Placement="Placement.Bottom" Text="@T.Layout.Notifications">
                <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" aria-label="@T.Layout.Notifications" OnClick="OnNotifications" />
            </MudTooltip>
            <LanguageSwitcher />
            <MudMenu ActivationEvent="MouseEvent.LeftClick"
                     AnchorOrigin="@(T.IsRTL ? Origin.BottomLeft : Origin.BottomRight)"
                     TransformOrigin="@(T.IsRTL ? Origin.TopLeft : Origin.TopRight)"
                     Class="profile-menu"
                     ListClass="profile-menu-list">
                <ActivatorContent>
                    <div class="d-flex align-center profile-trigger" @onclick="context.ToggleAsync">
                        <MudAvatar Size="Size.Small" Color="Color.Primary" Class="mx-2 app-bar-avatar">@GetInitial()</MudAvatar>
                        <MudText Typo="Typo.body2" Class="me-2 app-bar-user">@_displayName</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Class="app-bar-chevron" />
                    </div>
                </ActivatorContent>
                <ChildContent>
                    <div class="profile-menu-header">
                        <MudAvatar Size="Size.Medium" Class="profile-menu-avatar">@GetInitial()</MudAvatar>
                        <div class="profile-menu-meta">
                            <div class="profile-menu-name">@_userFullName</div>
                            <div class="profile-menu-email">@_userEmail</div>
                        </div>
                    </div>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Key" OnClick="OnChangePassword">@T.Layout.ChangePassword</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="OnLogout">@T.Layout.SignOut</MudMenuItem>
                </ChildContent>
            </MudMenu>
        </header>

        <ConnectionBanner />

        <main class="app-main-content">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-4">
                @Body
            </MudContainer>
        </main>
    </div>

    @if (_loggingOut)
    {
        <div class="logout-overlay">
            <MudProgressCircular Size="Size.Medium" Indeterminate="true" Color="Color.Primary" />
            <span>@T.Layout.SigningOut</span>
        </div>
    }

    @if (BusyState.Instance.IsBusy)
    {
        <div class="busy-overlay">
            <MudProgressCircular Size="Size.Large" Indeterminate="true" Color="Color.Primary" />
            <span>@T.Common.Loading</span>
        </div>
    }
</div>
