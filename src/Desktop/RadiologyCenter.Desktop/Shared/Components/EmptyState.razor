@inject AppLocalizer T

<MudStack AlignItems="AlignItems.Center" Spacing="1" Class="pa-6">
    <MudIcon Icon="@Icon" Size="Size.Large" Color="@Color" />
    <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="font-weight-medium">@_title</MudText>
    <MudText Typo="Typo.body2" Align="Align.Center" Class="text-secondary">@_message</MudText>
    @if (Action.HasDelegate)
    {
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="OnActionClick" Class="mt-2">@_actionLabel</MudButton>
    }
</MudStack>

