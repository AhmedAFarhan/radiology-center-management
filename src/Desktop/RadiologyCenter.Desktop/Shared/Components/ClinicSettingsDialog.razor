<FormDialog Title="@T["forms.setupTitle"]" Subtitle="@T["forms.setupSubtitle"]" Icon="@Icons.Material.Outlined.Settings">
    <DialogContent><ClinicSetupPanel ShowHeading="false" Completed="Close" BusyChanged="OnBusyChanged" /></DialogContent>
    <DialogActions><MudButton OnClick="Close" Disabled="_busy">@T.Common.Close</MudButton></DialogActions>
</FormDialog>
@inject AppLocalizer T
@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    private bool _busy;
    private bool _closed;
    private Task OnBusyChanged(bool busy)
    {
        _busy = busy;
        if (_closed) return Task.CompletedTask;
        return MudDialog.SetOptionsAsync(MudDialog.Options with { BackdropClick = !busy, CloseOnEscapeKey = !busy });
    }
    private void Close() { _closed = true; MudDialog.Close(); }
}
