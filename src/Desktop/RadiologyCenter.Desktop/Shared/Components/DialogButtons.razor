@using Microsoft.AspNetCore.Components

<MudButton Color="Color.Default" OnClick="OnCancel" Disabled="Busy">@CancelLabel</MudButton>
<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnSave" Disabled="Busy || Disabled">
    @if (Busy)
    {
        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
    }
    <text>@SaveLabel</text>
</MudButton>