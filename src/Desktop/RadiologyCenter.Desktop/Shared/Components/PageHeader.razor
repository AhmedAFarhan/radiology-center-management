@inject AppLocalizer T

<MudToolBar Dense="true" Class="mb-4 page-header-toolbar">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <MudIcon Icon="@Icon" Class="page-header-icon" />
    }
    <div class="page-header-heading">
    <h1 class="mud-typography mud-typography-h5 page-header-title" tabindex="-1">@Title</h1>
    @if (!string.IsNullOrWhiteSpace(Subtitle))
    {
        <MudText Typo="Typo.body2" Class="text-secondary">@Subtitle</MudText>
    }
    </div>
    <div class="page-header-actions">
        @if (ShowSearch && SearchValueChanged.HasDelegate)
        {
            <MudTextField T="string"
                          Value="@_search"
                          ValueChanged="OnLocalSearchChanged"
                          Placeholder="@_placeholder"
                          aria-label="@_placeholder"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="search-field" />
        }
        @ChildContent
        <div class="page-header-tools">
        @if (OnImport is not null)
        {
            <MudTooltip Placement="Placement.Bottom" Text="@T.Common.ImportFromExcel">
                <MudIconButton Icon="@Icons.Material.Filled.Upload" Color="Color.Default" aria-label="@T.Common.ImportFromExcel" OnClick="OnImport" />
            </MudTooltip>
        }
        @if (OnExport is not null)
        {
            <MudTooltip Placement="Placement.Bottom" Text="@T.Common.ExportToExcel">
                <MudIconButton Icon="@Icons.Material.Filled.Download" Color="Color.Default" aria-label="@T.Common.ExportToExcel" OnClick="OnExport" />
            </MudTooltip>
        }
        @if (OnRefresh is not null)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" aria-label="@T.Common.Retry" OnClick="OnRefresh" />
        }
        </div>
        @ActionContent
    </div>

</MudToolBar>

