<MudDialog>
    <DialogContent>
        <div class="confirm-dialog">
            <div class="confirm-dialog-icon" style="@IconTint">
                <MudIcon Icon="@Icon" Size="Size.Medium" Color="Color.Inherit" />
            </div>
            <MudText Typo="Typo.h6" Align="Align.Center" Class="confirm-dialog-title">@Title</MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="confirm-dialog-message">@Message</MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" Variant="Variant.Text" OnClick="OnCancel">@CancelText</MudButton>
        <MudButton Color="@Color" Variant="Variant.Filled" OnClick="OnConfirm">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>