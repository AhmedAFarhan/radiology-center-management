@implements IDisposable

<MudDialog>
    <DialogContent>
        <div class="clinic-update" aria-busy="@_busy.ToString().ToLowerInvariant()">
            <div class="clinic-update-heading">
                <MudIcon Icon="@Icons.Material.Outlined.SystemUpdate" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h6">@L("Application updates", "تحديثات التطبيق")</MudText>
                    <ReleaseVersion />
                </div>
            </div>
            @if (_update is not null)
            {
                <div class="clinic-update-versions">
                    <div><span>@L("Installed", "المثبت")</span><strong><bdi dir="ltr">@_update.CurrentVersion</bdi></strong></div>
                    <MudIcon Icon="@(T.IsRTL ? Icons.Material.Outlined.ArrowBack : Icons.Material.Outlined.ArrowForward)" aria-hidden="true" />
                    <div><span>@L("Available", "المتاح")</span><strong><bdi dir="ltr">@_update.Version</bdi></strong></div>
                </div>
                <MudAlert Severity="Severity.Info" Dense="true">@L("Save your work before installing. EGcare will restart; your clinic connection and saved sign-in are preserved.", "احفظ عملك قبل التثبيت. سيُعاد تشغيل EGcare مع الاحتفاظ باتصال العيادة وتسجيل الدخول المحفوظ.")</MudAlert>
            }
            <div class="clinic-update-status" role="status" aria-live="polite">
                @if (_busy)
                {
                    <MudText Typo="Typo.body2">@(_downloading ? L($"Downloading… {_progress}%", $"جارٍ التنزيل… {_progress}%") : _restarting ? L("Preparing to restart…", "جارٍ التحضير لإعادة التشغيل…") : L("Checking for updates…", "جارٍ البحث عن تحديثات…"))</MudText>
                    <MudProgressLinear Indeterminate="@(!_downloading)" Value="_progress" Class="mt-2" Color="Color.Primary" />
                }
                else if (_checked && _update is null && _error is null)
                {
                    <MudAlert Severity="Severity.Success" Dense="true">@L("You have the latest version from your update source.", "لديك أحدث إصدار متاح من مصدر التحديثات.")</MudAlert>
                }
                else if (_update is not null && Updates.IsDownloaded(_update))
                {
                    <MudText Color="Color.Success">@L("Download complete. Install whenever you are ready.", "اكتمل التنزيل. ثبّت التحديث عندما تكون مستعدًا.")</MudText>
                }
            </div>
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        @if (_downloading)
        {
            <MudButton OnClick="CancelDownload">@L("Cancel download", "إلغاء التنزيل")</MudButton>
        }
        else
        {
            <MudButton OnClick="Close" Disabled="_busy">@L("Later", "لاحقًا")</MudButton>
        }
        <MudButton OnClick="CheckAsync" Disabled="_busy">@L("Check again", "تحقق مجددًا")</MudButton>
        @if (_update is not null)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="InstallAsync"
                       StartIcon="@(Updates.IsDownloaded(_update) ? Icons.Material.Outlined.RestartAlt : Icons.Material.Outlined.Download)">
                @(Updates.IsDownloaded(_update) ? L("Install and restart", "تثبيت وإعادة التشغيل") : L("Download update", "تنزيل التحديث"))
            </MudButton>
        }
    </DialogActions>
</MudDialog>
