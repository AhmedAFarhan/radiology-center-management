@using static RadiologyCenter.Desktop.Services.Formatting
@inherits EditorDialogBase
@inject PayrollService PayrollService
@inject EnumOptionsService EnumOptionsService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Category" Title="@(Component is null ? T.SalaryComponent.NewSalaryComponent : T.FormatValue(T.SalaryComponent.EditTitle, Component.Name))" />
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="7">
                    <MudTextField @bind-Value="_model.Name"
                                  Label="@T.Common.Name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Name)" />
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudSelect T="string"
                               @bind-Value="_model.Kind"
                               Label="@T.SalaryComponent.Kind"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.Kind)">
                        @foreach (var kind in _kindOptions)
                        {
                            <MudSelectItem T="string" Value="@kind.Key">@kind.Value</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string"
                               @bind-Value="_model.Frequency"
                               Label="@T.SalaryComponent.FrequencyOptional"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        <MudSelectItem T="string" Value="@((string?)null)">@T.SalaryComponent.NotSet</MudSelectItem>
                        @foreach (var frequency in _frequencyOptions)
                        {
                            <MudSelectItem T="string" Value="@frequency.Key">@frequency.Value</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.DefaultValue"
                                     Label="@(_model.IsPercentage ? T.SalaryComponent.DefaultPercent : T.SalaryComponent.DefaultValue)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     For="@(() => _model.DefaultValue)" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex flex-column justify-center">
                    <MudSwitch T="bool" @bind-Value="_model.IsPercentage" Color="Color.Primary">@T.SalaryComponent.ValueIsPercentage</MudSwitch>
                    <MudSwitch T="bool" @bind-Value="_model.IsPerWorkDay" Color="Color.Primary">@T.SalaryComponent.PaidPerWorkDay</MudSwitch>
                </MudItem>
            </MudGrid>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.SalaryComponent.SaveChanges : T.SalaryComponent.CreateComponent)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>