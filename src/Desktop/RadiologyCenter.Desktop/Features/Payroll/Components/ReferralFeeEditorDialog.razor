@inherits EditorDialogBase
@inject PayrollService PayrollService
@inject ResourceService ResourceService
@inject ExaminationService ExaminationService

<FormDialog Title="@(Fee is null ? T.ReferralFee.NewReferralFee : T.ReferralFee.EditReferralFee)" Icon="@Icons.Material.Filled.LocalHospital" Subtitle="@T["forms.payrollSubtitle"]">
    <DialogContent>
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <MudGrid Spacing="3">
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.referral"]" Icon="@Icons.Material.Outlined.Person" First="true" />
                </MudItem>
                @if (IsEdit)
                {
                    <MudItem xs="12" sm="6">
                        <FormField Label="@T.ReferralFee.ReferralDoctor" Context="fieldId">
                            <MudTextField @bind-Value="_doctorName"
                                          InputId="@fieldId" aria-label="@T.ReferralFee.ReferralDoctor"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </FormField>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <FormField Label="@T.ReferralFee.ExaminationType" Context="fieldId">
                            <MudTextField @bind-Value="_examTypeName"
                                          InputId="@fieldId" aria-label="@T.ReferralFee.ExaminationType"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </FormField>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="6">
                        <FormField Label="@T.ReferralFee.DoctorSearch" Context="fieldId" Required="true">
                            <MudAutocomplete T="ReferralDoctorDto"
                                             @bind-Value="_selectedDoctor"
                                             InputId="@fieldId" aria-required="true" aria-label="@T.ReferralFee.DoctorSearch"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             MinCharacters="1"
                                             DebounceInterval="300"
                                             SearchFunc="SearchDoctorsAsync"
                                             ToStringFunc="@(d => d is null ? string.Empty : d.FullName)"
                                             Clearable="true"
                                             Disabled="Busy" />
                        </FormField>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <FormField Label="@T.ReferralFee.ExamTypeSearch" Context="fieldId" Required="true">
                            <MudAutocomplete T="ExaminationTypeDto"
                                             @bind-Value="_selectedType"
                                             InputId="@fieldId" aria-required="true" aria-label="@T.ReferralFee.ExamTypeSearch"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             MinCharacters="1"
                                             DebounceInterval="300"
                                             SearchFunc="SearchTypesAsync"
                                             ToStringFunc="@(t => t is null ? string.Empty : $"{t.Code} - {t.Name}")"
                                             Clearable="true"
                                             Disabled="Busy" />
                        </FormField>
                    </MudItem>
                }
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.calculation"]" Icon="@Icons.Material.Outlined.Calculate" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@(_model.IsPercentage ? T.ReferralFee.PercentagePercent : T.ReferralFee.FlatAmount)" Context="fieldId">
                        <LocalizedNumericField Disabled="Busy" T="decimal"
                                         @bind-Value="_model.Amount"
                                         InputId="@fieldId" aria-label="@(_model.IsPercentage ? T.ReferralFee.PercentagePercent : T.ReferralFee.FlatAmount)"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0"
                                         For="@(() => _model.Amount)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-items-center">
                    <MudSwitch Disabled="Busy" T="bool" @bind-Value="_model.IsPercentage" Color="Color.Primary">@T.ReferralFee.AmountIsPercentage</MudSwitch>
                </MudItem>
            </MudGrid>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.ReferralFee.SaveChanges : T.ReferralFee.CreateFee)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</FormDialog>