@inject AppLocalizer T

<MudGrid Spacing="2" Class="mb-2">
    <MudItem xs="12" sm="6">
        <MudText Typo="Typo.subtitle1" Class="font-weight-medium">@T.PayRunDialog.Payslips</MudText>
    </MudItem>
    <MudItem xs="12" sm="6" Class="d-flex justify-end">
        @if (CanEdit)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="@(() => OnAddPayslip.InvokeAsync())" Disabled="Busy">@T.Payslip.AddTitle</MudButton>
        }
    </MudItem>
</MudGrid>

@if (Payslips.Count == 0)
{
    <MudText Typo="Typo.body2" Class="text-secondary pa-4">@T.PayRunDialog.NoPayslips</MudText>
}
else
{
    <MudTable Breakpoint="Breakpoint.Sm" T="PayslipDto" Items="Payslips" Dense="true" Hover="true" Elevation="0" Class="rounded" Style="border:1px solid rgba(0,0,0,.12)">
        <HeaderContent>
            <MudTh />
            <MudTh>@T.PayRunDialog.Employee</MudTh>
            <MudTh Class="text-right">@T.PayRunDialog.Gross</MudTh>
            <MudTh Class="text-right">@T.PayRunDialog.Earnings</MudTh>
            <MudTh Class="text-right">@T.PayRunDialog.Deductions</MudTh>
            <MudTh Class="text-right">@T.PayRunDialog.UnpaidDays</MudTh>
            <MudTh Class="text-right">@T.PayRunDialog.Net</MudTh>
            <MudTh Class="text-center">@T.Common.Actions</MudTh>
        </HeaderContent>
        <RowTemplate Context="ps">
            <MudTd DataLabel="@T.PayRunDialog.ToggleBreakdown">
                <MudIconButton Icon="@(IsExpanded(ps) ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                               Size="Size.Small"
                               aria-label="@T.PayRunDialog.ToggleBreakdown"
                               OnClick="@(() => ToggleExpand(ps))" />
            </MudTd>
            <MudTd DataLabel="@T.PayRunDialog.Employee">
                <MudText Class="font-weight-medium">@ResolveStaff(ps.StaffId)</MudText>
            </MudTd>
            <MudTd DataLabel="@T.PayRunDialog.Gross" Class="text-right">@ps.GrossSalary.ToString("N2")</MudTd>
            <MudTd DataLabel="@T.PayRunDialog.Earnings" Class="text-right" Style="color:var(--mud-palette-success)">@ps.TotalEarnings.ToString("N2")</MudTd>
            <MudTd DataLabel="@T.PayRunDialog.Deductions" Class="text-right" Style="color:var(--mud-palette-error)">@ps.TotalDeductions.ToString("N2")</MudTd>
            <MudTd DataLabel="@T.PayRunDialog.UnpaidDays" Class="text-right">@ps.UnpaidLeaveDays</MudTd>
            <MudTd DataLabel="@T.PayRunDialog.Net" Class="text-right"><MudText Typo="Typo.body2" Class="font-weight-medium">@ps.NetSalary.ToString("N2")</MudText></MudTd>
            <MudTd DataLabel="@T.Common.Actions" Class="text-center">
                <MudTooltip Text="@T.PayRunDialog.ExportPdf">
                    <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" Color="Color.Info" aria-label="@T.PayRunDialog.ExportPdf" OnClick="@(() => OnExportPdf.InvokeAsync(ps))" Disabled="Busy" />
                </MudTooltip>
                @if (CanEdit)
                {
                    <MudTooltip Text="@T.PayRunDialog.RemovePayslip">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.PayRunDialog.RemovePayslip" OnClick="@(() => OnRemovePayslip.InvokeAsync(ps))" Disabled="Busy" />
                    </MudTooltip>
                }
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            @if (IsExpanded(context))
            {
                <MudTr>
                    <td colspan="8">
                        <MudText Typo="Typo.caption" Class="text-secondary mb-1">@T.PayRunDialog.Breakdown</MudText>
                        @if (context.Components.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="text-secondary pa-2">@T.PayRunDialog.NoComponents</MudText>
                        }
                        else
                        {
                            <MudTable T="PayslipComponentDto" Items="context.Components" Dense="true" Hover="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>@T.PayRunDialog.Component</MudTh>
                                    <MudTh Class="text-right">@T.PayRunDialog.Amount</MudTh>
                                </HeaderContent>
                                <RowTemplate Context="cmp">
                                    <MudTd DataLabel="@T.PayRunDialog.Component">
                                        <MudChip T="string" Size="Size.Small" Color="@(cmp.IsDeduction ? Color.Error : Color.Success)" Variant="Variant.Text">@(cmp.IsDeduction ? T.PayRunDialog.Deduction : T.PayRunDialog.Earning)</MudChip>
                                        <span class="ms-2">@cmp.Name</span>
                                    </MudTd>
                                    <MudTd DataLabel="@T.PayRunDialog.Amount" Class="text-right" Style="@(cmp.IsDeduction ? "color:var(--mud-palette-error)" : "color:var(--mud-palette-success)")">
                                        @(cmp.IsDeduction ? "-" : "+")@cmp.Amount.ToString("N2")
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        @if (!string.IsNullOrWhiteSpace(context.Notes))
                        {
                            <MudText Typo="Typo.caption" Class="text-secondary mt-2">@context.Notes</MudText>
                        }
                    </td>
                </MudTr>
            }
        </ChildRowContent>
    </MudTable>
}
