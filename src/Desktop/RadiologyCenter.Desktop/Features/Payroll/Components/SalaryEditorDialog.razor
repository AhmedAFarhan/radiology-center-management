@inherits EditorDialogBase
@inject PayrollService PayrollService
@inject ResourceService ResourceService
@inject EnumOptionsService EnumOptionsService

<FormDialog Title="@(Salary is null ? T.Salary.NewSalary : T.Salary.EditTitle)" Icon="@Icons.Material.Filled.Calculate" Subtitle="@T["forms.payrollSubtitle"]">
    <DialogContent>
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <MudGrid Spacing="3">
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.employee"]" Icon="@Icons.Material.Outlined.Badge" First="true" />
                </MudItem>
                @if (IsEdit)
                {
                    <MudItem xs="12">
                        <FormField Label="@T.Salary.Employee" Context="fieldId">
                            <MudTextField @bind-Value="_employeeName"
                                          InputId="@fieldId" aria-label="@T.Salary.Employee"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </FormField>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <FormField Label="@T.SalaryDialog.EmployeeSearch" Context="fieldId" Required="true">
                            <MudAutocomplete T="StaffDto"
                                             @bind-Value="_selectedStaff"
                                             InputId="@fieldId" aria-required="true" aria-label="@T.SalaryDialog.EmployeeSearch"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             MinCharacters="1"
                                             DebounceInterval="300"
                                             SearchFunc="SearchStaffAsync"
                                             ToStringFunc="@(s => s is null ? string.Empty : s.FullName)"
                                             Clearable="true"
                                             Disabled="Busy" />
                        </FormField>
                    </MudItem>
                }
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.salary"]" Icon="@Icons.Material.Outlined.Payments" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.Salary.BaseSalary" Context="fieldId">
                        <LocalizedNumericField Disabled="Busy" T="decimal"
                                         @bind-Value="_model.BaseSalary"
                                         InputId="@fieldId" aria-label="@T.Salary.BaseSalary"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0"
                                         For="@(() => _model.BaseSalary)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.SalaryDialog.SalaryType" Context="fieldId" Required="true">
                        <LocalizedSelect Disabled="Busy" T="string"
                                   @bind-Value="_model.SalaryType"
                                   InputId="@fieldId" aria-required="true" aria-label="@T.SalaryDialog.SalaryType"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   For="@(() => _model.SalaryType)">
                            @foreach (var salaryType in _salaryTypeOptions)
                            {
                                <MudSelectItem T="string" Value="@salaryType.Key">@salaryType.Value</MudSelectItem>
                            }
                        </LocalizedSelect>
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.SalaryDialog.EffectiveDate" Context="fieldId" Required="true">
                        <LocalizedDatePicker Disabled="Busy" @bind-Date="_model.EffectiveDate"
                                       InputId="@fieldId" aria-required="true" aria-label="@T.SalaryDialog.EffectiveDate"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       For="@(() => _model.EffectiveDate)"
                                       Class="w-100" />
                    </FormField>
                </MudItem>
            </MudGrid>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.SalaryDialog.SaveChanges : T.SalaryDialog.CreateSalary)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</FormDialog>