@inherits EditorDialogBase
@inject PayrollService PayrollService
@inject ExaminationService ExaminationService
@inject EnumOptionsService EnumOptionsService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.MedicalServices" Title="@(Fee is null ? T.ExamFee.NewExaminationFee : T.ExamFee.EditExaminationFee)" />
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                @if (IsEdit)
                {
                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="_examTypeName"
                                      Label="@T.ExamFee.ExaminationType"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="_model.Role"
                                      Label="@T.ExamFee.Role"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="true" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="8">
                        <MudAutocomplete T="ExaminationTypeDto"
                                         @bind-Value="_selectedType"
                                         Label="@T.ExamFee.ExamTypeSearch"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="1"
                                         DebounceInterval="300"
                                         SearchFunc="SearchTypesAsync"
                                         ToStringFunc="@(t => t is null ? string.Empty : $"{t.Code} - {t.Name}")"
                                         Clearable="true"
                                         Disabled="Busy" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string"
                                   @bind-Value="_model.Role"
                                   Label="@T.ExamFee.Role"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   For="@(() => _model.Role)">
                            @foreach (var role in _roleOptions)
                            {
                                <MudSelectItem T="string" Value="@role.Key">@role.Value</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.Amount"
                                     Label="@(_model.IsPercentage ? T.ExamFee.PercentagePercent : T.ExamFee.FlatAmount)"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     For="@(() => _model.Amount)" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-items-center">
                    <MudSwitch T="bool" @bind-Value="_model.IsPercentage" Color="Color.Primary">@T.ExamFee.AmountIsPercentage</MudSwitch>
                </MudItem>
            </MudGrid>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.ExamFee.SaveChanges : T.ExamFee.CreateFee)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>