@inherits EditorDialogBase
@inject PayrollService PayrollService
@inject ExaminationService ExaminationService
@inject EnumOptionsService EnumOptionsService

<FormDialog Title="@(Fee is null ? T.ExamFee.NewExaminationFee : T.ExamFee.EditExaminationFee)" Icon="@Icons.Material.Filled.MedicalServices" Subtitle="@T["forms.payrollSubtitle"]">
    <DialogContent>
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <MudGrid Spacing="3">
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.examinationType"]" Icon="@Icons.Material.Outlined.MedicalServices" First="true" />
                </MudItem>
                @if (IsEdit)
                {
                    <MudItem xs="12" sm="8">
                        <FormField Label="@T.ExamFee.ExaminationType" Context="fieldId">
                            <MudTextField @bind-Value="_examTypeName"
                                          InputId="@fieldId" aria-label="@T.ExamFee.ExaminationType"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </FormField>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <FormField Label="@T.ExamFee.Role" Context="fieldId">
                            <MudTextField @bind-Value="_model.Role"
                                          InputId="@fieldId" aria-label="@T.ExamFee.Role"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          ReadOnly="true" />
                        </FormField>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="8">
                        <FormField Label="@T.ExamFee.ExamTypeSearch" Context="fieldId" Required="true">
                            <MudAutocomplete T="ExaminationTypeDto"
                                             @bind-Value="_selectedType"
                                             InputId="@fieldId" aria-required="true" aria-label="@T.ExamFee.ExamTypeSearch"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             MinCharacters="1"
                                             DebounceInterval="300"
                                             SearchFunc="SearchTypesAsync"
                                             ToStringFunc="@(t => t is null ? string.Empty : $"{t.Code} - {t.Name}")"
                                             Clearable="true"
                                             Disabled="Busy" />
                        </FormField>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <FormField Label="@T.ExamFee.Role" Context="fieldId" Required="true">
                            <LocalizedSelect Disabled="Busy" T="string"
                                       @bind-Value="_model.Role"
                                       InputId="@fieldId" aria-required="true" aria-label="@T.ExamFee.Role"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       For="@(() => _model.Role)">
                                @foreach (var role in _roleOptions)
                                {
                                    <MudSelectItem T="string" Value="@role.Key">@role.Value</MudSelectItem>
                                }
                            </LocalizedSelect>
                        </FormField>
                    </MudItem>
                }
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.calculation"]" Icon="@Icons.Material.Outlined.Calculate" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@(_model.IsPercentage ? T.ExamFee.PercentagePercent : T.ExamFee.FlatAmount)" Context="fieldId">
                        <LocalizedNumericField Disabled="Busy" T="decimal"
                                         @bind-Value="_model.Amount"
                                         InputId="@fieldId" aria-label="@(_model.IsPercentage ? T.ExamFee.PercentagePercent : T.ExamFee.FlatAmount)"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0"
                                         For="@(() => _model.Amount)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-items-center">
                    <MudSwitch Disabled="Busy" T="bool" @bind-Value="_model.IsPercentage" Color="Color.Primary">@T.ExamFee.AmountIsPercentage</MudSwitch>
                </MudItem>
            </MudGrid>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.ExamFee.SaveChanges : T.ExamFee.CreateFee)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</FormDialog>