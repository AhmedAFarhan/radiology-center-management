@using static RadiologyCenter.Desktop.Services.Formatting
@inherits EditorDialogBase
@inject PayrollService PayrollService
@inject ResourceService ResourceService
@inject EnumOptionsService EnumOptionsService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.AttachMoney" Title="@(Allowance is null ? T.Allowance.NewAllowance : T.FormatValue(T.Allowance.EditTitle, Allowance.Name))" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                @if (IsEdit)
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_employeeName"
                                      Label="@T.Allowance.Employee"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_componentName"
                                      Label="@T.AllowanceDialog.SalaryComponent"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      ReadOnly="true" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="6">
                        <MudAutocomplete T="StaffDto"
                                         @bind-Value="_selectedStaff"
                                         Label="@T.AllowanceDialog.EmployeeSearch"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="1"
                                         DebounceInterval="300"
                                         SearchFunc="SearchStaffAsync"
                                         ToStringFunc="@(s => s is null ? string.Empty : s.FullName)"
                                         Clearable="true"
                                         Disabled="Busy" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudAutocomplete T="SalaryComponentDto"
                                         @bind-Value="_selectedComponent"
                                         Label="@T.AllowanceDialog.SalaryComponentOptional"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="1"
                                         DebounceInterval="300"
                                         SearchFunc="SearchComponentsAsync"
                                         ToStringFunc="@(c => c is null ? string.Empty : c.Name)"
                                         Clearable="true"
                                         Disabled="Busy" />
                    </MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Name"
                                  Label="@T.AllowanceDialog.AllowanceName"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Name)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.Amount"
                                     Label="@T.AllowanceDialog.Amount"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     For="@(() => _model.Amount)" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string"
                               @bind-Value="_model.Frequency"
                               Label="@T.AllowanceDialog.FrequencyOptional"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        <MudSelectItem T="string" Value="@((string?)null)">@T.AllowanceDialog.NotSet</MudSelectItem>
                        @foreach (var frequency in _frequencyOptions)
                        {
                            <MudSelectItem T="string" Value="@frequency.Key">@frequency.Value</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker @bind-Date="_model.EffectiveDate"
                                   Label="@T.AllowanceDialog.EffectiveDate"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   For="@(() => _model.EffectiveDate)"
                                   Class="w-100" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker @bind-Date="_model.EndDate"
                                   Label="@T.AllowanceDialog.EndDateOptional"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="w-100" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch T="bool" @bind-Value="_model.IsPerWorkDay" Color="Color.Primary">@T.AllowanceDialog.PaidPerWorkDay</MudSwitch>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.AllowanceDialog.SaveChanges : T.AllowanceDialog.CreateAllowance)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>