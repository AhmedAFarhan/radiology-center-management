@inject InventoryService InventoryService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<FormDialog Title="@(_po is null ? T.PoDialog.ReceiveOrder : T.FormatValue(T.PoDialog.ReceiveOrderTitle, _po.OrderNumber))" Icon="@Icons.Material.Filled.ReceiptLong" Subtitle="@T["forms.inventorySubtitle"]">
    <DialogContent>
        @if (_loading)
        {
            <DialogSkeleton Rows="4" />
        }
        else if (_error is not null)
        {
            <ErrorState Title="@T.PoDialog.LoadErrorTitle" Message="@_error" Action="LoadAsync" />
        }
        else if (_po is not null)
        {
            <MudText Typo="Typo.body2" Class="text-secondary mb-3">@_po.SupplierName · @_po.Status</MudText>

            @foreach (var line in _receiveLines)
            {
                var item = _po!.Items.First(i => i.Id == line.Id);
                var remaining = item.QuantityOrdered - item.QuantityReceived;

                <MudDivider Class="my-2" />
                <FormSectionHeading Title="@item.ItemName" Icon="@Icons.Material.Outlined.Inventory2" First="true" />
                <MudText Typo="Typo.caption" Class="text-secondary">
                    @T.PoDialog.Ordered @item.QuantityOrdered · @T.PoDialog.Received @item.QuantityReceived · @T.PoDialog.Remaining @remaining
                </MudText>

                <MudGrid Spacing="3" Class="mt-1">
                    <MudItem xs="12" sm="4">
                        <FormField Label="@T.PoDialog.ReceiveQty" Context="fieldId">
                            <MudNumericField Disabled="_busy" T="int?"
                                             @bind-Value="line.Quantity"
                                             InputId="@fieldId" aria-label="@T.PoDialog.ReceiveQty"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Min="1"
                                             Max="@remaining" />
                        </FormField>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <FormField Label="@T.PoDialog.LotNumber" Context="fieldId">
                            <MudTextField Disabled="_busy" @bind-Value="line.LotNumber"
                                          InputId="@fieldId" aria-label="@T.PoDialog.LotNumber"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true" />
                        </FormField>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <FormField Label="@T.PoDialog.ExpiryDate" Context="fieldId">
                            <MudDatePicker Disabled="_busy" @bind-Date="line.ExpiryDate"
                                           InputId="@fieldId" aria-label="@T.PoDialog.ExpiryDate"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Clearable="true" />
                        </FormField>
                    </MudItem>
                </MudGrid>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy || _po is null">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            <text>@T.PoDialog.ReceiveItems</text>
        </MudButton>
    </DialogActions>
</FormDialog>



