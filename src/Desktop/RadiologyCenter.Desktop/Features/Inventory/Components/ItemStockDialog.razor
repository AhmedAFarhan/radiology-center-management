@inject InventoryService InventoryService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<FormDialog Title="@(_stock?.ItemName ?? T.ItemDialog.ItemStockTitle)" Icon="@Icons.Material.Filled.Inventory2" Subtitle="@T["forms.inventorySubtitle"]">
    <DialogContent>
        @if (_loadError is not null)
        {
            <ErrorState Title="@T.ItemDialog.LoadStockErrorTitle" Message="@_loadError" Action="LoadStockAsync" />
        }
        else if (_stock is null)
        {
            <DialogSkeleton Rows="4" />
        }
        else
        {
            <MudText Typo="Typo.body2" Class="text-secondary mb-3">
                @T.ItemDialog.StockOnHand <b>@_stock.StockOnHand</b>
            </MudText>

            <FormSectionHeading Title="@T.ItemDialog.Batches" First="true" />
            <MudSimpleTable Dense="true">
                <thead>
                    <tr>
                        <th>@T.ItemDialog.Lot</th>
                        <th>@T.ItemDialog.Expiry</th>
                        <th>@T.ItemDialog.Remaining</th>
                        <th>@T.Common.Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_stock.Batches.Count == 0)
                    {
                        <tr>
                            <td colspan="4">@T.ItemDialog.NoBatches</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var batch in _stock.Batches)
                        {
                            <tr>
                                <td>@batch.LotNumber</td>
                                <td>@(batch.ExpiryDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>@batch.QuantityRemaining</td>
                                <td>
                                    <MudChip T="string" Size="Size.Small" Color="@(batch.IsExpired ? Color.Error : Color.Success)">@(batch.IsExpired ? T.ItemDialog.Expired : T.Common.Ok)</MudChip>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </MudSimpleTable>

            <MudDivider Class="my-4" />
            <FormSectionHeading Title="@T.ItemDialog.IssueStock" First="true" />
            <EditForm EditContext="_editContext">
                <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="4">
                        <FormField Label="@T.ItemDialog.Quantity" Context="fieldId">
                            <LocalizedNumericField Disabled="_busy" T="int?" @bind-Value="_model.Quantity"
                                             For="@(() => _model.Quantity)"
                                             InputId="@fieldId" aria-label="@T.ItemDialog.Quantity"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Min="1" />
                        </FormField>
                    </MudItem>
                    <MudItem xs="12" sm="8">
                        <FormField Label="@T.ItemDialog.Reference" Context="fieldId">
                            <MudTextField Disabled="_busy" @bind-Value="_model.Reference"
                                          InputId="@fieldId" aria-label="@T.ItemDialog.Reference"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true" />
                        </FormField>
                    </MudItem>
                    <MudItem xs="12">
                        <FormField Label="@T.ItemDialog.Notes" Context="fieldId">
                            <MudTextField Disabled="_busy" @bind-Value="_model.Notes"
                                          InputId="@fieldId" aria-label="@T.ItemDialog.Notes"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Immediate="true" />
                        </FormField>
                    </MudItem>
                </MudGrid>
            </EditForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="IssueAsync" Disabled="_busy || _stock is null || _loadError is not null">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            <text>@T.ItemDialog.IssueStock</text>
        </MudButton>
    </DialogActions>
</FormDialog>



