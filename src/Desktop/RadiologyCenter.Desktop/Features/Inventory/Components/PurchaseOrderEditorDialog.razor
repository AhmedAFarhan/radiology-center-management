@inherits EditorDialogBase
@inject InventoryService InventoryService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.ReceiptLong" Title="@T.PoDialog.NewPurchaseOrder" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="8">
                    <MudSelect T="string"
                               @bind-Value="_model.SupplierId"
                               Label="@T.PoDialog.Supplier"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.SupplierId)">
                        @foreach (var supplier in _suppliers)
                        {
                            <MudSelectItem T="string" Value="@supplier.Id">@supplier.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker @bind-Date="_model.ExpectedDeliveryAt"
                                   Label="@T.PoDialog.ExpectedDeliveryLabel"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true" />
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-3" />
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.subtitle2">@T.PoDialog.Items</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine" Size="Size.Small">@T.PoDialog.AddItem</MudButton>
            </div>

            @foreach (var line in _model.Items)
            {
                <MudGrid Spacing="2" Class="align-center mb-2">
                    <MudItem xs="12" sm="5">
                        <MudSelect T="string"
                                   @bind-Value="line.ItemId"
                                   Label="@T.PoDialog.Item"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            @foreach (var item in _items)
                            {
                                <MudSelectItem T="string" Value="@item.Id">@item.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudNumericField T="int"
                                         @bind-Value="line.QuantityOrdered"
                                         Label="@T.PoDialog.Qty"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="1" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudNumericField T="decimal"
                                         @bind-Value="line.UnitCost"
                                         Label="@T.PoDialog.UnitCost"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0" />
                    </MudItem>
                    <MudItem xs="12" sm="1">
                        <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       aria-label="@T.PoDialog.RemoveItem"
                                       OnClick="@(() => RemoveLine(line))" />
                    </MudItem>
                </MudGrid>
            }
            @if (_model.Items.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="text-secondary">@T.PoDialog.AddAtLeastOneItem</MudText>
            }

            <MudDivider Class="my-3" />
            <MudTextField @bind-Value="_model.Notes"
                          Label="@T.PoDialog.Notes"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="3"
                          Immediate="true" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       Disabled="@(_suppliers.Count == 0)"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@T.PoDialog.CreateOrder"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>


