@inherits EditorDialogBase
@inject InsuranceService InsuranceService
@inject ExaminationService ExaminationService
@inject PatientService PatientService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Approval" Title="@T.PreAuthDialog.Title" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="PatientDto"
                                     @bind-Value="_selectedPatient"
                                     Label="@T.PreAuthDialog.PatientSearchLabel"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchPatientsAsync"
                                     ToStringFunc="@(p => p is null ? string.Empty : p.FullName)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="InsurancePolicyDto"
                                     @bind-Value="_selectedPolicy"
                                     Label="@T.PreAuthDialog.PolicySearchLabel"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchPoliciesAsync"
                                     ToStringFunc="@(p => p is null ? string.Empty : p.PolicyNumber)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="ExaminationListItemDto"
                                     @bind-Value="_selectedExamination"
                                     Label="@T.PreAuthDialog.ExaminationSearchLabel"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchExaminationsAsync"
                                     ToStringFunc="@(e => e is null ? string.Empty : e.ExaminationTypeName)"
                                     Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal"
                                     @bind-Value="_model.EstimatedAmount"
                                     Label="@T.PreAuthDialog.EstimatedAmount"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     For="@(() => _model.EstimatedAmount)" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@T.PreAuthDialog.RequestAuthorization"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>

