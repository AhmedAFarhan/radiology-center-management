@inherits EditorDialogBase
@inject InsuranceService InsuranceService
@inject ExaminationService ExaminationService
@inject PatientService PatientService

<FormDialog Title="@T.PreAuthDialog.Title" Icon="@Icons.Material.Filled.Approval" Subtitle="@T["forms.insuranceSubtitle"]">
    <DialogContent>
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <MudGrid Spacing="3">
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.insuranceReferences"]" Icon="@Icons.Material.Outlined.Description" First="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.PreAuthDialog.PatientSearchLabel" Context="fieldId">
                        <MudAutocomplete Disabled="Busy" T="PatientDto"
                                         @bind-Value="_selectedPatient"
                                         InputId="@fieldId" aria-label="@T.PreAuthDialog.PatientSearchLabel"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="1"
                                         DebounceInterval="300"
                                         SearchFunc="SearchPatientsAsync"
                                         ToStringFunc="@(p => p is null ? string.Empty : p.FullName)"
                                         Clearable="true" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.PreAuthDialog.PolicySearchLabel" Context="fieldId">
                        <MudAutocomplete Disabled="Busy" T="InsurancePolicyDto"
                                         @bind-Value="_selectedPolicy"
                                         InputId="@fieldId" aria-label="@T.PreAuthDialog.PolicySearchLabel"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="1"
                                         DebounceInterval="300"
                                         SearchFunc="SearchPoliciesAsync"
                                         ToStringFunc="@(p => p is null ? string.Empty : p.PolicyNumber)"
                                         Clearable="true" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.PreAuthDialog.ExaminationSearchLabel" Context="fieldId">
                        <MudAutocomplete Disabled="Busy" T="ExaminationListItemDto"
                                         @bind-Value="_selectedExamination"
                                         InputId="@fieldId" aria-label="@T.PreAuthDialog.ExaminationSearchLabel"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="1"
                                         DebounceInterval="300"
                                         SearchFunc="SearchExaminationsAsync"
                                         ToStringFunc="@(e => e is null ? string.Empty : e.ExaminationTypeName)"
                                         Clearable="true" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.billing"]" Icon="@Icons.Material.Outlined.ReceiptLong" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.PreAuthDialog.EstimatedAmount" Context="fieldId">
                        <LocalizedNumericField Disabled="Busy" T="decimal"
                                         @bind-Value="_model.EstimatedAmount"
                                         InputId="@fieldId" aria-label="@T.PreAuthDialog.EstimatedAmount"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0"
                                         For="@(() => _model.EstimatedAmount)" />
                    </FormField>
                </MudItem>
            </MudGrid>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@T.PreAuthDialog.RequestAuthorization"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</FormDialog>

