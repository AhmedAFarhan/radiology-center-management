@inherits EditorDialogBase
@inject InsuranceService InsuranceService
@inject PatientService PatientService

<FormDialog Title="@T.PolicyDialog.Title" Icon="@Icons.Material.Filled.Description" Subtitle="@T["forms.insuranceSubtitle"]">
    <DialogContent>
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <MudGrid Spacing="3">
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.policy"]" Icon="@Icons.Material.Outlined.Description" First="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.PolicyDialog.PatientSearchLabel" Context="fieldId">
                        <MudAutocomplete Disabled="Busy" T="PatientDto"
                                         @bind-Value="_selectedPatient"
                                         InputId="@fieldId" aria-label="@T.PolicyDialog.PatientSearchLabel"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="1"
                                         DebounceInterval="300"
                                         SearchFunc="SearchPatientsAsync"
                                         ToStringFunc="@(p => p is null ? string.Empty : p.FullName)"
                                         Clearable="true" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.PolicyDialog.CompanyLabel" Context="fieldId">
                        <MudAutocomplete Disabled="Busy" T="InsuranceCompanyDto"
                                         @bind-Value="_selectedCompany"
                                         InputId="@fieldId" aria-label="@T.PolicyDialog.CompanyLabel"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="1"
                                         DebounceInterval="300"
                                         SearchFunc="SearchCompaniesAsync"
                                         ToStringFunc="@(c => c is null ? string.Empty : c.Name)"
                                         Clearable="true" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.PolicyDialog.PolicyNumber" Context="fieldId" Required="true">
                        <LocalizedTextField Disabled="Busy" @bind-Value="_model.PolicyNumber"
                                      InputId="@fieldId" aria-required="true" aria-label="@T.PolicyDialog.PolicyNumber"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      For="@(() => _model.PolicyNumber)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.coverage"]" Icon="@Icons.Material.Outlined.VerifiedUser" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.PolicyDialog.CoveragePercent" Context="fieldId">
                        <LocalizedNumericField Disabled="Busy" T="decimal"
                                         @bind-Value="_model.CoveragePercent"
                                         InputId="@fieldId" aria-label="@T.PolicyDialog.CoveragePercent"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0"
                                         Max="100"
                                         For="@(() => _model.CoveragePercent)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.PolicyDialog.EffectiveFrom" Context="fieldId">
                        <MudDatePicker Disabled="Busy" @bind-Date="_model.EffectiveFrom"
                                       InputId="@fieldId" aria-label="@T.PolicyDialog.EffectiveFrom"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.PolicyDialog.EffectiveTo" Context="fieldId">
                        <MudDatePicker Disabled="Busy" @bind-Date="_model.EffectiveTo" MinDate="_model.EffectiveFrom"
                                       InputId="@fieldId" aria-label="@T.PolicyDialog.EffectiveTo"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true" />
                    </FormField>
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch Disabled="Busy" T="bool" @bind-Value="_model.IsGovernment" Color="Color.Primary">@T.PolicyDialog.GovernmentPolicy</MudSwitch>
                </MudItem>
            </MudGrid>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@T.PolicyDialog.Create"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</FormDialog>

