@inject InsuranceService InsuranceService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Approval" Title="@T.PreAuthDialog.DetailsTitle" />

        @if (_loadError is not null)
        {
            <ErrorState Title="@T.PreAuthDialog.LoadErrorTitle" Message="@_loadError" Action="LoadAsync" />
        }
        else if (_preAuth is null)
        {
            <DialogSkeleton Rows="3" />
        }
        else
        {
            <MudGrid Spacing="2">
                <DetailField Label="@T.PreAuthDialog.Patient" Value="@_patientName" />
                <DetailField Label="@T.PreAuthDialog.Examination" Value="@_examinationName" />
                <DetailField Label="@T.PreAuthDialog.Policy" Value="@_policyNumber" />
                <DetailField Label="@T.PreAuthDialog.EstimatedAmount" Value="@_preAuth.EstimatedAmount.ToString("C")" />
                <DetailField Label="@T.Common.Status" Value="@_preAuth.Status" />
                <DetailField Label="@T.PreAuthDialog.RequestedAt" Value="@_preAuth.RequestedAt.ToString("yyyy-MM-dd HH:mm")" />
                @if (_preAuth.StatusKey == "Approved")
                {
                    <DetailField Label="@T.PreAuthDialog.ApprovedAmount" Value="@(_preAuth.ApprovedAmount?.ToString("C") ?? "-")" />
                }
                @if (_preAuth.StatusKey == "Denied" && !string.IsNullOrWhiteSpace(_preAuth.RejectionReason))
                {
                    <DetailField Label="@T.PreAuthDialog.RejectionReason" Sm="12" Md="12">
                        <MudText>@_preAuth.RejectionReason</MudText>
                    </DetailField>
                }
            </MudGrid>

            @if (_preAuth.StatusKey == "Requested")
            {
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2" Class="mb-1">@T.PreAuthDialog.Decision</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal?"
                                         @bind-Value="_approvedAmount"
                                         Label="@T.PreAuthDialog.ApprovedAmount"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_rejectionReason"
                                      Label="@T.PreAuthDialog.RejectionReasonForDeny"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="2"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudButton FullWidth="true" Color="Color.Success" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Check" OnClick="ApproveAsync" Disabled="_busy">@T.PreAuthDialog.Approve</MudButton>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudButton FullWidth="true" Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Close" OnClick="DenyAsync" Disabled="_busy">@T.PreAuthDialog.Deny</MudButton>
                    </MudItem>
                </MudGrid>
            }

            <MudDivider Class="my-2" />
            <MudText Typo="Typo.subtitle2" Class="mb-1">@T.PreAuthDialog.Documents</MudText>

            @if (_documents is null)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="d-flex mx-auto my-2" />
            }
            else if (_documents.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="text-secondary">@T.PreAuthDialog.NoDocuments</MudText>
            }
            else
            {
                @foreach (var document in _documents)
                {
                    <MudPaper Elevation="0" Outlined="true" Class="d-flex align-center pa-2 my-1">
                        <MudIcon Icon="@Icons.Material.Filled.Approval" Class="mx-2" />
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.body2">@document.FileName</MudText>
                            <MudText Typo="Typo.caption" Class="text-secondary">@($"{document.Type} · {document.SizeInBytes / 1024m:0.#} KB · {document.UploadedAt:yyyy-MM-dd}")</MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" Color="Color.Default" aria-label="@T.PreAuthDialog.Download" OnClick="@(() => DownloadDocumentAsync(document))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Delete" OnClick="@(() => DeleteDocumentAsync(document))" />
                    </MudPaper>
                }
            }

            <MudButton HtmlTag="label" for="preauth-doc-input"
                       Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Upload"
                       Disabled="_busy"
                       Class="mt-2">
                @(_busy ? T.PreAuthDialog.Uploading : T.PreAuthDialog.UploadDocument)
            </MudButton>
            <InputFile id="preauth-doc-input" OnChange="OnFileSelectedAsync" style="display:none" />
            <MudText Typo="Typo.caption" Class="text-secondary mt-1">@T.PreAuthDialog.UploadHint</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync">@T.Common.Close</MudButton>
    </DialogActions>
</MudDialog>

