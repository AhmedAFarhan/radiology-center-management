@inject InsuranceService InsuranceService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<FormDialog Title="@(Company is null ? T.CompanyDialog.Title : T.CompanyDialog.EditTitle)" Icon="@Icons.Material.Filled.Shield" Subtitle="@T["forms.insuranceSubtitle"]">
    <DialogContent>
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <MudGrid Spacing="3">
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.company"]" Icon="@Icons.Material.Outlined.Business" First="true" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <FormField Label="@T.Common.Name" Context="fieldId" Required="true">
                        <LocalizedTextField Disabled="_busy" @bind-Value="_model.Name"
                                      InputId="@fieldId" aria-required="true" aria-label="@T.Common.Name"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      For="@(() => _model.Name)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <FormField Label="@T.CompanyDialog.TaxNumber" Context="fieldId">
                        <LocalizedTextField Disabled="_busy" @bind-Value="_model.TaxId"
                                      InputId="@fieldId" aria-label="@T.CompanyDialog.TaxNumber"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      For="@(() => _model.TaxId)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.contact"]" Icon="@Icons.Material.Outlined.ContactPhone" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.CompanyDialog.Phone" Context="fieldId">
                        <LocalizedTextField InputType="InputType.Telephone" Disabled="_busy" @bind-Value="_model.Phone"
                                      InputId="@fieldId" aria-label="@T.CompanyDialog.Phone"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      For="@(() => _model.Phone)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.CompanyDialog.Email" Context="fieldId">
                        <LocalizedTextField InputType="InputType.Email" Disabled="_busy" @bind-Value="_model.Email"
                                      InputId="@fieldId" aria-label="@T.CompanyDialog.Email"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      For="@(() => _model.Email)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.CompanyDialog.Address" Context="fieldId">
                        <LocalizedTextField Disabled="_busy" @bind-Value="_model.Address"
                                      InputId="@fieldId" aria-label="@T.CompanyDialog.Address"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      For="@(() => _model.Address)" />
                    </FormField>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            <text>@(IsEdit ? T.CompanyDialog.SaveChanges : T.CompanyDialog.Create)</text>
        </MudButton>
    </DialogActions>
</FormDialog>

