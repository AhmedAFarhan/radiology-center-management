@inject InsuranceService InsuranceService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Description" Title="@(_policy?.PolicyNumber ?? T.PolicyDialog.DetailsTitle)" />

        @if (_loadError is not null)
        {
            <ErrorState Title="@T.PolicyDialog.LoadErrorTitle" Message="@_loadError" Action="LoadAsync" />
        }
        else if (_policy is null)
        {
            <DialogSkeleton Rows="3" />
        }
        else
        {
            <MudGrid Spacing="2">
                <DetailField Label="@T.PolicyDialog.Patient" Value="@_patientName" />
                <DetailField Label="@T.PolicyDialog.Company" Value="@_companyName" />
                <DetailField Label="@T.PolicyDialog.CoveragePercent" Value="@($"{_policy.CoveragePercent:0}%")" />
                <DetailField Label="@T.Common.Status" Value="@_policy.Status" />
                <DetailField Label="@T.PolicyDialog.EffectiveFrom" Value="@_policy.EffectiveFrom.ToString("yyyy-MM-dd")" />
                <DetailField Label="@T.PolicyDialog.EffectiveToLabel" Value="@(_policy.EffectiveTo?.ToString("yyyy-MM-dd") ?? "-")" />
            </MudGrid>

            <MudDivider Class="my-2" />
            <MudText Typo="Typo.subtitle2" Class="mb-1">@T.PolicyDialog.Documents</MudText>

            @if (_documents is null)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="d-flex mx-auto my-2" />
            }
            else if (_documents.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="text-secondary">@T.PolicyDialog.NoDocuments</MudText>
            }
            else
            {
                @foreach (var document in _documents)
                {
                    <MudPaper Elevation="0" Outlined="true" Class="d-flex align-center pa-2 my-1">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Class="mx-2" />
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.body2">@document.FileName</MudText>
                            <MudText Typo="Typo.caption" Class="text-secondary">@FormatDocumentMeta(document)</MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" Color="Color.Default" aria-label="@T.PolicyDialog.Download" OnClick="@(() => DownloadDocumentAsync(document))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Delete" OnClick="@(() => DeleteDocumentAsync(document))" />
                    </MudPaper>
                }
            }

            <MudButton HtmlTag="label" for="policy-doc-input"
                       Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Upload"
                       Disabled="_busy"
                       Class="mt-2">
                @(_busy ? T.PolicyDialog.Uploading : T.PolicyDialog.UploadDocument)
            </MudButton>
            <InputFile id="policy-doc-input" OnChange="OnFileSelectedAsync" style="display:none" />
            <MudText Typo="Typo.caption" Class="text-secondary mt-1">@T.PolicyDialog.DocumentsHint</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync">@T.Common.Close</MudButton>
    </DialogActions>
</MudDialog>

