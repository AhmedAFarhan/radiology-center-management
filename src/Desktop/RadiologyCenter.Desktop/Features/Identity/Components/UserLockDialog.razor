@inject IdentityService IdentityService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<FormDialog Title="@(T.FormatValue(T.UserDialog.LockTitle, User.UserName))" Icon="@Icons.Material.Filled.Lock" Subtitle="@T["forms.identitySubtitle"]">
    <DialogContent>
        <MudText Typo="Typo.body2" Class="text-secondary mb-3">
            @(T.FormatValue(T.UserDialog.LockDescription, User.UserName))
        </MudText>
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <FormField Label="@T.UserDialog.LockUntil" Context="fieldId" Required="true">
                <LocalizedDatePicker Disabled="_busy" @bind-Date="_model.LockUntilDate"
                               For="@(() => _model.LockUntilDate)"
                               InputId="@fieldId" aria-required="true" aria-label="@T.UserDialog.LockUntil"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="w-100" />
            </FormField>
            <FormField Label="@T.UserDialog.LockUntilTime" Context="fieldId" Required="true">
                <LocalizedTimePicker Disabled="_busy" @bind-Time="_model.LockUntilTime"
                               For="@(() => _model.LockUntilTime)"
                               InputId="@fieldId" aria-required="true" aria-label="@T.UserDialog.LockUntilTime"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="w-100" />
            </FormField>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            <text>@T.UserDialog.LockUser</text>
        </MudButton>
    </DialogActions>
</FormDialog>


