@inject IdentityService IdentityService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<FormDialog Title="@(T.FormatValue(T.RoleDialog.PermissionsTitle, Role.Name))" Icon="@Icons.Material.Filled.Security" Subtitle="@T["forms.identitySubtitle"]">
    <DialogContent>
        <MudText Typo="Typo.body2" Class="text-secondary mb-3">
            @T.RoleDialog.PermissionsDescription
        </MudText>

        @if (DesktopConfiguration.UseClinicServer)
        {
            <MudText Typo="Typo.caption" Class="mb-3">@(T.IsRTL?"تغييرات الحسابات والأدوار مقتصرة على المسؤولين.":"Account and role changes are limited to administrators.")</MudText>
        }
        @if (_loading)
        {
            <DialogSkeleton Rows="4" />
        }
        else if (_loadError is not null)
        {
            <ErrorState Icon="@Icons.Material.Filled.CloudOff"
                        Title="@T.Common.ErrorTitle"
                        Message="@_loadError"
                        Action="LoadAsync" />
        }
        else
        {
            <div class="permission-scroll">
                <MudGrid Spacing="3">
                    @foreach (var group in _groups)
                    {
                        <MudItem xs="12" sm="6">
                            <MudPaper Elevation="0" Class="pa-3 mb-2 permission-group">
                                <MudText Typo="Typo.subtitle2" Class="mb-1">@GroupName(group)</MudText>
                                @foreach (var permission in _byGroup[group])
                                {
                                    <div>
                                        <MudSwitch T="bool"
                                                   @bind-Value="_selected[permission.Code]"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   Disabled="@(DesktopConfiguration.UseClinicServer && !Role.IsSystem && (permission.Code.StartsWith("users.") || permission.Code.StartsWith("roles.")) && !permission.Code.EndsWith(".read"))">
                                            <MudText Typo="Typo.body2">@PermissionName(permission)</MudText>
                                        </MudSwitch>
                                    </div>
                                }
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="@(_busy || _loading)">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="@(_busy || _loading)">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            <text>@T.RoleDialog.SavePermissions</text>
        </MudButton>
    </DialogActions>
</FormDialog>

