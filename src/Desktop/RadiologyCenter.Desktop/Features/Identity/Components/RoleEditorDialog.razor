@inherits EditorDialogBase
@inject IdentityService IdentityService

<FormDialog Title="@(Role is null ? T.RoleDialog.NewRole : T.RoleDialog.EditTitle)" Icon="@Icons.Material.Filled.Security" Subtitle="@T["forms.identitySubtitle"]">
    <DialogContent>
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <FormField Label="@T.RoleDialog.RoleName" Context="fieldId" Required="true">
                <LocalizedTextField Disabled="Busy" @bind-Value="_model.Name"
                              InputId="@fieldId" aria-required="true" aria-label="@T.RoleDialog.RoleName"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Class="mb-3"
                              For="@(() => _model.Name)" />
            </FormField>
            <FormField Label="@T.Roles.Description" Context="fieldId">
                <LocalizedTextField Disabled="Busy" @bind-Value="_model.Description"
                              InputId="@fieldId" aria-label="@T.Roles.Description"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="3"
                              Immediate="true"
                              For="@(() => _model.Description)" />
            </FormField>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.RoleDialog.SaveChanges : T.RoleDialog.CreateRole)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</FormDialog>


