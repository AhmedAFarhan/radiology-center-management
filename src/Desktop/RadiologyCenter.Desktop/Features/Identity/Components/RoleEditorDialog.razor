@inherits EditorDialogBase
@inject IdentityService IdentityService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Security" Title="@(Role is null ? T.RoleDialog.NewRole : T.RoleDialog.EditTitle)" />
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <MudTextField @bind-Value="_model.Name"
                          Label="@T.RoleDialog.RoleName"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Class="mb-3"
                          For="@(() => _model.Name)" />
            <MudTextField @bind-Value="_model.Description"
                          Label="@T.Roles.Description"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Lines="3"
                          Immediate="true"
                          For="@(() => _model.Description)" />
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.RoleDialog.SaveChanges : T.RoleDialog.CreateRole)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>


