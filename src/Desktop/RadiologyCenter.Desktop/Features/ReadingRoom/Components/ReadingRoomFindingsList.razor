@if (CanEdit)
@inject AppLocalizer T

<MudText Typo="Typo.subtitle1" Class="font-weight-medium mb-2">@T.ReadingRoom.Findings</MudText>
@if (Findings.Any())
{
    @foreach (var finding in Findings)
    {
        var currentFinding = finding;
        <div class="d-flex align-center mb-2 pa-2" style="border:1px solid var(--mud-palette-lines-default,#e0e0e0);border-radius:8px;">
            <MudStack Spacing="0" Class="flex-grow-1">
                <MudText Typo="Typo.subtitle2">@currentFinding.Region</MudText>
                <MudText Typo="Typo.body2" Class="text-secondary">@currentFinding.Description</MudText>
            </MudStack>
            @if (CanEdit)
            {
                <MudSelect T="string"
                           Value="@currentFinding.Severity"
                           ValueChanged="@(s => OnSeverityChanged.InvokeAsync((currentFinding, s)))"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           Class="flex-shrink-0"
                           Style="min-width:120px;">
                    @foreach (var level in SeverityOptions)
                    {
                        <MudSelectItem T="string" Value="@level.Key">@level.Value</MudSelectItem>
                    }
                </MudSelect>
                <MudTooltip Placement="Placement.Bottom" Text="@T.ReadingRoom.RemoveFinding">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   aria-label="@T.ReadingRoom.RemoveFinding"
                                   OnClick="@(() => OnRemoveFinding.InvokeAsync(currentFinding))"
                                   Class="ms-1" />
                </MudTooltip>
            }
        </div>
    }
}
else
{
    <MudText Typo="Typo.body2" Class="text-secondary">@T.ReadingRoom.NoFindings</MudText>
}

@if (CanEdit)
{
    <MudDivider Class="my-3" />
    <MudText Typo="Typo.subtitle1" Class="font-weight-medium mb-2">@T.ReadingRoom.AddFinding</MudText>
    <MudTextField T="string"
                  @bind-Value="_newRegion"
                  Label="@T.ReadingRoom.RegionAnatomy"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Immediate="true" />
    <MudTextField T="string"
                  @bind-Value="_newDescription"
                  Label="@T.ReadingRoom.Description"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Lines="2"
                  Immediate="true"
                  Class="mt-2" />
    <MudSelect T="string"
               @bind-Value="_newSeverity"
               Label="@T.ReadingRoom.Severity"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Class="mt-2">
        @foreach (var level in SeverityOptions)
        {
            <MudSelectItem T="string" Value="@level.Key">@level.Value</MudSelectItem>
        }
    </MudSelect>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Add"
               Class="mt-2"
               OnClick="AddFinding"
               Disabled="@(string.IsNullOrWhiteSpace(_newRegion) || string.IsNullOrWhiteSpace(_newDescription))">@T.ReadingRoom.AddFinding</MudButton>
}
