@inject AppLocalizer T

<FormSectionHeading Title="@T.ReadingRoom.Findings" First="true" />
@if (Findings.Any())
{
    @foreach (var finding in Findings)
    {
        var currentFinding = finding;
        <div class="rr-finding-editor d-flex align-center flex-wrap gap-2">
            <MudStack Spacing="0" Class="flex-grow-1">
                <MudText Typo="Typo.subtitle2">@currentFinding.Region</MudText>
                <MudText Typo="Typo.body2" Class="text-secondary">@currentFinding.Description</MudText>
            </MudStack>
            @if (CanEdit)
            {
                <FormField Label="@T.ReadingRoom.Severity" Context="fieldId">
                    <MudSelect T="string" Disabled="Busy"
                               Value="@currentFinding.Severity" InputId="@fieldId" aria-label="@T.ReadingRoom.Severity"
                               ValueChanged="@(s => OnSeverityChanged.InvokeAsync((currentFinding, s)))"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Class="flex-shrink-0"
                               Style="min-width:120px;">
                        @foreach (var level in SeverityOptions)
                        {
                            <MudSelectItem T="string" Value="@level.Key">@level.Value</MudSelectItem>
                        }
                    </MudSelect>
                </FormField>
                <MudTooltip Placement="Placement.Bottom" Text="@T.ReadingRoom.RemoveFinding">
                    <MudIconButton Disabled="Busy" Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   aria-label="@T.ReadingRoom.RemoveFinding"
                                   OnClick="@(() => OnRemoveFinding.InvokeAsync(currentFinding))"
                                   Class="ms-1" />
                </MudTooltip>
            }
            else
            {
                <span class="rr-finding-severity">@(SeverityOptions.FirstOrDefault(o => o.Key == currentFinding.Severity)?.Value ?? currentFinding.Severity)</span>
            }
        </div>
    }
}
else
{
    <MudText Typo="Typo.body2" Class="text-secondary">@T.ReadingRoom.NoFindings</MudText>
}

@if (CanEdit)
{
    <MudDivider Class="my-3" />
    <FormSectionHeading Title="@T.ReadingRoom.AddFinding" First="true" />
    <FormField Label="@T.ReadingRoom.RegionAnatomy" Context="fieldId">
        <MudTextField T="string" Disabled="Busy"
                      @bind-Value="_newRegion"
                      InputId="@fieldId" aria-label="@T.ReadingRoom.RegionAnatomy"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true" />
    </FormField>
    <FormField Label="@T.ReadingRoom.Description" Context="fieldId">
        <MudTextField T="string" Disabled="Busy"
                      @bind-Value="_newDescription"
                      InputId="@fieldId" aria-label="@T.ReadingRoom.Description"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Lines="2"
                      Immediate="true"
                      Class="mt-2" />
    </FormField>
    <FormField Label="@T.ReadingRoom.Severity" Context="fieldId">
        <MudSelect T="string" Disabled="Busy"
                   @bind-Value="_newSeverity"
                   InputId="@fieldId" aria-label="@T.ReadingRoom.Severity"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Class="mt-2">
            @foreach (var level in SeverityOptions)
            {
                <MudSelectItem T="string" Value="@level.Key">@level.Value</MudSelectItem>
            }
        </MudSelect>
    </FormField>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Add"
               Class="mt-2"
               OnClick="AddFinding"
               Disabled="@(Busy || string.IsNullOrWhiteSpace(_newRegion) || string.IsNullOrWhiteSpace(_newDescription))">@T.ReadingRoom.AddFinding</MudButton>
}
