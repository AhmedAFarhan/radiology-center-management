@using RadiologyCenter.Desktop.Models
@using RadiologyCenter.Desktop.Services

<FormDialog Title="@T.AssignStaffDialog.Title" Icon="@Icons.Material.Filled.PersonAdd" Subtitle="@T["forms.assignmentSubtitle"]">
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Class="d-flex mx-auto my-4" />
        }
        else
        {
            <EditForm EditContext="_editContext">
                <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
                <MudGrid Spacing="3">
                    <MudItem xs="12">
                        <FormField Label="@T.AssignStaffDialog.Radiologist" Context="fieldId">
                            <MudSelect Disabled="_busy" T="string"
                                       InputId="@fieldId" aria-label="@T.AssignStaffDialog.Radiologist"
                                       @bind-Value="_radiologistId"
                                       Variant="Variant.Outlined"
                                       FullWidth="true">
                                @foreach (var r in _radiologists)
                                {
                                    <MudSelectItem Value="@r.Id">@r.FullName</MudSelectItem>
                                }
                            </MudSelect>
                        </FormField>
                    </MudItem>
                    <MudItem xs="12">
                        <FormField Label="@T.AssignStaffDialog.Technician" Context="fieldId">
                            <MudSelect Disabled="_busy" T="string"
                                       InputId="@fieldId" aria-label="@T.AssignStaffDialog.Technician"
                                       @bind-Value="_technicianId"
                                       Variant="Variant.Outlined"
                                       FullWidth="true">
                                @foreach (var t in _technicians)
                                {
                                    <MudSelectItem Value="@t.Id">@t.FullName</MudSelectItem>
                                }
                            </MudSelect>
                        </FormField>
                    </MudItem>
                    <MudItem xs="12">
                        <FormField Label="@T.AssignStaffDialog.Equipment" Context="fieldId">
                            <MudSelect Disabled="_busy" T="string"
                                       InputId="@fieldId" aria-label="@T.AssignStaffDialog.Equipment"
                                       @bind-Value="_equipmentId"
                                       Variant="Variant.Outlined"
                                       FullWidth="true">
                                <MudSelectItem Value="@((string?)null)">@T.AssignStaffDialog.None</MudSelectItem>
                                @foreach (var eq in _filteredEquipments)
                                {
                                    <MudSelectItem Value="@eq.Id">@eq.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </FormField>
                    </MudItem>
                </MudGrid>
            </EditForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy || _saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            <text>@T.AssignStaffDialog.Assign</text>
        </MudButton>
    </DialogActions>
</FormDialog>
