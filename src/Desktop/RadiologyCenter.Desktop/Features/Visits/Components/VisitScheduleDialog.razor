@inject ExaminationService ExaminationService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<FormDialog Title="@(T.FormatValue(T.VisitSchedule.Title, Visit.ExaminationTypeName))" Icon="@Icons.Material.Filled.EventNote" Subtitle="@T["forms.visitSubtitle"]">
    <DialogContent>
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <FormField Label="@T.VisitSchedule.ScheduledDate" Context="fieldId" Required="true">
                <LocalizedDatePicker Disabled="_busy" @bind-Date="_model.ScheduledDate"
                               For="@(() => _model.ScheduledDate)"
                               InputId="@fieldId" aria-required="true" aria-label="@T.VisitSchedule.ScheduledDate"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="w-100" />
            </FormField>
            <FormField Label="@T.VisitSchedule.ScheduledTime" Context="fieldId" Required="true">
                <LocalizedTimePicker Disabled="_busy" @bind-Time="_model.ScheduledTime"
                               For="@(() => _model.ScheduledTime)"
                               InputId="@fieldId" aria-required="true" aria-label="@T.VisitSchedule.ScheduledTime"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Class="w-100" />
            </FormField>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            <text>@T.VisitSchedule.Schedule</text>
        </MudButton>
    </DialogActions>
</FormDialog>


