@inject ExaminationService ExaminationService
@inject PatientService PatientService
@inject ResourceService ResourceService
@inject InventoryService InventoryService
@inject EnumOptionsService EnumOptionsService
@inject ISnackbar Snackbar
@inject AppLocalizer T
@inject PermissionService Permissions
@using RadiologyCenter.Desktop.Features.Patients.Components

<FormDialog Title="@(_quickRegistrationOpen ? T["visitDialog.newPatient"] : IsEdit ? T.VisitDialog.EditTitle : T.VisitDialog.NewTitle)"
            Icon="@(_quickRegistrationOpen ? Icons.Material.Outlined.PersonAdd : Icons.Material.Filled.EventNote)"
            Subtitle="@T[_quickRegistrationOpen ? "visitDialog.quickRegisterHint" : "forms.visitSubtitle"]">
    <DialogContent>
        @if (_quickRegistrationOpen && CanRegisterPatient)
        {
            <QuickPatientRegistration @ref="_registrationForm" SearchText="@_registrationSeed" Draft="_patientDraft"
                                      GenderOptions="_genderOptions" CreatePatient="CreateQuickPatientAsync"
                                      Registered="UseRegisteredPatientAsync" SavingChanged="PatientSavingChangedAsync" Disabled="_busy" />
        }
        else
        {
            <EditForm EditContext="_editContext">
                <LocalizedDataAnnotationsValidator />
                @if (_submitAttempted && _editContext.GetValidationMessages().Any())
                {
                    <div class="visit-validation-summary" role="alert" tabindex="-1" @ref="_validationSummary">
                        <strong><MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Small" aria-hidden="true" />@T["visitDialog.reviewFields"]</strong>
                        <ValidationSummary />
                    </div>
                }
                <div class="visit-form-layout">
                    <section class="visit-form-section" aria-label="@T.VisitDialog.Patient">
                        <MudGrid Spacing="3">
                            <MudItem xs="12">
                                <div class="visit-patient-heading">
                                    <h3><MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" aria-hidden="true" />@T.VisitDialog.Patient</h3>
                                </div>
                                @if (_model.Patient is { } selectedPatient && !_changingPatient)
                                {
                                    <div class="visit-selected-patient" role="status">
                                        <span class="visit-patient-avatar" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.Person" /></span>
                                        <div class="visit-patient-identity">
                                            <strong>@selectedPatient.FullName</strong>
                                            <span class="visit-patient-meta"><bdi>@selectedPatient.PatientCode</bdi><span aria-hidden="true">·</span><bdi dir="ltr">@selectedPatient.PhoneNumber</bdi></span>
                                            @if (_registeredPatientId == selectedPatient.Id)
                                            {
                                                <span class="visit-patient-confirmed"><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" aria-hidden="true" />@T["visitDialog.patientRegistered"]</span>
                                            }
                                        </div>
                                        <MudButton ButtonType="ButtonType.Button" Disabled="IsBusy" OnClick="ChangePatient" Color="Color.Primary">@T["visitDialog.changePatient"]</MudButton>
                                    </div>
                                }
                                else
                                {
                                <FormField Label="@T.VisitDialog.PatientSearch" Context="fieldId" Required="true">
                                    <LocalizedAutocomplete @ref="_patientLookup" Disabled="IsBusy" T="PatientDto"
                                                     Value="_model.Patient" ValueChanged="PatientSelected"
                                                     Text="@_patientSearchText" TextChanged="PatientSearchTextChanged"
                                                     OnClearButtonClick="ClearPatientSearch"
                                                     InputId="@fieldId" aria-required="true" aria-label="@T.VisitDialog.PatientSearch"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     MinCharacters="1"
                                                     DebounceInterval="300"
                                                     SearchFunc="SearchPatientsAsync"
                                                     ShowProgressIndicator="true"
                                                     ToStringFunc="@(p => p is null ? string.Empty : p.FullName)"
                                                     For="@(() => _model.Patient)"
                                                     Clearable="true">
                                        <ItemTemplate Context="patient">
                                            <div class="visit-patient-option">
                                                <strong>@patient.FullName</strong>
                                                <span><bdi>@patient.PatientCode</bdi> <span aria-hidden="true">·</span> <bdi dir="ltr">@patient.PhoneNumber</bdi></span>
                                            </div>
                                        </ItemTemplate>
                                        <NoItemsTemplate>
                                            @if (_patientSearchFailed)
                                            {
                                                <div class="visit-patient-empty" role="status">@T.VisitDialog.SearchPatientsError</div>
                                            }
                                            else if (_patientNotFound)
                                            {
                                                <div class="visit-patient-empty" role="status">
                                                    <MudStack Row="false" AlignItems="AlignItems.Center" Spacing="3">
                                                    <strong>@T["visitDialog.patientNotFound"]</strong>
                                                    @if (CanRegisterPatient)
                                                    {
                                                        <MudButton ButtonType="ButtonType.Button" Variant="Variant.Outlined" Color="Color.Primary"
                                                                   StartIcon="@Icons.Material.Outlined.PersonAdd" Disabled="IsBusy"
                                                                   OnClick="OpenQuickRegistrationAsync">@T["visitDialog.addPatient"]</MudButton>
                                                    }
                                                    </MudStack>
                                                </div>
                                            }
                                        </NoItemsTemplate>
                                    </LocalizedAutocomplete>
                                </FormField>
                                }
                            </MudItem>
                        </MudGrid>
                    </section>
                    <section class="visit-form-section" aria-label="@T["forms.examination"]">
                        <MudGrid Spacing="3">
                            <MudItem xs="12" Class="app-form-section-item">
                                <FormSectionHeading Title="@T["forms.examination"]" Icon="@Icons.Material.Outlined.MedicalServices" First="true" />
                            </MudItem>

                            <MudItem xs="12">
                                <FormField Label="@T.VisitDialog.TypeSearch" Context="fieldId" Required="true">
                                    <LocalizedAutocomplete @ref="_examinationLookup" Disabled="IsBusy" T="ExaminationTypeDto"
                                                     @bind-Value="_model.ExaminationType"
                                                     InputId="@fieldId" aria-required="true" aria-label="@T.VisitDialog.TypeSearch"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     MinCharacters="1"
                                                     DebounceInterval="300"
                                                     SearchFunc="SearchTypesAsync"
                                                     ToStringFunc="@(t => t is null ? string.Empty : $"{t.Code} - {t.Name}")"
                                                     For="@(() => _model.ExaminationType)"
                                                     Clearable="true" />
                                </FormField>
                            </MudItem>

                            <MudItem xs="12">
                                <FormField Label="@T.VisitDialog.ClinicalIndication" Context="fieldId" Required="true">
                                    <LocalizedTextField Disabled="IsBusy" @bind-Value="_model.ClinicalIndication"
                                                  InputId="@fieldId" aria-required="true" aria-label="@T.VisitDialog.ClinicalIndication"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Lines="2"
                                                  Immediate="true"
                                                  For="@(() => _model.ClinicalIndication)" />
                                </FormField>
                            </MudItem>
                        </MudGrid>
                    </section>
                    <section class="visit-form-section" aria-label="@T["forms.schedule"]">
                        <MudGrid Spacing="3">
                            <MudItem xs="12" Class="app-form-section-item">
                                <FormSectionHeading Title="@T["forms.schedule"]" Icon="@Icons.Material.Outlined.EventNote" First="true" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <FormField Label="@T.VisitDialog.Priority" Context="fieldId">
                                    <MudSelect Disabled="IsBusy" T="string"
                                               @bind-Value="_model.Priority"
                                               InputId="@fieldId" aria-label="@T.VisitDialog.Priority"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense">
                                        @foreach (var priority in _priorityOptions)
                                        {
                                            <MudSelectItem T="string" Value="@priority.Key">@priority.Value</MudSelectItem>
                                        }
                                    </MudSelect>
                                </FormField>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <FormField Label="@T.VisitDialog.Status" Context="fieldId">
                                    <MudSelect Disabled="IsBusy" T="string"
                                               @bind-Value="_model.Status" @bind-Value:after="OnStatusChanged"
                                               InputId="@fieldId" aria-label="@T.VisitDialog.Status"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense">
                                        @foreach (var status in _statusOptions)
                                        {
                                            <MudSelectItem T="string" Value="@status.Key">@status.Value</MudSelectItem>
                                        }
                                    </MudSelect>
                                </FormField>
                            </MudItem>
                            @if (_model.Status == "Scheduled")
                            {
                                <MudItem xs="12" sm="6">
                                    <FormField Label="@T.VisitDialog.ScheduledDate" Context="fieldId" Required="true">
                                        <LocalizedDatePicker Disabled="IsBusy" @bind-Date="_model.ScheduledDate"
                                                       InputId="@fieldId" aria-required="true" aria-label="@T.VisitDialog.ScheduledDate"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       Class="w-100"
                                                       For="@(() => _model.ScheduledDate)" />
                                    </FormField>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                <FormField Label="@T.VisitDialog.ScheduledTime" Context="fieldId" Required="true">
                                    <LocalizedTimePicker Disabled="IsBusy" @bind-Time="_model.ScheduledTime"
                                                   InputId="@fieldId" aria-required="true" aria-label="@T.VisitDialog.ScheduledTime"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense"
                                                   Class="w-100"
                                                   For="@(() => _model.ScheduledTime)" />
                                </FormField>
                                </MudItem>
                            }
                        </MudGrid>
                    </section>
                    <section class="visit-form-section" aria-label="@T["forms.careTeam"]">
                        <MudGrid Spacing="3">
                            <MudItem xs="12" Class="app-form-section-item">
                                <FormSectionHeading Title="@T["forms.careTeam"]" Icon="@Icons.Material.Outlined.Groups" First="true" Description="@T["visitDialog.careTeamHint"]" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <FormField Label="@T.VisitDialog.Radiologist" Context="fieldId">
                                    <MudSelect Disabled="IsBusy" T="string"
                                               @bind-Value="_model.RadiologistId"
                                               InputId="@fieldId" aria-label="@T.VisitDialog.Radiologist"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Clearable="true">
                                        @foreach (var staff in _radiologists)
                                        {
                                            <MudSelectItem T="string" Value="@staff.Id">@staff.FullName</MudSelectItem>
                                        }
                                    </MudSelect>
                                </FormField>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <FormField Label="@T.VisitDialog.Technician" Context="fieldId">
                                    <MudSelect Disabled="IsBusy" T="string"
                                               @bind-Value="_model.TechnicianId"
                                               InputId="@fieldId" aria-label="@T.VisitDialog.Technician"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Clearable="true">
                                        @foreach (var staff in _technicians)
                                        {
                                            <MudSelectItem T="string" Value="@staff.Id">@staff.FullName</MudSelectItem>
                                        }
                                    </MudSelect>
                                </FormField>
                            </MudItem>
                            <MudItem xs="12">
                                <FormField Label="@T.VisitDialog.ReferralDoctorId" Context="fieldId">
                                    <MudAutocomplete Disabled="IsBusy" T="ReferralDoctorDto"
                                                     @bind-Value="_selectedReferralDoctor"
                                                     InputId="@fieldId" aria-label="@T.VisitDialog.ReferralDoctorId"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     MinCharacters="1"
                                                     DebounceInterval="300"
                                                     SearchFunc="SearchReferralDoctorsAsync"
                                                     ToStringFunc="@(d => d is null ? string.Empty : d.FullName)"
                                                     Clearable="true" />
                                </FormField>
                            </MudItem>
                        </MudGrid>
                    </section>
                    <section class="visit-form-section" aria-label="@T.VisitDialog.Billing">
                        <MudGrid Spacing="3">
                            <MudItem xs="12">
                                <FormSectionHeading Title="@T.VisitDialog.Billing" Icon="@Icons.Material.Outlined.Payments" First="true" />
                            </MudItem>
                            <MudItem xs="12">
                                <div class="visit-price-summary">
                                    <span>@T.VisitDialog.Price</span>
                                    <output aria-label="@T.VisitDialog.Price">@(_model.ExaminationType is { } type ? type.Price.ToString("N2") : "—")</output>
                                </div>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <FormField Label="@T.VisitDialog.Discount" Context="fieldId">
                                    <MudNumericField Disabled="IsBusy" T="decimal"
                                                     @bind-Value="_model.Discount"
                                                     InputId="@fieldId" aria-label="@T.VisitDialog.Discount"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Min="0" />
                                </FormField>
                                <div class="visit-discount-mode"><MudSwitch Disabled="IsBusy" T="bool" @bind-Value="_model.IsDiscountPercentage" Color="Color.Primary">@T.VisitDialog.DiscountIsPercentage</MudSwitch></div>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <FormField Label="@T.VisitDialog.AmountPaid" Context="fieldId">
                                    <MudNumericField Disabled="IsBusy" T="decimal"
                                                     @bind-Value="_model.Paid"
                                                     InputId="@fieldId" aria-label="@T.VisitDialog.AmountPaid"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Min="0" />
                                </FormField>
                            </MudItem>
                            <MudItem xs="12">
                                <FormField Label="@T.VisitDialog.Notes" Context="fieldId">
                                    <MudTextField Disabled="IsBusy" @bind-Value="_model.Notes"
                                                  InputId="@fieldId" aria-label="@T.VisitDialog.Notes"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Lines="3"
                                                  Immediate="true" />
                                </FormField>
                            </MudItem>
                        </MudGrid>
                    </section>
                </div>
            </EditForm>
        }
    </DialogContent>
    <DialogActions>
        @if (_quickRegistrationOpen)
        {
            <MudButton ButtonType="ButtonType.Button" OnClick="CloseQuickRegistration" Disabled="IsBusy">@T["visitDialog.backToVisit"]</MudButton>
            <MudButton ButtonType="ButtonType.Button" Color="Color.Primary" Variant="Variant.Filled" OnClick="RegisterPatientAsync"
                       Disabled="@(IsBusy || _genderOptions.Count == 0)">
                @if (_patientSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
                }
                @T["visitDialog.registerAndUse"]
            </MudButton>
        }
        else
        {
            <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="IsBusy">@T.Common.Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="@(IsBusy || _quickRegistrationOpen)">
                @if (_busy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
                }
                <text>@(IsEdit ? T.VisitDialog.SaveChanges : T.VisitDialog.CreateVisit)</text>
            </MudButton>
        }
    </DialogActions>
</FormDialog>


