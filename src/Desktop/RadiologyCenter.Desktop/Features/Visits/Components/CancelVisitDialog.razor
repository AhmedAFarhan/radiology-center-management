@inject ExaminationService ExaminationService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<FormDialog Title="@(T.FormatValue(T.Visits.CancelVisitTitle, Visit.ExaminationTypeName))" Icon="@Icons.Material.Filled.Cancel" Subtitle="@T["forms.visitSubtitle"]">
    <DialogContent>
        <FormField Label="@T.Visits.CancellationReasonOptional" Context="fieldId">
            <MudTextField Disabled="_busy" @bind-Value="_reason"
                          InputId="@fieldId" aria-label="@T.Visits.CancellationReasonOptional"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          FullWidth="true" />
        </FormField>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            <text>@T.Visits.CancelVisit</text>
        </MudButton>
    </DialogActions>
</FormDialog>


