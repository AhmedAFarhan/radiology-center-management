@page "/visits"
@attribute [Authorize]
@inject ExaminationService ExaminationService
@inject PatientService PatientService
@inject InsuranceService InsuranceService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AppLocalizer T
@implements IDisposable

<PageHeader Icon="@Icons.Material.Filled.EventNote" Title="@T.Visits.Title"
            Subtitle="@T.Visits.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.Visits.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Visits.NewVisit</MudButton>
</PageHeader>

<MudTable Breakpoint="Breakpoint.Sm" T="ExaminationDto" @ref="_table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="ExaminationDto" SortLabel="@("PatientId")">@T.Visits.Patient</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ExaminationDto" SortLabel="@("ExaminationTypeName")">@T.Visits.Examination</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ExaminationDto" SortLabel="@("Priority")">@T.Visits.Priority</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ExaminationDto" SortLabel="@("Status")">@T.Common.Status</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="ExaminationDto" SortLabel="@("ScheduledAt")">@T.Visits.Scheduled</MudTableSortLabel></MudTh>
        <MudTh Class="text-right"><MudTableSortLabel T="ExaminationDto" SortLabel="@("Remaining")">@T.Visits.Balance</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Visits.Patient">
            <MudText Class="font-weight-medium">@ResolvePatientName(context.PatientId)</MudText>
        </MudTd>
        <MudTd DataLabel="@T.Visits.Examination">@context.ExaminationTypeName</MudTd>
        <MudTd DataLabel="@T.Visits.Priority">
            <StatusChip Token="@context.PriorityKey">@context.Priority</StatusChip>
        </MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <StatusChip Token="@context.StatusKey">@context.Status</StatusChip>
        </MudTd>
        <MudTd DataLabel="@T.Visits.Scheduled">@FormatScheduled(context.ScheduledAt)</MudTd>
        <MudTd DataLabel="@T.Visits.Balance" Class="text-right">
            @if (context.Remaining > 0)
            {
                <MudText Color="Color.Error">@context.Remaining.ToString("C")</MudText>
            }
            else
            {
                <MudText Color="Color.Success">@T.Visits.Paid</MudText>
            }
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <MudTooltip Placement="Placement.Bottom" Text="@T.Visits.View">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Default" aria-label="@T.Visits.View" OnClick="@(() => OpenViewDialogAsync(context))" />
            </MudTooltip>
            @if (HasInsurance(context))
            {
                <MudTooltip Placement="Placement.Bottom" Text="@T.Visits.Insurance">
                    <MudIconButton Icon="@Icons.Material.Filled.Approval" Size="Size.Small" Color="Color.Info" aria-label="@T.Visits.Insurance" OnClick="@(() => OpenInsuranceAsync(context))" />
                </MudTooltip>
            }
            @if (context.StatusKey is "Requested" or "Scheduled" or "CheckedIn")
            {
                <MudTooltip Placement="Placement.Bottom" Text="@T.Visits.EditVisit">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" aria-label="@T.Visits.EditVisit" OnClick="@(() => OpenEditDialogAsync(context))" />
                </MudTooltip>
            }
            @if (context.StatusKey == "Requested")
            {
                <MudTooltip Placement="Placement.Bottom" Text="@T.Visits.Schedule">
                    <MudIconButton Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Info" aria-label="@T.Visits.Schedule" OnClick="@(() => OpenScheduleDialogAsync(context))" />
                </MudTooltip>
            }
            @if (context.StatusKey == "Scheduled")
            {
                <MudTooltip Placement="Placement.Bottom" Text="@T.Visits.CheckIn">
                    <MudIconButton Icon="@Icons.Material.Filled.Login" Size="Size.Small" Color="Color.Primary" aria-label="@T.Visits.CheckIn" OnClick="@(() => CheckInAsync(context))" />
                </MudTooltip>
            }
            @if (context.StatusKey == "CheckedIn")
            {
                <MudTooltip Placement="Placement.Bottom" Text="@T.Visits.Start">
                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Secondary" aria-label="@T.Visits.Start" OnClick="@(() => StartAsync(context))" />
                </MudTooltip>
            }
            @if (context.StatusKey == "InProgress")
            {
                <MudTooltip Placement="Placement.Bottom" Text="@T.Visits.Complete">
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" aria-label="@T.Visits.Complete" OnClick="@(() => CompleteAsync(context))" />
                </MudTooltip>
            }
            @if (context.StatusKey is not "Completed" and not "Cancelled")
            {
                <MudTooltip Placement="Placement.Bottom" Text="@T.Common.Cancel">
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Cancel" OnClick="@(() => CancelAsync(context))" />
                </MudTooltip>
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @if (_loadError is not null)
        {
            <ErrorState Icon="@(_offline ? Icons.Material.Filled.CloudOff : Icons.Material.Filled.ErrorOutline)"
                        Title="@T.Visits.LoadErrorTitle"
                        Message="@_loadError"
                        Action="ReloadAsync" />
        }
        else
        {
        <EmptyState Icon="@Icons.Material.Filled.MedicalServices"
                    Title="@T.Visits.EmptyTitle"
                    Message="@T.Visits.EmptyMessage"
                    ActionLabel="@T.Visits.EmptyAction"
                    Action="OpenCreateDialogAsync" />
        }
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>


