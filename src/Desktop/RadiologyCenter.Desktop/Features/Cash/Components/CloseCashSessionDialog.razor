@inherits EditorDialogBase
@inject CashService CashService

<FormDialog Title="@T.CloseCash.Title" Icon="@Icons.Material.Filled.Lock" Subtitle="@T["forms.cashSubtitle"]">
    <DialogContent>
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <MudGrid Spacing="3">
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.cashCount"]" Icon="@Icons.Material.Outlined.AccountBalanceWallet" First="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="text-secondary mb-1">
                        @(T.FormatValue(T.CloseCash.ExpectedTotalHint, _expectedTotal.ToString("C")))
                    </MudText>
                    <FormField Label="@T.CloseCash.CountedTotal" Context="fieldId">
                        <LocalizedNumericField Disabled="Busy" @bind-Value="_model.CountedTotal"
                                         InputId="@fieldId" aria-label="@T.CloseCash.CountedTotal"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Immediate="true"
                                         For="@(() => _model.CountedTotal)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12">
                    <FormSectionHeading Title="@T["forms.handover"]" Description="@T.CloseCash.HandoverHint" Icon="@Icons.Material.Outlined.SwapHoriz" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.CloseCash.ReceivingUserId" Context="fieldId">
                        <LocalizedTextField Disabled="Busy" @bind-Value="_model.ReceivingUserId"
                                      InputId="@fieldId" aria-label="@T.CloseCash.ReceivingUserId"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      For="@(() => _model.ReceivingUserId)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.CloseCash.ReceivingOpeningFloat" Context="fieldId">
                        <LocalizedNumericField Disabled="Busy" @bind-Value="_model.ReceivingOpeningFloat"
                                         InputId="@fieldId" aria-label="@T.CloseCash.ReceivingOpeningFloat"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Immediate="true"
                                         For="@(() => _model.ReceivingOpeningFloat)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.CloseCash.Notes" Context="fieldId">
                        <LocalizedTextField Disabled="Busy" @bind-Value="_model.Notes"
                                      InputId="@fieldId" aria-label="@T.CloseCash.Notes"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      For="@(() => _model.Notes)" />
                    </FormField>
                </MudItem>
            </MudGrid>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@T.CloseCash.Submit"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</FormDialog>

