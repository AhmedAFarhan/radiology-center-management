@inherits EditorDialogBase
@inject CashService CashService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.AccountBalanceWallet" Title="@T.OpenCash.Title" />
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="text-secondary mb-1">@T.OpenCash.OpeningFloatHint</MudText>
                    <MudNumericField @bind-Value="_model.OpeningFloat"
                                     Label="@T.OpenCash.OpeningFloat"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Immediate="true"
                                     For="@(() => _model.OpeningFloat)" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Notes"
                                  Label="@T.OpenCash.Notes"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Notes)" />
                </MudItem>
            </MudGrid>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@T.OpenCash.Submit"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>

