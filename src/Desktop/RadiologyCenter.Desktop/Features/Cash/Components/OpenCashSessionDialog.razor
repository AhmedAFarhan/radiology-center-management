@inherits EditorDialogBase
@inject CashService CashService

<FormDialog Title="@T.OpenCash.Title" Icon="@Icons.Material.Filled.AccountBalanceWallet" Subtitle="@T["forms.cashSubtitle"]">
    <DialogContent>
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="text-secondary mb-1">@T.OpenCash.OpeningFloatHint</MudText>
                    <FormField Label="@T.OpenCash.OpeningFloat" Context="fieldId">
                        <LocalizedNumericField Disabled="Busy" @bind-Value="_model.OpeningFloat"
                                         InputId="@fieldId" aria-label="@T.OpenCash.OpeningFloat"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Immediate="true"
                                         For="@(() => _model.OpeningFloat)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.OpenCash.Notes" Context="fieldId">
                        <LocalizedTextField Disabled="Busy" @bind-Value="_model.Notes"
                                      InputId="@fieldId" aria-label="@T.OpenCash.Notes"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      For="@(() => _model.Notes)" />
                    </FormField>
                </MudItem>
            </MudGrid>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@T.OpenCash.Submit"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</FormDialog>

