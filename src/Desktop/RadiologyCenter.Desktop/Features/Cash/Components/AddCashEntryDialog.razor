@inherits EditorDialogBase
@inject CashService CashService
@inject EnumOptionsService EnumOptionsService

<FormDialog Title="@T.CashEntry.Title" Icon="@Icons.Material.Filled.SwapVert" Subtitle="@T["forms.cashSubtitle"]">
    <DialogContent>
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <MudGrid Spacing="3">
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.transaction"]" Icon="@Icons.Material.Outlined.Payments" First="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.CashEntry.Direction" Context="fieldId">
                        <LocalizedSelect Disabled="Busy" @bind-Value="_model.Direction"
                                   InputId="@fieldId" aria-label="@T.CashEntry.Direction"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   For="@(() => _model.Direction)">
                            @foreach (var direction in _directionOptions)
                            {
                                <MudSelectItem T="string" Value="@direction.Key">@direction.Value</MudSelectItem>
                            }
                        </LocalizedSelect>
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.CashEntry.Reason" Context="fieldId">
                        <LocalizedSelect Disabled="Busy" @bind-Value="_model.Reason"
                                   InputId="@fieldId" aria-label="@T.CashEntry.Reason"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   For="@(() => _model.Reason)">
                            @foreach (var reason in _reasonOptions)
                            {
                                <MudSelectItem T="string" Value="@reason.Key">@reason.Value</MudSelectItem>
                            }
                        </LocalizedSelect>
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.CashEntry.Amount" Context="fieldId">
                        <LocalizedNumericField Disabled="Busy" @bind-Value="_model.Amount"
                                         InputId="@fieldId" aria-label="@T.CashEntry.Amount"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Immediate="true"
                                         For="@(() => _model.Amount)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.reference"]" Icon="@Icons.Material.Outlined.Subject" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.CashEntry.Reference" Context="fieldId">
                        <LocalizedTextField Disabled="Busy" @bind-Value="_model.ReferenceId"
                                      InputId="@fieldId" aria-label="@T.CashEntry.Reference"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      For="@(() => _model.ReferenceId)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.CashEntry.Description" Context="fieldId">
                        <LocalizedTextField Disabled="Busy" @bind-Value="_model.Description"
                                      InputId="@fieldId" aria-label="@T.CashEntry.Description"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      For="@(() => _model.Description)" />
                    </FormField>
                </MudItem>
            </MudGrid>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@T.CashEntry.Submit"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</FormDialog>

