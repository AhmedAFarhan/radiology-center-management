@using static RadiologyCenter.Desktop.Services.Formatting
@using RadiologyCenter.Desktop.Services
@page "/cash/sessions"
@attribute [Authorize]
@inherits ListPageBase<CashSessionDto>
@inject CashService CashService
@inject EnumOptionsService EnumOptionsService
@inject UserTimezoneService TimezoneService

<PageHeader Icon="@Icons.Material.Filled.AccountBalanceWallet" Title="@T.Cash.Title"
            Subtitle="@T.Cash.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.Cash.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <MudSelect T="string" Value="_status" ValueChanged="OnStatusChangedAsync" Label="@T.Common.Status"
               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="status-filter ms-2">
        <MudSelectItem Value="@(string.Empty)">@T.Common.All</MudSelectItem>
        @foreach (var status in _statusOptions)
        {
            <MudSelectItem Value="@status.Key">@status.Value</MudSelectItem>
        }
    </MudSelect>
    <AuthorizeView Policy="@CashPermissions.SessionsOpen">
        <Authorized>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenSessionAsync">@T.Cash.OpenSession</MudButton>
        </Authorized>
    </AuthorizeView>
</PageHeader>

<MudTable Breakpoint="Breakpoint.Sm" T="CashSessionDto" @ref="Table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="CashSessionDto" SortLabel="@("OpenedAt")">@T.Cash.OpenedAt</MudTableSortLabel></MudTh>
        <MudTh>@T.Cash.User</MudTh>
        <MudTh><MudTableSortLabel T="CashSessionDto" SortLabel="@("Status")">@T.Common.Status</MudTableSortLabel></MudTh>
        <MudTh Class="text-right"><MudTableSortLabel T="CashSessionDto" SortLabel="@("OpeningFloat")">@T.Cash.OpeningFloat</MudTableSortLabel></MudTh>
        <MudTh Class="text-right">@T.Cash.Balance</MudTh>
        <MudTh Class="text-center">@T.Cash.Entries</MudTh>
        <MudTh><MudTableSortLabel T="CashSessionDto" SortLabel="@("OpenedAt")">@T.Cash.ClosedAt</MudTableSortLabel></MudTh>
        <MudTh Class="text-center">@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Cash.OpenedAt">@TimezoneHelper.Format(context.OpenedAt, TimezoneService.GetTimeZoneId())</MudTd>
        <MudTd DataLabel="@T.Cash.User">@(string.IsNullOrWhiteSpace(context.UserName) ? "-" : context.UserName)</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <StatusChip Token="@context.StatusKey">@context.Status</StatusChip>
        </MudTd>
        <MudTd DataLabel="@T.Cash.OpeningFloat" Class="text-right">@context.OpeningFloat.ToString("C")</MudTd>
        <MudTd DataLabel="@T.Cash.Balance" Class="text-right">
            <MudText Class="font-weight-medium" Color="@(context.Balance < 0 ? Color.Error : Color.Default)">@context.Balance.ToString("C")</MudText>
        </MudTd>
        <MudTd DataLabel="@T.Cash.Entries" Class="text-center">@context.EntryCount</MudTd>
        <MudTd DataLabel="@T.Cash.ClosedAt">@TimezoneHelper.FormatOptional(context.ClosedAt, TimezoneService.GetTimeZoneId())</MudTd>
        <MudTd DataLabel="@T.Common.Actions" Class="text-center">
            <MudTooltip Placement="Placement.Bottom" Text="@T.Cash.View">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Default" aria-label="@T.Cash.View" OnClick="@(() => OpenDetailAsync(context))" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <TableNoRecords LoadError="@LoadError"
                        Offline="@Offline"
                        ErrorTitle="@T.Cash.LoadErrorTitle"
                        EmptyIcon="@Icons.Material.Filled.AccountBalanceWallet"
                        EmptyTitle="@T.Cash.EmptyTitle"
                        EmptyMessage="@T.Cash.EmptyMessage"
                        EmptyActionLabel="@T.Cash.EmptyActionLabel"
                        ActionPolicy="@CashPermissions.SessionsOpen"
                        OnReload="ReloadAsync"
                        OnEmptyAction="OpenSessionAsync" />
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>

