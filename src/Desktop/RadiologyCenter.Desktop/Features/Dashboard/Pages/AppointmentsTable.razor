@inject AppLocalizer T
@using RadiologyCenter.Desktop.Services

<MudCard Elevation="0" Class="dashboard-card h-100">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.subtitle1" Class="font-weight-medium">@T.Dashboard.RecentExaminations</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudTable T="ExaminationDto" Items="Items" Dense="true" Hover="true" Striped="true" Elevation="0">
            <HeaderContent>
                <MudTh>@T.Dashboard.ExamType</MudTh>
                <MudTh>@T.Dashboard.ExamStatus</MudTh>
                <MudTh>@T.Dashboard.ExamPriority</MudTh>
                <MudTh>@T.Dashboard.ReferringDoctor</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@T.Dashboard.ExamType">@context.ExaminationTypeName</MudTd>
                <MudTd DataLabel="@T.Dashboard.ExamStatus">
                    <StatusChip Token="@context.StatusKey">@context.Status</StatusChip>
                </MudTd>
                <MudTd DataLabel="@T.Dashboard.ExamPriority">@context.Priority</MudTd>
                <MudTd DataLabel="@T.Dashboard.ReferringDoctor">@(string.IsNullOrWhiteSpace(context.ReferralDoctorId) ? "-" : "-")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Icon="@Icons.Material.Filled.EventNote" Title="@T.Dashboard.NoRecentExams" Message="@T.Dashboard.ExamsWillAppear" />
            </NoRecordsContent>
        </MudTable>
    </MudCardContent>
</MudCard>

