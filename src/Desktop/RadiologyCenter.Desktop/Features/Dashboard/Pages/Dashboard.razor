@page "/dashboard"
@attribute [Authorize]
@inject DashboardService DashboardService
@inject InsuranceService InsuranceService
@inject AppLocalizer T

<PageHeader Icon="@Icons.Material.Filled.Dashboard" Title="@T.Dashboard.Title" Subtitle="@T.Dashboard.Subtitle" ShowSearch="false" OnRefresh="RefreshAsync" />

@if (_loading)
{
    <DashboardSkeleton />
}
else if (_error)
{
<ErrorState Title="@T.Dashboard.LoadErrorTitle" Message="@T.Dashboard.LoadErrorMsg" Detail="@_errorDetail" Action="LoadAsync" />
}
else
{
    <MudGrid Spacing="3">
        @if (_data!.TotalPatients.HasValue)
        {
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Label="@T.Dashboard.TotalPatients" Value="@_data!.TotalPatients.ToString()" Icon="@Icons.Material.Filled.People" Color="Color.Primary" />
        </MudItem>
        }
        @if (_data!.TotalExaminations.HasValue)
        {
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Label="@T.Dashboard.TotalExaminations" Value="@_data!.TotalExaminations.ToString()" Icon="@Icons.Material.Filled.MedicalServices" Color="Color.Secondary" />
        </MudItem>
        }
        @if (_data!.ExamsInProgress.HasValue)
        {
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Label="@T.Dashboard.ExamsInProgress" Value="@_data!.ExamsInProgress.ToString()" Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Warning" />
        </MudItem>
        }
        @if (_data!.TotalInventoryItems.HasValue)
        {
        <MudItem xs="12" sm="6" lg="3">
            <StatCard Label="@T.Dashboard.InventoryItems" Value="@_data!.TotalInventoryItems.ToString()" Icon="@Icons.Material.Filled.Inventory2" Color="Color.Info" />
        </MudItem>
        }
        @if (_insuranceStats is not null)
        {
            <MudDivider Class="my-3" />
            <MudItem xs="12">
                <MudText Typo="Typo.h6" Class="mb-1">@T.Dashboard.Insurance</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <StatCard Label="@T.Dashboard.OutstandingClaims" Value="@_insuranceStats.OutstandingAmount.ToString("C")" Icon="@Icons.Material.Filled.RequestQuote" Color="Color.Primary" TrendText="@(T.FormatValue(T.Dashboard.Submitted, _insuranceStats.SubmittedClaims))" TrendUp="true" />
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <StatCard Label="@T.Dashboard.PendingAuthorizations" Value="@_insuranceStats.PendingPreAuthorizations.ToString()" Icon="@Icons.Material.Filled.Approval" Color="Color.Warning" TrendText="@(T.FormatValue(T.Dashboard.Approved, _insuranceStats.ApprovedPreAuthorizations))" TrendUp="true" />
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <StatCard Label="@T.Dashboard.ActivePolicies" Value="@_insuranceStats.ActivePolicies.ToString()" Icon="@Icons.Material.Filled.Description" Color="Color.Info" TrendText="@(T.FormatValue(T.Dashboard.Total, _insuranceStats.TotalPolicies))" TrendUp="true" />
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <StatCard Label="@T.Dashboard.InsuranceCompanies" Value="@_insuranceStats.TotalCompanies.ToString()" Icon="@Icons.Material.Filled.Shield" Color="Color.Secondary" TrendText="@(T.FormatValue(T.Dashboard.DraftClaims, _insuranceStats.DraftClaims))" TrendUp="true" />
            </MudItem>
        }
    </MudGrid>

    <MudPaper Class="pa-4 mt-4" Elevation="0">
        <MudText Typo="Typo.h6" Class="mb-3">@(T.IsRTL ? "الوصول السريع" : "Quick access")</MudText>
        <div class="dashboard-quick-actions">
            <AuthorizeView Policy="@ExaminationsPermissions.Read"><MudButton Href="/examinations/calendar" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CalendarMonth">@T.ExamCalendar.Title</MudButton></AuthorizeView>
            <AuthorizeView Policy="@PatientsPermissions.Read"><MudButton Href="/patients" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.People">@T.Patients.Title</MudButton></AuthorizeView>
            <AuthorizeView Policy="@ExaminationsPermissions.Read"><MudButton Href="/visits" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.EventNote">@T.Visits.Title</MudButton></AuthorizeView>
            <AuthorizeView Policy="@AnalyticsPermissions.Read"><MudButton Href="/analytics/financial" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Insights">@T.Financial.Title</MudButton></AuthorizeView>
        </div>
        <MudText Typo="Typo.body2" Class="mt-3 text-secondary">@(T.IsRTL ? "اختر صفحة من القائمة الجانبية للوصول إلى بقية مهامك." : "Use the sidebar to access your other tasks.")</MudText>
    </MudPaper>
    @if (_data!.TotalExaminations.HasValue)
    {
        <div class="mt-4"><AppointmentsTable Items="@_data.RecentExaminations" /></div>
    }
}
