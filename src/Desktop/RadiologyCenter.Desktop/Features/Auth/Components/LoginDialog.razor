@using System.ComponentModel.DataAnnotations
@inject AuthService AuthService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AppLocalizer T
@inject ReturnUrlService ReturnUrl

<MudDialog Class="login-dialog">
    <DialogContent>
        <div class="text-center mb-4">
            <MudAvatar Class="mb-3" Color="Color.Primary" Variant="Variant.Filled">
                <MudIcon Icon="@Icons.Material.Filled.MedicalServices" />
            </MudAvatar>
            <MudText Typo="Typo.h5" Class="mb-1">@T.Login.Title</MudText>
            <MudText Typo="Typo.body2" Class="text-secondary">@T.Login.Subtitle</MudText>
        </div>

        <EditForm Model="@_model" OnValidSubmit="@SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.UserName"
                                  Label="@T.Login.Username"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Autocomplete="username" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Password"
                                  Label="@T.Login.Password"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  Immediate="true"
                                  Autocomplete="current-password"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  AdornmentColor="Color.Default"
                                  OnAdornmentClick="@(() => _showPassword = !_showPassword)" />
                </MudItem>
            </MudGrid>
            <MudButton ButtonType="ButtonType.Submit"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Size="Size.Large"
                       Class="mt-4"
                       StartIcon="@Icons.Material.Filled.Login"
                       Disabled="@_busy">
                @if (_busy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
                }
                else
                {
                    <text>@T.Login.Submit</text>
                }
            </MudButton>
        </EditForm>
    </DialogContent>
</MudDialog>

