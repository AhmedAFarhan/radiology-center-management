@using System.ComponentModel.DataAnnotations
@inject AuthService AuthService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AppLocalizer T
@inject ReturnUrlService ReturnUrl
@inject RadiologyCenter.Desktop.Services.Updates.IAppUpdates Updates
@inject RadiologyCenter.Desktop.Services.Updates.UpdateDialogLauncher UpdateDialogs
@implements IDisposable
@using RadiologyCenter.Desktop.Shared.Components

<FormDialog Class="login-dialog" Title="@T.Login.Title" Subtitle="@T.Login.Subtitle" Icon="@Icons.Material.Outlined.MedicalServices">
    <DialogContent>
        <EditForm id="clinic-login-form" Model="@_model" OnValidSubmit="@SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <FormField Label="@T.Login.Username" Context="fieldId" Required="true">
                        <LocalizedTextField T="string" Disabled="_busy" @bind-Value="_model.UserName" For="@(() => _model.UserName)"
                                      InputId="@fieldId" aria-required="true" aria-label="@T.Login.Username"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      autocomplete="username" />
                    </FormField>
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.Login.Password" Context="fieldId" Required="true">
                        <LocalizedTextField T="string" AdornmentAriaLabel="@(T.IsRTL ? "إظهار أو إخفاء كلمة المرور" : "Show or hide password")" Disabled="_busy" @bind-Value="_model.Password" For="@(() => _model.Password)"
                                      InputId="@fieldId" aria-required="true" aria-label="@T.Login.Password"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                      Immediate="true"
                                      autocomplete="current-password"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      AdornmentColor="Color.Default"
                                      OnAdornmentClick="@(() => _showPassword = !_showPassword)" />
                    </FormField>
                </MudItem>
            </MudGrid>

        </EditForm>
        <MudButton OnClick="OpenClinicSettings" Class="mt-2" FullWidth="true" Disabled="_busy">@(T.IsRTL ? "اتصال العيادة / تحديث المسؤول" : "Clinic connection / admin upgrade")</MudButton>
        <MudButton OnClick="OpenClinicUpdates" FullWidth="true" Disabled="_busy" StartIcon="@Icons.Material.Filled.SystemUpdate">@(_updateAvailable ? (T.IsRTL ? "تحديث متاح للعيادة" : "Clinic update available") : (T.IsRTL ? "تحديثات العيادة" : "Clinic updates"))</MudButton>
        <div class="mt-2 text-center"><ReleaseVersion /></div>
    </DialogContent>
    <DialogActions>
            <MudButton ButtonType="ButtonType.Submit" form="clinic-login-form"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.Login"
                       Disabled="@_busy">
                @if (_busy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
                }
                <text>@T.Login.Submit</text>
            </MudButton>
    </DialogActions>
</FormDialog>

