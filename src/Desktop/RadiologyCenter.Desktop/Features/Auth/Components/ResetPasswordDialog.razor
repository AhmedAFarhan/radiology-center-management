@inherits EditorDialogBase
@inject IdentityService IdentityService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Key" Title="@(T.FormatValue(T.UserDialog.ResetPasswordTitle, User.UserName))" />
        <MudText Typo="Typo.body2" Class="text-secondary mb-3">
            @(T.FormatValue(T.UserDialog.ResetPasswordDescription, User.UserName))
        </MudText>
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudTextField @bind-Value="_model.NewPassword"
                          For="@(() => _model.NewPassword)"
                          Label="@T.UserDialog.NewPassword"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          InputType="@(_showNew ? InputType.Text : InputType.Password)"
                          AutoComplete="new-password"
                          HelperText="@T.UserDialog.PasswordHelper"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showNew ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          AdornmentColor="Color.Default"
                          OnAdornmentClick="@(() => _showNew = !_showNew)" />
            <MudTextField @bind-Value="_model.ConfirmPassword"
                          For="@(() => _model.ConfirmPassword)"
                          Label="@T.UserDialog.ConfirmPassword"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                          AutoComplete="new-password"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          AdornmentColor="Color.Default"
                          OnAdornmentClick="@(() => _showConfirm = !_showConfirm)" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@T.UserDialog.ResetPasswordButton"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>

