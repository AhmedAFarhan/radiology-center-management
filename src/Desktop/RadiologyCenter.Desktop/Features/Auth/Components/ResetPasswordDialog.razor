@inherits EditorDialogBase
@inject IdentityService IdentityService

<FormDialog Title="@(T.FormatValue(T.UserDialog.ResetPasswordTitle, User.UserName))" Icon="@Icons.Material.Filled.Key" Subtitle="@T["forms.accountSubtitle"]">
    <DialogContent>
        <MudText Typo="Typo.body2" Class="text-secondary mb-3">
            @(T.FormatValue(T.UserDialog.ResetPasswordDescription, User.UserName))
        </MudText>
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <FormField Label="@T.UserDialog.NewPassword" Context="fieldId">
                <LocalizedTextField AdornmentAriaLabel="@(T.IsRTL ? "إظهار أو إخفاء كلمة المرور" : "Show or hide password")" Disabled="Busy" @bind-Value="_model.NewPassword"
                              For="@(() => _model.NewPassword)"
                              InputId="@fieldId" aria-label="@T.UserDialog.NewPassword"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@(_showNew ? InputType.Text : InputType.Password)"
                              autocomplete="new-password"
                              HelperText="@T.UserDialog.PasswordHelper"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showNew ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              AdornmentColor="Color.Default"
                              OnAdornmentClick="@(() => _showNew = !_showNew)" />
            </FormField>
            <FormField Label="@T.UserDialog.ConfirmPassword" Context="fieldId">
                <LocalizedTextField AdornmentAriaLabel="@(T.IsRTL ? "إظهار أو إخفاء كلمة المرور" : "Show or hide password")" Disabled="Busy" @bind-Value="_model.ConfirmPassword"
                              For="@(() => _model.ConfirmPassword)"
                              InputId="@fieldId" aria-label="@T.UserDialog.ConfirmPassword"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                              autocomplete="new-password"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              AdornmentColor="Color.Default"
                              OnAdornmentClick="@(() => _showConfirm = !_showConfirm)" />
            </FormField>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@T.UserDialog.ResetPasswordButton"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</FormDialog>

