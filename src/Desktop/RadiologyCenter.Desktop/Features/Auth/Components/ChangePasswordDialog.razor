@inherits EditorDialogBase
@inject AuthService AuthService

<FormDialog Title="@(Forced ? T.ChangePassword.RequiredTitle : T.ChangePassword.Title)" Icon="@Icons.Material.Filled.Shield" Subtitle="@T["forms.accountSubtitle"]" Class="change-password-dialog">
    <DialogContent>
        @if (Forced)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3" Variant="Variant.Outlined">
                @T.ChangePassword.AdminWarning
            </MudAlert>
        }
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <MudGrid Spacing="3">
                <MudItem xs="12">
                    <FormField Label="@T.ChangePassword.Current" Context="fieldId" Required="true">
                        <LocalizedTextField AdornmentAriaLabel="@(T.IsRTL ? "إظهار أو إخفاء كلمة المرور" : "Show or hide password")" Disabled="Busy" @bind-Value="_model.CurrentPassword"
                                      For="@(() => _model.CurrentPassword)"
                                      InputId="@fieldId" aria-required="true" aria-label="@T.ChangePassword.Current"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="@(_showCurrent ? InputType.Text : InputType.Password)"
                                      autocomplete="current-password"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showCurrent ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      AdornmentColor="Color.Default"
                                      OnAdornmentClick="@(() => _showCurrent = !_showCurrent)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.ChangePassword.New" Context="fieldId">
                        <LocalizedTextField AdornmentAriaLabel="@(T.IsRTL ? "إظهار أو إخفاء كلمة المرور" : "Show or hide password")" Disabled="Busy" @bind-Value="_model.NewPassword"
                                      For="@(() => _model.NewPassword)"
                                      InputId="@fieldId" aria-label="@T.ChangePassword.New"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="@(_showNew ? InputType.Text : InputType.Password)"
                                      autocomplete="new-password"
                                      HelperText="@T.ChangePassword.Helper"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showNew ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      AdornmentColor="Color.Default"
                                      OnAdornmentClick="@(() => _showNew = !_showNew)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.ChangePassword.Confirm" Context="fieldId">
                        <LocalizedTextField AdornmentAriaLabel="@(T.IsRTL ? "إظهار أو إخفاء كلمة المرور" : "Show or hide password")" Disabled="Busy" @bind-Value="_model.ConfirmPassword"
                                      For="@(() => _model.ConfirmPassword)"
                                      InputId="@fieldId" aria-label="@T.ChangePassword.Confirm"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                                      autocomplete="new-password"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                      AdornmentColor="Color.Default"
                                      OnAdornmentClick="@(() => _showConfirm = !_showConfirm)" />
                    </FormField>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        @if (!Forced)
        {
            <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="Busy">@T.ChangePassword.Cancel</MudButton>
        }
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="Busy">
            @if (Busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            <text>@T.ChangePassword.Update</text>
        </MudButton>
    </DialogActions>
</FormDialog>

