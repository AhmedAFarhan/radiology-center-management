@inherits EditorDialogBase
@inject ResourceService ResourceService
@inject EnumOptionsService EnumOptionsService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Biotech" Title="@(Equipment is null ? T.Equipment.NewEquipment : T.FormatValue(T.Equipment.Edit, Equipment.Name))" />
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Name"
                                  Label="@T.Common.Name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.Name)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.Modality"
                               Label="@T.Equipment.Modality"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.Modality)">
                        @foreach (var option in _modalityOptions)
                        {
                            <MudSelectItem T="string" Value="@option.Key">@option.Value</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.SerialNumber"
                                  Label="@T.Equipment.SerialNumber"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_model.PurchaseDate"
                                   Label="@T.Equipment.PurchaseDate"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="w-100" />
                </MudItem>
            </MudGrid>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.EquipmentDialog.SaveChanges : T.EquipmentDialog.CreateEquipment)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>