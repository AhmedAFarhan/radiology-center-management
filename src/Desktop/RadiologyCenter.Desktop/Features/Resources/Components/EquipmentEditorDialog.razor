@inherits EditorDialogBase
@inject ResourceService ResourceService
@inject EnumOptionsService EnumOptionsService

<FormDialog Title="@(Equipment is null ? T.Equipment.NewEquipment : T.FormatValue(T.Equipment.Edit, Equipment.Name))" Icon="@Icons.Material.Filled.Biotech" Subtitle="@T["forms.resourceSubtitle"]">
    <DialogContent>
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <MudGrid Spacing="3">
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.equipment"]" Icon="@Icons.Material.Outlined.MedicalServices" First="true" />
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.Common.Name" Context="fieldId" Required="true">
                        <LocalizedTextField Disabled="Busy" @bind-Value="_model.Name"
                                      InputId="@fieldId" aria-required="true" aria-label="@T.Common.Name"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      For="@(() => _model.Name)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.Equipment.Modality" Context="fieldId" Required="true">
                        <LocalizedSelect Disabled="Busy" T="string"
                                   @bind-Value="_model.Modality"
                                   InputId="@fieldId" aria-required="true" aria-label="@T.Equipment.Modality"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   For="@(() => _model.Modality)">
                            @foreach (var option in _modalityOptions)
                            {
                                <MudSelectItem T="string" Value="@option.Key">@option.Value</MudSelectItem>
                            }
                        </LocalizedSelect>
                    </FormField>
                </MudItem>
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.asset"]" Icon="@Icons.Material.Outlined.Inventory2" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.Equipment.SerialNumber" Context="fieldId">
                        <MudTextField Disabled="Busy" @bind-Value="_model.SerialNumber"
                                      InputId="@fieldId" aria-label="@T.Equipment.SerialNumber"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.Equipment.PurchaseDate" Context="fieldId">
                        <MudDatePicker Disabled="Busy" @bind-Date="_model.PurchaseDate"
                                       InputId="@fieldId" aria-label="@T.Equipment.PurchaseDate"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Class="w-100" />
                    </FormField>
                </MudItem>
            </MudGrid>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.EquipmentDialog.SaveChanges : T.EquipmentDialog.CreateEquipment)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</FormDialog>