@inherits EditorDialogBase
@inject ResourceService ResourceService

<FormDialog Title="@(Shift is null ? T.WorkShift.NewWorkShift : T.WorkShift.EditWorkShift)" Icon="@Icons.Material.Filled.CalendarMonth" Subtitle="@T["forms.resourceSubtitle"]">
    <DialogContent>
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <MudGrid Spacing="3">
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.assignment"]" Icon="@Icons.Material.Outlined.Groups" First="true" />
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.WorkShiftDialog.StaffSearch" Context="fieldId" Required="true">
                        <MudAutocomplete T="StaffDto"
                                         @bind-Value="_selectedStaff"
                                         InputId="@fieldId" aria-required="true" aria-label="@T.WorkShiftDialog.StaffSearch"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="1"
                                         DebounceInterval="300"
                                         SearchFunc="SearchStaffAsync"
                                         ToStringFunc="@(s => s is null ? string.Empty : s.FullName)"
                                         Clearable="true"
                                         Disabled="Busy" />
                    </FormField>
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.WorkShiftDialog.EquipmentOptional" Context="fieldId">
                        <MudAutocomplete T="EquipmentDto"
                                         @bind-Value="_selectedEquipment"
                                         InputId="@fieldId" aria-label="@T.WorkShiftDialog.EquipmentOptional"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="1"
                                         DebounceInterval="300"
                                         SearchFunc="SearchEquipmentAsync"
                                         ToStringFunc="@(e => e is null ? string.Empty : e.Name)"
                                         Clearable="true"
                                         Disabled="Busy" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.appointment"]" Icon="@Icons.Material.Outlined.EventNote" />
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.WorkShiftDialog.ShiftDate" Context="fieldId" Required="true">
                        <LocalizedDatePicker Disabled="Busy" @bind-Date="_model.Date"
                                       InputId="@fieldId" aria-required="true" aria-label="@T.WorkShiftDialog.ShiftDate"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       For="@(() => _model.Date)"
                                       Class="w-100" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.WorkShiftDialog.StartTime" Context="fieldId" Required="true">
                        <LocalizedTimePicker Disabled="Busy" @bind-Time="_model.StartTime"
                                       InputId="@fieldId" aria-required="true" aria-label="@T.WorkShiftDialog.StartTime"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       For="@(() => _model.StartTime)"
                                       Class="w-100" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.WorkShiftDialog.EndTime" Context="fieldId" Required="true">
                        <LocalizedTimePicker Disabled="Busy" @bind-Time="_model.EndTime"
                                       InputId="@fieldId" aria-required="true" aria-label="@T.WorkShiftDialog.EndTime"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       For="@(() => _model.EndTime)"
                                       Class="w-100" />
                    </FormField>
                </MudItem>

                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.notes"]" Icon="@Icons.Material.Outlined.Notes" />
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.WorkShift.Notes" Context="fieldId">
                        <MudTextField Disabled="Busy" @bind-Value="_model.Notes"
                                      InputId="@fieldId" aria-label="@T.WorkShift.Notes"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="3"
                                      Immediate="true" />
                    </FormField>
                </MudItem>
            </MudGrid>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.WorkShiftDialog.SaveChanges : T.WorkShiftDialog.CreateWorkShift)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</FormDialog>
