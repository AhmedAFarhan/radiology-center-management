@inherits EditorDialogBase
@inject ResourceService ResourceService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.CalendarMonth" Title="@(Shift is null ? T.WorkShift.NewWorkShift : T.WorkShift.EditWorkShift)" />
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudAutocomplete T="StaffDto"
                                     @bind-Value="_selectedStaff"
                                     Label="@T.WorkShiftDialog.StaffSearch"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchStaffAsync"
                                     ToStringFunc="@(s => s is null ? string.Empty : s.FullName)"
                                     Clearable="true"
                                     Disabled="Busy" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_model.Date"
                                   Label="@T.WorkShiftDialog.ShiftDate"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   For="@(() => _model.Date)"
                                   Class="w-100" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTimePicker @bind-Time="_model.StartTime"
                                   Label="@T.WorkShiftDialog.StartTime"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   For="@(() => _model.StartTime)"
                                   Class="w-100" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudTimePicker @bind-Time="_model.EndTime"
                                   Label="@T.WorkShiftDialog.EndTime"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   For="@(() => _model.EndTime)"
                                   Class="w-100" />
                </MudItem>
                <MudItem xs="12">
                    <MudAutocomplete T="EquipmentDto"
                                     @bind-Value="_selectedEquipment"
                                     Label="@T.WorkShiftDialog.EquipmentOptional"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchEquipmentAsync"
                                     ToStringFunc="@(e => e is null ? string.Empty : e.Name)"
                                     Clearable="true"
                                     Disabled="Busy" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Notes"
                                  Label="@T.WorkShift.Notes"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="3"
                                  Immediate="true" />
                </MudItem>
            </MudGrid>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.WorkShiftDialog.SaveChanges : T.WorkShiftDialog.CreateWorkShift)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>