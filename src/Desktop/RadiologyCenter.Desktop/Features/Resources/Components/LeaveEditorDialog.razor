@inherits EditorDialogBase
@inject ResourceService ResourceService
@inject EnumOptionsService EnumOptionsService

<FormDialog Title="@(Leave is null ? T.Leave.NewLeave : T.Leave.EditLeave)" Icon="@Icons.Material.Filled.BeachAccess" Subtitle="@T["forms.resourceSubtitle"]">
    <DialogContent>
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <MudGrid Spacing="3">
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.leave"]" Icon="@Icons.Material.Outlined.EventNote" First="true" />
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.LeaveDialog.StaffSearch" Context="fieldId" Required="true">
                        <MudAutocomplete T="StaffDto"
                                         @bind-Value="_selectedStaff"
                                         InputId="@fieldId" aria-required="true" aria-label="@T.LeaveDialog.StaffSearch"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         MinCharacters="1"
                                         DebounceInterval="300"
                                         SearchFunc="SearchStaffAsync"
                                         ToStringFunc="@(s => s is null ? string.Empty : s.FullName)"
                                         Clearable="true"
                                         Disabled="Busy" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.LeaveDialog.LeaveType" Context="fieldId" Required="true">
                        <LocalizedSelect Disabled="Busy" T="string"
                                   @bind-Value="_model.LeaveType"
                                   InputId="@fieldId" aria-required="true" aria-label="@T.LeaveDialog.LeaveType"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   For="@(() => _model.LeaveType)">
                            @foreach (var type in _leaveTypeOptions)
                            {
                                <MudSelectItem T="string" Value="@type.Key">@type.Value</MudSelectItem>
                            }
                        </LocalizedSelect>
                    </FormField>
                </MudItem>
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.period"]" Icon="@Icons.Material.Outlined.DateRange" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.Leave.StartDate" Context="fieldId" Required="true">
                        <LocalizedDatePicker Disabled="Busy" @bind-Date="_model.StartDate"
                                       InputId="@fieldId" aria-required="true" aria-label="@T.Leave.StartDate"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       For="@(() => _model.StartDate)"
                                       Class="w-100" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.Leave.EndDate" Context="fieldId" Required="true">
                        <LocalizedDatePicker Disabled="Busy" @bind-Date="_model.EndDate" MinDate="_model.StartDate"
                                       InputId="@fieldId" aria-required="true" aria-label="@T.Leave.EndDate"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       For="@(() => _model.EndDate)"
                                       Class="w-100" />
                    </FormField>
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.Leave.Reason" Context="fieldId">
                        <MudTextField Disabled="Busy" @bind-Value="_model.Reason"
                                      InputId="@fieldId" aria-label="@T.Leave.Reason"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="3"
                                      Immediate="true" />
                    </FormField>
                </MudItem>
            </MudGrid>
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.LeaveDialog.SaveChanges : T.LeaveDialog.CreateLeave)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</FormDialog>