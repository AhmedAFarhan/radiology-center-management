@inherits EditorDialogBase
@inject ResourceService ResourceService
@inject IdentityService IdentityService
@inject EnumOptionsService EnumOptionsService

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.Badge" Title="@(Staff is null ? T.Staff.NewStaff : T.FormatValue(T.Staff.Edit, Staff.FullName))" />
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudAutocomplete T="UserDto"
                                     @bind-Value="_selectedUser"
                                     Label="@T.StaffDialog.UserSearch"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     MinCharacters="1"
                                     DebounceInterval="300"
                                     SearchFunc="SearchUsersAsync"
                                     ToStringFunc="@(u => u is null ? string.Empty : $"{u.FullName} ({u.UserName})")"
                                     Clearable="true"
                                     Disabled="Busy" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.FullName"
                                  Label="@T.StaffDialog.FullName"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.FullName)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.Position"
                               Label="@T.Staff.Position"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               For="@(() => _model.Position)">
                        @foreach (var position in _positionOptions)
                        {
                            <MudSelectItem T="string" Value="@position.Key">@position.Value</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_model.HireDate"
                                   Label="@T.Staff.HireDate"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="w-100" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.PhoneNumber"
                                  Label="@T.StaffDialog.PhoneNumber"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  For="@(() => _model.PhoneNumber)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Department"
                                  Label="@T.Staff.Department"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Specialization"
                                  Label="@T.Staff.Specialization"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.LicenseNumber"
                                  Label="@T.StaffDialog.LicenseNumber"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.SalaryCalculationRule"
                               Label="@T.StaffDialog.SalaryCalculationRule"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        <MudSelectItem T="string" Value="@("FixedPlusFees")">@T.StaffDialog.FixedPlusFees</MudSelectItem>
                        <MudSelectItem T="string" Value="@("HigherOfFixedOrFees")">@T.StaffDialog.HigherOfFixedOrFees</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.StaffDialog.SaveChanges : T.StaffDialog.CreateStaff)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</MudDialog>