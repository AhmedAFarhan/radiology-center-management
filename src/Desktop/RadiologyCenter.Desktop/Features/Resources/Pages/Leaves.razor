@page "/resources/leaves"
@attribute [Authorize]
@inherits ListPageBase<LeaveDto>
@inject ResourceService ResourceService

<PageHeader Icon="@Icons.Material.Filled.BeachAccess" Title="@T.Leave.Title"
            Subtitle="@T.Leave.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchPlaceholder="@T.Leave.SearchPlaceholder"
            OnRefresh="ReloadAsync">
    <AuthorizeView Policy="@ResourcesPermissions.LeaveCreate">
        <Authorized Context="auth">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Leave.Add</MudButton>
        </Authorized>
    </AuthorizeView>
</PageHeader>

<MudTable Breakpoint="Breakpoint.Sm" T="LeaveDto" @ref="Table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh>@T.Leave.Staff</MudTh>
        <MudTh><MudTableSortLabel T="LeaveDto" SortLabel="@("LeaveType")">@T.Common.Type</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="LeaveDto" SortLabel="@("StartDate")">@T.Leave.StartDate</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="LeaveDto" SortLabel="@("EndDate")">@T.Leave.EndDate</MudTableSortLabel></MudTh>
        <MudTh>@T.Leave.Duration</MudTh>
        <MudTh>@T.Leave.Reason</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Leave.Staff">
            <MudText Class="font-weight-medium">@ResolveStaff(context.StaffId)</MudText>
        </MudTd>
        <MudTd DataLabel="@T.Common.Type">
            <StatusChip Token="@context.LeaveTypeKey">@context.LeaveType</StatusChip>
        </MudTd>
        <MudTd DataLabel="@T.Leave.StartDate">@context.StartDate.ToString("yyyy-MM-dd")</MudTd>
        <MudTd DataLabel="@T.Leave.EndDate">@context.EndDate.ToString("yyyy-MM-dd")</MudTd>
        <MudTd DataLabel="@T.Leave.Duration">@(T.FormatValue(T.Leave.DurationDays, (context.EndDate.Date - context.StartDate.Date).Days + 1))</MudTd>
        <MudTd DataLabel="@T.Leave.Reason">@(string.IsNullOrWhiteSpace(context.Reason) ? "-" : context.Reason)</MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <AuthorizeView Policy="@ResourcesPermissions.LeaveUpdate">
                <Authorized Context="auth">
                    <MudTooltip Placement="Placement.Bottom" Text="@T.Common.Edit">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" aria-label="@T.Common.Edit" OnClick="@(() => OpenEditDialogAsync(context))" />
                    </MudTooltip>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@ResourcesPermissions.LeaveDelete">
                <Authorized Context="auth">
                    <MudTooltip Placement="Placement.Bottom" Text="@T.Common.Delete">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" aria-label="@T.Common.Delete" OnClick="@(() => DeleteLeaveAsync(context))" />
                    </MudTooltip>
                </Authorized>
            </AuthorizeView>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <TableNoRecords LoadError="@LoadError"
                        Offline="@Offline"
                        ErrorTitle="@T.Leave.LoadErrorTitle"
                        EmptyIcon="@Icons.Material.Filled.BeachAccess"
                        EmptyTitle="@T.Leave.EmptyTitle"
                        EmptyMessage="@T.Leave.EmptyMessage"
                        EmptyActionLabel="@T.Leave.EmptyActionLabel"
                        OnReload="ReloadAsync"
                        OnEmptyAction="OpenCreateDialogAsync" />
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>