<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.EventNote" Title="@T.ExamCalendar.ScheduleExam" />

        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Class="d-flex mx-auto my-4" />
        }
        else
        {
            <EditForm id="schedule-examination-form" EditContext="_editContext" OnValidSubmit="SubmitAsync">
                <LocalizedDataAnnotationsValidator />
                <ValidationSummary />
                @if (_formError is not null) { <MudAlert Severity="Severity.Error" Class="mb-3" role="alert">@_formError</MudAlert> }
                <MudGrid Spacing="3">
                    @* ── Patient ── *@
                    <MudItem xs="12">
                        <MudAutocomplete T="PatientDto" Disabled="_saving" ToStringFunc="@(patient => patient?.FullName ?? string.Empty)" Required="true" RequiredError="@T.ScheduleExam.PatientRequired"
                                         Label="@T.ScheduleExam.Patient"
                                         SearchFunc="SearchPatients"
                                         Value="_selectedPatient"
                                         ValueChanged="OnPatientChanged"
                                         Variant="Variant.Outlined"
                                         Dense="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         ShowProgressIndicator="true"
                                         MaxItems="50">
                        <ItemTemplate Context="patient">
                            <MudText Typo="Typo.body2">@patient.FullName</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@patient.PatientCode</MudText>
                        </ItemTemplate>
                        </MudAutocomplete>
                    </MudItem>

                    <MudItem xs="12">
                        <MudSelect T="string" Value="@_equipmentId" ValueChanged="OnEquipmentChanged" Label="@T.ScheduleExam.Equipment" Variant="Variant.Outlined" Disabled="_saving" Required="true">
                            @foreach (var equipment in _equipment)
                            { <MudSelectItem Value="@equipment.Id">@equipment.Name · @equipment.Modality</MudSelectItem> }
                        </MudSelect>
                    </MudItem>

                    @* ── Examination Type ── *@
                    <MudItem xs="12" Sm="6">
                        <MudAutocomplete T="ExaminationTypeDto" Disabled="_saving" ToStringFunc="@(type => type?.Name ?? string.Empty)" Required="true" RequiredError="@T.ScheduleExam.ExamTypeRequired"
                                         Label="@T.ScheduleExam.ExaminationType"
                                         SearchFunc="SearchExamTypes"
                                         Value="_selectedExamType"
                                         ValueChanged="OnExamTypeChanged"
                                         Variant="Variant.Outlined"
                                         Dense="true"
                                         ResetValueOnEmptyText="true"
                                         CoerceText="true"
                                         ShowProgressIndicator="true"
                                         MaxItems="50">
                        <ItemTemplate Context="examType">
                            <MudText Typo="Typo.body2">@examType.Name</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@examType.Modality · @examType.Code</MudText>
                        </ItemTemplate>
                        </MudAutocomplete>
                    </MudItem>

                    @* ── Priority ── *@
                    <MudItem xs="12" Sm="6">
                        <MudSelect T="string" Disabled="_saving" @bind-Value="_priority" Label="@T.ScheduleExam.Priority"
                                   Variant="Variant.Outlined" Dense="true">
                            <MudSelectItem Value="@("Routine")">@T.ScheduleExam.Routine</MudSelectItem>
                            <MudSelectItem Value="@("Urgent")">@T.ScheduleExam.Urgent</MudSelectItem>
                            <MudSelectItem Value="@("Stat")">@T.ScheduleExam.Emergency</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    @* ── Date & Time ── *@
                    <MudItem xs="12" Sm="6">
                        <MudDatePicker Disabled="_saving" @bind-Date="_model.ScheduledDate"
                                       Label="@T.ScheduleExam.Date"
                                       Variant="Variant.Outlined"

                                       MinDate="ClinicTime.Today" />
                        <ValidationMessage For="@(() => _model.ScheduledDate)" />
                    </MudItem>
                    <MudItem xs="12" Sm="6">
                        <MudTimePicker Disabled="_saving" @bind-Time="_model.ScheduledTime"
                                       Label="@T.ScheduleExam.Time"
                                       Variant="Variant.Outlined"
                                       />
                        <ValidationMessage For="@(() => _model.ScheduledTime)" />
                    </MudItem>

                    @if (_selectedExamType is not null && StartTime is { } start)
                    {
                        <MudItem xs="12"><MudAlert Severity="Severity.Info" Dense="true">
                            @L("Duration", "المدة"): @DurationMinutes @L("minutes", "دقيقة") · <span dir="ltr">@start.ToString("HH:mm")–@start.AddMinutes(DurationMinutes).ToString("HH:mm")</span>
                            <div>@L("Availability is checked for the full duration when you schedule. Times are in Cairo time.", "يتم التحقق من توفر الجهاز طوال مدة الفحص عند الحجز. الأوقات بتوقيت القاهرة.")</div>
                        </MudAlert></MudItem>
                    }

                    @* ── Clinical Indication ── *@
                    <MudItem xs="12">
                        <MudTextField T="string" Disabled="_saving" @bind-Value="_clinicalIndication"
                                      Label="@T.ScheduleExam.ClinicalIndication"
                                      Variant="Variant.Outlined"

                                      Lines="2" />
                    </MudItem>

                    @* ── Notes ── *@
                    <MudItem xs="12">
                        <MudTextField T="string" Disabled="_saving" @bind-Value="_notes"
                                      Label="@T.ScheduleExam.Notes"
                                      Variant="Variant.Outlined"

                                      Lines="2" />
                    </MudItem>
                </MudGrid>
            </EditForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="Cancel" Disabled="_saving">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" form="schedule-examination-form" Disabled="_saving || _loading">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            <MudText>@T.ScheduleExam.Schedule</MudText>
        </MudButton>
    </DialogActions>
</MudDialog>
