@inherits EditorDialogBase
@inject ExaminationService ExaminationService
@inject InventoryService InventoryService
@inject EnumOptionsService EnumOptionsService

<FormDialog Title="@(Type is null ? T.ExamDialog.NewTitle : T.ExamDialog.EditTitle)" Icon="@Icons.Material.Filled.MedicalServices" Subtitle="@T["forms.examinationSubtitle"]">
    <DialogContent>
        <EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <MudGrid Spacing="3">
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.examinationType"]" Icon="@Icons.Material.Outlined.MedicalServices" First="true" />
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.Common.Name" Context="fieldId" Required="true">
                        <LocalizedTextField Disabled="Busy" @bind-Value="_model.Name"
                                      InputId="@fieldId" aria-required="true" aria-label="@T.Common.Name"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      For="@(() => _model.Name)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.ExamDialog.Modality" Context="fieldId" Required="true">
                        <LocalizedSelect Disabled="Busy" T="string"
                                   @bind-Value="_model.Modality"
                                   InputId="@fieldId" aria-required="true" aria-label="@T.ExamDialog.Modality"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   For="@(() => _model.Modality)">
                            @foreach (var option in _modalityOptions)
                            {
                                <MudSelectItem T="string" Value="@option.Key">@option.Value</MudSelectItem>
                            }
                        </LocalizedSelect>
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.ExamDialog.BodyPart" Context="fieldId" Required="true">
                        <LocalizedTextField Disabled="Busy" @bind-Value="_model.BodyPart"
                                      InputId="@fieldId" aria-required="true" aria-label="@T.ExamDialog.BodyPart"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      For="@(() => _model.BodyPart)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.durationPrice"]" Icon="@Icons.Material.Outlined.Schedule" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.ExamDialog.StandardDuration" Context="fieldId">
                        <LocalizedNumericField Disabled="Busy" T="int"
                                         @bind-Value="_model.StandardDurationMinutes"
                                         InputId="@fieldId" aria-label="@T.ExamDialog.StandardDuration"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0"
                                         For="@(() => _model.StandardDurationMinutes)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.ExamDialog.Price" Context="fieldId">
                        <LocalizedNumericField Disabled="Busy" T="decimal"
                                         @bind-Value="_model.Price"
                                         InputId="@fieldId" aria-label="@T.ExamDialog.Price"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0"
                                         For="@(() => _model.Price)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch Disabled="Busy" T="bool" @bind-Value="_model.RequiresPreparation" Color="Color.Info">@T.ExamDialog.RequiresPreparation</MudSwitch>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSwitch Disabled="Busy" T="bool" @bind-Value="_model.RequiresConsent" Color="Color.Warning">@T.ExamDialog.RequiresConsent</MudSwitch>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-3" />
            <div class="d-flex align-center justify-space-between mb-2">
                <FormSectionHeading Title="@T.ExamDialog.ItemsTitle" First="true" />
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddItem" Size="Size.Small">@T.ExamDialog.AddItem</MudButton>
            </div>

            @foreach (var item in _model.Items)
            {
                <div class="app-form-line">
                    <MudGrid Spacing="3" Class="align-center mb-2">
                        <MudItem xs="12" sm="8">
                            <FormField Label="@T.ExamDialog.InventoryItem" Context="fieldId">
                                <MudSelect Disabled="Busy" T="string"
                                           @bind-Value="item.ItemId"
                                           InputId="@fieldId" aria-label="@T.ExamDialog.InventoryItem"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense">
                                    @foreach (var invItem in _inventoryItems)
                                    {
                                        <MudSelectItem T="string" Value="@invItem.Id">@invItem.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </FormField>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <FormField Label="@T.ExamDialog.Qty" Context="fieldId">
                                <MudNumericField Disabled="Busy" T="int"
                                                 @bind-Value="item.Quantity"
                                                 InputId="@fieldId" aria-label="@T.ExamDialog.Qty"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Min="1" />
                            </FormField>
                        </MudItem>
                        <MudItem xs="10">
                            <MudSwitch Disabled="Busy" T="bool" @bind-Value="item.IsContrast" Color="Color.Secondary" Class="me-3">@T.ExamDialog.Contrast</MudSwitch>
                            <MudSwitch Disabled="Busy" T="bool" @bind-Value="item.IsRequired" Color="Color.Primary">@T.ExamDialog.Required</MudSwitch>
                        </MudItem>
                        <MudItem xs="2" Class="d-flex justify-end">
                            <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           aria-label="@T.ExamDialog.RemoveItem"
                                           OnClick="@(() => RemoveItem(item))" />
                        </MudItem>
                    </MudGrid>
                </div>
            }
            @if (_model.Items.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="text-secondary">@T.ExamDialog.NoItems</MudText>
            }
            <button type="submit" style="display:none"></button>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <DialogButtons Busy="Busy"
                       CancelLabel="@T.Common.Cancel"
                       SaveLabel="@(IsEdit ? T.ExamDialog.SaveChanges : T.ExamDialog.CreateType)"
                       OnCancel="CancelAsync"
                       OnSave="SubmitAsync" />
    </DialogActions>
</FormDialog>


