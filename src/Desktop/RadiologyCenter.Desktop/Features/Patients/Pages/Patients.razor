@using RadiologyCenter.Desktop.Services
@page "/patients"
@attribute [Authorize]
@inherits ListPageBase<PatientDto>
@inject UserTimezoneService TimezoneService

<PageHeader Icon="@Icons.Material.Filled.People" Title="@T.Patients.Title"
            Subtitle="@T.Patients.Subtitle"
            SearchValueChanged="OnSearchChanged"
            SearchValue="@SearchQuery"
            SearchPlaceholder="@T.Patients.SearchPlaceholder"
            OnRefresh="ReloadAsync"
            OnExport="ExportToExcelAsync">
    <AuthorizeView Policy="@PatientsPermissions.Create">
        <Authorized Context="auth">
            <MudTooltip Placement="Placement.Bottom" Text="@T.Common.ImportFromExcel">
                <MudIconButton Icon="@Icons.Material.Filled.Download" Color="Color.Default" aria-label="@T.Common.ImportFromExcel" OnClick="OpenImportDialogAsync" />
            </MudTooltip>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialogAsync">@T.Patients.AddPatient</MudButton>
        </Authorized>
    </AuthorizeView>
</PageHeader>

<MudTable Breakpoint="Breakpoint.Sm" T="PatientDto" @ref="Table" ServerData="LoadServerData" Dense="true" Hover="true" Striped="true" Elevation="1" RowsPerPage="10" FixedHeader="true" Class="table-scroll">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="PatientDto" SortLabel="@("PatientCode")">@T.Patients.Code</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PatientDto" SortLabel="@("LastName")">@T.Common.Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PatientDto" SortLabel="@("Gender")">@T.Patients.Gender</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PatientDto" SortLabel="@("Age")">@T.Patients.Age</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PatientDto" SortLabel="@("PhoneNumber")">@T.Patients.Phone</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PatientDto" SortLabel="@("CreatedAt")">@T.Patients.Registered</MudTableSortLabel></MudTh>
        <MudTh>@T.Common.Status</MudTh>
        <MudTh>@T.Common.Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T.Patients.Code"><MudText Class="font-weight-medium">@context.PatientCode</MudText></MudTd>
        <MudTd DataLabel="@T.Common.Name">@context.FullName</MudTd>
        <MudTd DataLabel="@T.Patients.Gender">@context.Gender</MudTd>
        <MudTd DataLabel="@T.Patients.Age">@FormatAge(context.Age, context.DateOfBirth)</MudTd>
        <MudTd DataLabel="@T.Patients.Phone">@context.PhoneNumber</MudTd>
        <MudTd DataLabel="@T.Patients.Registered">@TimezoneHelper.Format(context.CreatedAt, TimezoneService.GetTimeZoneId(), "dd MMM yyyy")</MudTd>
        <MudTd DataLabel="@T.Common.Status">
            <ActiveStatusChip IsActive="context.IsActive" ActiveLabel="@T.Common.Active" InactiveLabel="@T.Common.Inactive" />
        </MudTd>
        <MudTd DataLabel="@T.Common.Actions">
            <RowActions IsActive="context.IsActive"
                        EditLabel="@T.Common.Edit"
                        ToggleLabel="@T.Patients.ToggleStatus"
                        DeleteLabel="@T.Common.Delete"
                        EditPolicy="@PatientsPermissions.Update"
                        TogglePolicy="@PatientsPermissions.Update"
                        DeletePolicy="@PatientsPermissions.Delete"
                        OnEdit="@(() => OpenEditDialogAsync(context))"
                        OnToggle="@(() => ToggleActiveAsync(context))"
                        OnDelete="@(() => DeletePatientAsync(context))" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <TableNoRecords LoadError="@LoadError"
                        Offline="@Offline"
                        ErrorTitle="@T.Patients.LoadErrorTitle"
                        EmptyIcon="@Icons.Material.Filled.Person"
                        EmptyTitle="@T.Patients.EmptyTitle"
                        EmptyMessage="@T.Patients.EmptyMessage"
                        EmptyActionLabel="@T.Patients.EmptyAction"
                        ActionPolicy="@PatientsPermissions.Create"
                        OnReload="ReloadAsync"
                        OnEmptyAction="OpenCreateDialogAsync" />
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" />
    </PagerContent>
</MudTable>


