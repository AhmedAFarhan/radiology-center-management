@inject PatientService PatientService
@inject EnumOptionsService EnumOptionsService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog Class="patient-editor" TitleClass="patient-editor-title" ContentClass="patient-editor-content" ActionsClass="patient-editor-actions">
    <TitleContent>
        <div class="patient-editor-heading">
            <span class="patient-editor-emblem" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.PersonAdd" /></span>
            <div>
                <h2>@(IsEdit ? T.PatientDialog.EditTitle : T.PatientDialog.NewTitle)</h2>
                <p>@T["patientDialog.subtitle"]</p>
            </div>
            @if (Patient is not null)
            {
                <span class="patient-editor-code" dir="ltr">@Patient.PatientCode</span>
            }
        </div>
    </TitleContent>
    <DialogContent>
        <EditForm id="patient-editor-form" EditContext="_editContext" OnSubmit="SubmitAsync" novalidate="novalidate">
            <LocalizedDataAnnotationsValidator />
            @if (_showValidationSummary)
            {
                <div class="patient-form-errors" role="alert" tabindex="-1" @ref="_validationSummary">
                    <strong>@T["patientDialog.reviewFields"]</strong>
                    <ValidationSummary />
                </div>
            }
            <fieldset class="patient-form-section" disabled="@_busy">
                <legend><MudIcon Icon="@Icons.Material.Outlined.Person" aria-hidden="true" /> @T["patientDialog.basicDetails"]</legend>
                <div class="patient-form-grid">
                    <div class="patient-form-field patient-form-wide">
                        <label for="patient-full-name">@T.PatientDialog.FullName <span class="patient-required" aria-hidden="true">*</span></label>
                        <LocalizedTextField InputId="patient-full-name" Disabled="_busy" @bind-Value="_model.FullName"
                                      Variant="Variant.Outlined" Margin="Margin.None" Immediate="true" aria-required="true"
                                      Placeholder="@T["patientDialog.fullNameHint"]" For="@(() => _model.FullName)" />
                    </div>
                    <div class="patient-form-field">
                        <label for="patient-gender">@T.PatientDialog.Gender <span class="patient-required" aria-hidden="true">*</span></label>
                        <LocalizedSelect InputId="patient-gender" Disabled="_busy" T="string" @bind-Value="_model.Gender" aria-label="@T.PatientDialog.Gender" aria-required="true"
                                   Variant="Variant.Outlined" Margin="Margin.None" For="@(() => _model.Gender)">
                            @foreach (var gender in _genderOptions)
                            {
                                <MudSelectItem T="string" Value="@gender.Key">@gender.Value</MudSelectItem>
                            }
                        </LocalizedSelect>
                    </div>
                    <div class="patient-form-field patient-form-ltr-value">
                        <label for="patient-phone">@T.PatientDialog.PhoneNumber <span class="patient-required" aria-hidden="true">*</span></label>
                        <LocalizedTextField InputId="patient-phone" InputType="InputType.Telephone" Disabled="_busy" @bind-Value="_model.PhoneNumber"
                                      Variant="Variant.Outlined" Margin="Margin.None" Immediate="true" aria-required="true" For="@(() => _model.PhoneNumber)" />
                    </div>
                    <div class="patient-form-field">
                        <label for="patient-age">@T.PatientDialog.Age <span class="patient-field-unit">@T["patientDialog.years"]</span></label>
                        <LocalizedNumericField InputId="patient-age" Disabled="_busy" T="int?" @bind-Value="_model.Age" aria-describedby="patient-age-hint"
                                         Variant="Variant.Outlined" Margin="Margin.None" Min="0" Max="150" Immediate="true" For="@(() => _model.Age)" />
                    </div>
                    <div class="patient-form-field">
                        <label for="patient-birth-date">@T.PatientDialog.DateOfBirth</label>
                        <LocalizedDatePicker InputId="patient-birth-date" Disabled="_busy" @bind-Date="_model.DateOfBirth" MaxDate="ClinicTime.Today"
                                       Variant="Variant.Outlined" Margin="Margin.None" Clearable="true" aria-describedby="patient-age-hint" For="@(() => _model.DateOfBirth)" />
                    </div>
                    <p class="patient-form-hint patient-form-wide" id="patient-age-hint">@T["patientDialog.ageHint"]</p>
                </div>
            </fieldset>

            <fieldset class="patient-form-section patient-form-clinical" disabled="@_busy">
                <legend><MudIcon Icon="@Icons.Material.Outlined.MedicalInformation" aria-hidden="true" /> @T["patientDialog.clinicalDetails"]</legend>
                <div class="patient-form-grid">
                    <div class="patient-form-field patient-form-wide">
                        <label for="patient-allergies">@T.PatientDialog.Allergies</label>
                        <MudTextField InputId="patient-allergies" Disabled="_busy" @bind-Value="_model.Allergies"
                                      Variant="Variant.Outlined" Margin="Margin.None" Immediate="true" Placeholder="@T["patientDialog.allergiesHint"]" />
                    </div>
                    <div class="patient-form-field patient-form-wide">
                        <label for="patient-history">@T.PatientDialog.MedicalHistory</label>
                        <MudTextField InputId="patient-history" Disabled="_busy" @bind-Value="_model.MedicalHistory"
                                      Variant="Variant.Outlined" Margin="Margin.None" Lines="2" Immediate="true" />
                    </div>
                </div>
            </fieldset>

            <MudExpansionPanels Class="patient-form-additional" Elevation="0">
                <MudExpansionPanel @bind-Expanded="_detailsOpen" Disabled="_busy" Text="@T["patientDialog.additionalDetails"]">
                    <div class="patient-form-grid">
                        <div class="patient-form-field patient-form-ltr-value">
                            <label for="patient-email">@T.PatientDialog.Email</label>
                            <LocalizedTextField InputId="patient-email" InputType="InputType.Email" Disabled="_busy" @bind-Value="_model.Email"
                                          Variant="Variant.Outlined" Margin="Margin.None" Immediate="true" For="@(() => _model.Email)" />
                        </div>
                        <div class="patient-form-field patient-form-ltr-value">
                            <label for="patient-national-id">@T.PatientDialog.NationalId</label>
                            <MudTextField InputId="patient-national-id" Disabled="_busy" @bind-Value="_model.NationalId"
                                          Variant="Variant.Outlined" Margin="Margin.None" Immediate="true" />
                        </div>
                        <div class="patient-form-field">
                            <label for="patient-blood-type">@T.PatientDialog.BloodType</label>
                            <MudSelect InputId="patient-blood-type" Disabled="_busy" T="string" @bind-Value="_model.BloodType" aria-label="@T.PatientDialog.BloodType"
                                       Variant="Variant.Outlined" Margin="Margin.None" Clearable="true">
                                @foreach (var bloodType in _bloodTypeOptions)
                                {
                                    <MudSelectItem T="string" Value="@bloodType.Key">@bloodType.Value</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                        <div class="patient-form-field patient-form-wide">
                            <label for="patient-address">@T.PatientDialog.Address</label>
                            <MudTextField InputId="patient-address" Disabled="_busy" @bind-Value="_model.Address"
                                          Variant="Variant.Outlined" Margin="Margin.None" Immediate="true" />
                        </div>
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <div class="patient-form-buttons">
            <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" form="patient-editor-form" Disabled="_busy">
                @if (_busy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                }
                @(IsEdit ? T.PatientDialog.SaveChanges : T.PatientDialog.CreatePatient)
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>
