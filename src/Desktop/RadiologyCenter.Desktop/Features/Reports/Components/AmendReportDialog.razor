@inject ReportService ReportService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<MudDialog>
    <DialogContent>
        <DialogHeader Icon="@Icons.Material.Filled.EditNote" Title="@T.AmendReport.Title" />
        <MudText Typo="Typo.body2" Class="text-secondary mb-2">
            @(T.FormatValue(T.AmendReport.Description, CurrentVersion + 1))
        </MudText>
        <MudTextField @bind-Value="_reason"
                      Label="@T.AmendReport.Reason"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      FullWidth="true"
                      Required="true"
                      MaxLength="500"
                      Disabled="_busy" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.EditNote" OnClick="SubmitAsync" Disabled="_busy || string.IsNullOrWhiteSpace(_reason)">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            else
            {
                <text>@T.AmendReport.Title</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

