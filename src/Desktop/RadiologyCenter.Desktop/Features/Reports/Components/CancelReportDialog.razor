@inject ReportService ReportService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<FormDialog Title="@T.CancelReport.Title" Icon="@Icons.Material.Filled.CancelPresentation" Subtitle="@T["forms.reportSubtitle"]">
    <DialogContent>
        <MudText Typo="Typo.body2" Class="text-muted-text mb-2">
            @T.CancelReport.Description
        </MudText>
        <FormField Label="@T.CancelReport.ReasonOptional" Context="fieldId">
            <MudTextField @bind-Value="_reason"
                          InputId="@fieldId" aria-label="@T.CancelReport.ReasonOptional"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          FullWidth="true"
                          Disabled="_busy" />
        </FormField>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            <text>@T.CancelReport.Title</text>
        </MudButton>
    </DialogActions>
</FormDialog>

