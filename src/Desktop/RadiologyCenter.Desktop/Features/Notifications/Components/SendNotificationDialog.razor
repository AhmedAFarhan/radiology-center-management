@inject NotificationService NotificationService
@inject EnumOptionsService EnumOptionsService
@inject ISnackbar Snackbar
@inject AppLocalizer T

<FormDialog Title="@T.SendDialog.Title" Icon="@Icons.Material.Filled.Send" Subtitle="@T["forms.notificationSubtitle"]">
    <DialogContent>
        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="mb-3">
            @T.SendDialog.LogOnlyAlert
        </MudAlert>
        <EditForm EditContext="_editContext">
            <LocalizedDataAnnotationsValidator />
            <div role="alert"><ValidationSummary /></div>
            <MudGrid Spacing="3">
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.delivery"]" Icon="@Icons.Material.Outlined.Send" First="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.SendDialog.RecipientLabel" Context="fieldId" Required="true">
                        <LocalizedTextField Disabled="_busy" @bind-Value="_model.Recipient"
                                      InputId="@fieldId" aria-required="true" aria-label="@T.SendDialog.RecipientLabel"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      For="@(() => _model.Recipient)" />
                    </FormField>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <FormField Label="@T.SendDialog.Channel" Context="fieldId" Required="true">
                        <LocalizedSelect Disabled="_busy" T="string"
                                   Value="_model.Channel"
                                   ValueChanged="OnChannelChangedAsync"
                                   InputId="@fieldId" aria-required="true" aria-label="@T.SendDialog.Channel"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   For="@(() => _model.Channel)">
                            @foreach (var channel in _channelOptions)
                            {
                                <MudSelectItem T="string" Value="@channel.Key">@channel.Value</MudSelectItem>
                            }
                        </LocalizedSelect>
                    </FormField>
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.SendDialog.Template" Context="fieldId">
                        <MudSelect Disabled="_busy" T="string"
                                   Value="_model.TemplateCode"
                                   ValueChanged="OnTemplateCodeChangedAsync"
                                   InputId="@fieldId" aria-label="@T.SendDialog.Template"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   HelperText="@T.SendDialog.TemplateHelper">
                            <MudSelectItem T="string" Value="@(string.Empty)">@T.SendDialog.NoTemplate</MudSelectItem>
                            @foreach (var template in _templates)
                            {
                                <MudSelectItem T="string" Value="@template.Code">@template.Code - @template.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </FormField>
                </MudItem>
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.message"]" Icon="@Icons.Material.Outlined.MailOutline" />
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.SendDialog.Subject" Context="fieldId">
                        <MudTextField Disabled="_busy" @bind-Value="_model.Subject"
                                      InputId="@fieldId" aria-label="@T.SendDialog.Subject"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                    </FormField>
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.SendDialog.Body" Context="fieldId">
                        <MudTextField Disabled="_busy" @bind-Value="_model.Body"
                                      InputId="@fieldId" aria-label="@T.SendDialog.Body"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Lines="4"
                                      />
                    </FormField>
                </MudItem>
                <MudItem xs="12" Class="app-form-section-item">
                    <FormSectionHeading Title="@T["forms.reference"]" Icon="@Icons.Material.Outlined.Subject" />
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.SendDialog.ReferenceOptional" Context="fieldId">
                        <MudTextField Disabled="_busy" @bind-Value="_model.ReferenceId"
                                      InputId="@fieldId" aria-label="@T.SendDialog.ReferenceOptional"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                    </FormField>
                </MudItem>
                <MudItem xs="12">
                    <FormField Label="@T.SendDialog.PlaceholdersLabel" Context="fieldId">
                        <MudTextField Disabled="_busy" @bind-Value="_model.Placeholders"
                                      InputId="@fieldId" aria-label="@T.SendDialog.PlaceholdersLabel"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true" />
                    </FormField>
                </MudItem>
            </MudGrid>
        </EditForm>

        @if (_preview is not null)
        {
            <MudPaper Elevation="1" Class="mt-3 pa-3">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-1">@T.SendDialog.Preview</MudText>
                <MudText Typo="Typo.caption" Class="mb-1">@(T.FormatValue(T.SendDialog.PreviewSubject, _preview.Subject))</MudText>
                <MudText>@_preview.Body</MudText>
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="CancelAsync" Disabled="_busy">@T.Common.Cancel</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="PreviewAsync" Disabled="_busy" StartIcon="@Icons.Material.Filled.Preview">
            @T.SendDialog.Preview
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy" StartIcon="@Icons.Material.Filled.Send">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mx-1" />
            }
            <text>@T.SendDialog.Send</text>
        </MudButton>
    </DialogActions>
</FormDialog>

