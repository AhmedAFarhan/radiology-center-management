@using ApexCharts
@inject AppLocalizer T

@if (Items.Count == 0)
{
    <div class="pa-6 text-center text-secondary">@T.Analytics.NoData</div>
}
else
{
    <ApexChart TItem="AnalyticsSlice" Height="Height" Options="_options">
        <ApexPointSeries TItem="AnalyticsSlice"
                         Items="Items"
                         Name="@SeriesName"
                         SeriesType="SeriesType.Bar"
                         XValue="@(s => s.Label)"
                         YValue="@(s => s.Value)" />
    </ApexChart>
}


