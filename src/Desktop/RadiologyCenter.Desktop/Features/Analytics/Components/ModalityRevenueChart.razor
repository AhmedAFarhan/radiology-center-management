@using ApexCharts
@using RadiologyCenter.Desktop.Models
@inject AppLocalizer T

@if (Items.Count == 0)
{
    <div class="pa-6 text-center text-secondary">@T.Analytics.NoModalityData</div>
}
else
{
    <ApexChart TItem="RevenueByModalityDto" Height="Height" Options="_options">
        <ApexPointSeries TItem="RevenueByModalityDto"
                         Items="Items"
                         Name="@T.Analytics.Collected"
                         SeriesType="SeriesType.Bar"
                         XValue="@(m => m.Modality)"
                         YValue="@(m => m.Collected)" />
    </ApexChart>
}

