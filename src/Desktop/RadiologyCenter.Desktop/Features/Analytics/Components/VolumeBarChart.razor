@using ApexCharts
@using RadiologyCenter.Desktop.Models
@inject AppLocalizer T

@if (Items.Count == 0)
{
    <div class="pa-6 text-center text-secondary">@T.Analytics.NoVolumeData</div>
}
else
{
    <ApexChart TItem="MonthlyVolumeDto" Height="Height" Options="_options">
        <ApexPointSeries TItem="MonthlyVolumeDto"
                         Items="Items"
                         Name="@T.Analytics.Total"
                         SeriesType="SeriesType.Bar"
                         XValue="@(m => m.Month)"
                         YValue="@(m => m.Total)" />
        <ApexPointSeries TItem="MonthlyVolumeDto"
                         Items="Items"
                         Name="@T.Analytics.Completed"
                         SeriesType="SeriesType.Bar"
                         XValue="@(m => m.Month)"
                         YValue="@(m => m.Completed)" />
    </ApexChart>
    <ChartDataTable Headers="@(new[] { T.Analytics.Period, T.Analytics.Total, T.Analytics.Completed })" Rows="@Items.Select(row => new[] { row.Month, row.Total.ToString("N0"), row.Completed.ToString("N0") })" />
}




