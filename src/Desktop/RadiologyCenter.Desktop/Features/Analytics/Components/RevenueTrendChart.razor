@using ApexCharts
@using RadiologyCenter.Desktop.Models
@inject AppLocalizer T

@if (Items.Count == 0)
{
    <div class="pa-6 text-center text-secondary">@T.Analytics.NoRevenueData</div>
}
else
{
    <ApexChart TItem="RevenuePointDto" Height="Height" Options="_options">
        <ApexPointSeries TItem="RevenuePointDto"
                         Items="Items"
                         Name="@T.Analytics.Collected"
                         SeriesType="SeriesType.Area"
                         XValue="@(r => r.Month)"
                         YValue="@(r => r.Collected)" />
        <ApexPointSeries TItem="RevenuePointDto"
                         Items="Items"
                         Name="@T.Analytics.Billed"
                         SeriesType="SeriesType.Area"
                         XValue="@(r => r.Month)"
                         YValue="@(r => r.Billed)" />
    </ApexChart>
}




