@using ApexCharts
@inject AppLocalizer T

@if (Items.Count == 0)
{
    <div class="pa-6 text-center text-secondary">@T.Analytics.NoData</div>
}
else
{
    <ApexChart TItem="AnalyticsSlice" Height="Height" Options="_options">
        <ApexPointSeries TItem="AnalyticsSlice"
                         Items="Items"
                         Name="@T.Analytics.Value"
                         SeriesType="SeriesType.Donut"
                         XValue="@(s => s.Label)"
                         YValue="@(s => s.Value)" />
    </ApexChart>
    <ChartDataTable Headers="@(new[] { T.Common.Name, T.Analytics.Value })" Rows="@Items.Select(row => new[] { row.Label, row.Value.ToString("N2") })" />
}


