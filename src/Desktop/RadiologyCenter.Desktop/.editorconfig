root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{cs,razor}]
indent_size = 4
indent_style = space
tab_width = 4

[*.cs]
# Naming rules
dotnet_naming_rule.private_members_with_underscore.symbols = private_members_with_underscore
dotnet_naming_rule.private_members_with_underscore.style = underscore_prefix
dotnet_naming_rule.private_members_with_underscore.severity = suggestion
dotnet_naming_symbols.private_members_with_underscore.applicable_kinds = field
dotnet_naming_symbols.private_members_with_underscore.required_modifiers = private
dotnet_naming_style.underscore_prefix.required_prefix = _
dotnet_naming_style.underscore_prefix.word_separator = _
dotnet_naming_style.underscore_prefix.capitalization = camel_case

# Formatting
csharp_new_line_before_open_brace = all
csharp_space_around_binary_operators = before_and_after
dotnet_sort_system_directives_first = true